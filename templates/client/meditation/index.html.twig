{% extends 'base.html.twig' %}
{% block title %}Meditation Guidee - Nafseyti{% endblock %}
{% block body %}
<style>
:root{--b-white:#FDFAF5;--b-cream:#F7F2E8;--b-light:#EDE3D0;--b-mid:#D9C4A0;--b-dark:#C4A882;--b-deep:#A8895A;--g-mid:#4A7C2F;--g-sage:#7BA05B;--g-pale:#D4E6C3;--txt:#2C1F0E;--txt-soft:#7A6248;--shadow:rgba(168,137,90,.14);--r:22px;}
.med-hero{background:var(--b-cream);padding:72px 64px 56px;position:relative;overflow:hidden;border-bottom:1px solid var(--b-light);}
.med-blob{position:absolute;border-radius:50% 40% 60% 30%/40% 60% 30% 50%;filter:blur(70px);pointer-events:none;}
.med-blob.a{width:500px;height:500px;background:rgba(196,168,130,.2);top:-160px;right:-100px;}
.med-blob.b{width:300px;height:300px;background:rgba(212,230,195,.15);bottom:-80px;left:60px;}
.med-hero-inner{position:relative;z-index:1;max-width:960px;}
.med-tag{display:inline-flex;align-items:center;gap:8px;background:white;border:1px solid var(--b-mid);border-radius:100px;padding:6px 18px;font-size:.65rem;letter-spacing:2.5px;text-transform:uppercase;color:var(--b-deep);margin-bottom:22px;box-shadow:0 2px 10px var(--shadow);}
.med-tag::before{content:'';width:7px;height:7px;background:var(--b-dark);border-radius:50%;}
.med-hero h1{font-family:'Playfair Display',serif;font-size:clamp(2rem,5vw,3.2rem);color:var(--txt);font-weight:400;line-height:1.15;margin-bottom:12px;}
.med-hero h1 em{font-style:italic;color:var(--b-deep);}
.med-hero-sub{font-family:'Cormorant Garamond',serif;font-size:1.15rem;color:var(--txt-soft);line-height:1.7;}
.med-page{background:var(--b-white);min-height:70vh;padding:56px 64px;}
.med-eyebrow{font-size:.65rem;text-transform:uppercase;letter-spacing:3px;color:var(--b-deep);margin-bottom:6px;display:flex;align-items:center;gap:10px;}
.med-eyebrow::before{content:'';width:24px;height:1px;background:var(--b-mid);}
.med-section-title{font-family:'Playfair Display',serif;font-size:1.9rem;color:var(--txt);font-weight:400;margin-bottom:32px;}
.med-section-title em{font-style:italic;color:var(--b-deep);}
.med-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;margin-bottom:56px;}
.med-card{background:white;border:1px solid var(--b-light);border-radius:var(--r);overflow:hidden;transition:all .3s;box-shadow:0 2px 10px rgba(168,137,90,.06);cursor:pointer;}
.med-card:hover{transform:translateY(-5px);border-color:var(--b-dark);box-shadow:0 16px 48px var(--shadow);}
.med-card-banner{height:120px;display:flex;align-items:center;justify-content:center;font-size:3.5rem;}
.med-card-body{padding:22px 24px;}
.med-card-tag{display:inline-block;background:var(--b-cream);border:1px solid var(--b-light);border-radius:100px;padding:3px 12px;font-size:.62rem;letter-spacing:2px;text-transform:uppercase;color:var(--b-deep);margin-bottom:10px;}
.med-card h3{font-family:'Playfair Display',serif;font-size:1.1rem;color:var(--txt);margin-bottom:6px;font-weight:600;}
.med-card p{font-size:.83rem;color:var(--txt-soft);line-height:1.6;margin-bottom:14px;}
.med-card-meta{display:flex;align-items:center;justify-content:space-between;font-size:.72rem;color:var(--txt-soft);}
.med-card-meta i{color:var(--b-dark);margin-right:4px;}
.med-play-btn{width:36px;height:36px;background:var(--g-mid);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:.8rem;flex-shrink:0;}
.med-card:hover .med-play-btn{background:var(--g-sage);}
.player-overlay{display:none;position:fixed;inset:0;background:rgba(44,31,14,.55);backdrop-filter:blur(6px);z-index:9999;align-items:center;justify-content:center;padding:20px;}
.player-overlay.active{display:flex;}
.player-modal{background:var(--b-white);border-radius:28px;max-width:520px;width:100%;box-shadow:0 32px 100px rgba(44,31,14,.25);overflow:hidden;}
.player-banner{height:160px;display:flex;align-items:center;justify-content:center;font-size:5rem;position:relative;}
.player-close{position:absolute;top:14px;right:14px;width:34px;height:34px;background:rgba(255,255,255,.8);border:1px solid var(--b-light);border-radius:50%;cursor:pointer;font-size:1rem;color:var(--txt-soft);display:flex;align-items:center;justify-content:center;}
.player-body{padding:28px 32px 32px;}
.player-tag{display:inline-block;background:var(--b-cream);border:1px solid var(--b-light);border-radius:100px;padding:3px 12px;font-size:.62rem;letter-spacing:2px;text-transform:uppercase;color:var(--b-deep);margin-bottom:10px;}
.player-title{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--txt);margin-bottom:6px;font-weight:600;}
.player-desc{font-size:.87rem;color:var(--txt-soft);line-height:1.65;margin-bottom:20px;}
.progress-track{height:6px;background:var(--b-light);border-radius:100px;overflow:hidden;cursor:pointer;margin-bottom:10px;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--g-mid),var(--g-sage));border-radius:100px;width:0%;pointer-events:none;}
.time-row{display:flex;justify-content:space-between;font-size:.72rem;color:var(--txt-soft);}
.controls{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:16px;}
.ctrl-btn{width:44px;height:44px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1rem;}
.ctrl-btn.secondary{background:var(--b-cream);border:1px solid var(--b-light);color:var(--txt-soft);}
.ctrl-btn.primary{width:56px;height:56px;font-size:1.2rem;background:var(--g-mid);color:white;}
.ctrl-btn.primary:hover{background:#2D5016;}
.volume-row{display:flex;align-items:center;gap:10px;margin-top:16px;font-size:.75rem;color:var(--txt-soft);}
.volume-row i{color:var(--b-dark);width:16px;}
input[type=range].vol-slider{flex:1;height:4px;accent-color:var(--g-mid);cursor:pointer;}
.phrase-box{min-height:48px;font-family:'Cormorant Garamond',serif;font-size:1.05rem;color:var(--txt-soft);text-align:center;font-style:italic;margin-bottom:14px;line-height:1.5;padding:10px;background:var(--b-cream);border-radius:10px;}
.breath-guide{text-align:center;padding:16px;background:var(--b-cream);border-radius:14px;border:1px solid var(--b-light);margin-top:16px;display:none;}
.breath-circle{width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,var(--g-pale),var(--g-sage));margin:0 auto 10px;animation:breathe 8s ease-in-out infinite;}
@keyframes breathe{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.4);opacity:1}}
.breath-label{font-size:.78rem;color:var(--txt-soft);}
</style>
<section class="med-hero">
<div class="med-blob a"></div><div class="med-blob b"></div>
<div class="med-hero-inner">
<div class="med-tag">Bien-etre Mental</div>
<h1>Meditation <em>Guidee</em></h1>
<p class="med-hero-sub">Des seances audio pour calmer ton esprit et retrouver l equilibre.</p>
</div>
</section>
<section class="med-page">
<div class="med-eyebrow">Seances disponibles</div>
<h2 class="med-section-title">Choisis ta <em>Seance</em></h2>
<div style="background:var(--b-cream);border:1px solid var(--b-mid);border-radius:14px;padding:16px 20px;margin-bottom:28px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
<span style="font-size:1.2rem;">&#128266;</span>
<span style="font-size:.85rem;color:var(--txt-soft);flex:1;">Teste la voix guidee avant de commencer</span>
<button onclick="testVoix()" style="background:var(--g-mid);color:white;border:none;padding:9px 22px;border-radius:100px;font-size:.78rem;font-weight:600;cursor:pointer;">Tester la voix</button>
<span id="ttsStatus" style="font-size:.78rem;color:var(--txt-soft);"></span>
</div>
<div class="med-grid">
<div class="med-card" onclick="openPlayer('stress')">
<div class="med-card-banner" style="background:linear-gradient(135deg,#f0e6d3,#e8d5b7);">&#127783;</div>
<div class="med-card-body"><span class="med-card-tag">Stress</span><h3>Respiration Anti-Stress</h3><p>Technique 4-7-8 pour calmer le systeme nerveux.</p>
<div class="med-card-meta"><span><i class="fas fa-clock"></i> 5 min</span><span><i class="fas fa-signal"></i> Debutant</span><div class="med-play-btn"><i class="fas fa-play"></i></div></div></div>
</div>
<div class="med-card" onclick="openPlayer('sommeil')">
<div class="med-card-banner" style="background:linear-gradient(135deg,#e8e0f0,#d5c8e8);">&#127769;</div>
<div class="med-card-body"><span class="med-card-tag">Sommeil</span><h3>Relaxation du Soir</h3><p>Detends chaque muscle pour un sommeil profond.</p>
<div class="med-card-meta"><span><i class="fas fa-clock"></i> 10 min</span><span><i class="fas fa-signal"></i> Tous niveaux</span><div class="med-play-btn"><i class="fas fa-play"></i></div></div></div>
</div>
<div class="med-card" onclick="openPlayer('focus')">
<div class="med-card-banner" style="background:linear-gradient(135deg,#d3e8d3,#b7d5b7);">&#127919;</div>
<div class="med-card-body"><span class="med-card-tag">Concentration</span><h3>Pleine Conscience</h3><p>Ancre-toi dans le moment present.</p>
<div class="med-card-meta"><span><i class="fas fa-clock"></i> 7 min</span><span><i class="fas fa-signal"></i> Intermediaire</span><div class="med-play-btn"><i class="fas fa-play"></i></div></div></div>
</div>
<div class="med-card" onclick="openPlayer('anxiete')">
<div class="med-card-banner" style="background:linear-gradient(135deg,#f0e8d3,#e8d5b0);">&#127754;</div>
<div class="med-card-body"><span class="med-card-tag">Anxiete</span><h3>Ancrage et Securite</h3><p>Technique des 5 sens contre l anxiete.</p>
<div class="med-card-meta"><span><i class="fas fa-clock"></i> 8 min</span><span><i class="fas fa-signal"></i> Tous niveaux</span><div class="med-play-btn"><i class="fas fa-play"></i></div></div></div>
</div>
<div class="med-card" onclick="openPlayer('confiance')">
<div class="med-card-banner" style="background:linear-gradient(135deg,#f5e8d0,#ecd5b0);">&#9728;</div>
<div class="med-card-body"><span class="med-card-tag">Confiance</span><h3>Visualisation Positive</h3><p>Renforce ta confiance par la visualisation.</p>
<div class="med-card-meta"><span><i class="fas fa-clock"></i> 6 min</span><span><i class="fas fa-signal"></i> Debutant</span><div class="med-play-btn"><i class="fas fa-play"></i></div></div></div>
</div>
<div class="med-card" onclick="openPlayer('energie')">
<div class="med-card-banner" style="background:linear-gradient(135deg,#e8f0d3,#d5e8b7);">&#9889;</div>
<div class="med-card-body"><span class="med-card-tag">Energie</span><h3>Reveil Energisant</h3><p>Commence ta journee avec vitalite.</p>
<div class="med-card-meta"><span><i class="fas fa-clock"></i> 5 min</span><span><i class="fas fa-signal"></i> Debutant</span><div class="med-play-btn"><i class="fas fa-play"></i></div></div></div>
</div>
</div>
</section>
<div class="player-overlay" id="playerOverlay">
<div class="player-modal">
<div class="player-banner" id="playerBanner"><button class="player-close" onclick="closePlayer()">X</button></div>
<div class="player-body">
<span class="player-tag" id="playerTag"></span>
<h2 class="player-title" id="playerTitle"></h2>
<p class="player-desc" id="playerDesc"></p>
<div id="ttsWarn" style="display:none;background:#FEF3C7;border:1px solid #FDE68A;border-radius:10px;padding:10px;font-size:.82rem;color:#92400E;margin-bottom:12px;">Voix non supportee. Utilise Chrome ou Edge.</div>
<div class="phrase-box" id="phraseBox">Appuie sur Play pour commencer...</div>
<div class="progress-track" id="progressTrack" onclick="seekTo(event)"><div class="progress-fill" id="progressFill"></div></div>
<div class="time-row"><span id="timeCur">0:00</span><span id="timeTot">0:00</span></div>
<div class="controls">
<button class="ctrl-btn secondary" onclick="skip(-15)"><i class="fas fa-undo"></i></button>
<button class="ctrl-btn primary" id="playBtn" onclick="togglePlay()"><i class="fas fa-play"></i></button>
<button class="ctrl-btn secondary" onclick="skip(15)"><i class="fas fa-redo"></i></button>
</div>
<div class="volume-row"><i class="fas fa-volume-down"></i><input type="range" class="vol-slider" id="volSlider" min="0" max="1" step="0.05" value="1"><i class="fas fa-volume-up"></i></div>
<div class="breath-guide" id="breathGuide"><div class="breath-circle"></div><div class="breath-label" id="breathLbl">Inspire...</div></div>
</div>
</div>
</div>
<script>
var S={stress:{tag:'Stress',icon:'Respiration',bg:'linear-gradient(135deg,#f0e6d3,#e8d5b7)',title:'Respiration Anti-Stress',desc:'Technique 4-7-8.',dur:300,breath:true,lines:[[0,'Bienvenue. Installe-toi confortablement.'],[6,'Ferme les yeux. Detends tes epaules.'],[13,'Nous allons pratiquer la respiration quatre sept huit.'],[20,'Inspire lentement. Un. Deux. Trois. Quatre.'],[28,'Retiens. Un. Deux. Trois. Quatre. Cinq. Six. Sept.'],[39,'Expire. Un. Deux. Trois. Quatre. Cinq. Six. Sept. Huit.'],[52,'Tres bien. Recommençons.'],[57,'Inspire. Un. Deux. Trois. Quatre.'],[65,'Retiens. Un. Deux. Trois. Quatre. Cinq. Six. Sept.'],[76,'Expire. Un. Deux. Trois. Quatre. Cinq. Six. Sept. Huit.'],[89,'Excellent. Tu sens ton corps se detendre.'],[128,'Tu peux ouvrir les yeux. Tu es calme.']]},sommeil:{tag:'Sommeil',icon:'Sommeil',bg:'linear-gradient(135deg,#e8e0f0,#d5c8e8)',title:'Relaxation du Soir',desc:'Detends chaque muscle.',dur:600,breath:false,lines:[[0,'Bonsoir. Allonge-toi confortablement.'],[6,'Ferme les yeux.'],[14,'Prends une grande inspiration et expire lentement.'],[23,'Detends tes pieds.'],[34,'Remonte vers tes mollets.'],[44,'Tes cuisses sont lourdes.'],[54,'Ton ventre se souleve doucement.'],[64,'Tes epaules descendent.'],[74,'Tes bras sont lourds.'],[84,'Ton visage se detend.'],[99,'Le sommeil arrive doucement.'],[129,'Bonne nuit.']]},focus:{tag:'Concentration',icon:'Focus',bg:'linear-gradient(135deg,#d3e8d3,#b7d5b7)',title:'Pleine Conscience',desc:'Moment present.',dur:420,breath:true,lines:[[0,'Assieds-toi confortablement.'],[6,'Ferme les yeux.'],[13,'Observe ta respiration.'],[21,'Ne cherche pas a controler.'],[29,'Si une pensee arrive, remarque-la.'],[37,'Ramene ton attention a ta respiration.'],[45,'Tu es ici. Tu es present.'],[85,'Ouvre les yeux. Tu es focus.']]},anxiete:{tag:'Anxiete',icon:'Ancrage',bg:'linear-gradient(135deg,#f0e8d3,#e8d5b0)',title:'Ancrage et Securite',desc:'Technique des 5 sens.',dur:480,breath:false,lines:[[0,'Tu es en securite.'],[6,'Pose tes pieds sur le sol.'],[14,'Nomme cinq choses que tu vois.'],[33,'Touche quelque chose. Sens sa texture.'],[51,'Nomme trois sons que tu entends.'],[69,'Et une chose que tu peux gouter.'],[85,'Tu vas bien.']]},confiance:{tag:'Confiance',icon:'Confiance',bg:'linear-gradient(135deg,#f5e8d0,#ecd5b0)',title:'Visualisation Positive',desc:'Renforce ta confiance.',dur:360,breath:false,lines:[[0,'Ferme les yeux.'],[8,'Visualise-toi confiant.'],[16,'Tu es calme. Tu es capable.'],[24,'Imagine-toi en train de reussir.'],[40,'Tu merites ce succes.'],[55,'Je suis pret. Je suis confiant.'],[62,'Ouvre les yeux.']]},energie:{tag:'Energie',icon:'Energie',bg:'linear-gradient(135deg,#e8f0d3,#d5e8b7)',title:'Reveil Energisant',desc:'Vitalite matinale.',dur:300,breath:true,lines:[[0,'Bonjour ! Belle journee.'],[6,'Etire-toi doucement.'],[13,'Grande inspiration.'],[21,'Lumiere doree qui entre.'],[41,'Tu es rempli d energie.'],[64,'Bonne journee !']]}};
var cur=null,playing=false,elapsed=0,timerId=null,keepId=null,breathId=null,lineIds=[];
var BP=['Inspire... 4s','Retiens... 7s','Expire... 8s'],BD=[4000,7000,8000];
if('speechSynthesis' in window){window.speechSynthesis.getVoices();window.speechSynthesis.onvoiceschanged=function(){window.speechSynthesis.getVoices();};}
function testVoix(){var st=document.getElementById('ttsStatus');if(!('speechSynthesis' in window)){st.textContent='Non supporte. Utilise Chrome.';st.style.color='#b91c1c';return;}window.speechSynthesis.cancel();var u=new SpeechSynthesisUtterance('Bonjour, la voix fonctionne.');u.lang='fr-FR';u.rate=0.9;u.volume=1;var fr=window.speechSynthesis.getVoices().find(function(v){return v.lang&&v.lang.startsWith('fr');});if(fr)u.voice=fr;u.onstart=function(){st.textContent='Voix active !';st.style.color='#166534';};u.onerror=function(e){st.textContent='Erreur: '+e.error;st.style.color='#b91c1c';};window.speechSynthesis.speak(u);}
function say(t){if(!('speechSynthesis' in window))return;window.speechSynthesis.cancel();var u=new SpeechSynthesisUtterance(t);u.lang='fr-FR';u.rate=0.88;u.volume=parseFloat(document.getElementById('volSlider').value);var fr=window.speechSynthesis.getVoices().find(function(v){return v.lang&&v.lang.startsWith('fr');});if(fr)u.voice=fr;window.speechSynthesis.speak(u);}
function openPlayer(k){cur=S[k];playing=false;elapsed=0;stopAll();if('speechSynthesis' in window)window.speechSynthesis.cancel();var old=document.getElementById('playerBanner').querySelector('.bicon');if(old)old.remove();var sp=document.createElement('span');sp.className='bicon';sp.style.fontSize='4rem';sp.textContent=cur.icon;document.getElementById('playerBanner').insertBefore(sp,document.getElementById('playerBanner').firstChild);document.getElementById('playerBanner').style.background=cur.bg;document.getElementById('playerTag').textContent=cur.tag;document.getElementById('playerTitle').textContent=cur.title;document.getElementById('playerDesc').textContent=cur.desc;document.getElementById('timeCur').textContent='0:00';document.getElementById('timeTot').textContent=fmt(cur.dur);document.getElementById('progressFill').style.width='0%';document.getElementById('playBtn').innerHTML='<i class="fas fa-play"></i>';document.getElementById('breathGuide').style.display=cur.breath?'block':'none';document.getElementById('breathLbl').textContent=BP[0];document.getElementById('phraseBox').textContent='Appuie sur Play...';document.getElementById('ttsWarn').style.display=('speechSynthesis' in window)?'none':'block';document.getElementById('playerOverlay').classList.add('active');}
function closePlayer(){stopAll();if('speechSynthesis' in window)window.speechSynthesis.cancel();playing=false;elapsed=0;document.getElementById('playerOverlay').classList.remove('active');}
function togglePlay(){if(playing){playing=false;stopAll();if('speechSynthesis' in window)window.speechSynthesis.cancel();document.getElementById('playBtn').innerHTML='<i class="fas fa-play"></i>';}else{playing=true;document.getElementById('playBtn').innerHTML='<i class="fas fa-pause"></i>';scheduleLines();timerId=setInterval(tick,1000);if(cur.breath)runBreath();keepId=setInterval(function(){if(window.speechSynthesis&&window.speechSynthesis.paused)window.speechSynthesis.resume();},8000);}}
function scheduleLines(){var now=elapsed;cur.lines.forEach(function(l){if(l[0]<now)return;var t=setTimeout(function(){if(!playing)return;document.getElementById('phraseBox').textContent=l[1];say(l[1]);},(l[0]-now)*1000);lineIds.push(t);});}
function tick(){if(!playing)return;elapsed++;if(elapsed>=cur.dur){elapsed=cur.dur;stopAll();playing=false;document.getElementById('playBtn').innerHTML='<i class="fas fa-redo"></i>';document.getElementById('phraseBox').textContent='Seance terminee. Bravo !';}document.getElementById('progressFill').style.width=(elapsed/cur.dur*100)+'%';document.getElementById('timeCur').textContent=fmt(elapsed);}
function stopAll(){clearInterval(timerId);clearInterval(keepId);clearTimeout(breathId);lineIds.forEach(clearTimeout);lineIds=[];}
function seekTo(e){if(!cur)return;var r=document.getElementById('progressTrack').getBoundingClientRect();var p=Math.max(0,Math.min(1,(e.clientX-r.left)/r.width));elapsed=Math.round(p*cur.dur);document.getElementById('progressFill').style.width=(p*100)+'%';document.getElementById('timeCur').textContent=fmt(elapsed);}
function skip(s){if(!cur)return;elapsed=Math.max(0,Math.min(cur.dur,elapsed+s));document.getElementById('progressFill').style.width=(elapsed/cur.dur*100)+'%';document.getElementById('timeCur').textContent=fmt(elapsed);}
function fmt(s){return Math.floor(s/60)+':'+String(s%60).padStart(2,'0');}
function runBreath(){var p=0;function next(){if(!playing)return;document.getElementById('breathLbl').textContent=BP[p];breathId=setTimeout(function(){p=(p+1)%3;next();},BD[p]);}next();}
document.getElementById('playerOverlay').addEventListener('click',function(e){if(e.target===this)closePlayer();});
</script>
{% endblock %}
