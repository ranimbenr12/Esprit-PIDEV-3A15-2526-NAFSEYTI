{% extends 'base.html.twig' %}
{% block title %}Mes Réductions — Nafseyti{% endblock %}
{% block body %}
<style>
:root{--gd:#2D5016;--gm:#4A7C2F;--gs:#7BA05B;--gl:#A8C68F;--gp:#D4E6C3;--bl:#EDE3D0;--bc:#F7F2E8;--bw:#FDFAF5;--td:#1A2E0A;}
.hero{background:var(--bc);padding:60px;position:relative;overflow:hidden;border-bottom:1px solid var(--bl);}
.hero::before{content:'';position:absolute;top:-80px;right:-80px;width:400px;height:400px;border-radius:50% 40% 60% 30% / 40% 60% 30% 50%;background:rgba(196,168,130,.18);filter:blur(60px);}
.hero h1{font-family:'Playfair Display',serif;font-size:2.2rem;color:var(--td);font-weight:400;position:relative;}
.hero h1 em{font-style:italic;color:#A8895A;}
.points-badge{display:inline-flex;align-items:center;gap:10px;background:white;border:1px solid var(--bl);border-radius:100px;padding:10px 24px;margin-top:16px;box-shadow:0 3px 12px rgba(168,137,90,.12);}
.points-badge .pts{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--td);font-weight:600;}
.points-badge .lbl{font-size:.78rem;color:#7A6248;letter-spacing:1px;text-transform:uppercase;}
.page{background:var(--bw);min-height:60vh;padding:50px 60px;}
.section-title{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--td);font-weight:400;margin-bottom:24px;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;margin-bottom:50px;}
.card{background:white;border:1.5px solid var(--bl);border-radius:20px;overflow:hidden;transition:all .3s;position:relative;}
.card:hover{border-color:var(--gs);box-shadow:0 12px 40px rgba(74,124,47,.15);transform:translateY(-3px);}
.card.obtained{border-color:#d4edda;}
.card.locked{opacity:.75;}
.card.expired{opacity:.6;filter:grayscale(.4);}
.card-img{width:100%;height:140px;object-fit:cover;background:var(--bc);display:flex;align-items:center;justify-content:center;font-size:3rem;}
.card-img img{width:100%;height:140px;object-fit:cover;}
.card-body{padding:20px;}
.card-brand{font-family:'Playfair Display',serif;font-size:1.1rem;color:var(--td);font-weight:600;margin-bottom:6px;}
.card-desc{font-size:.83rem;color:#6B7D5A;line-height:1.6;margin-bottom:14px;}
.card-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;}
.badge-pct{background:var(--gp);color:var(--gd);font-size:.75rem;font-weight:700;padding:5px 14px;border-radius:100px;}
.badge-pts{display:flex;align-items:center;gap:5px;font-size:.75rem;color:#6B7D5A;}
.badge-pts i{color:#f59e0b;}
.badge-exp{font-size:.7rem;color:#aaa;}
.btn-obtenir{width:100%;background:var(--gm);color:white;border:none;padding:11px;border-radius:100px;font-size:.78rem;letter-spacing:1px;text-transform:uppercase;font-weight:600;cursor:pointer;transition:background .2s;}
.btn-obtenir:hover{background:var(--gd);}
.btn-obtenir:disabled{background:#ccc;cursor:not-allowed;}
.code-box{background:var(--gp);border:1.5px dashed var(--gs);border-radius:14px;padding:10px 14px;text-align:center;}
.code-box .code{font-family:monospace;font-size:1.1rem;font-weight:700;color:var(--gd);letter-spacing:2px;}
.code-box .lbl{font-size:.68rem;color:var(--gs);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;}
.empty{text-align:center;padding:60px;color:#6B7D5A;}
.empty i{font-size:3rem;color:var(--gp);display:block;margin-bottom:16px;}
.toast{position:fixed;bottom:28px;right:28px;background:var(--gd);color:#F7F2E8;padding:13px 22px;border-radius:100px;font-size:.85rem;z-index:99999;display:none;}
</style>

<section class="hero">
    <h1>Mes <em>Réductions</em></h1>
    <p style="font-family:'Cormorant Garamond',serif;font-size:1rem;color:rgba(237,227,208,.75);margin-top:8px;">
        Échangez vos points contre des réductions exclusives.
    </p>
    <div class="points-badge">
        <i class="fas fa-star" style="color:#fbbf24;font-size:1.2rem;"></i>
        <span class="pts">{{ totalPoints }}</span>
        <span class="lbl">point(s) disponibles</span>
    </div>
</section>

<section class="page">

    {% if reductions|length == 0 %}
    <div class="empty">
        <i class="fas fa-tag"></i>
        <p>Aucune réduction disponible pour le moment.</p>
    </div>
    {% else %}

    <!-- Réductions disponibles -->
    <div class="section-title">
        <i class="fas fa-tag" style="color:var(--gs);margin-right:8px;"></i>
        Réductions disponibles
    </div>
    <div class="grid">
    {% for r in reductions %}
        {% set obtained = dejaObtenues[r.id_reduction] is defined %}
        {% set expired = r.date_expiration < "now"|date("Y-m-d") %}
        {% set canObtain = totalPoints >= r.points_requis and not obtained and not expired %}
        <div class="card {{ obtained ? 'obtained' : (expired ? 'expired' : (not canObtain ? 'locked' : '')) }}">
            <div class="card-img">
                {% if r.image_url %}
                    <img src="{{ r.image_url }}" alt="{{ r.nom_marque }}">
                {% else %}
                    🏷️
                {% endif %}
            </div>
            {% if expired %}
            <div style="position:absolute;top:10px;right:10px;background:#dc3545;color:white;font-size:.65rem;font-weight:700;padding:4px 10px;border-radius:100px;letter-spacing:1px;text-transform:uppercase;">Expiré</div>
            {% endif %}
            <div class="card-body">
                <div class="card-brand">{{ r.nom_marque }}</div>
                <div class="card-desc">{{ r.description }}</div>
                <div class="card-meta">
                    <span class="badge-pct">-{{ r.pourcentage_reduction }}%</span>
                    <span class="badge-pts">
                        <i class="fas fa-star"></i>
                        {{ r.points_requis }} pts requis
                    </span>
                    <span class="badge-exp">Expire le {{ r.date_expiration|date('d/m/Y') }}</span>
                </div>

                {% if obtained %}
                    <div class="code-box">
                        <div class="lbl">Votre code promo</div>
                        <div class="code">{{ dejaObtenues[r.id_reduction] }}</div>
                    </div>
                {% elseif expired %}
                    <button class="btn-obtenir" disabled style="background:#dc3545;">
                        <i class="fas fa-times-circle"></i> Réduction expirée
                    </button>
                {% elseif canObtain %}
                    <button class="btn-obtenir" onclick="obtenir({{ r.id_reduction }}, this)">
                        <i class="fas fa-unlock"></i> Obtenir ce code
                    </button>
                {% else %}
                    <button class="btn-obtenir" disabled>
                        <i class="fas fa-lock"></i>
                        Il vous manque {{ r.points_requis - totalPoints }} pts
                    </button>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</section>

<div class="toast" id="toast"></div>

<script>
function obtenir(id, btn) {
    confirmAction('Utiliser vos points pour obtenir ce code promo ?', { type: 'warning', confirmText: 'Obtenir' }).then(function(ok) {
        if (!ok) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> En cours...';
        fetch('/client/reductions/' + id + '/obtenir', { method: 'POST' })
            .then(function(r){ return r.json(); })
            .then(function(data) {
                if (data.success) {
                    showToast('Code obtenu : ' + data.code);
                    setTimeout(function(){ location.reload(); }, 1500);
                } else {
                    showToast(data.error, true);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-unlock"></i> Obtenir ce code';
                }
            });
    });
}

function showToast(msg, isErr) {
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.style.background = isErr ? '#dc3545' : 'var(--gd)';
    t.style.display = 'block';
    setTimeout(function(){ t.style.display = 'none'; }, 3000);
}
</script>
<!-- Modal confirmation global -->
<div id="globalConfirmOverlay" style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.45);backdrop-filter:blur(3px);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:12px;padding:32px 28px;max-width:380px;width:90%;text-align:center;animation:confirmPop .2s ease;">
        <div id="gcIcon" style="font-size:2.2rem;margin-bottom:12px;">⚠️</div>
        <p id="gcMessage" style="font-size:1rem;color:#1A2E0A;margin-bottom:24px;line-height:1.5;"></p>
        <div style="display:flex;gap:12px;justify-content:center;">
            <button id="gcCancel" style="flex:1;padding:10px;border:1px solid #d1d5db;background:#f9fafb;border-radius:8px;font-size:.9rem;cursor:pointer;">Annuler</button>
            <button id="gcConfirm" style="flex:1;padding:10px;border:none;border-radius:8px;font-size:.9rem;cursor:pointer;color:#fff;font-weight:600;">Confirmer</button>
        </div>
    </div>
</div>
<style>
@keyframes confirmPop {
    from{transform:scale(.85);opacity:0;}
    to{transform:scale(1);opacity:1;}
}
</style>
<script>
(function() {
    var overlay = document.getElementById('globalConfirmOverlay');
    var msgEl   = document.getElementById('gcMessage');
    var iconEl  = document.getElementById('gcIcon');
    var btnOk   = document.getElementById('gcConfirm');
    var btnNo   = document.getElementById('gcCancel');
    var _resolve;
    var themes = {
        danger:  { bg: '#dc2626', icon: '🗑️' },
        warning: { bg: '#d97706', icon: '⚠️' },
        success: { bg: '#16a34a', icon: '✅' },
        info:    { bg: '#2563eb', icon: 'ℹ️' },
    };
    window.confirmAction = function(message, options) {
        options = options || {};
        var type = themes[options.type] || themes.warning;
        msgEl.textContent      = message;
        iconEl.textContent     = type.icon;
        btnOk.textContent      = options.confirmText || 'Confirmer';
        btnNo.textContent      = options.cancelText  || 'Annuler';
        btnOk.style.background = type.bg;
        overlay.style.display  = 'flex';
        return new Promise(function(resolve) { _resolve = resolve; });
    };
    function close(result) {
        overlay.style.display = 'none';
        if (_resolve) { _resolve(result); _resolve = null; }
    }
    btnOk.addEventListener('click', function() { close(true); });
    btnNo.addEventListener('click', function() { close(false); });
    overlay.addEventListener('click', function(e) { if (e.target === overlay) close(false); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') close(false); });
})();
</script>
{% endblock %}
