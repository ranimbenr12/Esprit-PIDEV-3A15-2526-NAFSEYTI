{% extends 'base.html.twig' %}
{% block title %}Mes Suivis — Nafseyti{% endblock %}
{% block body %}
<style>
:root {
    --b-white:  #FDFAF5;
    --b-cream:  #F7F2E8;
    --b-light:  #EDE3D0;
    --b-mid:    #D9C4A0;
    --b-dark:   #C4A882;
    --b-deep:   #A8895A;
    --g-mid:    #4A7C2F;
    --g-sage:   #7BA05B;
    --g-pale:   #D4E6C3;
    --txt:      #2C1F0E;
    --txt-soft: #7A6248;
    --shadow:   rgba(168,137,90,.14);
    --r:        22px;
}

/* ── HERO ── */
.sh-hero {
    background: var(--b-cream);
    padding: 72px 64px 56px;
    position: relative; overflow: hidden;
    border-bottom: 1px solid var(--b-light);
}
.sh-blob {
    position: absolute; border-radius: 50% 40% 60% 30% / 40% 60% 30% 50%;
    filter: blur(70px); pointer-events: none;
}
.sh-blob.a { width:500px;height:500px;background:rgba(196,168,130,.2);top:-160px;right:-100px; }
.sh-blob.b { width:300px;height:300px;background:rgba(217,196,160,.15);bottom:-80px;left:60px; }

.sh-hero-inner { position:relative;z-index:1;max-width:960px; }
.sh-tag {
    display:inline-flex;align-items:center;gap:8px;
    background:white;border:1px solid var(--b-mid);border-radius:100px;
    padding:6px 18px;font-size:.65rem;letter-spacing:2.5px;text-transform:uppercase;
    color:var(--b-deep);margin-bottom:22px;box-shadow:0 2px 10px var(--shadow);
}
.sh-tag::before { content:'';width:7px;height:7px;background:var(--b-dark);border-radius:50%; }
.sh-hero h1 {
    font-family:'Playfair Display',serif;
    font-size:clamp(2rem,5vw,3.2rem);color:var(--txt);font-weight:400;line-height:1.15;margin-bottom:12px;
}
.sh-hero h1 em { font-style:italic;color:var(--b-deep); }
.sh-hero-sub {
    font-family:'Cormorant Garamond',serif;
    font-size:1.15rem;color:var(--txt-soft);line-height:1.7;margin-bottom:32px;
}

/* Badges hero */
.sh-badges { display:flex;gap:14px;flex-wrap:wrap;align-items:center; }
.sh-badge {
    display:inline-flex;align-items:center;gap:10px;
    background:white;border:1px solid var(--b-light);border-radius:var(--r);
    padding:12px 22px;box-shadow:0 3px 12px var(--shadow);
    text-decoration:none;transition:all .25s;color:var(--txt);
}
.sh-badge:hover { border-color:var(--b-dark);transform:translateY(-2px);box-shadow:0 8px 24px var(--shadow); }
.sh-badge-icon {
    width:38px;height:38px;background:var(--b-cream);border:1px solid var(--b-light);
    border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1rem;
}
.sh-badge-label { font-size:.62rem;text-transform:uppercase;letter-spacing:2px;color:var(--txt-soft); }
.sh-badge-val { font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--txt);font-weight:600;line-height:1; }
.sh-badge-link { font-size:.72rem;font-weight:600;color:var(--g-mid);letter-spacing:1px;text-transform:uppercase; }

/* ── PAGE ── */
.sh-page { background:var(--b-white);min-height:60vh;padding:56px 64px; }

/* Titre section */
.sh-section-head { margin-bottom:28px; }
.sh-eyebrow {
    font-size:.65rem;text-transform:uppercase;letter-spacing:3px;
    color:var(--b-deep);margin-bottom:6px;display:flex;align-items:center;gap:10px;
}
.sh-eyebrow::before { content:'';width:24px;height:1px;background:var(--b-mid); }
.sh-section-head h2 {
    font-family:'Playfair Display',serif;font-size:1.9rem;
    color:var(--txt);font-weight:400;
}

/* ── TOOLBAR ── */
.sh-toolbar { display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:28px; }
.sh-search {
    display:flex;align-items:center;gap:0;
    background:white;border:1.5px solid var(--b-light);border-radius:100px;
    overflow:hidden;flex:1;min-width:220px;max-width:420px;
    box-shadow:0 2px 10px var(--shadow);transition:border-color .2s;
}
.sh-search:focus-within { border-color:var(--g-sage); }
.sh-search i { padding:0 16px;color:var(--b-deep);font-size:.9rem; }
.sh-search input {
    border:none;outline:none;padding:12px 16px 12px 0;
    font-size:.88rem;color:var(--txt);background:transparent;width:100%;
    font-family:'DM Sans',sans-serif;
}
.sh-search input::placeholder { color:var(--b-dark); }

.sh-filters { display:flex;gap:8px;flex-wrap:wrap; }
.sh-fbtn {
    padding:10px 20px;border-radius:100px;border:1.5px solid var(--b-light);
    background:white;font-size:.75rem;font-weight:600;color:var(--txt-soft);
    cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:7px;
    font-family:'DM Sans',sans-serif;
}
.sh-fbtn:hover { border-color:var(--b-dark);color:var(--txt); }
.sh-fbtn.active { background:var(--g-mid);color:white;border-color:var(--g-mid); }
.sh-fbtn.active-alert { background:#D97706;color:white;border-color:#D97706; }
.sh-fbtn.active-ok { background:var(--g-mid);color:white;border-color:var(--g-mid); }

/* ── GRILLE CARTES ── */
.sh-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px; }

.sh-card {
    background:white;border:1px solid var(--b-light);border-radius:var(--r);
    padding:28px;transition:all .3s cubic-bezier(.34,1.56,.64,1);
    position:relative;overflow:hidden;
    box-shadow:0 2px 10px rgba(168,137,90,.06);
}
.sh-card::after {
    content:'';position:absolute;inset:0;border-radius:var(--r);
    background:linear-gradient(135deg,rgba(196,168,130,.07),transparent);
    opacity:0;transition:opacity .3s;
    pointer-events: none;
}
.sh-card:hover { transform:translateY(-5px) scale(1.01);border-color:var(--g-sage);box-shadow:0 16px 48px rgba(74,124,47,.15); }
.sh-card:hover::after { opacity:1; }
.sh-card.has-alert { border-color:#FDE68A;background:#FFFBF0; }
.sh-card.has-alert:hover { border-color:#F59E0B; }

.sh-card-top { display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px; }
.sh-type-badge {
    background:var(--b-cream);border:1px solid var(--b-light);
    border-radius:100px;padding:4px 14px;
    font-size:.62rem;letter-spacing:2px;text-transform:uppercase;color:var(--b-deep);font-weight:600;
}
.sh-type-badge.alert-type { background:#FEF3C7;border-color:#FDE68A;color:#92400E; }
.sh-card-num {
    width:36px;height:36px;background:var(--b-cream);border:1px solid var(--b-light);
    border-radius:12px;display:flex;align-items:center;justify-content:center;
    font-family:'Playfair Display',serif;font-size:1rem;color:var(--b-deep);font-weight:600;
}

.sh-alert-pill {
    display:inline-flex;align-items:center;gap:6px;
    background:#FEF3C7;color:#92400E;border:1px solid #FDE68A;
    border-radius:100px;padding:5px 12px;font-size:.7rem;font-weight:600;margin-bottom:12px;
}
.sh-alert-pill i { color:#F59E0B; }

.sh-card h3 {
    font-family:'Playfair Display',serif;font-size:1.15rem;
    color:var(--txt);margin-bottom:8px;font-weight:600;
}
.sh-card p { font-size:.84rem;color:var(--txt-soft);line-height:1.65;margin-bottom:20px; }

.sh-btn {
    display:inline-flex;align-items:center;gap:8px;
    background:var(--g-mid);color:white;border:none;
    padding:11px 22px;border-radius:100px;
    font-size:.73rem;letter-spacing:1.5px;text-transform:uppercase;
    font-weight:600;text-decoration:none;cursor:pointer;
    transition:all .2s;box-shadow:0 4px 14px rgba(74,124,47,.25);
    position: relative; z-index: 2;
}
.sh-btn:hover { background:var(--g-deep,#2D5016);color:white;transform:translateY(-1px);box-shadow:0 8px 20px rgba(45,80,22,.2); }
.sh-btn.urgent { background:#D97706;box-shadow:0 4px 14px rgba(217,119,6,.3); }
.sh-btn.urgent:hover { background:#B45309; }

/* ── EMPTY ── */
.sh-empty { text-align:center;padding:80px 40px; }
.sh-empty-icon {
    width:80px;height:80px;background:var(--b-cream);border:1px solid var(--b-light);
    border-radius:24px;display:flex;align-items:center;justify-content:center;
    font-size:2rem;margin:0 auto 20px;
}
.sh-empty h3 { font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--txt);margin-bottom:8px; }
.sh-empty p { font-size:.9rem;color:var(--txt-soft); }

/* ── CHATBOT ── */
.chat-btn{position:fixed;bottom:30px;right:30px;width:56px;height:56px;border-radius:50%;background:var(--g-mid);border:none;cursor:pointer;box-shadow:0 6px 20px rgba(74,124,47,.3);display:flex;align-items:center;justify-content:center;z-index:9990;transition:all .2s;}
.chat-btn:hover{transform:scale(1.08);background:#2D5016;}
.chat-btn i{color:white;font-size:1.3rem;}
.chat-notif{position:absolute;top:-4px;right:-4px;width:16px;height:16px;background:#ef4444;border-radius:50%;border:2px solid white;display:none;}
.chat-window{position:fixed;bottom:100px;right:30px;width:360px;height:500px;background:var(--b-white);border-radius:24px;box-shadow:0 20px 60px rgba(44,31,14,.18);z-index:9991;display:none;flex-direction:column;overflow:hidden;border:1px solid var(--b-light);}
.chat-window.open{display:flex;}
.chat-head{background:var(--b-cream);border-bottom:1px solid var(--b-light);padding:16px 20px;display:flex;align-items:center;gap:12px;}
.chat-head-avatar{width:38px;height:38px;border-radius:12px;background:var(--b-light);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.chat-head-avatar i{color:var(--b-deep);font-size:1rem;}
.chat-head-info .name{font-family:'Playfair Display',serif;font-size:.95rem;color:var(--txt);font-weight:600;}
.chat-head-info .status{font-size:.68rem;color:var(--txt-soft);display:flex;align-items:center;gap:5px;}
.chat-head-info .dot{width:7px;height:7px;background:#4ade80;border-radius:50%;display:inline-block;}
.chat-close{margin-left:auto;background:var(--b-light);border:none;color:var(--txt-soft);width:30px;height:30px;border-radius:50%;cursor:pointer;font-size:.85rem;display:flex;align-items:center;justify-content:center;transition:background .2s;}
.chat-close:hover{background:var(--b-mid);}
.chat-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:var(--b-white);}
.chat-messages::-webkit-scrollbar{width:3px;}
.chat-messages::-webkit-scrollbar-thumb{background:var(--b-light);border-radius:3px;}
.msg{max-width:80%;padding:10px 14px;border-radius:16px;font-size:.85rem;line-height:1.5;animation:msgIn .2s ease;}
@keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.msg.user{background:var(--b-deep);color:white;align-self:flex-end;border-bottom-right-radius:4px;}
.msg.bot{background:white;color:var(--txt);align-self:flex-start;border:1px solid var(--b-light);border-bottom-left-radius:4px;}
.msg.typing{background:white;border:1px solid var(--b-light);align-self:flex-start;padding:12px 16px;}
.typing-dots{display:flex;gap:4px;}
.typing-dots span{width:7px;height:7px;background:var(--b-dark);border-radius:50%;animation:bounce .8s infinite;}
.typing-dots span:nth-child(2){animation-delay:.15s;}
.typing-dots span:nth-child(3){animation-delay:.3s;}
@keyframes bounce{0%,80%,100%{transform:translateY(0)}40%{transform:translateY(-6px)}}
.msg-time{font-size:.62rem;opacity:.6;margin-top:4px;text-align:right;}
.chat-input-area{padding:12px 16px;border-top:1px solid var(--b-light);display:flex;gap:8px;background:white;}
.chat-input{flex:1;border:1.5px solid var(--b-light);border-radius:12px;padding:9px 14px;font-size:.85rem;outline:none;font-family:'DM Sans',sans-serif;resize:none;max-height:80px;transition:border-color .2s;}
.chat-input:focus{border-color:var(--b-dark);}
.chat-send{background:var(--b-deep);color:white;border:none;width:38px;height:38px;border-radius:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .2s;}
.chat-send:hover{background:var(--txt);}
.chat-send:disabled{background:var(--b-mid);cursor:not-allowed;}
</style>

<!-- ── HERO ── -->
<section class="sh-hero">
    <div class="sh-blob a"></div>
    <div class="sh-blob b"></div>
    <div class="sh-hero-inner">
        <div class="sh-tag">Espace Personnel</div>
        <h1>Mes <em>Suivis</em></h1>
        <p class="sh-hero-sub">Consultez vos suivis et partagez vos progrès avec votre psychologue.</p>

        <div class="sh-badges">
            <div class="sh-badge" style="cursor:default;">
                <div class="sh-badge-icon">⭐</div>
                <div>
                    <div class="sh-badge-label">Points</div>
                    <div class="sh-badge-val">{{ totalPoints }}</div>
                </div>
            </div>
            <a href="{{ path('client_reductions') }}" class="sh-badge">
                <div class="sh-badge-icon">🏷️</div>
                <div>
                    <div class="sh-badge-label">Mes réductions</div>
                    <div class="sh-badge-link">Voir →</div>
                </div>
            </a>
            <a href="{{ path('client_jeu_index') }}" class="sh-badge">
                <div class="sh-badge-icon">🌿</div>
                <div>
                    <div class="sh-badge-label">Défis Émotionnels</div>
                    <div class="sh-badge-link">Jouer →</div>
                </div>
            </a>
            <a href="{{ path('client_meditation_index') }}" class="sh-badge">
                <div class="sh-badge-icon">🧘</div>
                <div>
                    <div class="sh-badge-label">Méditation Guidée</div>
                    <div class="sh-badge-link">Écouter →</div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ── CONTENU ── -->
<section class="sh-page">
    <div class="sh-section-head">
        <div class="sh-eyebrow">Mes suivis</div>
        <h2>{{ suivis|length }} suivi(s) en cours</h2>
    </div>

    {% if suivis|length == 0 %}
    <div class="sh-empty">
        <div class="sh-empty-icon">🌱</div>
        <h3>Aucun suivi pour le moment</h3>
        <p>Votre psychologue n'a pas encore créé de suivi pour vous.</p>
    </div>
    {% else %}

    <div class="sh-toolbar">
        <div class="sh-search">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Rechercher un suivi…" oninput="applyFilters()">
        </div>
        <div class="sh-filters">
            <button class="sh-fbtn active" id="btn-all" onclick="setFilter('all')">
                <i class="fas fa-list"></i> Tous
            </button>
            <button class="sh-fbtn" id="btn-alert" onclick="setFilter('alert')">
                <i class="fas fa-upload"></i> À uploader
            </button>
            <button class="sh-fbtn" id="btn-ok" onclick="setFilter('ok')">
                <i class="fas fa-check-circle"></i> Complets
            </button>
        </div>
    </div>

    <div class="sh-grid" id="suivisGrid">
        {% for suivi in suivis %}
        {% set nb_alertes = alertes[suivi.idsuivi] ?? 0 %}
        <div class="sh-card {{ nb_alertes > 0 ? 'has-alert' : '' }}"
             data-titre="{{ suivi.titre|lower }}"
             data-type="{{ suivi.typeSuivi|lower }}"
             data-alerte="{{ nb_alertes > 0 ? '1' : '0' }}">

            <div class="sh-card-top">
                <span class="sh-type-badge {{ nb_alertes > 0 ? 'alert-type' : '' }}">{{ suivi.typeSuivi }}</span>
                <div class="sh-card-num">{{ loop.index }}</div>
            </div>

            {% if nb_alertes > 0 %}
            <div class="sh-alert-pill">
                <i class="fas fa-exclamation-circle"></i>
                {{ nb_alertes }} objectif(s) en attente
            </div>
            {% endif %}

            <h3>{{ suivi.titre }}</h3>
            <p>{{ suivi.description|default('Aucune description.')|slice(0,120) }}{% if suivi.description|length > 120 %}…{% endif %}</p>

            <a href="{{ path('client_objectif_index', {idSuivi: suivi.idsuivi}) }}"
               class="sh-btn {{ nb_alertes > 0 ? 'urgent' : '' }}">
                {% if nb_alertes > 0 %}
                    <i class="fas fa-upload"></i> Uploader mes documents
                {% else %}
                    <i class="fas fa-tasks"></i> Voir mes objectifs
                {% endif %}
            </a>
            {# Debug: afficher l'URL générée #}
            {# <small style="display:block;margin-top:4px;color:#999;font-size:.65rem;">{{ path('client_objectif_index', {idSuivi: suivi.idsuivi}) }}</small> #}
        </div>
        {% endfor %}
    </div>
    {% endif %}
</section>

<script>
var currentFilter = 'all';
function setFilter(f) {
    currentFilter = f;
    document.querySelectorAll('.sh-fbtn').forEach(function(b){ b.className = 'sh-fbtn'; });
    var btn = document.getElementById('btn-' + f);
    if (btn) {
        btn.classList.add(f === 'alert' ? 'active-alert' : f === 'ok' ? 'active-ok' : 'active');
    }
    applyFilters();
}
function applyFilters() {
    var q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
    document.querySelectorAll('#suivisGrid .sh-card').forEach(function(c) {
        var matchSearch = !q || (c.dataset.titre||'').includes(q) || (c.dataset.type||'').includes(q);
        var matchFilter = currentFilter === 'all'
            || (currentFilter === 'alert' && c.dataset.alerte === '1')
            || (currentFilter === 'ok'    && c.dataset.alerte === '0');
        c.style.display = (matchSearch && matchFilter) ? '' : 'none';
    });
}
</script>

<!-- ── CHATBOT ── -->
<button class="chat-btn" onclick="toggleChat()" title="Assistant Nafseyti">
    <i class="fas fa-comment-dots"></i>
    <div class="chat-notif" id="chatNotif"></div>
</button>

<div class="chat-window" id="chatWindow">
    <div class="chat-head">
        <div class="chat-head-avatar"><i class="fas fa-robot"></i></div>
        <div class="chat-head-info">
            <div class="name">Assistant Nafseyti</div>
            <div class="status"><span class="dot"></span> En ligne</div>
        </div>
        <button class="chat-close" onclick="toggleChat()"><i class="fas fa-times"></i></button>
    </div>
    <div class="chat-messages" id="chatMessages">
        <div class="msg bot">
            Bonjour ! Je suis ton assistant Nafseyti 🌿<br>
            Comment puis-je t'aider aujourd'hui ?
            <div class="msg-time">maintenant</div>
        </div>
    </div>
    <div class="chat-input-area">
        <textarea class="chat-input" id="chatInput" placeholder="Écris ton message…" rows="1"
            onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMessage();}"></textarea>
        <button class="chat-send" id="chatSend" onclick="sendMessage()">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
</div>

<script>
var chatOpen = false;
function toggleChat() {
    chatOpen = !chatOpen;
    document.getElementById('chatWindow').classList.toggle('open', chatOpen);
    document.getElementById('chatNotif').style.display = 'none';
    if (chatOpen) { loadHistory(); document.getElementById('chatInput').focus(); }
}
function loadHistory() {
    fetch('/client/chatbot/history').then(function(r){ return r.json(); }).then(function(msgs) {
        if (!msgs.length) return;
        var container = document.getElementById('chatMessages');
        while (container.children.length > 1) container.removeChild(container.lastChild);
        msgs.forEach(function(m) {
            var d = new Date(m.date_envoi);
            var time = d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
            appendMsg('user', m.message_utilisateur, time);
            appendMsg('bot', m.reponse_chatbot, time);
        });
        scrollBottom();
    });
}
function sendMessage() {
    var input = document.getElementById('chatInput');
    var msg = input.value.trim();
    if (!msg) return;
    input.value = ''; input.style.height = 'auto';
    appendMsg('user', msg, now()); showTyping();
    document.getElementById('chatSend').disabled = true;
    fetch('/client/chatbot/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({message:msg}) })
    .then(function(r){ return r.json(); })
    .then(function(data) {
        removeTyping(); document.getElementById('chatSend').disabled = false;
        if (data.success) {
            appendMsg('bot', data.reponse, data.date);
            if (data.niveau === 'critique') appendBandeau('Ton psychologue a été informé. Tu n\'es pas seul(e). 💚', '#2C1F0E');
            else if (data.niveau === 'urgent') appendBandeau('Ton psychologue a été notifié. 🌿', '#4A7C2F');
        } else { appendMsg('bot', 'Désolé, une erreur est survenue.', now()); }
        scrollBottom();
    }).catch(function(err) {
        removeTyping(); document.getElementById('chatSend').disabled = false;
        appendMsg('bot', 'Erreur : ' + err.message, now()); scrollBottom();
    });
}
function appendMsg(type, text, time) {
    var container = document.getElementById('chatMessages');
    var div = document.createElement('div');
    div.className = 'msg ' + type;
    div.innerHTML = text.replace(/\n/g,'<br>') + '<div class="msg-time">' + time + '</div>';
    container.appendChild(div); scrollBottom();
}
function appendBandeau(text, color) {
    var container = document.getElementById('chatMessages');
    var div = document.createElement('div');
    div.style.cssText = 'background:' + color + ';color:white;border-radius:12px;padding:10px 14px;font-size:.8rem;font-weight:600;line-height:1.5;text-align:center;';
    div.textContent = text; container.appendChild(div);
}
function showTyping() {
    var container = document.getElementById('chatMessages');
    var div = document.createElement('div');
    div.className = 'msg typing'; div.id = 'typingIndicator';
    div.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';
    container.appendChild(div); scrollBottom();
}
function removeTyping() { var el = document.getElementById('typingIndicator'); if (el) el.remove(); }
function scrollBottom() { var c = document.getElementById('chatMessages'); c.scrollTop = c.scrollHeight; }
function now() { var d = new Date(); return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0'); }
document.getElementById('chatInput').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 80) + 'px';
});
</script>
{% endblock %}
