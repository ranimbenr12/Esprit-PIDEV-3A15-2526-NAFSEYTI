{% extends 'base.html.twig' %}
{% block title %}Mes Suivis — Nafseyti{% endblock %}
{% block body %}
<style>
/* Cacher la navbar sur les pages client */
.navbar-wrap { display: none !important; }

:root{--green-deep:#2D5016;--green-mid:#4A7C2F;--green-sage:#7BA05B;--green-light:#A8C68F;--green-pale:#D4E6C3;--beige-light:#EDE3D0;--beige-cream:#F7F2E8;--beige-white:#FDFAF5;--text-dark:#1A2E0A;--text-mid:#3D5C28;}
.hero{background:linear-gradient(135deg,var(--green-deep),var(--green-mid));padding:70px 60px 50px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;top:-60px;right:-60px;width:300px;height:300px;border-radius:50%;background:rgba(168,198,143,.1);}
.hero h1{font-family:'Playfair Display',serif;font-size:2.4rem;color:var(--beige-cream);font-weight:400;position:relative;}
.hero h1 em{font-style:italic;color:var(--green-light);}
.hero p{font-family:'Cormorant Garamond',serif;font-size:1.1rem;color:rgba(237,227,208,.75);margin-top:10px;position:relative;}
.page{background:var(--beige-white);min-height:60vh;padding:60px;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:24px;margin-top:36px;}

.card{background:white;border:1px solid var(--beige-light);border-radius:8px;padding:28px;transition:all .3s;position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--green-sage);}
.card:hover{border-color:var(--green-sage);box-shadow:0 12px 40px rgba(45,80,22,.12);transform:translateY(-4px);}
.card.has-alert::before{background:#F59E0B;}
.card.has-alert{border-color:#FDE68A;}

.badge-type{display:inline-block;background:var(--green-pale);color:var(--green-deep);font-size:.65rem;letter-spacing:2px;text-transform:uppercase;padding:5px 14px;border-radius:100px;margin-bottom:14px;}
.card h3{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--text-dark);margin-bottom:8px;}
.card p{font-size:.87rem;color:#6B7D5A;line-height:1.7;margin-bottom:18px;}

/* Badge alerte */
.alert-badge{display:inline-flex;align-items:center;gap:6px;background:#FEF3C7;color:#92400E;font-size:.72rem;font-weight:600;padding:6px 12px;border-radius:6px;margin-bottom:14px;border:1px solid #FDE68A;}
.alert-badge i{color:#F59E0B;}

.btn-view{background:var(--green-mid);color:white;border:none;padding:10px 20px;font-size:.75rem;letter-spacing:1px;text-transform:uppercase;border-radius:4px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:background .2s;}
.btn-view:hover{background:var(--green-deep);color:white;}
.btn-view.urgent{background:#D97706;}
.btn-view.urgent:hover{background:#B45309;}

.empty{text-align:center;padding:80px 40px;color:#6B7D5A;}
.empty i{font-size:4rem;color:var(--green-pale);margin-bottom:20px;display:block;}
.empty h3{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--text-mid);}
</style>

<section class="hero">
    <h1>Mes <em>Suivis Personnels</em></h1>
    <p>Consultez vos suivis et partagez vos progrès avec votre psychologue.</p>
</section>

<section class="page">
    <div>
        <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:3px;color:var(--green-sage);margin-bottom:6px;">Mes suivis</div>
        <h2 style="font-family:'Playfair Display',serif;font-size:1.8rem;color:var(--text-dark);font-weight:400;">
            {{ suivis|length }} suivi(s) en cours
        </h2>
    </div>

    {% if suivis|length == 0 %}
    <div class="empty">
        <i class="fas fa-seedling"></i>
        <h3>Aucun suivi pour le moment</h3>
        <p>Votre psychologue n'a pas encore créé de suivi pour vous.</p>
    </div>
    {% else %}
    <div class="grid">
        {% for suivi in suivis %}
        {% set nb_alertes = alertes[suivi.idsuivi] ?? 0 %}
        <div class="card {{ nb_alertes > 0 ? 'has-alert' : '' }}">
            <span class="badge-type">{{ suivi.typeSuivi }}</span>

            {% if nb_alertes > 0 %}
            <div class="alert-badge">
                <i class="fas fa-exclamation-circle"></i>
                {{ nb_alertes }} objectif(s) en attente de document
            </div>
            {% endif %}

            <h3>{{ suivi.titre }}</h3>
            <p>{{ suivi.description|default('Aucune description.')|slice(0,120) }}{% if suivi.description|length > 120 %}…{% endif %}</p>

            <a href="{{ path('client_objectif_index', {idSuivi: suivi.idsuivi}) }}"
               class="btn-view {{ nb_alertes > 0 ? 'urgent' : '' }}">
                {% if nb_alertes > 0 %}
                    <i class="fas fa-upload"></i> Uploader mes documents
                {% else %}
                    <i class="fas fa-tasks"></i> Voir mes objectifs
                {% endif %}
            </a>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</section>
{% endblock %}
