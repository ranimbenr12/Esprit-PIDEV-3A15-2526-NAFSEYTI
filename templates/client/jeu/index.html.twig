{% extends 'base.html.twig' %}
{% block title %}Défis Émotionnels — Nafseyti{% endblock %}
{% block body %}
<style>
/* ── VARIABLES ── */
:root {
    --b-white:  #FDFAF5;
    --b-cream:  #F7F2E8;
    --b-light:  #EDE3D0;
    --b-mid:    #D9C4A0;
    --b-dark:   #C4A882;
    --b-deep:   #A8895A;
    --g-deep:   #2D5016;
    --g-mid:    #4A7C2F;
    --g-sage:   #7BA05B;
    --g-light:  #A8C68F;
    --g-pale:   #D4E6C3;
    --txt:      #2C1F0E;
    --txt-soft: #7A6248;
    --shadow:   rgba(168,137,90,.18);
    --radius:   20px;
}

/* ── HERO ── */
.jeu-hero {
    background: var(--b-cream);
    padding: 72px 64px 56px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--b-light);
}
.jeu-hero-blob {
    position: absolute;
    border-radius: 50% 40% 60% 30% / 40% 60% 30% 50%;
    filter: blur(60px);
    pointer-events: none;
}
.jeu-hero-blob.b1 {
    width: 420px; height: 420px;
    background: rgba(196,168,130,.2);
    top: -120px; right: -80px;
}
.jeu-hero-blob.b2 {
    width: 280px; height: 280px;
    background: rgba(217,196,160,.15);
    bottom: -80px; left: 40px;
}
.jeu-hero-inner { position: relative; z-index: 1; max-width: 900px; }
.jeu-tag {
    display: inline-flex; align-items: center; gap: 8px;
    background: white; border: 1px solid var(--b-mid);
    border-radius: 100px; padding: 6px 18px;
    font-size: .68rem; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--b-deep); margin-bottom: 24px;
    box-shadow: 0 2px 10px var(--shadow);
}
.jeu-tag::before { content: ''; width: 7px; height: 7px; background: var(--b-dark); border-radius: 50%; }
.jeu-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    color: var(--txt); font-weight: 400; line-height: 1.15; margin-bottom: 14px;
}
.jeu-hero h1 em { font-style: italic; color: var(--b-deep); }
.jeu-hero p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem; color: var(--txt-soft); line-height: 1.7; margin-bottom: 36px;
}
.jeu-stats { display: flex; gap: 16px; flex-wrap: wrap; }
.jeu-stat {
    background: white;
    border: 1px solid var(--b-light);
    border-radius: var(--radius);
    padding: 18px 26px;
    display: flex; align-items: center; gap: 14px;
    box-shadow: 0 3px 12px var(--shadow);
    min-width: 160px;
}
.jeu-stat-icon {
    width: 48px; height: 48px;
    background: var(--b-cream);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
    border: 1px solid var(--b-light);
}
.jeu-stat-label { font-size: .65rem; text-transform: uppercase; letter-spacing: 2px; color: var(--txt-soft); }
.jeu-stat-value { font-family: 'Playfair Display', serif; font-size: 1.9rem; color: var(--txt); font-weight: 600; line-height: 1; }

/* ── PAGE ── */
.jeu-page { background: var(--b-white); padding: 64px; min-height: 60vh; }
.jeu-eyebrow {
    text-align: center; font-size: .68rem; text-transform: uppercase;
    letter-spacing: 3px; color: var(--b-deep); margin-bottom: 10px;
    display: flex; align-items: center; justify-content: center; gap: 14px;
}
.jeu-eyebrow::before, .jeu-eyebrow::after {
    content: ''; flex: 1; max-width: 60px; height: 1px; background: var(--b-mid);
}
.jeu-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem; color: var(--txt); text-align: center;
    font-weight: 400; margin-bottom: 48px;
}
.jeu-title em { font-style: italic; color: var(--b-deep); }

/* ── GRILLE CARTES ── */
.jeu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 20px;
    margin-bottom: 64px;
}
.jeu-card {
    background: white;
    border: 1px solid var(--b-light);
    border-radius: var(--radius);
    padding: 32px 28px;
    cursor: pointer;
    transition: all .3s cubic-bezier(.34,1.56,.64,1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(168,137,90,.06);
}
.jeu-card::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(196,168,130,.08), transparent);
    opacity: 0; transition: opacity .3s;
}
.jeu-card:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: var(--g-sage);
    box-shadow: 0 16px 48px rgba(74,124,47,.15);
}
.jeu-card:hover::after { opacity: 1; }
.jeu-card-top {
    display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 18px;
}
.jeu-card-icon {
    width: 60px; height: 60px;
    background: var(--b-cream);
    border: 1px solid var(--b-light);
    border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
    transition: transform .3s;
}
.jeu-card:hover .jeu-card-icon { transform: rotate(-6deg) scale(1.1); }
.jeu-card-pts {
    background: var(--g-pale);
    border: 1px solid var(--g-sage);
    border-radius: 100px;
    padding: 4px 12px;
    font-size: .7rem; font-weight: 600;
    color: var(--g-deep); letter-spacing: 1px;
}
.jeu-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem; color: var(--txt); margin-bottom: 8px; font-weight: 600;
}
.jeu-card p {
    font-size: .84rem; color: var(--txt-soft); line-height: 1.65; margin-bottom: 20px;
}
.jeu-bar-wrap { background: var(--b-light); height: 5px; border-radius: 100px; overflow: hidden; margin-bottom: 10px; }
.jeu-bar { height: 100%; background: linear-gradient(90deg, #4A7C2F, #7BA05B); border-radius: 100px; transition: width 1.2s ease; }
.jeu-card-foot {
    display: flex; justify-content: space-between;
    font-size: .72rem; color: var(--txt-soft);
}
.jeu-card-arrow {
    position: absolute; bottom: 20px; right: 20px;
    width: 32px; height: 32px;
    background: var(--b-cream); border: 1px solid var(--b-light);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: .8rem; color: var(--b-deep);
    transition: all .3s;
}
.jeu-card:hover .jeu-card-arrow {
    background: var(--g-mid); color: white; border-color: var(--g-mid);
    transform: translateX(3px);
}

/* ── OVERLAY QUIZ ── */
.quiz-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(44,31,14,.5);
    backdrop-filter: blur(6px);
    z-index: 9999;
    align-items: center; justify-content: center; padding: 20px;
}
.quiz-overlay.active { display: flex; }
.quiz-modal {
    background: var(--b-white);
    border-radius: 28px;
    max-width: 660px; width: 100%;
    max-height: 92vh; overflow-y: auto;
    box-shadow: 0 32px 100px rgba(44,31,14,.25);
    animation: qPop .28s cubic-bezier(.34,1.56,.64,1);
}
@keyframes qPop { from { transform: scale(.88) translateY(20px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }

/* Header modal */
.quiz-head {
    background: var(--b-cream);
    border-bottom: 1px solid var(--b-light);
    padding: 28px 32px 24px;
    border-radius: 28px 28px 0 0;
    position: relative;
    text-align: center;
}
.quiz-head-deco {
    position: absolute; top: -30px; right: -30px;
    width: 120px; height: 120px;
    background: rgba(196,168,130,.2);
    border-radius: 50%;
    opacity: .5;
}
.quiz-close-btn {
    position: absolute; top: 16px; right: 16px;
    width: 36px; height: 36px;
    background: white; border: 1px solid var(--b-light);
    border-radius: 50%; cursor: pointer;
    font-size: 1rem; color: var(--txt-soft);
    display: flex; align-items: center; justify-content: center;
    transition: all .2s; z-index: 1;
}
.quiz-close-btn:hover { background: var(--b-light); color: var(--txt); }
.quiz-head h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem; color: var(--txt); margin-bottom: 4px; position: relative;
}
.quiz-head p { font-size: .82rem; color: var(--txt-soft); position: relative; }
.quiz-dots { display: flex; gap: 8px; justify-content: center; margin-top: 18px; }
.quiz-dot {
    width: 9px; height: 9px;
    background: var(--b-mid); border-radius: 50%;
    transition: all .3s;
}
.quiz-dot.on { background: var(--g-mid); width: 28px; border-radius: 5px; }

/* Corps modal */
.quiz-body { padding: 32px 36px; }
.q-num { font-size: .65rem; text-transform: uppercase; letter-spacing: 3px; color: var(--g-sage); margin-bottom: 10px; }
.q-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem; color: var(--txt); line-height: 1.45; margin-bottom: 24px;
}
.q-answers { display: flex; flex-direction: column; gap: 10px; }
.q-btn {
    background: white; border: 1.5px solid var(--b-light);
    border-radius: 14px; padding: 14px 18px;
    display: flex; align-items: center; gap: 14px;
    font-size: .9rem; color: var(--txt); cursor: pointer;
    transition: all .2s; font-family: 'DM Sans', sans-serif;
    text-align: left;
}
.q-btn:hover { border-color: var(--g-sage); background: var(--g-pale); }
.q-btn .ltr {
    width: 32px; height: 32px; flex-shrink: 0;
    background: var(--b-cream); border: 1px solid var(--b-light);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: .78rem; color: var(--b-deep);
    transition: all .2s;
}
.q-btn:hover .ltr { background: var(--g-sage); color: white; border-color: var(--g-sage); }
.q-btn.correct { border-color: var(--g-mid); background: var(--g-pale); }
.q-btn.correct .ltr { background: var(--g-mid); color: white; border-color: var(--g-mid); }
.q-btn.wrong { border-color: #c0392b; background: #fdf0ef; }
.q-btn.wrong .ltr { background: #c0392b; color: white; border-color: #c0392b; }
.q-btn:disabled { cursor: not-allowed; opacity: .7; }

.quiz-foot { padding: 0 36px 32px; display: flex; justify-content: flex-end; }
.btn-suivant {
    background: var(--g-mid); color: white; border: none;
    padding: 13px 34px; border-radius: 100px;
    font-size: .78rem; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; cursor: pointer; transition: all .25s;
    box-shadow: 0 4px 16px rgba(74,124,47,.3);
}
.btn-suivant:hover { background: #2D5016; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(45,80,22,.2); }
.btn-suivant:disabled { background: var(--b-mid); color: var(--txt-soft); cursor: not-allowed; transform: none; box-shadow: none; }

/* ── RÉSULTAT ── */
.result-wrap { text-align: center; padding: 40px 24px; }
.result-badge {
    width: 90px; height: 90px; margin: 0 auto 20px;
    background: var(--b-cream); border: 2px solid var(--b-mid);
    border-radius: 28px; display: flex; align-items: center; justify-content: center;
    font-size: 2.8rem;
}
.result-title { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--txt); margin-bottom: 8px; }
.result-score { font-family: 'Playfair Display', serif; font-size: 3.2rem; color: var(--g-mid); font-weight: 600; margin-bottom: 14px; }
.result-msg { font-size: .95rem; color: var(--txt-soft); line-height: 1.7; max-width: 420px; margin: 0 auto 28px; }
.result-reward {
    background: var(--b-cream); border: 1px solid var(--b-mid);
    border-radius: 16px; padding: 20px 28px; margin-bottom: 28px;
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 1rem; color: var(--txt);
}
.result-reward i { color: var(--b-dark); font-size: 1.3rem; }
.btn-retry {
    background: var(--g-mid); color: white; border: none;
    padding: 13px 30px; border-radius: 100px;
    font-size: .78rem; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; cursor: pointer; margin-right: 10px;
    transition: all .2s; box-shadow: 0 4px 16px rgba(74,124,47,.3);
}
.btn-retry:hover { background: #2D5016; }
.btn-fermer {
    background: white; color: var(--txt-soft);
    border: 1.5px solid var(--b-light);
    padding: 13px 30px; border-radius: 100px;
    font-size: .78rem; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; cursor: pointer; transition: all .2s;
}
.btn-fermer:hover { background: var(--b-light); color: var(--txt); }
</style>

<!-- ── HERO ── -->
<section class="jeu-hero">
    <div class="jeu-hero-blob b1"></div>
    <div class="jeu-hero-blob b2"></div>
    <div class="jeu-hero-inner">
        <div class="jeu-tag">Parcours du Bien-Être</div>
        <h1>Défis <em>Émotionnels</em></h1>
        <p>Apprends à mieux te connaître et à prendre soin de ta santé mentale,<br>une question à la fois.</p>
        <div class="jeu-stats">
            <div class="jeu-stat">
                <div class="jeu-stat-icon">⭐</div>
                <div>
                    <div class="jeu-stat-label">Niveau</div>
                    <div class="jeu-stat-value">{{ niveau }}</div>
                </div>
            </div>
            <div class="jeu-stat">
                <div class="jeu-stat-icon">🏆</div>
                <div>
                    <div class="jeu-stat-label">Points</div>
                    <div class="jeu-stat-value">{{ totalPoints }}</div>
                </div>
            </div>
            <div class="jeu-stat">
                <div class="jeu-stat-icon">🎯</div>
                <div>
                    <div class="jeu-stat-label">Défis réussis</div>
                    <div class="jeu-stat-value">{{ defisReussis }}</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── GRILLE ── -->
<section class="jeu-page">
    <div class="jeu-eyebrow">Bien-être &amp; Apprentissage</div>
    <h2 class="jeu-title">Choisis ton <em>Défi</em></h2>

    <div class="jeu-grid">
        {% set cats = {
            'stress':    {icon: '😰', title: 'Gestion du Stress',         desc: 'Apprends à identifier et gérer ton stress au quotidien'},
            'emotions':  {icon: '❤️', title: 'Intelligence Émotionnelle',  desc: 'Développe ta capacité à comprendre et gérer tes émotions'},
            'pensees':   {icon: '💭', title: 'Pensées Positives',          desc: 'Transforme tes pensées négatives en pensées constructives'},
            'relations': {icon: '🤝', title: 'Relations Saines',           desc: 'Construis et maintiens des relations équilibrées'},
            'sommeil':   {icon: '😴', title: 'Sommeil & Repos',            desc: 'Améliore la qualité de ton sommeil et ton repos'},
            'confiance': {icon: '💪', title: 'Confiance en Soi',           desc: 'Renforce ton estime personnelle et ta confiance'}
        } %}
        {% for cat, info in cats %}
        {% set prog = progression[cat] ?? {defis: 0, points: 0} %}
        {% set pct = (prog.defis / 12 * 100)|round %}
        <div class="jeu-card" id="card-{{ cat }}" onclick="startQuiz('{{ cat }}')">
            <div class="jeu-card-top">
                <div class="jeu-card-icon">{{ info.icon }}</div>
                <span class="jeu-card-pts" id="pts-{{ cat }}">+{{ prog.points }} pts</span>
            </div>
            <h3>{{ info.title }}</h3>
            <p>{{ info.desc }}</p>
            <div class="jeu-bar-wrap">
                <div class="jeu-bar" id="bar-{{ cat }}" style="width:{{ pct }}%"></div>
            </div>
            <div class="jeu-card-foot">
                <span id="count-{{ cat }}">{{ prog.defis }} / 12 défis</span>
                <span id="pct-{{ cat }}">{{ pct }}%</span>
            </div>
            <div class="jeu-card-arrow">→</div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- ── MODAL QUIZ ── -->
<div class="quiz-overlay" id="quizOverlay">
    <div class="quiz-modal">
        <div class="quiz-head">
            <div class="quiz-head-deco"></div>
            <button class="quiz-close-btn" onclick="closeQuiz()">✕</button>
            <h2 id="quizTitle">Défi</h2>
            <p id="quizSubtitle">Réponds aux questions pour gagner des points</p>
            <div class="quiz-dots" id="quizDots"></div>
        </div>
        <div class="quiz-body" id="quizBody"></div>
        <div class="quiz-foot" id="quizFoot"></div>
    </div>
</div>

<script>
const quizData = {
    stress: { title: 'Gestion du Stress', icon: '😰', questions: [
        { q: 'Quelle est la première étape pour gérer le stress ?', answers: ['Ignorer le problème', 'Identifier la source du stress', 'Dormir plus', 'Manger du chocolat'], correct: 1 },
        { q: 'Quelle technique de respiration aide à réduire le stress ?', answers: ['Respiration rapide', 'Respiration profonde et lente', 'Retenir sa respiration', 'Respirer par la bouche uniquement'], correct: 1 },
        { q: "Combien de temps d'exercice par jour est recommandé pour réduire le stress ?", answers: ['5 minutes', '30 minutes', '2 heures', '4 heures'], correct: 1 }
    ]},
    emotions: { title: 'Intelligence Émotionnelle', icon: '❤️', questions: [
        { q: "Qu'est-ce que l'intelligence émotionnelle ?", answers: ['Être toujours heureux', 'Comprendre et gérer ses émotions', 'Ne jamais pleurer', 'Ignorer ses sentiments'], correct: 1 },
        { q: "Quelle est la meilleure façon d'exprimer sa colère ?", answers: ['Crier sur les autres', 'Garder tout pour soi', 'Exprimer calmement ses sentiments', 'Casser des objets'], correct: 2 },
        { q: 'Pourquoi est-il important de reconnaître ses émotions ?', answers: ['Pour les cacher', 'Pour mieux les gérer', 'Pour les ignorer', 'Pour paraître fort'], correct: 1 }
    ]},
    pensees: { title: 'Pensées Positives', icon: '💭', questions: [
        { q: "Qu'est-ce qu'une pensée automatique négative ?", answers: ['Une pensée qui vient sans réfléchir', 'Une pensée positive', 'Un souvenir heureux', 'Un rêve'], correct: 0 },
        { q: 'Comment transformer une pensée négative ?', answers: ["L'ignorer", 'La remplacer par une pensée réaliste', 'Y penser encore plus', 'La partager avec tout le monde'], correct: 1 },
        { q: 'Quel est l\'effet des pensées positives sur le cerveau ?', answers: ['Aucun effet', 'Libération de dopamine', 'Augmentation du stress', 'Perte de mémoire'], correct: 1 }
    ]},
    relations: { title: 'Relations Saines', icon: '🤝', questions: [
        { q: "Qu'est-ce qu'une relation saine ?", answers: ["Toujours d'accord", 'Respect mutuel et communication', 'Dépendance totale', 'Absence de conflits'], correct: 1 },
        { q: 'Comment gérer un désaccord dans une relation ?', answers: ['Éviter la personne', 'Communiquer calmement', 'Crier plus fort', 'Ignorer le problème'], correct: 1 },
        { q: 'Pourquoi les limites sont-elles importantes ?', answers: ['Pour isoler les autres', 'Pour protéger son bien-être', 'Pour être méchant', 'Elles ne le sont pas'], correct: 1 }
    ]},
    sommeil: { title: 'Sommeil & Repos', icon: '😴', questions: [
        { q: "Combien d'heures de sommeil sont recommandées pour un adulte ?", answers: ['4-5 heures', '7-9 heures', '10-12 heures', '2-3 heures'], correct: 1 },
        { q: 'Quelle habitude améliore la qualité du sommeil ?', answers: ['Regarder son téléphone au lit', 'Routine régulière de coucher', 'Boire du café le soir', 'Faire du sport intense avant de dormir'], correct: 1 },
        { q: 'Quel est l\'effet du manque de sommeil ?', answers: ["Plus d'énergie", 'Meilleure concentration', 'Irritabilité et fatigue', 'Aucun effet'], correct: 2 }
    ]},
    confiance: { title: 'Confiance en Soi', icon: '💪', questions: [
        { q: "Qu'est-ce que l'estime de soi ?", answers: ['Se croire supérieur', "La valeur qu'on se donne", 'Ignorer ses défauts', 'Être parfait'], correct: 1 },
        { q: 'Comment développer sa confiance ?', answers: ['Se comparer aux autres', 'Célébrer ses petites victoires', 'Éviter les défis', 'Critiquer ses erreurs'], correct: 1 },
        { q: 'Quel est le rôle du dialogue intérieur ?', answers: ['Aucun', 'Influence notre confiance', 'Nous rend triste', "Nous empêche de dormir"], correct: 1 }
    ]}
};

let cQuiz = null, cQ = 0, score = 0, answered = false;

function startQuiz(cat) {
    cQuiz = quizData[cat]; cQ = 0; score = 0; answered = false;
    document.getElementById('quizTitle').textContent = cQuiz.icon + '  ' + cQuiz.title;
    document.getElementById('quizSubtitle').textContent = cQuiz.questions.length + ' questions · 15 pts par bonne réponse';
    renderDots(); renderQ();
    document.getElementById('quizOverlay').classList.add('active');
}

function closeQuiz() { document.getElementById('quizOverlay').classList.remove('active'); }

function renderDots() {
    document.getElementById('quizDots').innerHTML = cQuiz.questions.map((_, i) =>
        '<div class="quiz-dot' + (i === cQ ? ' on' : '') + '"></div>'
    ).join('');
}

function renderQ() {
    const q = cQuiz.questions[cQ];
    const L = ['A','B','C','D'];
    let h = '<div class="q-num">Question ' + (cQ+1) + ' / ' + cQuiz.questions.length + '</div>';
    h += '<div class="q-text">' + q.q + '</div><div class="q-answers">';
    q.answers.forEach((a, i) => {
        h += '<button class="q-btn" onclick="pick(' + i + ')">'
           + '<span class="ltr">' + L[i] + '</span><span>' + a + '</span></button>';
    });
    h += '</div>';
    document.getElementById('quizBody').innerHTML = h;
    document.getElementById('quizFoot').innerHTML = '<button class="btn-suivant" onclick="next()" disabled>Suivant →</button>';
    answered = false;
}

function pick(i) {
    if (answered) return;
    answered = true;
    const q = cQuiz.questions[cQ];
    document.querySelectorAll('.q-btn').forEach((b, j) => {
        b.disabled = true;
        if (j === q.correct) b.classList.add('correct');
        else if (j === i) b.classList.add('wrong');
    });
    if (i === q.correct) score++;
    document.querySelector('.btn-suivant').disabled = false;
}

function next() {
    cQ++;
    if (cQ < cQuiz.questions.length) { renderDots(); renderQ(); }
    else showResult();
}

function showResult() {
    const total = cQuiz.questions.length;
    const pct = Math.round(score / total * 100);
    const pts = score * 15;
    const catKey = Object.keys(quizData).find(k => quizData[k] === cQuiz);
    let icon = '🌱', title = 'Continue !', msg = "N'abandonne pas ! Réessaye pour t'améliorer.";
    if (pct === 100) { icon = '🏆'; title = 'Parfait !'; msg = 'Score parfait ! Tu maîtrises ce sujet.'; }
    else if (pct >= 70) { icon = '⭐'; title = 'Excellent !'; msg = 'Très bon score ! Continue sur cette lancée.'; }
    else if (pct >= 50) { icon = '👍'; title = 'Bien joué !'; msg = 'Bon travail ! Tu peux encore progresser.'; }

    document.getElementById('quizBody').innerHTML =
        '<div class="result-wrap">'
        + '<div class="result-badge">' + icon + '</div>'
        + '<h2 class="result-title">' + title + '</h2>'
        + '<div class="result-score">' + score + ' / ' + total + '</div>'
        + '<p class="result-msg">' + msg + '</p>'
        + '<div class="result-reward"><i class="fas fa-star"></i> +' + pts + ' points gagnés</div>'
        + '<button class="btn-retry" onclick="startQuiz(\'' + catKey + '\')">Réessayer</button>'
        + '<button class="btn-fermer" onclick="closeQuiz()">Fermer</button>'
        + '</div>';
    document.getElementById('quizFoot').innerHTML = '';
    document.getElementById('quizDots').innerHTML = '';

    fetch('/client/jeu/save-score', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category: catKey, score: score, total: total, points: pts })
    }).then(function(r){ return r.json(); }).then(function(data) {
        if (!data.success) return;
        // Mettre à jour la carte de la catégorie
        var prog = (data.progression || []).find(function(p){ return p.categorie === catKey; });
        if (prog) {
            var defis = parseInt(prog.defis_reussis);
            var pct = Math.round(defis / 12 * 100);
            var bar = document.getElementById('bar-' + catKey);
            var count = document.getElementById('count-' + catKey);
            var pctEl = document.getElementById('pct-' + catKey);
            var ptsEl = document.getElementById('pts-' + catKey);
            if (bar) bar.style.width = pct + '%';
            if (count) count.textContent = defis + ' / 12 défis';
            if (pctEl) pctEl.textContent = pct + '%';
            if (ptsEl) ptsEl.textContent = '+' + prog.points_gagnes + ' pts';
        }
        // Mettre à jour le compteur global
        var totalDefis = (data.progression || []).reduce(function(s, p){ return s + parseInt(p.defis_reussis); }, 0);
        var el = document.getElementById('userCompleted');
        if (el) el.textContent = totalDefis;
    });
}

document.getElementById('quizOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeQuiz();
});
</script>
{% endblock %}
