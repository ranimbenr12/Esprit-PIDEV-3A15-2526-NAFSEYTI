{% extends 'back/base.html.twig' %}
{% block title %}Gestion des Réductions{% endblock %}
{% block body %}
<div class="full_container">
  <div class="inner_container">

    <!-- Sidebar -->
    <nav id="sidebar">
      <div class="sidebar_blog_1">
        <div class="sidebar-header">
          <div class="logo_section">
            <a href="#"><img class="logo_icon img-responsive" src="{{ asset('back/images/logo/logo_icon1.png') }}" alt="logo" /></a>
          </div>
        </div>
        <div class="sidebar_user_info">
          <div class="user_profle_side">
            <div class="user_img"><img class="img-responsive" src="{{ asset('back/images/layout_img/user_img.jpg') }}" alt="user" /></div>
            <div class="user_info">
              <h6>{{ app.user.firstname }} {{ app.user.lastname }}</h6>
              <p><span class="online_animation"></span> En ligne</p>
            </div>
          </div>
        </div>
      </div>
      <div class="sidebar_blog_2">
        <ul class="list-unstyled components">
          <li><a href="{{ path('back_dashboard') }}"><i class="fa fa-dashboard yellow_color"></i> Tableau de bord</a></li>
          <li><a href="{{ path('admin_users') }}"><i class="fa fa-users blue1_color"></i> Utilisateurs</a></li>
          <li><a href="{{ path('back_suivi_index') }}"><i class="fa fa-line-chart yellow_color"></i> Suivi personnel</a></li>
          <li class="active"><a href="{{ path('back_reduction_index') }}"><i class="fa fa-tag green_color"></i> Réductions</a></li>
        </ul>
      </div>
    </nav>

    <!-- Content -->
    <div id="content">
      <div class="topbar">
        <nav class="navbar navbar-expand-lg navbar-light">
          <div class="full">
            <button type="button" id="sidebarCollapse" class="sidebar_toggle"><i class="fa fa-bars"></i></button>
            <div class="logo_section">
              <a href="{{ path('back_dashboard') }}" style="display:flex;align-items:center;text-decoration:none;">
                <img class="img-responsive" src="{{ asset('back/images/logo/logo1.png') }}" alt="logo" style="width:40px;margin-right:10px;" />
                <span style="font-size:20px;color:#3c943c;">Nafseyti</span>
              </a>
            </div>
            <div class="right_topbar">
              <div class="icon_info">
                <ul class="user_profile_dd">
                  <li>
                    <a class="dropdown-toggle" data-toggle="dropdown">
                      <span class="name_user">{{ app.user.firstname }} {{ app.user.lastname }}</span>
                    </a>
                    <div class="dropdown-menu">
                      <a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <div class="midde_cont">
        <div class="container-fluid">
          <div class="row column_title">
            <div class="col-md-12">
              <div class="page_title">
                <h2><i class="fa fa-tag"></i> Gestion des Réductions</h2>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-12">
              <button class="btn btn-success" onclick="openModal()">
                <i class="fa fa-plus"></i> Nouvelle réduction
              </button>
            </div>
          </div>

          <div class="row">
            <div class="col-md-12">
              <div class="white_shd full">
                <div class="full graph_head"><h2>Liste des réductions ({{ reductions|length }})</h2></div>
                <div class="table_section">
                  <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                      <thead>
                        <tr>
                          <th>Image</th>
                          <th>Marque</th>
                          <th>Description</th>
                          <th>Points requis</th>
                          <th>Réduction</th>
                          <th>Expiration</th>
                          <th>Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                      {% for r in reductions %}
                      <tr id="row-{{ r.id_reduction }}">
                        <td>
                          {% if r.image_url %}
                            <img src="{{ r.image_url }}" style="width:50px;height:40px;object-fit:cover;border-radius:4px;" onerror="this.style.display='none'">
                          {% else %}
                            <span class="text-muted">—</span>
                          {% endif %}
                        </td>
                        <td><strong>{{ r.nom_marque }}</strong></td>
                        <td>{{ r.description|slice(0,60) }}{% if r.description|length > 60 %}…{% endif %}</td>
                        <td><span class="badge badge-info">{{ r.points_requis }} pts</span></td>
                        <td><span class="badge badge-success">-{{ r.pourcentage_reduction }}%</span></td>
                        <td>{{ r.date_expiration|date('d/m/Y') }}</td>
                        <td>
                          <button class="btn btn-warning btn-sm" onclick="editReduction({{ r.id_reduction }})">
                            <i class="fa fa-edit"></i> Modifier
                          </button>
                          <button class="btn btn-danger btn-sm" onclick="deleteReduction({{ r.id_reduction }})">
                            <i class="fa fa-trash"></i> Supprimer
                          </button>
                        </td>
                      </tr>
                      {% else %}
                      <tr><td colspan="7" class="text-center text-muted">Aucune réduction.</td></tr>
                      {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modalReduction" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">Nouvelle réduction</h5>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="rId" value="0">
        <div class="form-group">
          <label>Nom de la marque *</label>
          <input type="text" id="rNom" class="form-control" placeholder="Ex: McDonald's">
        </div>
        <div class="form-group">
          <label>Description *</label>
          <textarea id="rDesc" class="form-control" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label>Points requis *</label>
          <input type="number" id="rPoints" class="form-control" min="1" value="30">
        </div>
        <div class="form-group">
          <label>Pourcentage de réduction *</label>
          <input type="number" id="rPct" class="form-control" min="1" max="100" value="10">
        </div>
        <div class="form-group">
          <label>Date d'expiration *</label>
          <input type="date" id="rDate" class="form-control">
        </div>
        <div class="form-group">
          <label>URL de l'image</label>
          <input type="text" id="rImg" class="form-control" placeholder="https://...">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
        <button type="button" class="btn btn-success" onclick="saveReduction()">Enregistrer</button>
      </div>
    </div>
  </div>
</div>

<script>
function openModal() {
    document.getElementById('modalTitle').textContent = 'Nouvelle réduction';
    document.getElementById('rId').value = '0';
    document.getElementById('rNom').value = '';
    document.getElementById('rDesc').value = '';
    document.getElementById('rPoints').value = '30';
    document.getElementById('rPct').value = '10';
    document.getElementById('rDate').value = '';
    document.getElementById('rImg').value = '';
    $('#modalReduction').modal('show');
}

function editReduction(id) {
    fetch('/back/reductions/' + id + '/json')
        .then(function(r){ return r.json(); })
        .then(function(d) {
            document.getElementById('modalTitle').textContent = 'Modifier la réduction';
            document.getElementById('rId').value = d.id_reduction;
            document.getElementById('rNom').value = d.nom_marque;
            document.getElementById('rDesc').value = d.description;
            document.getElementById('rPoints').value = d.points_requis;
            document.getElementById('rPct').value = d.pourcentage_reduction;
            document.getElementById('rDate').value = d.date_expiration;
            document.getElementById('rImg').value = d.image_url || '';
            $('#modalReduction').modal('show');
        });
}

function saveReduction() {
    var id = document.getElementById('rId').value;
    var url = parseInt(id) > 0 ? '/back/reductions/' + id + '/edit' : '/back/reductions/new';
    var body = new URLSearchParams({
        nom_marque: document.getElementById('rNom').value,
        description: document.getElementById('rDesc').value,
        points_requis: document.getElementById('rPoints').value,
        pourcentage_reduction: document.getElementById('rPct').value,
        date_expiration: document.getElementById('rDate').value,
        image_url: document.getElementById('rImg').value,
    });
    fetch(url, { method: 'POST', body })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (data.success) { $('#modalReduction').modal('hide'); location.reload(); }
            else alert('Erreur : ' + data.error);
        });
}

function deleteReduction(id) {
    confirmAction('Supprimer cette réduction ?', { type: 'danger', confirmText: 'Supprimer' }).then(function(ok) {
        if (!ok) return;
        fetch('/back/reductions/' + id + '/delete', { method: 'POST' })
            .then(function(r){ return r.json(); })
            .then(function(data) {
                if (data.success) { var row = document.getElementById('row-' + id); if (row) row.remove(); }
                else alert('Erreur : ' + data.error);
            });
    });
}
</script>
{% endblock %}
