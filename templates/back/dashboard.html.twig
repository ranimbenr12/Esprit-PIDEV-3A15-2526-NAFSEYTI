{% extends 'back/admin_base.html.twig' %}

{% block title %}Dashboard - Nafseyti{% endblock %}
{% block dashboard_active %}active{% endblock %}

{% block admin_content %}
<div class="row column_title">
    <div class="col-md-12">
        <div class="page_title">
            <h2>Tableau de bord</h2>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="dashboard-card users-card">
            <div class="icon-box">
                <i class="fa fa-users"></i>
            </div>
            <div class="info-box">
                <h3>1 250</h3>
                <p>Utilisateurs</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card rdv-card">
            <div class="icon-box">
                <i class="fa fa-calendar"></i>
            </div>
            <div class="info-box">
                <h3>320</h3>
                <p>Rendez-vous</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card content-card">
            <div class="icon-box">
                <i class="fa fa-book"></i>
            </div>
            <div class="info-box">
                <h3>85</h3>
                <p>Contenus</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card test-card">
            <div class="icon-box">
                <i class="fa fa-check-square"></i>
            </div>
            <div class="info-box">
                <h3>{{ total_tests }}</h3>
                <p>Tests</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card event-card">
            <div class="icon-box">
                <i class="fa fa-question-circle"></i>
            </div>
            <div class="info-box">
                <h3>{{ total_questions }}</h3>
                <p>Questions</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card suivi-card">
            <div class="icon-box">
                <i class="fa fa-line-chart"></i>
            </div>
            <div class="info-box">
                <h3>540</h3>
                <p>Suivi personnel</p>
            </div>
        </div>
    </div>
</div>

<!-- Graph -->
<div class="row column2 graph margin_bottom_30">
    <div class="col-lg-12">
        <div class="white_shd full">
            <div class="full graph_head">
                <div class="heading1 margin_0">
                    <h2>Statistiques des tests</h2>
                </div>
            </div>
            <div class="full graph_revenue">
                <canvas height="120" id="canvas"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="psychology-section">
    <div class="row">
        <div class="col-md-4">
            <div class="psychology-card">
                <img src="{{ asset('back/images/event-33.jpg') }}" alt="meditation">
                <div class="psychology-content">
                    <h4>Bien-être mental</h4>
                    <p>Suivez l'évolution émotionnelle des utilisateurs et leur équilibre psychologique.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="psychology-card">
                <img src="{{ asset('back/images/event-22.jpg') }}" alt="support">
                <div class="psychology-content">
                    <h4>Accompagnement</h4>
                    <p>Visualisez le suivi personnel et les rendez-vous psychologiques.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="psychology-card">
                <img src="{{ asset('back/images/Anasayfa.jpg') }}" alt="motivation">
                <div class="psychology-content">
                    <h4>Motivation</h4>
                    <p>Encouragez les utilisateurs avec du contenu positif et des tests adaptés.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div style="background: linear-gradient(135deg, #f5f0fb, #bdabb8); color: white; padding: 20px; border-radius: 18px; text-align: center; font-size: 18px; font-weight: 500; margin-top: 20px; box-shadow: 0 8px 20px rgba(0,0,0,0.12);">
    🧠 Prenez soin de votre santé mentale chaque jour 💙<br>
    🌿 Un esprit apaisé mène à une vie équilibrée ✨<br>
    😊 Chaque petit progrès compte !
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Configuration du graphique
var ctx = document.getElementById('canvas').getContext('2d');
var chart = new Chart(ctx, {
    type: 'line',
    data: {
        labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jun'],
        datasets: [{
            label: 'Tests complétés',
            data: [65, 78, 82, 91, 88, 95],
            borderColor: '#36d1dc',
            backgroundColor: 'rgba(54, 209, 220, 0.1)',
            fill: true
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true
    }
});
</script>
{% endblock %}