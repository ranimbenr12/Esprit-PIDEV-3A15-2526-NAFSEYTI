{% extends 'back/admin_base.html.twig' %}

{% block title %}Gestion des Questions - Nafseyti{% endblock %}
{% block question_active %}active{% endblock %}

{% block admin_content %}
<div class="row">
    <div class="col-md-12">
        <div class="white_shd full margin_bottom_30">
            <div class="full graph_head">
                <div class="heading1 margin_0 d-flex justify-content-between align-items-center flex-wrap">
                    <h2>Liste des questions</h2>
                    <a href="{{ path('app_question_new') }}" class="btn btn-success">
                        <i class="fa fa-plus"></i> Nouvelle question
                    </a>
                </div>
            </div>
            
            <div class="full price_table padding_infor_info">
                <div class="row">
                    <div class="col-lg-12">
                        
                        {# Barre de recherche #}
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <form method="get" action="{{ path('app_question_index') }}" class="form-inline">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <input type="text" name="search" class="form-control" 
                                                   placeholder="🔍 Rechercher une question..." 
                                                   value="{{ search }}" style="width: 100%;">
                                        </div>
                                        <div class="col-md-2">
                                            <select name="type" class="form-control" style="width: 100%;">
                                                <option value="">Tous les types</option>
                                                <option value="qcm_unique" {{ type == 'qcm_unique' ? 'selected' : '' }}>QCM</option>
                                                <option value="vrai_faux" {{ type == 'vrai_faux' ? 'selected' : '' }}>Vrai/Faux</option>
                                                <option value="texte_libre" {{ type == 'texte_libre' ? 'selected' : '' }}>Texte libre</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <select name="status" class="form-control" style="width: 100%;">
                                                <option value="">Tous statuts</option>
                                                <option value="actif" {{ status == 'actif' ? 'selected' : '' }}>Actif</option>
                                                <option value="inactif" {{ status == 'inactif' ? 'selected' : '' }}>Inactif</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <button type="submit" class="btn btn-primary" style="width: 100%;">
                                                <i class="fa fa-search"></i> Filtrer
                                            </button>
                                        </div>
                                        <div class="col-md-2">
                                            <a href="{{ path('app_question_index') }}" class="btn btn-secondary" style="width: 100%;">
                                                <i class="fa fa-refresh"></i> Réinitialiser
                                            </a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        
                        <div class="table-responsive-sm">
                            {% if questions is empty %}
                                <div class="alert alert-info text-center">
                                    <i class="fa fa-info-circle"></i> Aucune question trouvée.
                                    <a href="{{ path('app_question_new') }}">Créer la première question</a>
                                </div>
                            {% else %}
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Test</th>
                                            <th>Question</th>
                                            <th>Type</th>
                                            <th>Points</th>
                                            <th>Statut</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for question in questions %}
                                        <tr>
                                            <td><span class="badge badge-primary">{{ question.test.titre }}</span></td>
                                            <td>{{ question.texte|slice(0, 60) }}{{ question.texte|length > 60 ? '...' : '' }}</td>
                                            <td><span class="badge badge-info">{{ question.typeQuestion }}</span></td>
                                            <td>{{ question.points }}</td>
                                            <td>
                                                {% if question.status == 'actif' %}
                                                    <span class="badge bg-success">Actif</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Inactif</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="{{ path('app_question_show', {'id': question.id}) }}" class="btn btn-sm btn-info">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                    <a href="{{ path('app_question_edit', {'id': question.id}) }}" class="btn btn-sm btn-warning">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteQuestion({{ question.id }})">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </div>
                                                <form id="delete-form-{{ question.id }}" method="post" action="{{ path('app_question_delete', {'id': question.id}) }}" style="display: none;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ question.id) }}">
                                                </form>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function deleteQuestion(id) {
    Swal.fire({
        title: 'Confirmation',
        text: 'Êtes-vous sûr de vouloir supprimer cette question ?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Oui, supprimer',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('delete-form-' + id).submit();
        }
    });
}
</script>
{% endblock %}
{% endblock %}