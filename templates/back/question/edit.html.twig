{% extends 'back/admin_base.html.twig' %}

{% block title %}Modifier la question - Nafseyti{% endblock %}
{% block question_active %}active{% endblock %}

{% block admin_content %}
<div class="row">
    <div class="col-md-12">
        <div class="white_shd full margin_bottom_30">
            <div class="full graph_head">
                <div class="heading1 margin_0">
                    <h2>Modifier la question #{{ question.id }}</h2>
                </div>
            </div>
            
            <div class="full price_table padding_infor_info">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        {{ form_start(form, {'attr': {'class': 'form-horizontal', 'id': 'questionForm'}}) }}
                        
                        {% if question.test %}
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"></i>
                                <strong>Test associé :</strong> {{ question.test.titre }}
                            </div>
                        {% endif %}
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.test, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.test, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.test) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.texte, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.texte, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                                {{ form_errors(form.texte) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.typeQuestion, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.typeQuestion, {'attr': {'class': 'form-control', 'id': 'typeQuestion'}}) }}
                                {{ form_errors(form.typeQuestion) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3" id="reponsesPossiblesGroup">
                            {{ form_label(form.reponsesPossibles, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.reponsesPossibles, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                                {{ form_errors(form.reponsesPossibles) }}
                                <small class="form-text text-muted" id="reponsesHelp">
                                    Pour les QCM, séparez les options par des virgules
                                </small>
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.points, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.points, {'attr': {'class': 'form-control', 'min': 1, 'max': 100}}) }}
                                {{ form_errors(form.points) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.ordre, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.ordre, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.ordre) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            <div class="col-sm-9 offset-sm-3">
                                <div class="custom-control custom-checkbox">
                                    {{ form_widget(form.obligatoire, {'attr': {'class': 'custom-control-input'}}) }}
                                    {{ form_label(form.obligatoire, null, {'label_attr': {'class': 'custom-control-label'}}) }}
                                </div>
                                {{ form_errors(form.obligatoire) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.status, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.status) }}
                            </div>
                        </div>
                        
                        <div class="form-group row">
                            <div class="col-sm-9 offset-sm-3">
                                <a href="{{ path('app_question_show', {'id': question.id}) }}" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i> Enregistrer
                                </button>
                            </div>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeQuestionSelect = document.getElementById('typeQuestion');
    const reponsesPossiblesGroup = document.getElementById('reponsesPossiblesGroup');
    const reponsesPossiblesField = document.querySelector('#question_reponsesPossibles');
    const reponsesHelp = document.getElementById('reponsesHelp');
    
    function toggleReponsesPossibles() {
        const typeValue = typeQuestionSelect.value;
        const isQCM = typeValue && (typeValue.includes('qcm'));
        
        if (isQCM) {
            reponsesPossiblesGroup.style.display = 'flex';
            if (!reponsesPossiblesField.value) {
                reponsesPossiblesField.setAttribute('required', 'required');
            }
            reponsesHelp.innerHTML = '<span class="text-danger">* Obligatoire pour les QCM</span>';
        } else {
            reponsesPossiblesGroup.style.display = 'flex';
            reponsesPossiblesField.removeAttribute('required');
            reponsesHelp.innerHTML = 'Pour les QCM, séparez les options par des virgules. Ex: "Option 1, Option 2, Option 3"';
        }
    }
    
    if (typeQuestionSelect) {
        typeQuestionSelect.addEventListener('change', toggleReponsesPossibles);
        toggleReponsesPossibles();
    }
});
</script>
{% endblock %}
{% endblock %}