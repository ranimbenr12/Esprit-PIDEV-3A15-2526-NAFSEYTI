{% extends 'back/admin_base.html.twig' %}

{% block title %}Créer une nouvelle question - Nafseyti{% endblock %}
{% block question_active %}active{% endblock %}

{% block admin_content %}
<div class="row">
    <div class="col-md-12">
        <div class="white_shd full margin_bottom_30">
            <div class="full graph_head">
                <div class="heading1 margin_0">
                    <h2>Créer une nouvelle question</h2>
                </div>
            </div>
            
            <div class="full price_table padding_infor_info">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        {{ form_start(form, {'attr': {'class': 'form-horizontal', 'id': 'questionForm'}}) }}
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.test, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.test, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.test) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.texte, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.texte, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                                {{ form_errors(form.texte) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.typeQuestion, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.typeQuestion, {'attr': {'class': 'form-control', 'id': 'question_type'}}) }}
                                {{ form_errors(form.typeQuestion) }}
                            </div>
                        </div>
                        
                        <!-- Zone pour les options QCM (visible uniquement pour QCM) -->
                        <div class="form-group row mb-3" id="qcmOptionsGroup" style="display: none;">
                            {{ form_label(form.reponsesPossibles, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.reponsesPossibles, {'attr': {'class': 'form-control', 'rows': 3, 'id': 'question_reponses'}}) }}
                                {{ form_errors(form.reponsesPossibles) }}
                                <small class="form-text text-muted">
                                    <i class="fa fa-info-circle"></i> 
                                    Séparez chaque option par une virgule. Exemple: "Option 1, Option 2, Option 3"
                                </small>
                            </div>
                        </div>
                        
                        <!-- Message d'aide dynamique -->
                        <div class="form-group row mb-3">
                            <div class="col-sm-9 offset-sm-3">
                                <div id="helpMessage" class="alert alert-info" style="display: none;">
                                    <i class="fa fa-lightbulb-o"></i> 
                                    <span id="helpText"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.points, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.points, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.points) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.ordre, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.ordre, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.ordre) }}
                                <small class="form-text text-muted">Laissez vide pour mettre automatiquement à la fin</small>
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            <div class="col-sm-9 offset-sm-3">
                                <div class="custom-control custom-checkbox">
                                    {{ form_widget(form.obligatoire, {'attr': {'class': 'custom-control-input'}}) }}
                                    {{ form_label(form.obligatoire, null, {'label_attr': {'class': 'custom-control-label'}}) }}
                                </div>
                                {{ form_errors(form.obligatoire) }}
                            </div>
                        </div>
                        
                        <div class="form-group row mb-3">
                            {{ form_label(form.status, null, {'label_attr': {'class': 'col-sm-3 col-form-label'}}) }}
                            <div class="col-sm-9">
                                {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.status) }}
                            </div>
                        </div>
                        
                        <div class="form-group row">
                            <div class="col-sm-9 offset-sm-3">
                                <a href="{{ path('app_question_index') }}" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i> Créer la question
                                </button>
                            </div>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeSelect = document.getElementById('question_type');
    const qcmOptionsGroup = document.getElementById('qcmOptionsGroup');
    const reponsesField = document.getElementById('question_reponses');
    const helpMessage = document.getElementById('helpMessage');
    const helpText = document.getElementById('helpText');
    
    // Messages d'aide par type de question
    const helpMessages = {
        'texte_libre': {
            text: ' Les utilisateurs pourront répondre par un texte libre. Aucune option à configurer.',
            showQcmOptions: false,
            required: false
        },
        'numerique': {
            text: ' Les utilisateurs devront saisir un nombre. Aucune option à configurer.',
            showQcmOptions: false,
            required: false
        },
        'qcm_unique': {
            text: ' Les utilisateurs pourront sélectionner UNE SEULE option parmi celles que vous allez définir ci-dessous.',
            showQcmOptions: true,
            required: true
        },
        'qcm_multiple': {
            text: ' Les utilisateurs pourront sélectionner PLUSIEURS options parmi celles que vous allez définir ci-dessous.',
            showQcmOptions: true,
            required: true
        },
      
    };
    
    function updateForm() {
        const selectedType = typeSelect.value;
        const config = helpMessages[selectedType];
        
        if (config) {
            // Afficher le message d'aide
            helpMessage.style.display = 'block';
            helpText.innerHTML = config.text;
            
            // Gérer l'affichage des options QCM
            if (config.showQcmOptions) {
                qcmOptionsGroup.style.display = 'flex';
                reponsesField.setAttribute('required', 'required');
                reponsesField.placeholder = 'Exemple: Très satisfait, Satisfait, Neutre, Insatisfait, Très insatisfait';
            } else {
                qcmOptionsGroup.style.display = 'none';
                reponsesField.removeAttribute('required');
                reponsesField.value = '';
                
                // Pour l'échelle de Likert, pré-remplir automatiquement
                if (selectedType === 'likert') {
                    reponsesField.value = '1 - Pas du tout d\'accord, 2 - Pas d\'accord, 3 - Neutre, 4 - D\'accord, 5 - Tout à fait d\'accord';
                    reponsesField.readOnly = true;
                } else {
                    reponsesField.readOnly = false;
                }
            }
        } else {
            helpMessage.style.display = 'none';
            qcmOptionsGroup.style.display = 'none';
        }
    }
    
    if (typeSelect) {
        typeSelect.addEventListener('change', updateForm);
        updateForm(); // Appeler au chargement
    }
});
</script>
{% endblock %}
{% endblock %}