{% extends 'back/admin_base.html.twig' %}

{% block title %}Gestion des Tests - Nafseyti{% endblock %}
{% block test_active %}active{% endblock %}

{% block admin_content %}
<div class="row">
    <div class="col-md-12">
        <div class="white_shd full margin_bottom_30">
            <div class="full graph_head">
                <div class="heading1 margin_0 d-flex justify-content-between align-items-center">
                    <h2>Liste des tests psychologiques</h2>
                    <a href="{{ path('app_test_new') }}" class="btn btn-success">
                        <i class="fa fa-plus"></i> Nouveau test
                    </a>
                </div>
            </div>
            
            <div class="full price_table padding_infor_info">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="table-responsive-sm">
                            {% if tests is empty %}
                                <div class="alert alert-info text-center">
                                    <i class="fa fa-info-circle"></i> Aucun test n'a été créé pour le moment.
                                    <a href="{{ path('app_test_new') }}">Créer le premier test</a>
                                </div>
                            {% else %}
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Titre</th>
                                            <th>Catégorie</th>
                                            <th>Niveau</th>
                                            <th>Durée</th>
                                            <th>Questions</th>
                                            <th>Statut</th>
                                            <th>Créé par</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for test in tests %}
                                            <tr>
                                                <td>{{ test.id }}</td>
                                                <td><strong>{{ test.titre }}</strong></td>
                                                <td>
                                                    <span class="badge badge-info">
                                                        {{ test.categorie|capitalize }}
                                                    </span>
                                                </td>
                                                <td>{{ test.niveau|capitalize }}</td>
                                                <td>{{ test.duree ? test.duree ~ ' min' : '-' }}</td>
                                                <td>
                                                    <span class="badge bg-primary">
                                                        {{ test.questions|length }} question(s)
                                                    </span>
                                                </td>
                                                <td>
                                                    {% if test.status == 'actif' %}
                                                        <span class="badge bg-success">Actif</span>
                                                    {% else %}
                                                        <span class="badge bg-danger">Inactif</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {# CORRECTION ICI - Vérifier si user existe #}
                                                    {% if test.user %}
                                                        {{ test.user.email|split('@')[0] }}
                                                    {% else %}
                                                        <span class="text-muted">Non assigné</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <a href="{{ path('app_test_show', {'id': test.id}) }}" 
                                                           class="btn btn-sm btn-info" title="Voir">
                                                            <i class="fa fa-eye"></i>
                                                        </a>
                                                        <a href="{{ path('app_test_edit', {'id': test.id}) }}" 
                                                           class="btn btn-sm btn-warning" title="Modifier">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <button type="button" 
                                                                class="btn btn-sm btn-danger" 
                                                                title="Supprimer"
                                                                onclick="deleteTest({{ test.id }}, '{{ test.titre }}')">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </div>
                                                    
                                                    <form id="delete-form-{{ test.id }}" 
                                                          method="post" 
                                                          action="{{ path('app_test_delete', {'id': test.id}) }}" 
                                                          style="display: none;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ test.id) }}">
                                                    </form>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script>
function deleteTest(id, titre) {
    Swal.fire({
        title: 'Confirmation',
        text: `Êtes-vous sûr de vouloir supprimer le test "${titre}" ?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Oui, supprimer',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('delete-form-' + id).submit();
        }
    });
}
</script>
{% endblock %}
{% endblock %}