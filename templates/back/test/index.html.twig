{% extends 'back/admin_base.html.twig' %}

{% block title %}Gestion des Tests{% endblock %}
{% block test_active %}active{% endblock %}

{% block admin_content %}

<style>
    /* ── Variables ── */
    :root {
        --ink:       #1a1d23;
        --ink-mid:   #4a5060;
        --ink-light: #8b90a0;
        --border:    #e4e7ef;
        --surface:   #ffffff;
        --bg:        #f5f6fa;
        --accent:    #3b5bdb;
        --accent-dk: #2f4ac7;
        --green:     #2f9e44;
        --red:       #c92a2a;
        --amber:     #e67700;
        --radius:    10px;
        --shadow:    0 1px 4px rgba(0,0,0,0.07), 0 4px 16px rgba(0,0,0,0.05);
    }

    /* ── Page header ── */
    .pg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
    }
    .pg-header h1 {
        font-size: 1.45rem;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -.3px;
        margin: 0;
    }
    .pg-header h1 span {
        color: var(--accent);
    }
    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--accent);
        color: #fff;
        font-size: .875rem;
        font-weight: 600;
        padding: 9px 20px;
        border-radius: var(--radius);
        border: none;
        text-decoration: none;
        transition: background .15s, transform .1s;
    }
    .btn-create:hover {
        background: var(--accent-dk);
        color: #fff;
        transform: translateY(-1px);
        text-decoration: none;
    }
    .btn-create svg { flex-shrink: 0; }

    /* ── Stat cards ── */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--shadow);
    }
    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .stat-icon.blue  { background: #e8eeff; color: var(--accent); }
    .stat-icon.green { background: #ebfbee; color: var(--green); }
    .stat-icon.red   { background: #fff5f5; color: var(--red); }
    .stat-info strong {
        display: block;
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1;
    }
    .stat-info span {
        font-size: .78rem;
        color: var(--ink-light);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    /* ── Search bar ── */
    .search-bar {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 16px 20px;
        margin-bottom: 20px;
        box-shadow: var(--shadow);
    }
    .search-bar form {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }
    .search-wrap {
        flex: 1;
        min-width: 200px;
        position: relative;
    }
    .search-wrap svg {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ink-light);
        pointer-events: none;
    }
    .search-wrap input {
        width: 100%;
        padding: 9px 12px 9px 36px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: .875rem;
        color: var(--ink);
        background: var(--bg);
        transition: border-color .15s, box-shadow .15s;
        outline: none;
    }
    .search-wrap input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(59,91,219,.12);
        background: #fff;
    }
    .filter-select {
        padding: 9px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: .875rem;
        color: var(--ink);
        background: var(--bg);
        min-width: 160px;
        outline: none;
        transition: border-color .15s;
        cursor: pointer;
    }
    .filter-select:focus { border-color: var(--accent); }
    .btn-filter {
        padding: 9px 18px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: .875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background .15s;
        white-space: nowrap;
    }
    .btn-filter:hover { background: var(--accent-dk); }
    .btn-reset {
        padding: 9px 14px;
        background: transparent;
        color: var(--ink-mid);
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: .875rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: border-color .15s, color .15s;
        white-space: nowrap;
    }
    .btn-reset:hover { border-color: var(--ink-mid); color: var(--ink); text-decoration: none; }

    /* ── Table ── */
    .tbl-wrap {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }
    .tbl-wrap table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }
    .tbl-wrap thead tr {
        background: #f9fafc;
        border-bottom: 2px solid var(--border);
    }
    .tbl-wrap thead th {
        padding: 12px 16px;
        font-weight: 600;
        color: var(--ink-mid);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }
    .tbl-wrap thead th a {
        color: var(--ink-mid);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: color .15s;
    }
    .tbl-wrap thead th a:hover { color: var(--accent); }
    .tbl-wrap thead th a.active { color: var(--accent); }
    .tbl-wrap tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .1s;
    }
    .tbl-wrap tbody tr:last-child { border-bottom: none; }
    .tbl-wrap tbody tr:hover { background: #f9fafc; }
    .tbl-wrap tbody td {
        padding: 13px 16px;
        color: var(--ink);
        vertical-align: middle;
    }
    .cell-title strong { color: var(--ink); font-weight: 600; }
    .cell-title small  { color: var(--ink-light); font-size: .8rem; display: block; margin-top: 2px; }

    /* ── Badges ── */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .75rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .badge-cat   { background: #e8eeff; color: var(--accent); }
    .badge-lvl   { background: #ebfbee; color: var(--green); }
    .badge-q     { background: #f1f3f5; color: var(--ink-mid); }
    .badge-actif { background: #ebfbee; color: var(--green); }
    .badge-inact { background: #fff5f5; color: var(--red); }

    /* ── Action buttons ── */
    .actions { display: flex; gap: 6px; align-items: center; }
    .btn-act {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink-mid);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: background .12s, color .12s, border-color .12s;
    }
    .btn-act:hover { text-decoration: none; }
    .btn-act.view:hover   { background: #e8eeff; color: var(--accent); border-color: #b8c9ff; }
    .btn-act.edit:hover   { background: #fff9e6; color: var(--amber); border-color: #ffd97a; }
    .btn-act.del:hover    { background: #fff5f5; color: var(--red);   border-color: #ffc9c9; }

    /* ── Empty state ── */
    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--ink-light);
    }
    .empty-state svg { margin-bottom: 12px; opacity: .4; }
    .empty-state p { font-size: .95rem; margin-bottom: 16px; }

    /* ── Result info ── */
    .result-info {
        margin-top: 14px;
        font-size: .82rem;
        color: var(--ink-light);
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .result-info strong { color: var(--ink-mid); }

    /* ── Sort arrows ── */
    .sort-arrow { font-size: .65rem; opacity: .6; }
    .sort-arrow.on { opacity: 1; color: var(--accent); }
</style>

<div class="pg-header">
    <h1>Gestion des <span>Tests Psychologiques</span></h1>
    <a href="{{ path('app_test_new') }}" class="btn-create">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nouveau test
    </a>
</div>

{# ── STATS ── #}
<div class="stat-row">
    <div class="stat-card">
        <div class="stat-icon blue">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <div class="stat-info">
            <strong>{{ totalTests }}</strong>
            <span>Total des tests</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <div class="stat-info">
            <strong>{{ testsActifs }}</strong>
            <span>Tests actifs</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>
        </div>
        <div class="stat-info">
            <strong>{{ testsInactifs }}</strong>
            <span>Tests inactifs</span>
        </div>
    </div>
</div>

{# ── SEARCH / FILTER ── #}
<div class="search-bar">
    <form method="get" action="{{ path('app_test_index') }}" id="searchForm">
        <div class="search-wrap">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" id="searchInput"
                   placeholder="Rechercher par titre ou description..."
                   value="{{ search }}">
        </div>

        <select name="status" class="filter-select">
            <option value="">Tous les statuts</option>
            <option value="actif"   {{ status == 'actif'   ? 'selected' : '' }}>Actif</option>
            <option value="inactif" {{ status == 'inactif' ? 'selected' : '' }}>Inactif</option>
        </select>

        <select name="categorie" class="filter-select">
            <option value="">Toutes les catégories</option>
            <option value="personnalite" {{ categorie == 'personnalite' ? 'selected' : '' }}>Personnalité</option>
            <option value="intelligence" {{ categorie == 'intelligence' ? 'selected' : '' }}>Intelligence</option>
            <option value="competences"  {{ categorie == 'competences'  ? 'selected' : '' }}>Compétences</option>
            <option value="aptitudes"    {{ categorie == 'aptitudes'    ? 'selected' : '' }}>Aptitudes</option>
            <option value="comportement" {{ categorie == 'comportement' ? 'selected' : '' }}>Comportement</option>
        </select>

        <button type="submit" class="btn-filter">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            Filtrer
        </button>

        {% if search or status or categorie %}
            <a href="{{ path('app_test_index') }}" class="btn-reset">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Réinitialiser
            </a>
        {% endif %}
    </form>
</div>

{# ── TABLE ── #}
<div class="tbl-wrap">
    <table>
        <thead>
            <tr>
                <th style="width:60px">
                    <a href="?sort=id&order={{ sort == 'id' and order == 'ASC' ? 'DESC' : 'ASC' }}{{ search ? '&search='~search : '' }}{{ status ? '&status='~status : '' }}{{ categorie ? '&categorie='~categorie : '' }}"
                       class="{{ sort == 'id' ? 'active' : '' }}">
                        ID
                        <span class="sort-arrow {{ sort == 'id' ? 'on' : '' }}">
                            {{ sort == 'id' ? (order == 'ASC' ? '▲' : '▼') : '▲' }}
                        </span>
                    </a>
                </th>
                <th>
                    <a href="?sort=titre&order={{ sort == 'titre' and order == 'ASC' ? 'DESC' : 'ASC' }}{{ search ? '&search='~search : '' }}{{ status ? '&status='~status : '' }}{{ categorie ? '&categorie='~categorie : '' }}"
                       class="{{ sort == 'titre' ? 'active' : '' }}">
                        Titre
                        <span class="sort-arrow {{ sort == 'titre' ? 'on' : '' }}">
                            {{ sort == 'titre' ? (order == 'ASC' ? '▲' : '▼') : '▲' }}
                        </span>
                    </a>
                </th>
                <th>Catégorie</th>
                <th>Niveau</th>
                <th>Durée</th>
                <th>Questions</th>
                <th>Statut</th>
                <th style="width:110px">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% if tests is empty %}
                <tr>
                    <td colspan="8">
                        <div class="empty-state">
                            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                            <p>Aucun test trouvé</p>
                            <a href="{{ path('app_test_new') }}" class="btn-create" style="margin: 0 auto;">Créer un test</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                {% for test in tests %}
                <tr>
                    <td style="color: var(--ink-light); font-size:.8rem;">#{{ test.id }}</td>
                    <td class="cell-title">
                        <strong>{{ test.titre }}</strong>
                        {% if test.description %}
                            <small>{{ test.description|slice(0,65) }}{% if test.description|length > 65 %}…{% endif %}</small>
                        {% endif %}
                    </td>
                    <td><span class="badge badge-cat">{{ test.categorie|capitalize }}</span></td>
                    <td><span class="badge badge-lvl">{{ test.niveau|capitalize }}</span></td>
                    <td style="color:var(--ink-mid);">{{ test.duree ? test.duree ~ ' min' : '—' }}</td>
                    <td><span class="badge badge-q">{{ test.questions|length }} question{{ test.questions|length != 1 ? 's' : '' }}</span></td>
                    <td>
                        {% if test.status == 'actif' %}
                            <span class="badge badge-actif">Actif</span>
                        {% else %}
                            <span class="badge badge-inact">Inactif</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="actions">
                            <a href="{{ path('app_test_show', {'id': test.id}) }}" class="btn-act view" title="Voir">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                            <a href="{{ path('app_test_edit', {'id': test.id}) }}" class="btn-act edit" title="Modifier">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
                            <button type="button" class="btn-act del" title="Supprimer"
                                    onclick="deleteTest({{ test.id }}, '{{ test.titre|e('js') }}')">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                            </button>
                        </div>
                        <form id="delete-form-{{ test.id }}" method="post"
                              action="{{ path('app_test_delete', {'id': test.id}) }}"
                              style="display:none;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete'~test.id) }}">
                        </form>
                    </td>
                </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>
</div>

{% if search or status or categorie %}
    <div class="result-info">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <strong>{{ tests|length }}</strong> résultat{{ tests|length != 1 ? 's' : '' }} trouvé{{ tests|length != 1 ? 's' : '' }}
    </div>
{% endif %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function deleteTest(id, titre) {
    Swal.fire({
        title: 'Supprimer ce test ?',
        text: '"' + titre + '" sera définitivement supprimé.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#c92a2a',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Supprimer',
        cancelButtonText: 'Annuler',
        borderRadius: '12px'
    }).then(function(result) {
        if (result.isConfirmed) {
            document.getElementById('delete-form-' + id).submit();
        }
    });
}

// Recherche auto après 500 ms
var searchTimeout = null;
var searchInput = document.getElementById('searchInput');
if (searchInput) {
    searchInput.addEventListener('keyup', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
            document.getElementById('searchForm').submit();
        }, 500);
    });
}
</script>
{% endblock %}

{% endblock %}
