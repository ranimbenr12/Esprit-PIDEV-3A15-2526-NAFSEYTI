        <h3><i class="fa fa-tag"></i> Gestion des <em>Réductions</em></h3>
        <button class="red-close" onclick="closeReductionsPanel()"><i class="fa fa-times"></i></button>
    </div>
    <div class="red-body">
        <button class="btn-add-red" style="outline:none;border:none;" onclick="openModalReduction(0)">
            <i class="fa fa-plus"></i> Ajouter une réduction
        </button>
        <div id="redList"><p class="text-muted text-center">Chargement...</p></div>
    </div>
</div>

<!-- Modal Réduction -->
<div class="modal fade" id="modalReduction" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRedTitle">Nouvelle réduction</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rId" value="0">
                <div class="form-group"><label>Nom de la marque *</label><input type="text" id="rNom" class="form-control"></div>
                <div class="form-group"><label>Description *</label><textarea id="rDesc" class="form-control" rows="2"></textarea></div>
                <div class="form-group"><label>Points requis *</label><input type="number" id="rPoints" class="form-control" value="30" min="1"></div>
                <div class="form-group"><label>Réduction (%) *</label><input type="number" id="rPct" class="form-control" value="10" min="1" max="100"></div>
                <div class="form-group"><label>Date d'expiration *</label><input type="date" id="rDate" class="form-control"></div>
                <div class="form-group"><label>URL image</label><input type="text" id="rImg" class="form-control" placeholder="https://..."></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                <button type="button" class="btn-save-red" style="outline:none;border:none;" onclick="saveReduction()">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<script>
function openReductionsPanel() {
    document.getElementById('redBackdrop').classList.add('open');
    document.getElementById('redPanel').classList.add('open');
    loadReductions();
}

function closeReductionsPanel() {
    document.getElementById('redBackdrop').classList.remove('open');
    document.getElementById('redPanel').classList.remove('open');
}

function loadReductions() {
    fetch('/back/reductions/list')
        .then(function(r){ return r.json(); })
        .then(function(data) {
            var container = document.getElementById('redList');
            if (!data.length) {
                container.innerHTML = '<p class="text-muted text-center">Aucune réduction.</p>';
                return;
            }
            var html = '';
            data.forEach(function(r) {
                html += '<div class="red-card" id="rcard-' + r.id_reduction + '">';
                if (r.image_url) {
                    html += '<img src="' + r.image_url + '" onerror="this.style.display=\'none\'">';
                } else {
                    html += '<div class="red-card-img-ph"><i class="fa fa-tag"></i></div>';
                }
                html += '<div class="red-card-info">';
                html += '<div class="red-card-name">' + r.nom_marque + '</div>';
                html += '<div class="red-card-meta">';
                html += '<span class="red-badge pts"><i class="fa fa-star"></i> ' + r.points_requis + ' pts</span>';
                html += '<span class="red-badge pct"><i class="fa fa-percent"></i> -' + r.pourcentage_reduction + '%</span>';
                html += '<span class="red-badge exp"><i class="fa fa-calendar"></i> ' + r.date_expiration + '</span>';
                html += '</div></div>';
                html += '<div class="red-card-actions">';
                html += '<button style="background:#EDE3D0;color:#3D5C28;border:none;outline:none;width:30px;height:30px;border-radius:6px;cursor:pointer;font-size:.75rem;" onclick="openModalReduction(' + r.id_reduction + ')" title="Modifier"><i class="fa fa-edit"></i></button>';
                html += '<button style="background:#FEE2E2;color:#991B1B;border:none;outline:none;width:30px;height:30px;border-radius:6px;cursor:pointer;font-size:.75rem;" onclick="deleteReduction(' + r.id_reduction + ')" title="Supprimer"><i class="fa fa-trash"></i></button>';
                html += '</div></div>';
            });
            container.innerHTML = html;
        });
}

function openModalReduction(id) {
    if (id === 0) {
        document.getElementById('modalRedTitle').textContent = 'Nouvelle réduction';
        document.getElementById('rId').value = '0';
        document.getElementById('rNom').value = '';
        document.getElementById('rDesc').value = '';
        document.getElementById('rPoints').value = '30';
        document.getElementById('rPct').value = '10';
        document.getElementById('rDate').value = '';
        document.getElementById('rImg').value = '';
        $('#modalReduction').modal('show');
    } else {
        fetch('/back/reductions/' + id + '/json')
            .then(function(r){ return r.json(); })
            .then(function(d) {
                document.getElementById('modalRedTitle').textContent = 'Modifier la réduction';
                document.getElementById('rId').value = d.id_reduction;
                document.getElementById('rNom').value = d.nom_marque;
                document.getElementById('rDesc').value = d.description;
                document.getElementById('rPoints').value = d.points_requis;
                document.getElementById('rPct').value = d.pourcentage_reduction;
                document.getElementById('rDate').value = d.date_expiration;
                document.getElementById('rImg').value = d.image_url || '';
                $('#modalReduction').modal('show');
            });
    }
}

function saveReduction() {
    var id = document.getElementById('rId').value;
    var url = parseInt(id) > 0 ? '/back/reductions/' + id + '/edit' : '/back/reductions/new';
    var body = new URLSearchParams({
        nom_marque: document.getElementById('rNom').value,
        description: document.getElementById('rDesc').value,
        points_requis: document.getElementById('rPoints').value,
        pourcentage_reduction: document.getElementById('rPct').value,
        date_expiration: document.getElementById('rDate').value,
        image_url: document.getElementById('rImg').value,
    });
    fetch(url, { method: 'POST', body })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (data.success) {
                $('#modalReduction').modal('hide');
                loadReductions();
            } else {
                alert('Erreur : ' + data.error);
            }
        });
}

var _deleteTarget = null;

document.getElementById('deleteCancelBtn').onclick = function() {
    document.getElementById('deleteOverlay').style.display = 'none';
    _deleteTarget = null;
};

document.getElementById('deleteConfirmBtn').onclick = function() {
    if (!_deleteTarget) return;
    var id = _deleteTarget;
    document.getElementById('deleteOverlay').style.display = 'none';
    fetch('/back/reductions/' + id + '/delete', { method: 'POST' })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (data.success) {
                var el = document.getElementById('rcard-' + id);
                if (el) el.remove();
            } else {
                alert('Erreur : ' + data.error);
            }
        });
    _deleteTarget = null;
};

function deleteReduction(id) {
    _deleteTarget = id;
    var overlay = document.getElementById('deleteOverlay');
    overlay.style.display = 'flex';
}
</script>

{% endblock %}