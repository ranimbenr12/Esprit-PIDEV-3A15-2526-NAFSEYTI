<!-- Modal Formulaire Suivi (Ajouter/Modifier) -->
<div class="modal fade" id="modalSuivi" tabindex="-1" role="dialog" style="z-index:10500;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Ajouter un suivi</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <form id="suiviForm" method="post">
                <div class="modal-body">
                    <input type="hidden" id="suiviId" name="id" value="0">
                    
                    <div class="form-group">
                        <label>Titre *</label>
                        <input type="text" class="form-control" id="titre" name="titre" required>
                        <span id="err_titre" class="text-danger small" style="display:none;"></span>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                        <span id="err_description" class="text-danger small" style="display:none;"></span>
                    </div>
                    <div class="form-group">
                        <label>Type de suivi</label>
                        <select class="form-control" id="type_suivi" name="type_suivi">
                            <option value="Psychologique">🧠 Psychologique</option>
                            <option value="Académique">📚 Académique</option>
                            <option value="Social">🤝 Social</option>
                            <option value="Comportemental">🎯 Comportemental</option>
                        </select>
                        <span id="err_type_suivi" class="text-danger small" style="display:none;"></span>
                    </div>
                    <div class="form-group">
                        <label>Étudiant *</label>
                        <select class="form-control" id="idutilisateur" name="idutilisateur">
                            <option value="">— Sélectionner un étudiant —</option>
                            {% for etudiant in etudiants %}
                            <option value="{{ etudiant.id }}">{{ etudiant.firstname }} {{ etudiant.lastname }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Psychologue *</label>
                        <select class="form-control" id="idpsychologue" name="idpsychologue">
                            <option value="">— Sélectionner un psychologue —</option>
                            {% for psy in psychologues %}
                            <option value="{{ psy.id }}">{{ psy.firstname }} {{ psy.lastname }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Popup confirmation suppression réduction -->
<div id="deleteOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99999;align-items:center;justify-content:center;">
  <div style="background:var(--color-background-primary,#fff);border-radius:12px;border:0.5px solid #ddd;padding:2rem;width:360px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.18);">
    <div style="width:56px;height:56px;border-radius:50%;background:#FCEBEB;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#A32D2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
        <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
      </svg>
    </div>
    <p style="font-size:16px;font-weight:500;margin:0 0 6px;">Supprimer cette réduction ?</p>
    <p style="font-size:13px;color:#888;margin:0 0 1.5rem;">Cette action est irréversible. La réduction sera définitivement supprimée.</p>
    <div style="display:flex;gap:10px;">
      <button id="deleteCancelBtn" style="flex:1;padding:9px;border:1px solid #ddd;background:#fff;border-radius:8px;cursor:pointer;font-size:14px;">Annuler</button>
      <button id="deleteConfirmBtn" style="flex:1;padding:9px;background:#A32D2D;border:none;border-radius:8px;cursor:pointer;font-size:14px;color:#F7C1C1;font-weight:500;">Supprimer</button>
    </div>
  </div>
</div>

<script>
// Reset formulaire
function resetForm() {
    document.getElementById('modalTitle').innerHTML = 'Ajouter un suivi';
    document.getElementById('suiviId').value = '0';
    document.getElementById('titre').value = '';
    document.getElementById('description').value = '';
    document.getElementById('type_suivi').value = 'Psychologique';
    document.getElementById('idutilisateur').value = '';
    document.getElementById('idpsychologue').value = '';
    clearErrors(['titre', 'description', 'type_suivi']);
    $('#modalSuivi').modal('show');
}

// Modifier un suivi
function editSuivi(id) {
    // Charger les données du suivi
    fetch('/back/suivi/' + id + '/show')
        .then(response => response.text())
        .then(html => {
            // Extraire les données du HTML (méthode simple)
            // Alternative: faire une requête AJAX qui retourne du JSON
            loadSuiviData(id);
        });
}

function loadSuiviData(id) {
    fetch('/back/suivi/' + id + '/json')
        .then(response => response.json())
        .then(data => {
            document.getElementById('modalTitle').innerHTML = 'Modifier le suivi';
            document.getElementById('suiviId').value = data.id;
            document.getElementById('titre').value = data.titre;
            document.getElementById('description').value = data.description || '';
            document.getElementById('type_suivi').value = data.type_suivi;
            document.getElementById('idutilisateur').value = data.idutilisateur || '';
            document.getElementById('idpsychologue').value = data.idpsychologue || '';
            $('#modalSuivi').modal('show');
        })
        .catch(error => {
            document.getElementById('modalTitle').innerHTML = 'Modifier le suivi';
            document.getElementById('suiviId').value = id;
            $('#modalSuivi').modal('show');
        });
}

// Voir les objectifs d'un suivi
function viewObjectifs(id) {
    window.location.href = '/back/objectif/suivi/' + id;
}

// Supprimer un suivi
function deleteSuivi(id) {
    if (confirm('Êtes-vous sûr de vouloir supprimer ce suivi ? Cette action est irréversible.')) {
        fetch('/back/suivi/' + id + '/delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({_token: '{{ csrf_token("delete") }}'})
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Erreur HTTP ' + response.status);
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Erreur: ' + (data.error || 'Une erreur est survenue'));
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            alert('Erreur lors de la suppression: ' + error.message);
        });
    }
}

// Soumission du formulaire (Ajouter/Modifier)
document.getElementById('suiviForm').addEventListener('submit', function(e) {
    e.preventDefault();

    clearErrors(['titre', 'description', 'type_suivi']);

    var id = parseInt(document.getElementById('suiviId').value) || 0;
    var url = id > 0 ? '/back/suivi/' + id + '/edit' : '/back/suivi/new';

    var params = new URLSearchParams({
        titre:          document.getElementById('titre').value,
        description:    document.getElementById('description').value,
        type_suivi:     document.getElementById('type_suivi').value,
        idutilisateur:  document.getElementById('idutilisateur').value,
        idpsychologue:  document.getElementById('idpsychologue').value,
    });

    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body: params.toString()
    })
    .then(function(r) {
        if (!r.ok) { return r.text().then(function(t){ throw new Error('HTTP ' + r.status + ': ' + t.substring(0,200)); }); }
        return r.json();
    })
    .then(function(data) {
        if (data.success) {
            $('#modalSuivi').modal('hide');
            location.reload();
        } else if (data.errors) {
            showErrors(data.errors);
        } else {
            alert('Erreur : ' + (data.error || JSON.stringify(data)));
        }
    })
    .catch(function(err) { alert('Erreur : ' + err.message); });
});

function clearErrors(fields) {
    fields.forEach(function(f) {
        var el = document.getElementById('err_' + f);
        if (el) { el.textContent = ''; el.style.display = 'none'; }
        var input = document.getElementById(f) || document.querySelector('[name="' + f + '"]');
        if (input) input.classList.remove('is-invalid');
    });
}

function showErrors(errors) {
    Object.keys(errors).forEach(function(field) {
        var el = document.getElementById('err_' + field);
        if (el) { el.textContent = errors[field]; el.style.display = 'block'; }
        var input = document.getElementById(field) || document.querySelector('[name="' + field + '"]');
        if (input) input.classList.add('is-invalid');
        if (field === 'global') { alert(errors[field]); }
    });
}
</script>

<script>
// Fix backdrop z-index so modal is always interactive
$(document).on('show.bs.modal', '#modalSuivi', function() {
    setTimeout(function() {
        $('.modal-backdrop').css('z-index', '10400');
        $('#modalSuivi').css('z-index', '10500');
    }, 10);
});

function filterSuivis(val) {
    var q = val.toLowerCase().trim();
    var rows = document.querySelectorAll('#suiviTableBody tr[id^="row-"]');
    var visible = 0;
    rows.forEach(function(row) {
        var text = row.innerText.toLowerCase();
        var show = !q || text.indexOf(q) !== -1;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    var empty = document.getElementById('emptyRow');
    if (empty) empty.style.display = visible === 0 ? '' : 'none';
}
</script>

