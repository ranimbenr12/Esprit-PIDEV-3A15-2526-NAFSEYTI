        $('#statusWarning').show();
    };

    $('#confirmStatusBtn').click(function() {
        if (!currentEventId || !currentSelectedStatus) return;
        
        var btn = $(this);
        btn.prop('disabled', true).text('⏳ Mise à jour...');
        
        fetch('/admin/events/' + currentEventId + '/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: currentSelectedStatus })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                $('#statusModal').modal('hide');
                showToast('✅ Statut mis à jour avec succès !', '#4CAF50');
                setTimeout(function() { location.reload(); }, 1500);
            } else {
                showToast('❌ Erreur: ' + (data.error || 'Inconnue'), '#f44336');
            }
            btn.prop('disabled', false).text('Confirmer');
        })
        .catch(function() {
            showToast('❌ Erreur réseau', '#f44336');
