══════════════════════════════════════════════════════ -->
<div class="modal fade" id="analyseModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
    <div class="modal-content" style="border-radius:20px; border:2px solid #4a5160; overflow:hidden; background:linear-gradient(to bottom right,#0f1219,#1a1f2f);">
      <div class="modal-body" style="padding:0; background:transparent; position:relative;">
        <canvas id="particleCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;opacity:.35;"></canvas>
        <div style="position:relative; padding:30px;">

          <!-- HEADER -->
          <div style="display:flex; align-items:center; gap:20px; margin-bottom:25px;">
            <div style="width:80px;height:80px;border-radius:50%;border:2px solid #9C27B0;display:flex;align-items:center;justify-content:center;font-size:36px;background:rgba(156,39,176,.15);animation:analysisPulse 2s infinite;flex-shrink:0;">📊</div>
            <div style="flex:1;">
              <div style="font-size:26px;font-weight:bold;color:#9C27B0;text-shadow:0 0 15px #9C27B080;">RAPPORT D'ANALYSE</div>
              <div style="font-size:13px;color:#b0b0b0;font-style:italic;">Analyse intelligente par Google Gemini AI</div>
            </div>
            <div style="border:2px dashed #4CAF50;border-radius:25px;padding:7px 16px;color:#4CAF50;font-size:11px;font-weight:bold;">🔒 IA CERTIFIÉE</div>
            <button type="button" data-dismiss="modal" style="background:none;border:none;color:#b0b0b0;font-size:24px;cursor:pointer;line-height:1;margin-left:10px;">&times;</button>
          </div>

          <!-- STAT CARDS -->
          <div id="analyseStats" style="display:flex;gap:15px;margin-bottom:20px;flex-wrap:wrap;">
            <div style="color:#b0b0b0;font-size:13px;padding:15px;">Chargement des statistiques...</div>
          </div>

          <!-- TOP EVENT -->
          <div id="analyseTopEvent" style="margin-bottom:20px;"></div>

          <!-- GEMINI ZONE -->
          <div style="background:rgba(0,0,0,.4);border-radius:15px;padding:20px;border:1px solid #3a4150;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
              <div style="display:flex;align-items:center;gap:10px;">
                <span style="font-size:18px;">💻</span>
                <span style="font-size:15px;font-weight:bold;color:#9C27B0;">ANALYSE GEMINI AI</span>
              </div>
              <span style="color:#4CAF50;font-size:12px;font-weight:bold;">● EN LIGNE</span>
            </div>
            <div id="analyseTextArea"
                 style="background:#0a0c12;color:#e0e0e0;font-family:Consolas,monospace;font-size:13px;
                        border-radius:10px;padding:18px;min-height:180px;max-height:280px;overflow-y:auto;
                        border:1px solid #3a4150;white-space:pre-wrap;line-height:1.6;">
Cliquez sur "Générer l'analyse" pour obtenir une analyse IA de vos événements...
            </div>
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:12px;">
              <button id="btnCopyAnalyse" style="background:linear-gradient(135deg,#374535,#4a5a45);border:none;color:white;font-weight:bold;padding:9px 20px;border-radius:25px;cursor:pointer;font-size:13px;">📋 Copier</button>
              <button id="btnGenerateAnalyse" style="background:linear-gradient(135deg,#9C27B0,#7B1FA2);border:none;color:white;font-weight:bold;padding:9px 20px;border-radius:25px;cursor:pointer;font-size:13px;">✨ Générer l'analyse</button>
            </div>
          </div>

          <div style="text-align:center;margin-top:20px;">
            <button type="button" data-dismiss="modal" style="background:linear-gradient(135deg,#b22222,#8b1a1a);border:none;color:white;font-weight:bold;padding:12px 40px;border-radius:25px;cursor:pointer;font-size:15px;">✖ Fermer</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes analysisPulse {
  0%,100% { transform:scale(1); box-shadow:0 0 10px #9C27B080; }
  50%      { transform:scale(1.06); box-shadow:0 0 25px #9C27B0; }
}
</style>

<!-- Status Management Modal -->
<div class="modal fade" id="statusModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 450px;">
        <div class="modal-content" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #4A90E2, #357ABD); color: white;">
                <h5 class="modal-title">📊 Gérer le statut</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" style="background: #F5F1E6; padding: 25px;">
                <p id="statusEventTitle" style="font-weight: bold; color: #285921; margin-bottom: 20px; text-align: center;"></p>
                
                <div class="status-options">
                    <div class="status-option" data-status="upcoming" onclick="selectStatus('upcoming')">
                        <div style="display: flex; align-items: center; gap: 15px; padding: 12px; border-radius: 10px; cursor: pointer; transition: all 0.3s;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: #4A90E2; display: flex; align-items: center; justify-content: center; font-size: 20px;">📅</div>
                            <div>
                                <div style="font-weight: bold;">À venir</div>
                                <div style="font-size: 11px; color: #8b9a8b;">L'événement est planifié</div>
                            </div>
                        </div>
                    </div>
                    <div class="status-option" data-status="ongoing" onclick="selectStatus('ongoing')">
                        <div style="display: flex; align-items: center; gap: 15px; padding: 12px; border-radius: 10px; cursor: pointer; transition: all 0.3s;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: #4CAF50; display: flex; align-items: center; justify-content: center; font-size: 20px;">🟢</div>
                            <div>
                                <div style="font-weight: bold;">En cours</div>
                                <div style="font-size: 11px; color: #8b9a8b;">L'événement se déroule actuellement</div>
                            </div>
                        </div>
                    </div>
                    <div class="status-option" data-status="completed" onclick="selectStatus('completed')">
                        <div style="display: flex; align-items: center; gap: 15px; padding: 12px; border-radius: 10px; cursor: pointer; transition: all 0.3s;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: #9E9E9E; display: flex; align-items: center; justify-content: center; font-size: 20px;">✅</div>
                            <div>
                                <div style="font-weight: bold;">Terminé</div>
                                <div style="font-size: 11px; color: #8b9a8b;">L'événement est terminé</div>
                            </div>
                        </div>
                    </div>
                    <div class="status-option" data-status="cancelled" onclick="selectStatus('cancelled')">
                        <div style="display: flex; align-items: center; gap: 15px; padding: 12px; border-radius: 10px; cursor: pointer; transition: all 0.3s;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: #f44336; display: flex; align-items: center; justify-content: center; font-size: 20px;">❌</div>
                            <div>
                                <div style="font-weight: bold;">Annulé</div>
                                <div style="font-size: 11px; color: #8b9a8b;">L'événement a été annulé</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div id="statusWarning" style="display: none; margin-top: 15px; padding: 10px; background: #fff3cd; border-radius: 8px; font-size: 12px; color: #856404;">
                    ⚠️ Changer le statut enverra une notification à tous les participants.
                </div>
            </div>
            <div class="modal-footer" style="justify-content: center; gap: 15px; padding: 20px;">
                <button type="button" class="btn" data-dismiss="modal" style="background: #e0e0e0; border-radius: 25px; padding: 10px 30px;">Annuler</button>
                <button type="button" id="confirmStatusBtn" class="btn" style="background: linear-gradient(135deg, #4A90E2, #357ABD); color: white; border-radius: 25px; padding: 10px 30px;">Confirmer</button>
            </div>
        </div>
    </div>
</div>

<style>
.status-option {
    margin-bottom: 8px;
    border: 2px solid transparent;
    border-radius: 10px;
    transition: all 0.3s;
}
.status-option:hover {
    background: rgba(74, 144, 226, 0.1);
    transform: translateX(5px);
}
.status-option.selected {
    border-color: #4A90E2;
    background: rgba(74, 144, 226, 0.15);
}
</style>

<!-- ══════════════════════════════════════════════════════
     MODAL CREER
══════════════════════════════════════════════════════ -->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
    <div class="modal-content" style="border-radius:15px; background:#F5F1E6;">
      <div class="modal-header" style="background:linear-gradient(135deg,#374535,#2a3328); border-radius:15px 15px 0 0;">
        <h5 class="modal-title" style="color:white;">✨ CRÉER UN NOUVEL ÉVÉNEMENT</h5>
        <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body" style="padding:25px;">

        <div id="createFlash"></div>

        <form method="post" action="{{ path('admin_events_create_save') }}"
              enctype="multipart/form-data" id="createForm" novalidate>

          <!-- Titre -->
          <div class="form-group">
            <label class="modal-label">📝 TITRE DE L'ÉVÉNEMENT</label>
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
              <input type="text" name="title" id="c_title" class="modal-input"
                     placeholder="Ex: Atelier de méditation pour débutants" style="flex:1; min-width:180px;" required>
              <button type="button" class="btn-correct-m" id="c_btnCorrectTitle" disabled>🔍 Corriger</button>
              <button type="button" class="btn-ai-m" id="c_btnGenerateAll">✨ Générer planification</button>
              <div class="modal-spinner" id="c_spinnerTitle"></div>
            </div>
            <div class="field-msg" id="c_titleMsg"></div>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label class="modal-label">📄 DESCRIPTION</label>
            <textarea name="description" id="c_description" class="modal-input" rows="3"
                      placeholder="Décrivez votre événement..."></textarea>
            <div style="text-align:right; margin-top:4px;">
              <button type="button" class="btn-correct-m" id="c_btnCorrectDesc" disabled>🔍 Corriger</button>
              <div class="modal-spinner" id="c_spinnerDesc" style="display:inline-block; vertical-align:middle;"></div>
            </div>
          </div>

          <!-- Lieu -->
          <div class="form-group">
            <label class="modal-label">📍 LIEU</label>
            <input type="text" name="location" id="c_location" class="modal-input"
                   placeholder="Ex: Salle de conférence, Paris" required>
            <div class="field-msg" id="c_locationMsg"></div>
          </div>

          <!-- Date + Participants -->
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label class="modal-label">📅 DATE</label>
                <input type="date" name="eventDate" id="c_eventDate" class="modal-input" required>
                <div class="field-msg" id="c_dateMsg"></div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label class="modal-label">👥 PARTICIPANTS MAX</label>
                <input type="number" name="maxParticipants" id="c_maxParticipants" class="modal-input"
                       placeholder="Ex: 50" min="1" required>
                <div class="field-msg" id="c_maxMsg"></div>
              </div>
            </div>
          </div>

          <!-- Image URL -->
          <div class="form-group">
            <label class="modal-label">🖼️ IMAGE URL</label>
            <input type="text" name="link" id="c_link" class="modal-input"
                   placeholder="URL de l'image ou lien de l'événement">
          </div>

          <!-- Upload -->
          <div class="form-group">
            <div class="modal-upload" id="c_uploadArea">
              <label style="cursor:pointer; margin:0;">☁️ Cliquez ici pour uploader une image</label>
              <p style="font-size:11px; color:#8a9a87; margin:4px 0 0;">PNG, JPG, JPEG</p>
              <input type="file" id="c_imageFile" name="imageFile" accept="image/*" style="display:none;">
              <img id="c_imagePreview" style="max-width:180px; max-height:110px; margin-top:8px; border-radius:8px; display:none;">
            </div>
          </div>

          <!-- Planification -->
          <div class="modal-planif-section">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
              <strong style="color:#5c715a;">📋 PLANIFICATION</strong>
              <span id="c_suggestionBadge" style="color:#4CAF50; font-style:italic; font-size:12px; display:none;">✨ Suggestion Gemini</span>
              <div class="modal-spinner" id="c_spinnerPlan"></div>
            </div>
            <div class="form-group">
              <label class="modal-label">Description :</label>
              <input type="text" name="planDescription" id="c_planDescription"
                     class="modal-input {% if createErrors.planDescription is defined %}field-error{% endif %}"
                     placeholder="Ex: Séance de méditation guidée"
                     value="{{ createOld.planDescription ?? '' }}">
              {% if createErrors.planDescription is defined %}
                <div class="field-msg err" style="color:red;font-size:11px;margin-top:3px;">{{ createErrors.planDescription }}</div>
              {% endif %}
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="modal-label">Durée :</label>
              <div style="display:flex; gap:8px; align-items:flex-start; flex-direction:column;">
                <div style="display:flex; gap:8px; align-items:center;">
                  <input type="text" name="planDuree" id="c_planDuree"
                         class="modal-input {% if createErrors.planDuree is defined %}field-error{% endif %}"
                         placeholder="Ex: 2 heures"
                         value="{{ createOld.planDuree ?? '' }}"
                         style="max-width:200px;">
                  <button type="button" class="btn-accept-m" id="c_btnAccept" style="display:none;">✓ Accepter</button>
                  <button type="button" class="btn-reject-m" id="c_btnReject" style="display:none;">✗ Rejeter</button>
                </div>
                {% if createErrors.planDuree is defined %}
                  <div class="field-msg err" style="color:red;font-size:11px;">{{ createErrors.planDuree }}</div>
                {% endif %}
              </div>
            </div>
          </div>

          <div class="modal-footer" style="border:none; padding:20px 0 0; justify-content:center; gap:15px;">
            <button type="submit" class="btn-modal-save">💾 Sauvegarder</button>
            <button type="button" class="btn-modal-cancel" data-dismiss="modal">✖ Annuler</button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     MODAL MODIFIER UN ÉVÉNEMENT
══════════════════════════════════════════════════════ -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
    <div class="modal-content" style="border-radius:15px; background:#F5F1E6;">
      <div class="modal-header" style="background:linear-gradient(135deg,#4CAF50,#45a049); border-radius:15px 15px 0 0;">
        <h5 class="modal-title" style="color:white;">✏️ MODIFIER L'ÉVÉNEMENT</h5>
        <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body" style="padding:25px;">

        <div id="editFlash"></div>
        <div id="editLoadingSpinner" style="text-align:center; padding:30px; display:none;">
          <div class="modal-spinner" style="display:inline-block; width:40px; height:40px;"></div>
          <p style="color:#5c715a; margin-top:10px;">Chargement...</p>
        </div>

        <form method="post" id="editForm" enctype="multipart/form-data">

          <input type="hidden" id="e_eventId" name="_eventId">

          <!-- Titre -->
          <div class="form-group">
            <label class="modal-label">📝 TITRE</label>
            <input type="text" name="title" id="e_title"
                   class="modal-input {% if editErrors.title is defined %}field-error{% endif %}">
            <div class="field-msg {% if editErrors.title is defined %}err{% endif %}" id="e_titleMsg" style="font-size:11px; margin-top:3px;">{{ editErrors.title ?? '' }}</div>
          </div>

          <!-- Lieu -->
          <div class="form-group">
            <label class="modal-label">📍 LIEU</label>
            <input type="text" name="location" id="e_location"
                   class="modal-input {% if editErrors.location is defined %}field-error{% endif %}">
            <div class="field-msg {% if editErrors.location is defined %}err{% endif %}" id="e_locationMsg" style="font-size:11px; margin-top:3px;">{{ editErrors.location ?? '' }}</div>
          </div>

          <!-- Date + Participants -->
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label class="modal-label">📅 DATE</label>
                <input type="date" name="eventDate" id="e_eventDate"
                       class="modal-input {% if editErrors.eventDate is defined %}field-error{% endif %}">
                <div class="field-msg {% if editErrors.eventDate is defined %}err{% endif %}" id="e_dateMsg" style="font-size:11px; margin-top:3px;">{{ editErrors.eventDate ?? '' }}</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label class="modal-label">👥 PARTICIPANTS MAX</label>
                <input type="text" name="maxParticipants" id="e_maxParticipants"
                       class="modal-input {% if editErrors.maxParticipants is defined %}field-error{% endif %}">
                <div class="field-msg {% if editErrors.maxParticipants is defined %}err{% endif %}" id="e_maxMsg" style="font-size:11px; margin-top:3px;">{{ editErrors.maxParticipants ?? '' }}</div>
              </div>
            </div>
          </div>

          <!-- Image URL -->
          <div class="form-group">
            <label class="modal-label">🖼️ URL IMAGE / LIEN</label>
            <input type="text" name="link" id="e_link" class="modal-input">
          </div>

          <!-- Upload -->
          <div class="form-group">
            <div class="modal-upload" id="e_uploadArea">
              <label style="cursor:pointer; margin:0;">☁️ Cliquez ici pour changer l'image</label>
              <input type="file" id="e_imageFile" name="imageFile" accept="image/*" style="display:none;">
              <img id="e_imagePreview" style="max-width:180px; max-height:110px; margin-top:8px; border-radius:8px; display:none;">
            </div>
          </div>

          <!-- Planification -->
          <div class="modal-planif-section">
            <strong style="color:#5c715a; display:block; margin-bottom:12px;">📋 PLANIFICATION</strong>
            <div class="form-group">
              <label class="modal-label">Description :</label>
              <input type="text" name="planDescription" id="e_planDescription"
                     class="modal-input {% if editErrors.planDescription is defined %}field-error{% endif %}"
                     placeholder="Description de la planification">
              <div class="field-msg {% if editErrors.planDescription is defined %}err{% endif %}" id="e_planDescMsg" style="font-size:11px; margin-top:3px;">{{ editErrors.planDescription ?? '' }}</div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="modal-label">Durée :</label>
              <input type="text" name="planDuree" id="e_planDuree"
                     class="modal-input {% if editErrors.planDuree is defined %}field-error{% endif %}"
                     placeholder="Ex: 2 heures" style="max-width:250px;">
              <div class="field-msg {% if editErrors.planDuree is defined %}err{% endif %}" id="e_planDureeMsg" style="font-size:11px; margin-top:3px;">{{ editErrors.planDuree ?? '' }}</div>
            </div>
          </div>

          <div class="modal-footer" style="border:none; padding:20px 0 0; justify-content:center; gap:15px;">
            <button type="submit" class="btn-modal-update">💾 Mettre à jour</button>
            <button type="button" class="btn-modal-cancel" data-dismiss="modal">✖ Annuler</button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     MODAL SUPPRIMER
══════════════════════════════════════════════════════ -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content" style="border-radius:15px; border:none; overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#b22222,#8b1a1a); border:none; padding:20px 25px;">
                <h5 class="modal-title" style="color:white; font-weight:bold; font-size:18px;">🗑️ Supprimer l'événement</h5>
                <button type="button" class="close text-white" data-dismiss="modal" style="opacity:1;">&times;</button>
            </div>
            <div class="modal-body" style="background:#F5F1E6; padding:25px; text-align:center;">
                <div style="font-size:48px; margin-bottom:15px;">⚠️</div>
                <p style="font-size:15px; color:#374535; margin-bottom:5px;">Voulez-vous supprimer l'événement :</p>
                <p id="deleteEventTitle" style="font-size:17px; font-weight:bold; color:#b22222; margin-bottom:5px;"></p>
                <p style="font-size:12px; color:#888; margin:0;">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer" style="background:#F5F1E6; border:none; justify-content:center; gap:15px; padding:15px 25px 25px;">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"
                        style="border-radius:25px; padding:10px 30px; font-weight:bold;">
                    Annuler
                </button>
                <button type="button" id="confirmDeleteBtn"
                        style="background:linear-gradient(135deg,#b22222,#8b1a1a); border:none; color:white;
                               font-weight:bold; border-radius:25px; padding:10px 30px; cursor:pointer;">
                    🗑️ Supprimer
                </button>
            </div>
