    this.disabled = true;
    const sp = document.getElementById('c_spinnerDesc'); sp.style.display = 'inline-block';
    try {
        const corrected = (await callGemini(`Corrige les fautes dans cette phrase française: "${desc}". Réponds UNIQUEMENT avec la phrase corrigée.`)).replace(/^["']|["']$/g,'').trim();
        if (corrected && corrected.toLowerCase() !== desc.toLowerCase()) {
