{% extends 'back/base.html.twig' %}

{% block title %}Gestion des Commentaires - Contenu psychologique{% endblock %}

{% block body %}
<div class="full_container">
    <div class="inner_container">

        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar_blog_1">
                <div class="sidebar-header">
                    <div class="logo_section">
                        <a href="#">
                            <img class="logo_icon img-responsive"
                                 src="{{ asset('back/images/logo/logo_icon1.png') }}"
                                 alt="logo" />
                        </a>
                    </div>
                </div>
                <div class="sidebar_user_info">
                    <div class="icon_setting"></div>
                    <div class="user_profle_side">
                        <div class="user_img">
                            <img class="img-responsive"
                                 src="{{ asset('back/images/layout_img/user_img.jpg') }}"
                                 alt="user" />
                        </div>
                        <div class="user_info">
                            <h6>Amri Sirine</h6>
                            <p><span class="online_animation"></span> En ligne</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sidebar_blog_2">
                <ul class="list-unstyled components">
                    <li><a href="{{ path('admin_dashboard') }}"><i class="fa fa-dashboard yellow_color"></i><span>Tableau de bord</span></a></li>
                    <li><a href="#"><i class="fa fa-users blue1_color"></i><span>Utilisateurs</span></a></li>
                    <li><a href="#"><i class="fa fa-calendar orange_color"></i><span>Rendez-vous</span></a></li>
                    <li class="active"><a href="{{ path('admin_contenu_psy') }}"><i class="fa fa-book purple_color2"></i><span>Contenu psychologique</span></a></li>
                    <li><a href="#"><i class="fa fa-check-square green_color"></i><span>Tests</span></a></li>
                    <li><a href="#"><i class="fa fa-calendar-check-o red_color"></i><span>Événements</span></a></li>
                    <li><a href="#"><i class="fa fa-line-chart yellow_color"></i><span>Suivi personnel</span></a></li>
                </ul>
            </div>
        </nav>

        <!-- Content -->
        <div id="content">

            <!-- Topbar -->
            <div class="topbar">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <div class="full">
                        <button type="button" id="sidebarCollapse" class="sidebar_toggle"><i class="fa fa-bars"></i></button>
                        <div class="logo_section">
                            <a href="#" style="display:flex;align-items:center;text-decoration:none;">
                                <img class="img-responsive" src="{{ asset('back/images/logo/logo1.png') }}" alt="logo" style="width:40px;height:40px;margin-right:10px;" />
                                <span style="font-size:20px;font-weight:bold;color:#3c943c;">Nafseyti</span>
                            </a>
                        </div>
                        <div class="right_topbar">
                            <div class="icon_info">
                                <ul>
                                    <li><a href="#"><i class="fa fa-bell-o"></i><span class="badge">2</span></a></li>
                                    <li><a href="#"><i class="fa fa-question-circle"></i></a></li>
                                    <li><a href="#"><i class="fa fa-envelope-o"></i><span class="badge">3</span></a></li>
                                </ul>
                                <ul class="user_profile_dd">
                                    <li>
                                        <a class="dropdown-toggle" data-toggle="dropdown">
                                            <img class="img-responsive rounded-circle" src="{{ asset('back/images/layout_img/user_img.jpg') }}" alt="user" />
                                            <span class="name_user">Amri Sirine</span>
                                        </a>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="#">Mon profil</a>
                                            <a class="dropdown-item" href="#">Paramètres</a>
                                            <a class="dropdown-item" href="#">Aide</a>
                                            <a class="dropdown-item" href="#"><span>Déconnexion</span> <i class="fa fa-sign-out"></i></a>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>

            <!-- Main Content -->
            <div class="midde_cont">
                <div class="container-fluid">

                    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

                    <style>
                        .comments-wrap { font-family: 'DM Sans', sans-serif; padding: 10px 0 40px; }

                        .comments-hero {
                            background: linear-gradient(135deg, #4facfe, #00f2fe);
                            border-radius: 24px;
                            padding: 44px 48px;
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            margin-bottom: 28px;
                            overflow: hidden;
                            position: relative;
                        }
                        .comments-hero::before {
                            content: '';
                            position: absolute;
                            width: 320px; height: 320px;
                            border-radius: 50%;
                            background: rgba(255,255,255,0.1);
                            right: -60px; top: -80px;
                        }
                        .comments-hero::after {
                            content: '';
                            position: absolute;
                            width: 200px; height: 200px;
                            border-radius: 50%;
                            background: rgba(255,255,255,0.05);
                            right: 120px; bottom: -80px;
                        }
                        .hero-left { flex: 1; z-index: 1; }
                        .hero-eyebrow {
                            font-size: 11px;
                            letter-spacing: 2px;
                            text-transform: uppercase;
                            color: rgba(255,255,255,0.7);
                            margin-bottom: 10px;
                        }
                        .hero-title {
                            font-family: 'DM Serif Display', serif;
                            font-size: 42px;
                            color: white;
                            line-height: 1.1;
                            margin-bottom: 14px;
                        }
                        .hero-title em { color: #c8ffff; font-style: italic; }
                        .hero-sub {
                            font-size: 14px;
                            color: rgba(255,255,255,0.7);
                            max-width: 340px;
                            line-height: 1.6;
                        }

                        .stats-container {
                            display: flex;
                            gap: 20px;
                            margin-bottom: 28px;
                        }
                        .stat-card {
                            background: white;
                            border-radius: 20px;
                            padding: 20px;
                            flex: 1;
                            text-align: center;
                            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
                        }
                        .stat-number {
                            font-family: 'DM Serif Display', serif;
                            font-size: 48px;
                            color: #4facfe;
                            margin-bottom: 5px;
                        }
                        .stat-label {
                            font-size: 14px;
                            color: #666;
                        }

                        .table-container {
                            background: white;
                            border-radius: 24px;
                            padding: 25px;
                            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                        }
                        .comments-table {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .comments-table th {
                            text-align: left;
                            padding: 15px 10px;
                            background: #e8f4fe;
                            color: #1a6fa8;
                            font-weight: 600;
                            border-bottom: 2px solid #cce8ff;
                        }
                        .comments-table td {
                            padding: 15px 10px;
                            border-bottom: 1px solid #eee;
                            color: #444;
                        }
                        .comments-table tr:hover { background: #f0f8ff; }

                        .action-btn {
                            padding: 8px 12px;
                            border-radius: 20px;
                            font-size: 14px;
                            margin: 0 3px;
                            border: none;
                            cursor: pointer;
                            transition: 0.2s;
                            background: transparent;
                        }
                        .view-btn { background: #4facfe; color: white; }
                        .delete-btn { background: #f5576c; color: white; }
                        .action-btn:hover { opacity: 0.8; transform: scale(1.05); }

                        .modal-custom {
                            display: none;
                            position: fixed;
                            top: 0;
                            left: 0;
                            width: 100%;
                            height: 100%;
                            background: rgba(0,0,0,0.5);
                            z-index: 1000;
                            justify-content: center;
                            align-items: center;
                        }
                        .modal-content-custom {
                            background: white;
                            border-radius: 24px;
                            padding: 30px;
                            max-width: 600px;
                            width: 90%;
                            max-height: 80vh;
                            overflow-y: auto;
                        }
                        .form-group { margin-bottom: 20px; }
                        .form-group label { display: block; margin-bottom: 8px; font-weight: 500; color: #333; }
                        .modal-buttons { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
                        .btn-cancel { background: #ccc; color: #333; padding: 10px 20px; border: none; border-radius: 12px; cursor: pointer; }
                        .btn-save { background: #f5576c; color: white; padding: 10px 20px; border: none; border-radius: 12px; cursor: pointer; }
                        .btn-link { color: #4facfe; text-decoration: none; }
                        .btn-link:hover { text-decoration: underline; }
                        .text-muted { color: #999; }
                    </style>

                    <div class="comments-wrap">

                        <!-- Hero -->
                        <div class="comments-hero">
                            <div class="hero-left">
                                <div class="hero-eyebrow">Nafseyti · Gestion</div>
                                <div class="hero-title">Gestion des<br><em>Commentaires</em></div>
                                <div class="hero-sub">Modérez et gérez tous les commentaires des utilisateurs.</div>
                            </div>
                        </div>

                        <!-- Statistiques -->
                        <div class="stats-container">
                            <div class="stat-card">
                                <div class="stat-number">{{ commentaires|length }}</div>
                                <div class="stat-label">Total commentaires</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-number">
                                    {% set postsUniq = [] %}
                                    {% for commentaire in commentaires %}
                                        {% if commentaire.id_post not in postsUniq %}
                                            {% set postsUniq = postsUniq|merge([commentaire.id_post]) %}
                                        {% endif %}
                                    {% endfor %}
                                    {{ postsUniq|length }}
                                </div>
                                <div class="stat-label">Posts commentés</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-number">
                                    {% if commentaires|length > 0 and postsUniq|length > 0 %}
                                        {{ (commentaires|length / postsUniq|length)|round }}
                                    {% else %}
                                        0
                                    {% endif %}
                                </div>
                                <div class="stat-label">Moyenne/post</div>
                            </div>
                        </div>

                        <!-- Messages flash -->
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success" style="background:#e8f5e8;color:#2a6a10;padding:12px 20px;border-radius:12px;margin-bottom:20px;">
                                <i class="fa fa-check-circle"></i> {{ message }}
                            </div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger" style="background:#ffe8e8;color:#c05050;padding:12px 20px;border-radius:12px;margin-bottom:20px;">
                                <i class="fa fa-exclamation-circle"></i> {{ message }}
                            </div>
                        {% endfor %}

                        <!-- Tableau des commentaires -->
                        <div class="table-container">
                            <table class="comments-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Contenu</th>
                                        <th>Post associé (ID)</th>
                                        <th>Date création</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for commentaire in commentaires %}
                                    <tr>
                                        <td>{{ commentaire.id_commentaire }}</td>
                                        <td>
                                            <div style="max-width: 400px;">
                                                {% if commentaire.contenu|length > 100 %}
                                                    <span id="shortText{{ commentaire.id_commentaire }}">{{ commentaire.contenu|slice(0, 100) }}...</span>
                                                    <span id="fullText{{ commentaire.id_commentaire }}" style="display:none;">{{ commentaire.contenu }}</span>
                                                    <button type="button" class="btn-link" onclick="toggleText({{ commentaire.id_commentaire }})" style="color:#4facfe; padding:0; margin-top:5px; border:none; background:none; cursor:pointer;">
                                                        <i class="fa fa-eye"></i> Voir plus
                                                    </button>
                                                {% else %}
                                                    {{ commentaire.contenu }}
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td>
                                            {% if commentaire.id_post %}
                                                <strong>Post ID: {{ commentaire.id_post }}</strong>
                                            {% else %}
                                                <span class="text-muted">Post supprimé</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {{ commentaire.date_commentaire ? commentaire.date_commentaire|date('d/m/Y H:i') : '-' }}
                                        </td>
                                        <td>
                                            <button type="button" class="action-btn view-btn" onclick='openViewModal({{ commentaire.id_commentaire }}, "{{ commentaire.contenu|escape('js') }}", "{{ commentaire.id_post }}", "{{ commentaire.date_commentaire ? commentaire.date_commentaire|date('d/m/Y H:i:s') : '-' }}")' title="Voir">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                            <form method="POST" action="{{ path('admin_commentaire_delete', {'id': commentaire.id_commentaire}) }}" style="display:inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ commentaire.id_commentaire) }}">
                                                <button type="submit" class="action-btn delete-btn" title="Supprimer">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr>
                                        <td colspan="5" style="text-align:center; padding:40px;">
                                            <i class="fa fa-comments" style="font-size:48px; color:#ddd;"></i>
                                            <p style="margin-top:10px;">Aucun commentaire trouvé</p>
                                            <p class="text-muted">Les commentaires des utilisateurs apparaîtront ici.</p>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                    </div><!-- /comments-wrap -->

                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL VISUALISATION -->
<div id="viewModal" class="modal-custom">
    <div class="modal-content-custom" style="max-width: 700px;">
        <h3 style="margin-bottom:20px;"><i class="fa fa-eye" style="color:#4facfe;"></i> Détails du commentaire</h3>
        <div class="form-group">
            <label>ID Commentaire</label>
            <p id="view_id" style="padding:10px; background:#f5f5f5; border-radius:8px;"></p>
        </div>
        <div class="form-group">
            <label>Post associé (ID)</label>
            <p id="view_post" style="padding:10px; background:#f5f5f5; border-radius:8px;"></p>
        </div>
        <div class="form-group">
            <label>Date création</label>
            <p id="view_date" style="padding:10px; background:#f5f5f5; border-radius:8px;"></p>
        </div>
        <div class="form-group">
            <label>Contenu</label>
            <div id="view_contenu" style="padding:15px; background:#f9f5ef; border-radius:12px; max-height:300px; overflow-y:auto;"></div>
        </div>
        <div class="modal-buttons">
            <button type="button" class="btn-cancel" onclick="closeViewModal()">Fermer</button>
        </div>
    </div>
</div>

<script>
    // MODAL VISUALISATION
    function openViewModal(id, contenu, id_post, date) {
        document.getElementById('view_id').innerHTML = id;
        document.getElementById('view_contenu').innerHTML = contenu.replace(/\n/g, '<br>');
        document.getElementById('view_post').innerHTML = id_post ? 'Post ID: ' + id_post : 'Post supprimé';
        document.getElementById('view_date').innerHTML = date;
        document.getElementById('viewModal').style.display = 'flex';
    }
    
    function closeViewModal() { 
        document.getElementById('viewModal').style.display = 'none'; 
    }
    
    // Fonction pour voir plus/moins
    function toggleText(id) {
        var shortText = document.getElementById('shortText' + id);
        var fullText = document.getElementById('fullText' + id);
        var btn = event.target;
        
        if (shortText.style.display === 'none') {
            shortText.style.display = 'inline';
            fullText.style.display = 'none';
            btn.innerHTML = '<i class="fa fa-eye"></i> Voir plus';
        } else {
            shortText.style.display = 'none';
            fullText.style.display = 'inline';
            btn.innerHTML = '<i class="fa fa-eye-slash"></i> Voir moins';
        }
    }
    
    // Fermer les modals en cliquant en dehors
    window.onclick = function(event) {
        if (event.target.classList.contains('modal-custom')) {
            event.target.style.display = 'none';
        }
    }
    
    // Initialisation
    document.addEventListener('DOMContentLoaded', function() {
        console.log('DOM chargé - Gestion des commentaires');
    });
</script>

{% endblock %}