function marquerLue(id, el) {
  fetch('/psy/notification/' + id + '/lue', {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  })
  .then(r => r.json())
  .then(data => { if (data.success) { el.classList.remove('unread'); _decrementerBadge(); } });
