</section>

{# ════ SIDE PANEL ════ #}
<div class="panel-backdrop" id="panelBackdrop" onclick="closePanel()"></div>

<div class="side-panel" id="sidePanel">
  <div class="sp-header">
    <button class="sp-close" onclick="closePanel()"><i class="fas fa-times"></i></button>
    <div class="sp-pro-row">
      <img src="" alt="" class="sp-avatar" id="spAvatar">
      <div>
        <div class="sp-pro-name" id="spName">—</div>
        <div class="sp-pro-role" id="spRole">—</div>
        <div class="sp-pro-meta" id="spMeta"></div>
      </div>
    </div>
    <div class="sp-tabs">
      <button class="sp-tab active" onclick="switchTab('slots')">
        <i class="fas fa-calendar-check" style="margin-right:5px;"></i>Créneaux
      </button>
      <button class="sp-tab" onclick="switchTab('book')">
        <i class="fas fa-pen-to-square" style="margin-right:5px;"></i>Réserver
      </button>
    </div>
  </div>

  <div class="sp-body">
    <div class="sp-pane active" id="pane-slots">
      <div class="sp-section-label">Sélectionnez un créneau disponible</div>
      <div class="slots-grid" id="slotsGrid"></div>
      <div class="sp-no-slots" id="noSlots" style="display:none;">
