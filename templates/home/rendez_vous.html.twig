let currentTrackIndex = 0;
let isPlaying = false;
let audio = null;
let visualizerInterval = null;
let currentFilter = "all";
let currentSearchTerm = "";

// Fonction pour filtrer la playlist
function getFilteredPlaylist() {
  let filtered = PLAYLIST;
  
  // Filtre par catégorie
  if (currentFilter !== "all") {
    filtered = filtered.filter(track => track.category === currentFilter);
  }
  
  // Filtre par recherche
  if (currentSearchTerm.trim() !== "") {
    const term = currentSearchTerm.toLowerCase();
    filtered = filtered.filter(track => 
      track.title.toLowerCase().includes(term) ||
      track.artist.toLowerCase().includes(term) ||
      track.tags.some(tag => tag.toLowerCase().includes(term))
    );
  }
  
  return filtered;
}

// Mettre à jour le compteur
function updateResultsCount() {
  const count = getFilteredPlaylist().length;
  document.getElementById('musicResultsCount').textContent = `${count} titre${count > 1 ? 's' : ''}`;
}

// Initialisation du lecteur
function initMusicPlayer() {
  createVisualizer();
  setupAudio();
  setupVolumeControl();
  setupSearchAndFilters();
  updatePlaylist();
  loadTrack(0);
}



function setupSearchAndFilters() {
  // Recherche
  const searchInput = document.getElementById('musicSearchInput');
  searchInput.addEventListener('input', (e) => {
    currentSearchTerm = e.target.value;
    updateResultsCount();
    updatePlaylist();
    
    // Vérifier si le morceau actuel est toujours dans les résultats
    const filtered = getFilteredPlaylist();
    const currentStillExists = filtered.some(track => 
      track.title === PLAYLIST[currentTrackIndex].title
    );
    
    if (!currentStillExists && filtered.length > 0) {
      // Trouver le premier morceau correspondant
      const newIndex = PLAYLIST.findIndex(t => t.title === filtered[0].title);
      if (newIndex !== -1) {
        selectTrack(newIndex);
      }
    }
  });
  
  // Catégories
  document.querySelectorAll('.music-cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.music-cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.cat;
      updateResultsCount();
      updatePlaylist();
      
      // Vérifier si le morceau actuel est toujours dans les résultats
      const filtered = getFilteredPlaylist();
      const currentStillExists = filtered.some(track => 
        track.title === PLAYLIST[currentTrackIndex].title
      );
      
      if (!currentStillExists && filtered.length > 0) {
        const newIndex = PLAYLIST.findIndex(t => t.title === filtered[0].title);
        if (newIndex !== -1) {
          selectTrack(newIndex);
        }
      }
    });
  });
}

function createVisualizer() {
  const container = document.getElementById('musicVisualizer');
  container.innerHTML = '';
  for (let i = 0; i < 40; i++) {
    const bar = document.createElement('div');
    bar.className = 'vis-bar';
    bar.style.height = '3px';
    container.appendChild(bar);
  }
}

function updatePlaylist() {
  const container = document.getElementById('playlistContainer');
  const filtered = getFilteredPlaylist();
  
  if (filtered.length === 0) {
    container.innerHTML = `
      <div style="padding: 20px; text-align: center; color: rgba(255,255,255,0.5);">
        <i class="fas fa-search"></i> Aucun résultat pour "${currentSearchTerm}"
      </div>
    `;
    return;
  }
  
  container.innerHTML = filtered.map((track, idx) => {
    const originalIndex = PLAYLIST.findIndex(t => t.title === track.title);
    const isActive = originalIndex === currentTrackIndex;
    const categoryIcon = {
      meditation: "🧘",
      nature: "🌿",
      piano: "🎹",
      ambient: "🌊",
      sleep: "😴"
    }[track.category] || "🎵";
    
    return `
      <div class="playlist-item ${isActive ? 'active' : ''}" onclick="selectTrack(${originalIndex})">
        <div class="playlist-icon">${categoryIcon}</div>
        <div class="playlist-info">
          <div class="playlist-title">${track.title}</div>
          <div class="playlist-artist">${track.artist}</div>
        </div>
        <div class="playlist-duration">${track.duration}</div>
      </div>
    `;
  }).join('');
}

function setupAudio() {
  audio = new Audio();
  audio.src = PLAYLIST[currentTrackIndex].url;
  audio.volume = 0.5;
  
  audio.addEventListener('timeupdate', updateVisualizer);
  audio.addEventListener('ended', () => {
    nextTrack();
  });
  audio.addEventListener('play', () => {
    isPlaying = true;
    updatePlayPauseButton();
    startVisualizerAnimation();
  });
  audio.addEventListener('pause', () => {
    isPlaying = false;
    updatePlayPauseButton();
    stopVisualizerAnimation();
  });
}

function setupVolumeControl() {
  const volumeSlider = document.getElementById('volumeSlider');
  volumeSlider.addEventListener('input', (e) => {
    if (audio) {
      audio.volume = parseFloat(e.target.value);
    }
  });
}

function loadTrack(index) {
  currentTrackIndex = index;
  const track = PLAYLIST[currentTrackIndex];
  
  document.getElementById('currentTrackTitle').textContent = track.title;
  document.getElementById('currentTrackArtist').textContent = track.artist;
  
  if (audio) {
    const wasPlaying = isPlaying;
    audio.pause();
    audio.src = track.url;
    if (wasPlaying) {
      audio.play().catch(e => console.log('Auto-play bloqué par navigateur'));
    }
  }
  
  updatePlaylist();
}

function togglePlay() {
  if (!audio) return;
  
  if (isPlaying) {
    audio.pause();
  } else {
    audio.play().catch(e => {
      console.log('Lecture automatique bloquée');
    });
  }
}

function nextTrack() {
  const filtered = getFilteredPlaylist();
  if (filtered.length === 0) return;
  
  const currentFilteredIndex = filtered.findIndex(t => t.title === PLAYLIST[currentTrackIndex].title);
  const nextFilteredIndex = (currentFilteredIndex + 1) % filtered.length;
  const nextOriginalIndex = PLAYLIST.findIndex(t => t.title === filtered[nextFilteredIndex].title);
  
  selectTrack(nextOriginalIndex);
}

function prevTrack() {
  const filtered = getFilteredPlaylist();
  if (filtered.length === 0) return;
  
  const currentFilteredIndex = filtered.findIndex(t => t.title === PLAYLIST[currentTrackIndex].title);
  const prevFilteredIndex = (currentFilteredIndex - 1 + filtered.length) % filtered.length;
  const prevOriginalIndex = PLAYLIST.findIndex(t => t.title === filtered[prevFilteredIndex].title);
  
  selectTrack(prevOriginalIndex);
}

function selectTrack(index) {
  currentTrackIndex = index;
  loadTrack(currentTrackIndex);
  if (isPlaying) audio.play();
}

function updatePlayPauseButton() {
  const btn = document.getElementById('playPauseBtn');
  if (btn) {
    btn.innerHTML = isPlaying ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play"></i>';
  }
}

function updateVisualizer() {
  if (!audio || !audio.currentTime) return;
  
  const time = audio.currentTime;
  const bars = document.querySelectorAll('.vis-bar');
  
  bars.forEach((bar, i) => {
    const frequency = Math.sin(time * 5 + i * 0.3) * 0.5 + 0.5;
    const intensity = isPlaying ? 8 + frequency * 20 : 3;
    bar.style.height = `${intensity}px`;
    
    if (isPlaying) {
      bar.classList.add('playing');
    } else {
      bar.classList.remove('playing');
    }
  });
}

function startVisualizerAnimation() {
  if (visualizerInterval) clearInterval(visualizerInterval);
  visualizerInterval = setInterval(() => {
    if (isPlaying && audio) {
      updateVisualizer();
    }
  }, 50);
}

function stopVisualizerAnimation() {
  if (visualizerInterval) {
    clearInterval(visualizerInterval);
    visualizerInterval = null;
  }
  
  const bars = document.querySelectorAll('.vis-bar');
  bars.forEach(bar => {
    bar.style.height = '3px';
    bar.classList.remove('playing');
  });
}

function togglePlaylist() {
  const playlist = document.getElementById('playlistContainer');
  const btn = document.getElementById('togglePlaylistBtn');
  
  playlist.classList.toggle('open');
  btn.classList.toggle('rotated');
}

// Lier la musique à l'humeur sélectionnée
function playMusicForMood(humeur) {
  const moodCategoryMap = {
    'anxieux': 'meditation',
    'triste': 'piano',
    'stresse': 'nature',
    'fatigue': 'sleep',
    'bien': 'ambient'
  };
  
  const targetCategory = moodCategoryMap[humeur];
  if (targetCategory) {
    // Changer le filtre actif
    document.querySelectorAll('.music-cat-btn').forEach(btn => {
      if (btn.dataset.cat === targetCategory) {
        btn.click();
      }
    });
  }
  
  if (!isPlaying) {
    togglePlay();
  }
}

// Initialiser au chargement
document.addEventListener('DOMContentLoaded', () => {
  initMusicPlayer();
});

/* ══════════════════════════════════════════
   CARTE — LEAFLET + GEOAPIFY (CLÉ API GRATUITE)
══════════════════════════════════════════ */

const GEOAPIFY_KEY = '598a68002dde4d0f8efb17679aa53ea7'; // ← collez votre clé ici

let leafletMap    = null;
let leafletMarkers = [];

function initLeafletMap() {
  if (leafletMap) return;

  leafletMap = L.map('leafletMap').setView([36.8065, 10.1815], 11);

  // Tuiles Geoapify — avec votre clé API
  L.tileLayer(
    `https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=${GEOAPIFY_KEY}`,
    {
      attribution: '© <a href="https://www.geoapify.com/">Geoapify</a> | © OpenStreetMap',
      maxZoom: 20
    }
  ).addTo(leafletMap);
}

function makeProIcon(color) {
  return L.divIcon({
    className: '',
    html: `
      <div style="
        width: 36px; height: 36px;
        border-radius: 50% 50% 50% 0;
        background: ${color};
        border: 3px solid white;
        box-shadow: 0 4px 12px rgba(0,0,0,.3);
        transform: rotate(-45deg);
      "></div>`,
    iconSize: [36, 36],
    iconAnchor: [18, 36],
    popupAnchor: [0, -36]
  });
}

function makeUserIcon() {
  return L.divIcon({
    className: '',
    html: `
      <div style="
        width: 18px; height: 18px;
        border-radius: 50%;
        background: #4a331e;
        border: 3px solid white;
        box-shadow: 0 0 0 6px rgba(74,51,30,.2);
      "></div>`,
    iconSize: [18, 18],
    iconAnchor: [9, 9]
  });
}

async function rechercherProximite() {
  const address = document.getElementById('mapsAddressInput').value.trim();
  if (!address) {
    document.getElementById('mapsStatus').textContent = '⚠ Entrez une adresse ou une ville.';
    return;
  }

  document.getElementById('mapsStatus').textContent = '🔍 Recherche en cours…';

  try {
    // Geocoding via Geoapify API
    const url = `https://api.geoapify.com/v1/geocode/search?text=${encodeURIComponent(address)}&lang=fr&limit=1&apiKey=${GEOAPIFY_KEY}`;
    const res  = await fetch(url);
    const data = await res.json();

    if (!data.features || data.features.length === 0) {
      document.getElementById('mapsStatus').textContent = '❌ Adresse introuvable. Essayez avec une ville.';
      return;
    }

    const [lng, lat] = data.features[0].geometry.coordinates;
    const label      = data.features[0].properties.formatted || address;
    document.getElementById('mapsStatus').textContent = '✅ ' + label.split(',').slice(0, 2).join(',');

    await loadProsProches(lat, lng);

  } catch (e) {
    document.getElementById('mapsStatus').textContent = '❌ Erreur réseau. Réessayez.';
    console.error(e);
  }
}

function geolocateMe() {
  if (!navigator.geolocation) {
    alert('Géolocalisation non supportée par votre navigateur.');
    return;
  }

  document.getElementById('mapsStatus').textContent = '📡 Localisation en cours…';

  navigator.geolocation.getCurrentPosition(
    async pos => {
      document.getElementById('mapsAddressInput').value = 'Ma position actuelle';
      document.getElementById('mapsStatus').textContent = '✅ Position trouvée';
      await loadProsProches(pos.coords.latitude, pos.coords.longitude);
    },
    () => {
      document.getElementById('mapsStatus').textContent = '❌ Localisation refusée. Entrez votre adresse manuellement.';
    }
  );
}

async function loadProsProches(lat, lng) {
  document.getElementById('mapsContainer').style.display = 'block';
  document.getElementById('mapsResults').innerHTML =
    '<p style="color:var(--slate);font-size:.85rem;padding:10px 0;">⏳ Chargement des professionnels…</p>';

  initLeafletMap();
  leafletMap.setView([lat, lng], 12);
  setTimeout(() => leafletMap.invalidateSize(), 150);

  // Supprimer anciens marqueurs
  leafletMarkers.forEach(m => leafletMap.removeLayer(m));
  leafletMarkers = [];

  // Marqueur utilisateur
  const userMarker = L.marker([lat, lng], { icon: makeUserIcon() })
    .addTo(leafletMap)
    .bindPopup('<strong>📍 Vous êtes ici</strong>');
  leafletMarkers.push(userMarker);

  // Cercle rayon
  const rayon = parseInt(document.getElementById('mapsRayon').value);
  const circle = L.circle([lat, lng], {
    radius:      rayon * 1000,
    color:       '#4a331e',
    fillColor:   '#4a331e',
    fillOpacity: 0.05,
    weight:      1.5,
    dashArray:   '6 4'
  }).addTo(leafletMap);
  leafletMarkers.push(circle);

  try {
    const res   = await fetch(`/rendez-vous/pros-proches?lat=${lat}&lng=${lng}&rayon=${rayon}`);
const json  = await res.json();

if (!json.success) {
    document.getElementById('mapsResults').innerHTML =
        `<p style="color:#DC2626;font-size:.85rem;">❌ ${json.error || 'Erreur serveur.'}</p>`;
    return;
}

const pros = json.data || [];

    // Marqueurs professionnels
    pros.forEach(pro => {
      const color  = pro.role.includes('Coach') ? '#6D8B74' : '#4a331e';
      const marker = L.marker([pro.lat, pro.lng], { icon: makeProIcon(color) })
        .addTo(leafletMap);

      marker.bindPopup(`
        <div style="font-family:'Instrument Sans',sans-serif;min-width:190px;padding:4px;">
          <div style="font-family:'Syne',sans-serif;font-weight:700;font-size:.92rem;color:#4a331e;margin-bottom:4px;">
            ${pro.name}
          </div>
          <div style="font-size:.75rem;color:#6B705C;margin-bottom:3px;">
            ${pro.role}
          </div>
          <div style="font-size:.72rem;color:#A5A58D;margin-bottom:6px;">
            📍 ${pro.distance} km · ${pro.location || ''}
          </div>
          <button onclick="openPanel(${pro.id})"
            style="width:100%;padding:8px;background:#4a331e;color:white;
            border:none;border-radius:6px;font-size:.75rem;
            cursor:pointer;font-weight:600;letter-spacing:.03em;">
            📅 Voir les créneaux
          </button>
        </div>
      `);

      marker.on('mouseover', () => marker.openPopup());
      leafletMarkers.push(marker);
    });

    // Résultats sous la carte
    if (pros.length === 0) {
      document.getElementById('mapsResults').innerHTML = `
        <p style="color:var(--slate);font-size:.9rem;">
          Aucun professionnel trouvé dans un rayon de <strong>${rayon} km</strong>.
          Essayez d'augmenter le rayon.
        </p>`;
    } else {
      const cards = pros.map(p => `
        <div onclick="openPanel(${p.id})"
          style="display:inline-flex;align-items:center;gap:10px;
          background:white;border:1.5px solid var(--border);
          border-radius:12px;padding:10px 16px;
          margin:6px 6px 0 0;cursor:pointer;
          transition:all .2s;vertical-align:top;"
          onmouseover="this.style.borderColor='#4a331e';this.style.transform='translateY(-2px)';this.style.boxShadow='0 4px 14px rgba(74,51,30,.12)'"
          onmouseout="this.style.borderColor='var(--border)';this.style.transform='none';this.style.boxShadow='none'">
          <img src="${p.avatar}"
            style="width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid var(--border);">
          <div>
            <div style="font-family:'Syne',sans-serif;font-weight:700;font-size:.85rem;color:#4a331e;">
              ${p.name}
            </div>
            <div style="font-size:.72rem;color:#6B705C;">${p.role}</div>
            <div style="font-size:.7rem;color:#A5A58D;margin-top:2px;">📍 ${p.distance} km</div>
          </div>
        </div>`).join('');

      document.getElementById('mapsResults').innerHTML = `
        <p style="margin:0 0 10px;font-size:.8rem;color:var(--slate);font-family:'Instrument Sans',sans-serif;">
          <strong style="color:#4a331e;">${pros.length}</strong>
          professionnel(s) trouvé(s) dans un rayon de ${rayon} km
        </p>${cards}`;
    }

  } catch (e) {
    document.getElementById('mapsResults').innerHTML =
      '<p style="color:#DC2626;font-size:.85rem;">❌ Erreur lors du chargement. Réessayez.</p>';
    console.error(e);
  }
}
</script>
