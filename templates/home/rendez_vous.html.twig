{# templates/home/rendez_vous.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}NAFSEYTI — Prendre un Rendez-vous{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Instrument+Sans:wght@300;400;500&display=swap');

:root {
  --navy: #4a331e;
  --navy-mid: #050a45;
  --navy-soft: #A6BB8D;
  --blue-acc: #C1D0B5;
  --blue-light: #EFEAD8;
  --slate: #6B705C;
  --slate-lt: #A5A58D;
  --white: #FFFFFF;
  --off-white: #FAF8F3;
  --border: #DDD3C3;

  --gradient-main: linear-gradient(135deg, #5F7161 0%, #6D8B74 100%);
  --shadow-soft: 0 8px 30px rgba(95, 113, 97, 0.12);
  --shadow-hover: 0 12px 40px rgba(95, 113, 97, 0.18);
}

.rdv-page { font-family: 'Instrument Sans', sans-serif; background: var(--off-white); }

/* ════ HERO ════ */
.rdv-hero {
  background: linear-gradient(135deg, #ffffff 0%, #f8f5f0 100%);
  position: relative;
  overflow: hidden;
  padding: 64px 0 0;
  border-bottom: 1px solid var(--border);
}
.rdv-hero-dots {
  position: absolute; inset: 0;
  background-image: radial-gradient(var(--border) 1px, transparent 1px);
  background-size: 24px 24px;
  pointer-events: none; opacity: .55;
}
.rdv-hero-inner {
  max-width: 1160px; margin: 0 auto; padding: 0 40px;
  position: relative; z-index: 2;
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 60px; align-items: center;
}
.rdv-hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'Syne', sans-serif; font-size: .68rem; font-weight: 700;
  letter-spacing: .18em; text-transform: uppercase;
  color: var(--blue-acc); background: var(--blue-light);
  border: 1px solid rgba(59,111,232,.2);
  padding: 5px 14px; border-radius: 100px; margin-bottom: 20px;
}
.rdv-hero-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 800;
  color: var(--navy); line-height: 1.12;
  margin-bottom: 16px; letter-spacing: -.02em;
}
.rdv-hero-title span { color: var(--blue-acc); }
.rdv-hero-sub {
  font-size: .95rem; color: var(--slate);
  line-height: 1.75; max-width: 440px; font-weight: 400;
}
.rdv-hero-pills { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
.rdv-hero-pill {
  display: flex; align-items: center; gap: 7px;
  background: var(--off-white); border: 1.5px solid var(--border);
  border-radius: 100px; padding: 7px 14px;
  font-size: .78rem; color: var(--navy);
  font-family: 'Instrument Sans', sans-serif; font-weight: 500;
}
.rdv-hero-pill i { color: var(--blue-acc); font-size: .8rem; }

/* ── Photo collage ── */
.rdv-photo-collage { position: relative; height: 400px; padding-bottom: 32px; }
.collage-main {
  position: absolute; top: 0; right: 0;
  width: 63%; height: 320px;
  border-radius: 18px; overflow: hidden;
  box-shadow: 0 20px 60px rgba(13,27,62,.16);
}
.collage-main img { width:100%; height:100%; object-fit:cover; display:block; }
.collage-sec {
  position: absolute; bottom: 0; left: 0;
  width: 50%; height: 230px;
  border-radius: 16px; overflow: hidden;
  box-shadow: 0 12px 40px rgba(13,27,62,.13);
  border: 4px solid white;
}
.collage-sec img { width:100%; height:100%; object-fit:cover; display:block; }
.collage-tert {
  position: absolute; top: 44px; left: calc(50% - 56px);
  width: 108px; height: 108px;
  border-radius: 14px; overflow: hidden;
  box-shadow: 0 8px 24px rgba(13,27,62,.14);
  border: 3px solid white; z-index: 3;
}
.collage-tert img { width:100%; height:100%; object-fit:cover; display:block; }
.collage-stat {
  position: absolute; top: 20px; left: 0;
  background: white; border: 1.5px solid var(--border);
  border-radius: 14px; padding: 14px 20px;
  box-shadow: 0 8px 32px rgba(13,27,62,.1); z-index: 4; min-width: 130px;
}
.collage-stat::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0;
  height: 3px; border-radius: 14px 14px 0 0; background: var(--blue-acc);
}
.collage-stat-num {
  font-family: 'Syne', sans-serif; font-size: 1.6rem; font-weight: 800;
  color: var(--navy); line-height: 1;
}
.collage-stat-lbl { font-size: .7rem; color: var(--slate); margin-top: 4px; }
.collage-badge {
  position: absolute; bottom: 50px; right: -10px;
  background: var(--navy); color: white;
  border-radius: 12px; padding: 12px 16px;
  display: flex; align-items: center; gap: 10px;
  box-shadow: 0 8px 24px rgba(13,27,62,.2); z-index: 4;
  font-family: 'Instrument Sans', sans-serif; font-size: .78rem; white-space: nowrap;
}
.collage-badge i { color: var(--blue-acc); font-size: 1rem; }

/* ── Steps bar ── */
.rdv-steps-bar { background: var(--navy); }
.rdv-steps-bar-inner {
  max-width: 1160px; margin: 0 auto; padding: 0 40px;
  display: grid; grid-template-columns: repeat(4, 1fr);
}
.rdv-step-row {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 24px 24px 24px 0;
  border-right: 1px solid rgba(255,255,255,.08);
}
.rdv-step-row:first-child { padding-left: 0; }
.rdv-step-row:last-child { border-right: none; }
.rdv-step-num {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--blue-acc); color: white;
  font-family: 'Syne', sans-serif; font-size: .75rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 2px;
}
.rdv-step-title { font-family: 'Syne', sans-serif; font-size: .8rem; font-weight: 700; color: white; margin-bottom: 3px; }
.rdv-step-txt { font-size: .78rem; color: rgba(255,255,255,.65); line-height: 1.5; }

/* ════ TOOLBAR ════ */
.rdv-toolbar {
  background: var(--white); border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 100;
  margin-top: -20px; /* ← ajuste la valeur selon ton besoin */
}
.rdv-toolbar-inner {
  max-width: 1160px; margin:  auto; padding: 20px 40px;
  display: flex; align-items: center; gap: 24px; height: 64px;
}
.rdv-hero {
  padding: 64px 0 0; /* réduis le 0 final si besoin */
}
.rdv-search { position: relative; flex: 1; max-width: 320px; }
.rdv-search input {
  width: 100%; padding: 9px 16px 9px 38px;
  border: 1.5px solid var(--border); border-radius: 8px;
  font-family: 'Instrument Sans', sans-serif; font-size: .85rem;
  color: var(--navy); background: var(--off-white); outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.rdv-search input:focus { border-color: var(--blue-acc); box-shadow: 0 0 0 3px rgba(59,111,232,.1); background: white; }
.rdv-search input::placeholder { color: var(--slate-lt); }
.rdv-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--slate-lt); font-size: .8rem; pointer-events: none; }
.rdv-filters { display: flex; gap: 4px; margin-left: auto; }
.rdv-filter-btn {
  padding: 7px 16px; border-radius: 8px;
  border: 1.5px solid transparent; background: transparent;
  font-family: 'Instrument Sans', sans-serif; font-size: .8rem; font-weight: 500;
  color: var(--slate); cursor: pointer; transition: all .2s; white-space: nowrap;
}
.rdv-filter-btn:hover { background: var(--blue-light); color: var(--navy-mid); }
.rdv-filter-btn.active { background: var(--navy); color: white; border-color: var(--navy); }
.rdv-count-badge { font-family: 'Instrument Sans', sans-serif; font-size: .75rem; color: var(--slate); margin-left: auto; white-space: nowrap; }
.rdv-count-badge strong { color: var(--navy); font-weight: 600; }

/* ════ CONTENT ════ */
.rdv-content { max-width: 1160px; margin: 0 auto; padding: 40px 40px 80px; }

/* ════ FLASH ════ */
.rdv-flash { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 10px; margin-bottom: 24px; font-size: .88rem; }
.rdv-flash.success { background: #EFF6FF; border: 1px solid #BFDBFE; color: #1D4ED8; }
.rdv-flash.error   { background: #FEF2F2; border: 1px solid #FECACA; color: #DC2626; }

/* ════ BOUTON MES RDV ════ */
.btn-my-rdv {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 22px; background: var(--white); color: var(--navy);
  border: 1.5px solid var(--border); border-radius: 9px;
  font-family: 'Syne', sans-serif; font-size: .78rem; font-weight: 700;
  letter-spacing: .04em; text-decoration: none; cursor: pointer;
  transition: border-color .2s, background .2s, box-shadow .2s;
}
.btn-my-rdv:hover {
  border-color: var(--navy); background: var(--blue-light);
  color: var(--navy); text-decoration: none;
  box-shadow: 0 4px 14px rgba(95,113,97,.15);
}
.btn-my-rdv i { color: var(--navy-mid); }
.btn-my-rdv .rdv-badge-count {
  background: var(--navy); color: white;
  font-size: .65rem; font-weight: 700;
  padding: 2px 7px; border-radius: 100px; margin-left: 2px;
}

/* ════ PRO CARDS ════ */
.pro-list { display: flex; flex-direction: column; gap: 16px; }
.pro-card-h {
  background: var(--white); border: 1.5px solid var(--border);
  border-radius: 14px;
  display: grid; grid-template-columns: 100px 1fr auto;
  overflow: hidden;
  transition: border-color .25s, box-shadow .25s, transform .25s;
  animation: slideIn .4s ease both;
}
.pro-card-h:hover { border-color: var(--blue-acc); box-shadow: 0 8px 32px rgba(95,113,97,.15); transform: translateY(-2px); }
@keyframes slideIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
.pro-card-h:nth-child(1){animation-delay:.04s}
.pro-card-h:nth-child(2){animation-delay:.10s}
.pro-card-h:nth-child(3){animation-delay:.16s}
.pro-card-h:nth-child(4){animation-delay:.22s}
.pro-card-h:nth-child(5){animation-delay:.28s}
.pro-card-h:nth-child(6){animation-delay:.34s}

.pro-card-img { width: 100px; position: relative; flex-shrink: 0; overflow: hidden; }
.pro-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
.pro-card-h:hover .pro-card-img img { transform: scale(1.06); }
.pro-img-role {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 6px 4px; font-family: 'Syne', sans-serif;
  font-size: .55rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; text-align: center;
}
.role-psy   { background: var(--navy); color: white; }
.role-coach { background: var(--blue-acc); color: white; }

.pro-card-info {
  padding: 22px 28px; display: flex; flex-direction: column;
  justify-content: center; gap: 8px;
  border-right: 1px solid var(--border);
}
.pro-card-top { display: flex; align-items: center; gap: 12px; }
.pro-card-name { font-family: 'Syne', sans-serif; font-size: 1.05rem; font-weight: 700; color: var(--navy); letter-spacing: -.01em; }
.pro-card-role { font-size: .78rem; font-weight: 500; color: var(--navy-mid); background: var(--blue-light); padding: 3px 10px; border-radius: 100px; white-space: nowrap; }
.pro-card-meta { display: flex; gap: 20px; flex-wrap: wrap; }
.pro-meta-chip { display: flex; align-items: center; gap: 5px; font-size: .78rem; color: var(--slate); }
.pro-meta-chip i { color: var(--slate-lt); font-size: .72rem; }
.pro-avail-dot { width: 7px; height: 7px; border-radius: 50%; background: #22C55E; display: inline-block; animation: blink 2s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.35} }

.pro-card-cta {
  padding: 22px 28px; display: flex; flex-direction: column;
  align-items: flex-end; justify-content: center; gap: 10px; min-width: 200px;
}
.btn-book {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 22px; background: var(--navy); color: white;
  border: none; border-radius: 8px;
  font-family: 'Syne', sans-serif; font-size: .78rem; font-weight: 700;
  letter-spacing: .04em; cursor: pointer;
  transition: background .2s, transform .15s;
  text-decoration: none; white-space: nowrap;
}
.btn-book:hover { background: var(--navy-mid); transform: scale(1.02); color: white; text-decoration: none; }
.btn-conge {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'Instrument Sans', sans-serif; font-size: 0.85rem; font-weight: 500;
  color: var(--slate); background: none; border: none; cursor: pointer;
  padding: 8px 12px; transition: all 0.2s ease; border-radius: 8px; width: 100%;
}
.btn-conge:hover { color: var(--navy); background: rgba(74, 103, 65, 0.08); }
.btn-conge i, .btn-conge svg { font-size: 1.1rem; color: var(--slate); transition: color 0.2s; }
.btn-conge:hover i, .btn-conge:hover svg { color: var(--navy); }

.rdv-empty { text-align: center; padding: 80px 0; color: var(--slate); }
.rdv-empty i { font-size: 2.5rem; color: var(--border); margin-bottom: 16px; display: block; }
.rdv-empty p { font-size: .95rem; }

/* ════ CRÉNEAUX RÉSERVÉS ════ */
.slot-reserved { opacity: .5; cursor: not-allowed !important; background: var(--off-white) !important; pointer-events: none; }
.slot-taken { display: inline-flex; align-items: center; gap: 4px; margin-top: 7px; font-size: .62rem; font-weight: 600; padding: 3px 8px; border-radius: 100px; background: #FEF3C7; color: #92400E; }

/* ════ SECTION PHOTOS ════ */
.photos-section { padding: 64px 0 80px; background: var(--white); border-top: 1px solid var(--border); }
.photos-inner { max-width: 1160px; margin: 0 auto; padding: 0 40px; }
.photos-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px; }
.photos-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'Syne', sans-serif; font-size: .68rem; font-weight: 700;
  letter-spacing: .18em; text-transform: uppercase;
  color: var(--navy-mid); background: var(--blue-light);
  border: 1px solid var(--border); padding: 5px 14px;
  border-radius: 100px; margin-bottom: 12px;
}
.photos-title { font-family: 'Syne', sans-serif; font-size: 1.7rem; font-weight: 800; color: var(--navy); letter-spacing: -.02em; line-height: 1.15; }
.photos-title span { color: var(--navy-soft); }
.photos-sub { font-family: 'Instrument Sans', sans-serif; font-size: .88rem; color: var(--slate); line-height: 1.6; max-width: 340px; text-align: right; }
.photos-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 240px 200px; gap: 14px; }
.photo-cell { border-radius: 14px; overflow: hidden; position: relative; cursor: pointer; }
.photo-cell img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
.photo-cell:hover img { transform: scale(1.06); }
.photo-cell.span-col { grid-column: 1; grid-row: 1 / 3; border-radius: 18px; }
.photo-cell .overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(95,113,97,.55) 0%, transparent 55%); opacity: 0; transition: opacity .3s; }
.photo-cell:hover .overlay { opacity: 1; }
.photo-cell .caption { position: absolute; bottom: 14px; left: 16px; right: 16px; font-family: 'Syne', sans-serif; font-size: .72rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: white; opacity: 0; transform: translateY(6px); transition: all .3s .05s; }
.photo-cell:hover .caption { opacity: 1; transform: translateY(0); }
.photo-cell .corner-badge { position: absolute; top: 12px; left: 12px; background: white; color: var(--navy); font-family: 'Syne', sans-serif; font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 5px 11px; border-radius: 100px; border: 1px solid var(--border); }
.photos-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 14px; }
.photo-strip-item { border-radius: 12px; overflow: hidden; height: 130px; position: relative; cursor: pointer; }
.photo-strip-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s ease; }
.photo-strip-item:hover img { transform: scale(1.08); }
.photo-strip-item .strip-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 8px 12px; background: var(--navy); color: white; font-family: 'Instrument Sans', sans-serif; font-size: .72rem; font-weight: 500; opacity: 0; transform: translateY(100%); transition: all .3s; }
.photo-strip-item:hover .strip-label { opacity: 1; transform: translateY(0); }
.photos-cta-row { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 32px; }
.photos-cta { display: inline-flex; align-items: center; gap: 8px; padding: 11px 26px; background: var(--navy); color: white; border-radius: 9px; font-family: 'Syne', sans-serif; font-size: .78rem; font-weight: 700; letter-spacing: .04em; border: none; cursor: pointer; text-decoration: none; transition: background .2s; }
.photos-cta:hover { background: var(--navy-mid); color: white; text-decoration: none; }
.photos-cta-ghost { display: inline-flex; align-items: center; gap: 8px; padding: 11px 26px; background: transparent; color: var(--navy); border: 1.5px solid var(--border); border-radius: 9px; font-family: 'Syne', sans-serif; font-size: .78rem; font-weight: 700; letter-spacing: .04em; cursor: pointer; text-decoration: none; transition: border-color .2s, background .2s; }
.photos-cta-ghost:hover { border-color: var(--navy); background: var(--off-white); color: var(--navy); text-decoration: none; }

/* ════ SIDE PANEL ════ */
.panel-backdrop { display: none; position: fixed; inset: 0; background: rgba(13,27,62,.45); backdrop-filter: blur(3px); z-index: 9998; }
.panel-backdrop.open { display: block; }
.side-panel { position: fixed; top: 0; right: 0; bottom: 0; width: 480px; background: var(--off-white); z-index: 9999; display: flex; flex-direction: column; transform: translateX(100%); transition: transform .38s cubic-bezier(.4,0,.2,1); overflow: hidden; }
.side-panel.open { transform: translateX(0); }
.sp-header { background: var(--navy); padding: 28px 28px 0; flex-shrink: 0; position: relative; }
.sp-close { position: absolute; top: 18px; right: 20px; width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.12); border: none; color: white; cursor: pointer; font-size: .9rem; display: flex; align-items: center; justify-content: center; transition: background .2s; }
.sp-close:hover { background: rgba(255,255,255,.22); }
.sp-pro-row { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
.sp-avatar { width: 62px; height: 62px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,.2); flex-shrink: 0; }
.sp-pro-name { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 800; color: white; line-height: 1.2; }
.sp-pro-role { font-size: .75rem; color: var(--blue-acc); font-family: 'Instrument Sans', sans-serif; margin-top: 3px; }
.sp-pro-meta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 6px; }
.sp-meta-chip { display: flex; align-items: center; gap: 5px; font-size: .72rem; color: rgba(255,255,255,.6); font-family: 'Instrument Sans', sans-serif; }
.sp-meta-chip i { font-size: .68rem; }
.sp-tabs { display: flex; margin-top: 4px; }
.sp-tab { flex: 1; padding: 12px 0; background: transparent; border: none; font-family: 'Syne', sans-serif; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.45); cursor: pointer; border-bottom: 3px solid transparent; transition: color .2s, border-color .2s; }
.sp-tab.active { color: white; border-bottom-color: var(--blue-acc); }
.sp-body { flex: 1; overflow-y: auto; padding: 28px; }
.sp-body::-webkit-scrollbar { width: 4px; }
.sp-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
.sp-pane { display: none; }
.sp-pane.active { display: block; }
.sp-section-label { font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--slate-lt); margin-bottom: 12px; }
.slots-grid { overflow-x: auto; margin-bottom: 24px; }
.cal-table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 340px; }
.cal-table th { text-align: center; padding: 8px 6px 10px; font-family: 'Syne', sans-serif; font-size: .72rem; font-weight: 700; color: var(--navy); border-bottom: 2px solid var(--border); }
.cal-table th .cal-day-name { display: block; font-size: .78rem; color: var(--navy); }
.cal-table th .cal-day-date { display: block; font-size: .68rem; color: var(--slate-lt); font-weight: 400; margin-top: 2px; }
.cal-table td { text-align: center; padding: 4px 5px; }
.slot-time-btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; padding: 9px 4px; background: #8eba59; color: #1a2e1a; border: 1.5px solid #1a2e1a; border-radius: 8px; font-family: 'Instrument Sans', sans-serif; font-size: .76rem; font-weight: 600; cursor: pointer; transition: background .15s, border-color .15s, transform .1s; white-space: nowrap; }
.slot-time-btn:hover { background: #8eba59; border-color: #1a2e1a; transform: scale(1.04); }
.slot-time-btn.selected { background: var(--navy); color: white; border-color: var(--navy); }
.slot-time-btn.taken { background: var(--off-white); color: var(--slate-lt); border-color: var(--border); cursor: not-allowed; opacity: .55; font-size: .7rem; }
.cal-empty { color: var(--slate-lt); font-size: 1.1rem; }
.cal-more-row td { padding-top: 10px; }
.cal-more-btn { background: none; border: none; color: var(--slate); font-family: 'Instrument Sans', sans-serif; font-size: .78rem; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; padding: 6px 0; }
.cal-more-btn:hover { color: var(--navy); }
.cal-nav-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.cal-nav-btn { width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid var(--border); background: white; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: .75rem; color: var(--navy); transition: background .15s; }
.cal-nav-btn:hover { background: var(--blue-light); }
.cal-week-label { font-family: 'Syne', sans-serif; font-size: .72rem; color: var(--slate); font-weight: 700; }
.slot-card { background: var(--white); border: 1.5px solid var(--border); border-radius: 12px; padding: 14px 16px; cursor: pointer; transition: border-color .2s, box-shadow .2s, transform .15s; position: relative; }
.slot-card:hover { border-color: var(--navy-mid); box-shadow: 0 4px 16px rgba(95,113,97,.15); transform: translateY(-1px); }
.slot-card.selected { border-color: var(--navy); background: var(--blue-light); box-shadow: 0 4px 20px rgba(95,113,97,.2); }
.slot-card.selected::after { content: '✓'; position: absolute; top: 8px; right: 10px; font-size: .7rem; font-weight: 700; color: var(--navy); }
.slot-date { font-family: 'Syne', sans-serif; font-size: .78rem; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
.slot-time { font-size: .72rem; color: var(--slate); font-family: 'Instrument Sans', sans-serif; display: flex; align-items: center; gap: 5px; }
.slot-time i { font-size: .65rem; color: var(--blue-acc); }
.slot-type-badge { display: inline-flex; align-items: center; gap: 4px; margin-top: 7px; font-size: .62rem; font-weight: 600; padding: 3px 8px; border-radius: 100px; }
.slot-type-badge.presentiel { background: #e8f5e9; color: #2e7d32; }
.slot-type-badge.enligne    { background: #e3f2fd; color: #1565c0; }
.sp-no-slots { text-align: center; padding: 40px 0; color: var(--slate-lt); font-family: 'Instrument Sans', sans-serif; font-size: .88rem; }
.sp-no-slots i { font-size: 2rem; display: block; margin-bottom: 10px; color: var(--border); }
.selected-slot-preview { background: var(--blue-light); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; margin-bottom: 18px; font-size: .8rem; color: var(--navy); font-family: 'Instrument Sans', sans-serif; display: flex; gap: 10px; align-items: center; }
.selected-slot-preview i { color: var(--navy-mid); flex-shrink: 0; }
.btn-confirm-sp { width: 100%; padding: 14px; background: var(--navy); color: white; border: none; border-radius: 12px; font-family: 'Syne', sans-serif; font-size: .82rem; font-weight: 700; letter-spacing: .05em; cursor: pointer; margin-top: 8px; transition: background .2s, transform .15s; display: flex; align-items: center; justify-content: center; gap: 10px; }
.btn-confirm-sp:hover { background: var(--navy-mid); transform: scale(1.01); }

/* ════ POPUP MES RDV ════ */
.popup-backdrop { display: none; position: fixed; inset: 0; background: rgba(13,27,62,.5); backdrop-filter: blur(4px); z-index: 10000; align-items: center; justify-content: center; }
.popup-backdrop.open { display: flex; }
.popup-box { background: var(--white); border-radius: 20px; width: 100%; max-width: 640px; max-height: 82vh; display: flex; flex-direction: column; box-shadow: 0 32px 80px rgba(13,27,62,.22); animation: popIn .3s cubic-bezier(.34,1.56,.64,1); overflow: hidden; margin: 20px; }
@keyframes popIn { from { opacity: 0; transform: scale(.92) translateY(20px); } to   { opacity: 1; transform: scale(1) translateY(0); } }
.popup-header { background: var(--navy); padding: 24px 28px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
.popup-header-left { display: flex; align-items: center; gap: 12px; }
.popup-header-icon { width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; font-size: 1rem; color: var(--blue-acc); }
.popup-title { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 800; color: white; }
.popup-subtitle { font-size: .72rem; color: rgba(255,255,255,.6); margin-top: 2px; font-family: 'Instrument Sans', sans-serif; }
.popup-close { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.12); border: none; color: white; cursor: pointer; font-size: .9rem; display: flex; align-items: center; justify-content: center; transition: background .2s; flex-shrink: 0; }
.popup-close:hover { background: rgba(255,255,255,.25); }
.popup-body { flex: 1; overflow-y: auto; padding: 24px 28px; }
.popup-body::-webkit-scrollbar { width: 4px; }
.popup-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
.popup-loading { text-align: center; padding: 48px 0; color: var(--slate-lt); font-family: 'Instrument Sans', sans-serif; font-size: .88rem; }
.popup-loading i { font-size: 1.5rem; display: block; margin-bottom: 10px; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.popup-empty { text-align: center; padding: 48px 0; color: var(--slate-lt); font-family: 'Instrument Sans', sans-serif; }
.popup-empty i { font-size: 2rem; color: var(--border); display: block; margin-bottom: 12px; }
.res-list-popup { display: flex; flex-direction: column; gap: 12px; }
.res-card-popup { background: var(--off-white); border: 1.5px solid var(--border); border-radius: 14px; overflow: hidden; display: grid; grid-template-columns: 5px 1fr; animation: fadeUp .3s ease both; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to   { opacity: 1; transform: translateY(0); } }
.res-stripe-popup { background: var(--navy-mid); }
.res-body-popup { padding: 16px 20px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.res-avatar-popup { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border); flex-shrink: 0; }
.res-info-popup { flex: 1; min-width: 120px; }
.res-doctor-popup { font-family: 'Syne', sans-serif; font-size: .88rem; font-weight: 700; color: var(--navy); }
.res-role-popup   { font-size: .72rem; color: var(--navy-mid); margin-top: 2px; }
.res-meta-popup { display: flex; gap: 10px; flex-wrap: wrap; }
.res-chip-popup { display: flex; align-items: center; gap: 4px; font-size: .74rem; color: var(--slate); font-family: 'Instrument Sans', sans-serif; }
.res-chip-popup i { font-size: .66rem; color: var(--slate-lt); }
.res-status-popup { display: inline-flex; align-items: center; gap: 5px; font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; padding: 5px 11px; border-radius: 100px; background: #FEF3C7; color: #92400E; white-space: nowrap; }
.res-lock-popup { display: flex; align-items: center; gap: 4px; font-size: .7rem; color: var(--slate-lt); font-family: 'Instrument Sans', sans-serif; white-space: nowrap; }
.res-status-popup.confirme { background:#dcfce7; color:#166534; }
.res-status-popup.annule   { background:#fee2e2; color:#991b1b; }
.res-status-popup.attente  { background:#fef3c7; color:#92400e; }

/* ════ SECTION VIDÉOS BIEN-ÊTRE — NOUVEAU STYLE IA ════ */
.vb-section {
  background: var(--white);
  border: 1.5px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 40px;
  position: relative;
}

/* En-tête section */
.vb-header {
  padding: 28px 32px 24px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  background: linear-gradient(135deg, #ffffff 0%, #f8f5f0 100%);
  position: relative;
  overflow: hidden;
}
.vb-header-dots {
  position: absolute; inset: 0;
  background-image: radial-gradient(var(--border) 1px, transparent 1px);
  background-size: 20px 20px;
  opacity: .35;
  pointer-events: none;
}

.vb-eyebrow {
  display: inline-flex; align-items: center; gap: 7px;
  font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase;
  color: #5f7161; background: #eef4ec;
  border: 1px solid #c1d0b5;
  padding: 5px 13px; border-radius: 100px; margin-bottom: 10px;
}
.vb-eyebrow-dot {
  width: 6px; height: 6px; border-radius: 50%; background: #5f7161;
  animation: vb-blink 2s ease-in-out infinite;
}
@keyframes vb-blink { 0%,100%{opacity:1} 50%{opacity:.3} }

.vb-title {
  font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800;
  color: var(--navy); line-height: 1.2; margin-bottom: 6px; letter-spacing: -.02em;
}
.vb-title span { color: #6D8B74; }
.vb-sub { font-size: .85rem; color: var(--slate); line-height: 1.6; max-width: 340px; }

/* Badge IA animé */
.vb-ai-badge {
  display: flex; align-items: center; gap: 10px;
  background: var(--white); border: 1.5px solid var(--border);
  border-radius: 14px; padding: 12px 16px;
  font-size: .75rem; color: var(--slate);
  flex-shrink: 0; position: relative; z-index: 1;
}
.vb-ai-orb {
  width: 38px; height: 38px; border-radius: 50%;
  background: var(--navy);
  position: relative; flex-shrink: 0; overflow: visible;
}
.vb-orb-ring {
  position: absolute; inset: -4px; border-radius: 50%;
  border: 2px solid transparent;
  border-top-color: #8eba59;
  border-right-color: #6D8B74;
  animation: vb-spin 2s linear infinite;
}
.vb-orb-ring2 {
  position: absolute; inset: -8px; border-radius: 50%;
  border: 1.5px solid transparent;
  border-bottom-color: rgba(193,208,181,.5);
  border-left-color: rgba(193,208,181,.3);
  animation: vb-spin 3.5s linear infinite reverse;
}
@keyframes vb-spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
.vb-orb-inner {
  position: absolute; inset: 5px; border-radius: 50%;
  background: #5f7161;
  display: flex; align-items: center; justify-content: center;
}
.vb-orb-bars {
  display: flex; gap: 2px; align-items: center;
}
.vb-orb-bars span {
  display: block; width: 2.5px;
  background: #eef4ec; border-radius: 2px;
  animation: vb-wave 1.2s ease-in-out infinite;
}
.vb-orb-bars span:nth-child(1){height:5px;animation-delay:0s}
.vb-orb-bars span:nth-child(2){height:11px;animation-delay:.15s}
.vb-orb-bars span:nth-child(3){height:7px;animation-delay:.3s}
.vb-orb-bars span:nth-child(4){height:13px;animation-delay:.1s}
.vb-orb-bars span:nth-child(5){height:5px;animation-delay:.25s}
@keyframes vb-wave { 0%,100%{transform:scaleY(1)} 50%{transform:scaleY(.25)} }
.vb-ai-label { font-family: 'Syne', sans-serif; font-size: .72rem; font-weight: 700; color: var(--navy); }
.vb-ai-sub   { font-size: .68rem; color: var(--slate); margin-top: 2px; }

/* Boutons humeur */
.vb-moods {
  display: flex; gap: 8px; flex-wrap: wrap;
  padding: 18px 32px;
  border-bottom: 1px solid var(--border);
  background: var(--off-white);
}
.vb-mood-btn {
  display: flex; align-items: center; gap: 7px;
  padding: 9px 18px; border-radius: 100px;
  border: 1.5px solid var(--border);
  background: var(--white);
  font-family: 'Instrument Sans', sans-serif; font-size: .82rem; font-weight: 500;
  color: var(--navy); cursor: pointer;
  transition: all .2s;
}
.vb-mood-btn:hover { border-color: #6D8B74; background: #eef4ec; }
.vb-mood-btn.active { background: var(--navy); color: #eef4ec; border-color: var(--navy); }

/* Zone résultat */
.vb-result { padding: 24px 32px; }

/* Box conseil */
.vb-conseil-box {
  display: flex; align-items: flex-start; gap: 12px;
  background: #f0f7ee; border: 1px solid #c1d0b5;
  border-radius: 12px; padding: 14px 18px; margin-bottom: 24px;
  font-size: .85rem; color: #2d4a1e; line-height: 1.65;
  animation: vb-fadeIn .4s ease;
}
.vb-conseil-icon {
  width: 28px; height: 28px; flex-shrink: 0; border-radius: 8px;
  background: var(--navy);
  display: flex; align-items: center; justify-content: center;
}
@keyframes vb-fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

/* Grille vidéos */
.vb-videos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 14px;
}
.vb-video-card {
  background: var(--white); border: 1.5px solid var(--border);
  border-radius: 14px; overflow: hidden;
  cursor: pointer;
  transition: border-color .2s, transform .2s, box-shadow .2s;
  animation: vb-cardIn .4s ease both;
}
.vb-video-card:hover { border-color: #6D8B74; transform: translateY(-3px); box-shadow: 0 8px 24px rgba(95,113,97,.15); }
@keyframes vb-cardIn { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
.vb-video-card:nth-child(1){animation-delay:.05s}
.vb-video-card:nth-child(2){animation-delay:.12s}
.vb-video-card:nth-child(3){animation-delay:.19s}
.vb-video-card:nth-child(4){animation-delay:.26s}

/* Miniature */
.vb-thumb {
  height: 110px; position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.vb-play-btn {
  width: 42px; height: 42px; border-radius: 50%;
  background: rgba(255,255,255,.92);
  display: flex; align-items: center; justify-content: center;
  z-index: 2; transition: transform .2s;
  box-shadow: 0 4px 12px rgba(13,27,62,.15);
}
.vb-video-card:hover .vb-play-btn { transform: scale(1.12); }
.vb-play-arrow { width:0; height:0; border-style:solid; border-width:7px 0 7px 14px; border-color:transparent transparent transparent #4a331e; margin-left:2px; }
.vb-waveform {
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 30px; display: flex; align-items: flex-end;
  justify-content: center; gap: 2.5px; padding: 0 12px 6px;
  opacity: .55;
}
.vb-waveform-bar {
  width: 3px; background: rgba(255,255,255,.75); border-radius: 2px;
  animation: vb-wave 1.2s ease-in-out infinite;
}

/* Corps carte */
.vb-video-body { padding: 12px 14px; }
.vb-video-tag {
  display: inline-block; font-size: .62rem; font-weight: 600;
  padding: 3px 9px; border-radius: 100px; margin-bottom: 7px; letter-spacing: .04em;
}
.vb-video-title {
  font-family: 'Syne', sans-serif; font-size: .82rem; font-weight: 700;
  color: var(--navy); margin-bottom: 5px; line-height: 1.35;
}
.vb-video-meta {
  font-size: .7rem; color: var(--slate);
  display: flex; align-items: center; gap: 5px;
}
.vb-video-link {
  display: block; margin-top: 8px; font-size: .7rem;
  color: var(--navy-mid); text-decoration: none;
  font-family: 'Instrument Sans', sans-serif;
}
.vb-video-link:hover { text-decoration: underline; }

/* États loading / empty */
.vb-loading {
  padding: 48px 0; text-align: center;
  color: var(--slate); font-size: .85rem;
}
.vb-loading-orb { width: 52px; height: 52px; margin: 0 auto 16px; position: relative; }
.vb-loading-ring1 { position:absolute;inset:0;border-radius:50%;border:2px solid var(--border);border-top-color:#6D8B74;animation:vb-spin 1.2s linear infinite; }
.vb-loading-ring2 { position:absolute;inset:6px;border-radius:50%;border:2px solid var(--border);border-bottom-color:#8eba59;animation:vb-spin 1.8s linear infinite reverse; }
.vb-loading-core { position:absolute;inset:14px;border-radius:50%;background:#eef4ec; }
.vb-typing { display:flex;gap:4px;justify-content:center;margin-top:12px; }
.vb-typing-dot { width:6px;height:6px;border-radius:50%;background:#6D8B74;animation:vb-type 1.2s ease-in-out infinite; }
.vb-typing-dot:nth-child(2){animation-delay:.2s}
.vb-typing-dot:nth-child(3){animation-delay:.4s}
@keyframes vb-type { 0%,100%{opacity:.3;transform:translateY(0)} 50%{opacity:1;transform:translateY(-4px)} }

.vb-empty {
  padding: 36px 0; text-align: center;
  color: var(--slate); font-size: .85rem;
}
.vb-empty-icon {
  width: 50px; height: 50px; border-radius: 50%;
  background: var(--off-white); border: 1.5px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 12px;
}

/* ════ OVERLAY GLOBAL ════ */
.rdv-overlay { display: flex; position: fixed; inset: 0; background: rgba(13, 27, 62, 0.5); backdrop-filter: blur(4px); z-index: 10001; align-items: center; justify-content: center; }

/* ════ RESPONSIVE ════ */
@media (max-width: 900px) {
  .rdv-hero-inner { grid-template-columns: 1fr; padding-bottom: 40px; }
  .rdv-photo-collage { display: none; }
  .rdv-steps-bar-inner { grid-template-columns: 1fr 1fr; }
  .rdv-toolbar-inner { gap: 12px; }
  .rdv-filters { display: none; }
  .pro-card-h { grid-template-columns: 90px 1fr; }
  .pro-card-cta { display: none; }
  .rdv-content { padding: 24px 20px 60px; }
  .photos-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
  .photo-cell.span-col { grid-column: 1 / 3; grid-row: auto; height: 220px; }
  .photos-strip { grid-template-columns: 1fr 1fr; }
  .photos-header { flex-direction: column; align-items: flex-start; gap: 12px; }
  .photos-sub { text-align: left; }
  .photos-inner { padding: 0 20px; }
  .side-panel { width: 100%; }
  .slots-grid { grid-template-columns: 1fr; }
  .vb-header { padding: 20px; }
  .vb-moods { padding: 16px 20px; }
  .vb-result { padding: 20px; }
  .vb-videos-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 480px) {
  .rdv-steps-bar-inner { grid-template-columns: 1fr; }
  .popup-box { margin: 12px; border-radius: 16px; }
  .res-body-popup { gap: 10px; }
  .vb-videos-grid { grid-template-columns: 1fr; }
  .vb-ai-badge { display: none; }
}

/* ════ MUSIC PLAYER — NOUVEAU ════ */
.music-section {
  margin-bottom: 40px;
}
.music-player-card {
  background: linear-gradient(135deg, #2d3e2d 0%, #4a5b3e 100%);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.music-player-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.2);
}
.music-visualizer {
  height: 80px;
  background: rgba(0,0,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 16px;
  cursor: pointer;
}
.vis-bar {
  width: 4px;
  background: rgba(255,255,255,0.7);
  border-radius: 2px;
  transition: height 0.05s ease;
}
.vis-bar.playing {
  background: #8eba59;
  box-shadow: 0 0 8px #8eba59;
}
.music-info {
  padding: 16px 20px;
  display: flex;
 align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(10px);
}
.music-text {
  flex: 1;
}
.music-title {
  font-family: 'Syne', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  color: white;
  margin-bottom: 4px;
}
.music-artist {
  font-size: 0.7rem;
  color: rgba(255,255,255,0.7);
  font-family: 'Instrument Sans', sans-serif;
}
.music-controls {
  display: flex;
  gap: 12px;
  align-items: center;
}
.music-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.3);
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.music-btn:hover {
  background: rgba(255,255,255,0.3);
  transform: scale(1.05);
}
.music-volume {
  display: flex;
  align-items: center;
  gap: 8px;
}
.music-volume input {
  width: 80px;
  height: 3px;
  -webkit-appearance: none;
  background: rgba(255,255,255,0.3);
  border-radius: 3px;
  outline: none;
}
.music-volume input::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #8eba59;
  cursor: pointer;
}
.music-playlist {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(10px);
}
.music-playlist.open {
  max-height: 300px;
  overflow-y: auto;
}
.playlist-item {
  padding: 10px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  transition: background 0.2s;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.playlist-item:hover {
  background: rgba(255,255,255,0.1);
}
.playlist-item.active {
  background: rgba(142,186,89,0.2);
  border-left: 3px solid #8eba59;
}
.playlist-icon {
  width: 30px;
  text-align: center;
  font-size: 0.8rem;
}
.playlist-info {
  flex: 1;
}
.playlist-title {
  font-size: 0.8rem;
  color: white;
  font-family: 'Instrument Sans', sans-serif;
}
.playlist-artist {
  font-size: 0.65rem;
  color: rgba(255,255,255,0.6);
}
.playlist-duration {
  font-size: 0.65rem;
  color: rgba(255,255,255,0.5);
}
.music-toggle-playlist {
  background: none;
  border: none;
  color: rgba(255,255,255,0.6);
  cursor: pointer;
  padding: 5px;
  transition: transform 0.2s;
}
.music-toggle-playlist:hover {
  color: white;
}
.music-toggle-playlist.rotated {
  transform: rotate(180deg);
}
/* ════ MUSIC SEARCH & CATEGORIES ════ */
.music-search-bar {
  padding: 12px 20px;
  background: rgba(0,0,0,0.2);
  border-bottom: 1px solid rgba(255,255,255,0.1);
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.music-search-input {
  flex: 1;
  padding: 8px 15px;
  border: none;
  border-radius: 25px;
  background: rgba(255,255,255,0.15);
  color: white;
  font-family: 'Instrument Sans', sans-serif;
  font-size: 0.8rem;
  outline: none;
}
.music-search-input::placeholder {
  color: rgba(255,255,255,0.5);
}
.music-search-input:focus {
  background: rgba(255,255,255,0.25);
}
.music-categories {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.music-cat-btn {
  padding: 5px 12px;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.8);
  font-size: 0.7rem;
  cursor: pointer;
  transition: all 0.2s;
  font-family: 'Instrument Sans', sans-serif;
}
.music-cat-btn:hover {
  background: rgba(142,186,89,0.5);
  border-color: #8eba59;
}
.music-cat-btn.active {
  background: #8eba59;
  border-color: #8eba59;
  color: #1a2e1a;
}
.music-results-count {
  font-size: 0.7rem;
  color: rgba(255,255,255,0.5);
  padding: 0 10px;
}
</style>
{% endblock %}

{% block body %}
<div class="rdv-page">

{# ════ HERO ════ #}
<section class="rdv-hero">
  <div class="rdv-hero-dots"></div>
  <div class="rdv-hero-inner">
    <div>
      <div class="rdv-hero-eyebrow"><i class="fas fa-calendar-check"></i> Prise de rendez-vous</div>
      <h1 class="rdv-hero-title">Trouvez votre<br><span>expert en bien-être</span></h1>
      <p class="rdv-hero-sub">Consultez nos psychologues et coachs de vie certifiés. Réservez une séance en quelques secondes, en toute confidentialité.</p>
      <div class="rdv-hero-pills">
        <div class="rdv-hero-pill"><i class="fas fa-shield-halved"></i> 100 % Anonyme</div>
        <div class="rdv-hero-pill"><i class="fas fa-bolt"></i> Confirmation immédiate</div>
        <div class="rdv-hero-pill"><i class="fas fa-graduation-cap"></i> Experts certifiés</div>
      </div>
    </div>
    <div class="rdv-photo-collage">
      <div class="collage-stat">
        <div class="collage-stat-num">1 000+</div>
        <div class="collage-stat-lbl">Étudiants accompagnés</div>
      </div>
      <div class="collage-main">
        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=600&q=80" alt="Séance">
      </div>
      <div class="collage-sec">
        <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&q=80" alt="Bien-être">
      </div>
      <div class="collage-tert">
        <img src="https://images.unsplash.com/photo-1551836022-deb4988cc6c0?w=300&q=80" alt="Consultation">
      </div>
      <div class="collage-badge"><i class="fas fa-star"></i> Professionnels certifiés</div>
    </div>
  </div>

  <div class="rdv-steps-bar">
    <div class="rdv-steps-bar-inner">
      <div class="rdv-step-row">
        <div class="rdv-step-num">1</div>
        <div><div class="rdv-step-title">Choisissez</div><div class="rdv-step-txt">Parcourez la liste des professionnels</div></div>
      </div>
      <div class="rdv-step-row">
        <div class="rdv-step-num">2</div>
        <div><div class="rdv-step-title">Sélectionnez</div><div class="rdv-step-txt">Choisissez un créneau disponible</div></div>
      </div>
      <div class="rdv-step-row">
        <div class="rdv-step-num">3</div>
        <div><div class="rdv-step-title">Confirmez</div><div class="rdv-step-txt">Remplissez le formulaire et validez</div></div>
      </div>
      <div class="rdv-step-row">
        <div class="rdv-step-num">4</div>
        <div><div class="rdv-step-title">Consultez</div><div class="rdv-step-txt">Rencontrez votre expert en présentiel ou visio</div></div>
      </div>
    </div>
  </div>
</section>



{# ════ BARRE LOCALISATION — GEOAPIFY ════ #}
<div style="background:white;border-bottom:1px solid var(--border);padding:14px 40px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
  <i class="fas fa-map-marker-alt" style="color:var(--navy);font-size:1rem;"></i>
  <input id="mapsAddressInput" type="text"
    placeholder="Entrez votre ville pour trouver les pros près de vous..."
    style="flex:1;min-width:240px;padding:10px 16px;border:1.5px solid var(--border);border-radius:8px;font-family:'Instrument Sans',sans-serif;font-size:.88rem;outline:none;"
    onkeydown="if(event.key==='Enter') rechercherProximite()">
  <select id="mapsRayon" style="padding:10px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:.85rem;font-family:'Instrument Sans',sans-serif;color:var(--navy);">
    <option value="10">10 km</option>
    <option value="25">25 km</option>
    <option value="50">50 km</option>
    <option value="100">100 km</option>
    <option value="200" selected>200 km</option>  {# ← ajoute ça #}
    <option value="500">Toute la Tunisie</option>  {# ← et ça #}
</select>
  <button onclick="rechercherProximite()"
    style="padding:10px 22px;background:var(--navy);color:white;border:none;border-radius:8px;font-family:'Syne',sans-serif;font-weight:700;font-size:.8rem;cursor:pointer;">
    <i class="fas fa-search"></i> Rechercher
  </button>
  <button onclick="geolocateMe()"
    style="padding:10px 14px;background:var(--off-white);color:var(--navy);border:1.5px solid var(--border);border-radius:8px;font-size:.85rem;cursor:pointer;">
    📍 Me localiser
  </button>
  <span id="mapsStatus" style="font-size:.78rem;color:var(--slate);font-family:'Instrument Sans',sans-serif;"></span>
</div>

<div id="mapsContainer" style="display:none;">
  <div id="leafletMap" style="height:420px;width:100%;z-index:1;"></div>
  <div id="mapsResults" style="padding:20px 40px;background:var(--off-white);border-bottom:1px solid var(--border);"></div>
</div>

{# ════ CONTENT ════ #}
<div class="rdv-content">

  {% for msg in app.flashes('success') %}
    <div class="rdv-flash success"><i class="fas fa-circle-check"></i> {{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="rdv-flash error"><i class="fas fa-circle-exclamation"></i> {{ msg }}</div>
  {% endfor %}

  

  {# ════ MUSIC PLAYER — ANTI-STRESS AVEC RECHERCHE ════ #}
<div class="music-section">
  <div class="music-player-card">
    <!-- Barre de recherche et catégories -->
    <div class="music-search-bar">
      <input type="text" id="musicSearchInput" class="music-search-input" placeholder="🔍 Rechercher une musique anti-stress... (ex: pluie, méditation, piano)">
      <div class="music-categories" id="musicCategories">
        <button class="music-cat-btn active" data-cat="all">🎵 Toutes</button>
        <button class="music-cat-btn" data-cat="meditation">🧘 Méditation</button>
        <button class="music-cat-btn" data-cat="nature">🌿 Nature</button>
        <button class="music-cat-btn" data-cat="piano">🎹 Piano</button>
        <button class="music-cat-btn" data-cat="ambient">🌊 Ambient</button>
        <button class="music-cat-btn" data-cat="sleep">😴 Sommeil</button>
      </div>
      <span id="musicResultsCount" class="music-results-count">5 titres</span>
    </div>
    
    <div class="music-visualizer" id="musicVisualizer" onclick="togglePlay()"></div>
    
    <div class="music-info">
      <div class="music-text">
        <div class="music-title" id="currentTrackTitle">Musique anti-stress</div>
        <div class="music-artist" id="currentTrackArtist">Bien-être & relaxation</div>
      </div>
      <div class="music-controls">
        <button class="music-btn" onclick="togglePlay()" id="playPauseBtn">
          <i class="fas fa-play"></i>
        </button>
        <button class="music-btn" onclick="nextTrack()">
          <i class="fas fa-forward"></i>
        </button>
        <button class="music-btn" onclick="prevTrack()">
          <i class="fas fa-backward"></i>
        </button>
        <div class="music-volume">
          <i class="fas fa-volume-up" style="color:white;font-size:0.8rem;"></i>
          <input type="range" id="volumeSlider" min="0" max="1" step="0.01" value="0.5">
        </div>
        <button class="music-toggle-playlist" id="togglePlaylistBtn" onclick="togglePlaylist()">
          <i class="fas fa-list"></i>
        </button>
      </div>
    </div>
    
    <div class="music-playlist" id="playlistContainer"></div>
  </div>
</div>

  {# ════ SECTION VIDÉOS BIEN-ÊTRE — NOUVEAU STYLE IA ════ #}
  <div class="vb-section">

    {# En-tête #}
    <div class="vb-header">
      <div class="vb-header-dots"></div>
      <div style="position:relative;z-index:1;">
        <div class="vb-eyebrow">
          <div class="vb-eyebrow-dot"></div>
          Vidéos bien-être · IA
        </div>
        <h2 class="vb-title">
          Comment vous sentez-vous<br><span>en ce moment ?</span>
        </h2>
        <p class="vb-sub">
          Choisissez votre humeur — l'IA sélectionne des vidéos adaptées à votre profil.
        </p>
      </div>

      {# Badge IA animé #}
      <div class="vb-ai-badge">
        <div class="vb-ai-orb">
          <div class="vb-orb-ring"></div>
          <div class="vb-orb-ring2"></div>
          <div class="vb-orb-inner">
            <div class="vb-orb-bars">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        </div>
        <div>
          <div class="vb-ai-label">IA active</div>
          <div class="vb-ai-sub">Analyse en cours</div>
        </div>
      </div>
    </div>

    {# Boutons humeur #}
    <div class="vb-moods" id="vbHumeurBtns">
      <button class="vb-mood-btn" data-humeur="anxieux" onclick="choisirHumeur(this)">😰 Anxieux</button>
      <button class="vb-mood-btn" data-humeur="triste"  onclick="choisirHumeur(this)">😔 Triste</button>
      <button class="vb-mood-btn" data-humeur="stresse" onclick="choisirHumeur(this)">😤 Stressé</button>
      <button class="vb-mood-btn" data-humeur="fatigue" onclick="choisirHumeur(this)">😴 Fatigué</button>
      <button class="vb-mood-btn" data-humeur="bien"    onclick="choisirHumeur(this)">😊 Bien</button>
    </div>

    {# Zone résultat #}
    <div class="vb-result" id="vbResultZone">
      <div class="vb-empty">
        <div class="vb-empty-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M12 21C12 21 3 14.5 3 8.5C3 5.42 5.42 3 8.5 3C10.24 3 11.81 3.94 12 5C12.19 3.94 13.76 3 15.5 3C18.58 3 21 5.42 21 8.5C21 14.5 12 21 12 21Z" fill="#c1d0b5"/>
          </svg>
        </div>
        Sélectionnez votre humeur pour découvrir vos vidéos personnalisées.
      </div>
    </div>

  </div>{# /vb-section #}


{# ════ TOOLBAR ════ #}
<div class="rdv-toolbar">
  <div class="rdv-toolbar-inner">
    <div class="rdv-search">
      <i class="fas fa-search"></i>
      <input type="text" id="rdvSearch" placeholder="Rechercher un professionnel...">
    </div>
    <div class="rdv-filters">
      <button class="rdv-filter-btn active" data-filter="all">Tous</button>
      <button class="rdv-filter-btn" data-filter="psychologue">Psychologues</button>
      <button class="rdv-filter-btn" data-filter="coach_vie">Coachs de vie</button>
    </div>
    <div class="rdv-count-badge" id="rdvCount">
      <strong>{{ professionals|length }}</strong> professionnel{{ professionals|length > 1 ? 's' : '' }} disponible{{ professionals|length > 1 ? 's' : '' }}
    </div>
  </div>
</div>

  {# ── Boutons haut ── #}
  <div style="display:flex; justify-content:flex-end; margin-bottom:20px;">
    <button class="btn-my-rdv" onclick="openReservationsPopup()">
      <i class="fas fa-calendar-check"></i>
      Mes rendez-vous réservés
      <span class="rdv-badge-count" id="rdvBadgeCount">…</span>
    </button>
    <button class="btn-my-rdv" onclick="openMesCongesPopup()" style="margin-left:10px">
      <i class="fas fa-file-medical-alt"></i>
      Mes congés
    </button>
  </div>


  {# ════ LISTE PROFESSIONNELS ════ #}
  <div class="pro-list" id="proList">
    {% for user in professionals %}
      {% set isCoach = (user.role == 'coach_vie') %}
      {% set roleLabel = isCoach ? 'Coach de vie' : 'Psychologue' %}
      {% set roleBadgeClass = isCoach ? 'role-coach' : 'role-psy' %}

      <div class="pro-card-h"
           data-role="{{ user.role }}"
           data-name="{{ user.firstname|lower }} {{ user.lastname|lower }}">

        <div class="pro-card-img">
          {% if user.profile_photo %}
            <img src="{{ asset(user.profile_photo) }}" alt="{{ user.firstname }} {{ user.lastname }}">
          {% else %}
            <img src="https://ui-avatars.com/api/?name={{ user.firstname|url_encode }}+{{ user.lastname|url_encode }}&background={{ isCoach ? '6D8B74' : '5F7161' }}&color=fff&size=200" alt="{{ user.firstname }} {{ user.lastname }}">
          {% endif %}
          <div class="pro-img-role {{ roleBadgeClass }}">{{ roleLabel }}</div>
        </div>

        <div class="pro-card-info">
          <div class="pro-card-top">
            <div class="pro-card-name">{{ user.firstname }} {{ user.lastname }}</div>
            <div class="pro-card-role">{{ roleLabel }}</div>
          </div>
          <div class="pro-card-meta">
            <div class="pro-meta-chip"><span class="pro-avail-dot"></span> Disponible</div>
            {% if user.location %}
              <div class="pro-meta-chip"><i class="fas fa-location-dot"></i> {{ user.location }}</div>
            {% endif %}
            {% if user.phone_number %}
              <div class="pro-meta-chip"><i class="fas fa-phone"></i> {{ user.phone_number }}</div>
            {% endif %}
            {% if user.email %}
              <div class="pro-meta-chip"><i class="fas fa-envelope"></i> {{ user.email }}</div>
            {% endif %}
            <div class="pro-meta-chip">
              <i class="fas fa-clock"></i>
              Membre depuis {{ user.created_at ? user.created_at|date('Y') : '—' }}
            </div>
          </div>
        </div>

        <div class="pro-card-cta">
          <button class="btn-book" onclick="openPanel({{ user.id }})">
            <i class="fas fa-calendar-plus"></i>
            Voir les créneaux
          </button>
          <button class="btn-conge"
                  onclick="openCongeModal({{ user.id }}, '{{ user.firstname }} {{ user.lastname }}')"
                  data-psy-id="{{ user.id }}">
            <i class="fas fa-file-medical"></i>
            <span>Demander un congé</span>
          </button>
        </div>

      </div>
    {% else %}
      <div class="rdv-empty">
        <i class="fas fa-user-slash"></i>
        <p>Aucun professionnel disponible pour le moment.</p>
      </div>
    {% endfor %}
  </div>

</div>{# /rdv-content #}

{# ════ SECTION PHOTOS ════ #}
