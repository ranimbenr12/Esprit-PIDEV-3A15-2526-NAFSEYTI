<script>
/* ══════════════════════════════════════════
   SECTION VIDÉOS BIEN-ÊTRE — LOGIQUE IA
══════════════════════════════════════════ */

/**
 * Couleurs par humeur pour les miniatures et tags
 */
const VB_COLORS = {
  anxieux: { bg:'#e8f0fe', grad:'#3b6dd1', tagBg:'#e8f0fe', tagColor:'#1a4db5' },
  triste:  { bg:'#f0ebfb', grad:'#7c5cbf', tagBg:'#ede9f7', tagColor:'#5a3ea0' },
  stresse: { bg:'#fff3e8', grad:'#c05a00', tagBg:'#fde8d0', tagColor:'#a04800' },
  fatigue: { bg:'#eef4ec', grad:'#5f7161', tagBg:'#dbecd7', tagColor:'#3a5c3d' },
  bien:    { bg:'#e1f5ee', grad:'#1d9e75', tagBg:'#c5ead9', tagColor:'#0d6b4f' },
};

/**
 * Génère des hauteurs de barres pseudo-aléatoires (waveform)
 */
function makeWaveBars(count) {
  const bars = [];
  for (let i = 0; i < count; i++) {
    bars.push(4 + Math.floor(Math.random() * 12));
  }
  return bars;
}

/**
 * Sélectionner une humeur et déclencher l'appel API
 */
async function choisirHumeur(btn) {
  document.querySelectorAll('.vb-mood-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  const humeur = btn.dataset.humeur;

  /* Afficher le loader */
  document.getElementById('vbResultZone').innerHTML = `
    <div class="vb-loading">
      <div class="vb-loading-orb">
        <div class="vb-loading-ring1"></div>
        <div class="vb-loading-ring2"></div>
        <div class="vb-loading-core"></div>
      </div>
      <div>L'IA analyse votre profil et cherche les meilleures vidéos…</div>
      <div class="vb-typing">
        <div class="vb-typing-dot"></div>
        <div class="vb-typing-dot"></div>
        <div class="vb-typing-dot"></div>
      </div>
    </div>
  `;

  try {
    const formData = new FormData();
    formData.append('humeur', humeur);

    const res  = await fetch('/rendez-vous/videos-humeur', { method: 'POST', body: formData });
    const json = await res.json();

    if (!json.success || !json.data) {
      showVbError();
      return;
    }

    renderVbVideos(humeur, json.data);

  } catch (e) {
    showVbError();
    console.error(e);
  }
}

function showVbError() {
  document.getElementById('vbResultZone').innerHTML = `
    <div class="vb-empty">
      <div class="vb-empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M12 8v4m0 4h.01M21 12A9 9 0 113 12a9 9 0 0118 0z" stroke="#c1d0b5" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      Impossible de charger les vidéos. Veuillez réessayer.
    </div>
  `;
}

/**
 * Rendu des vidéos retournées par l'API
 */
function renderVbVideos(humeur, d) {
  const c = VB_COLORS[humeur] || VB_COLORS['bien'];

  /* Conseil */
  const conseilHtml = `
    <div class="vb-conseil-box">
      <div class="vb-conseil-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="#eef4ec"/>
        </svg>
      </div>
      <div>${d.conseil}</div>
    </div>
  `;

  /* Grille vidéos */
  const videosHtml = (d.videos || []).map((v, i) => {
    const bars = makeWaveBars(15);
    const barsHtml = bars.map((h, bi) =>
      `<div class="vb-waveform-bar" style="height:${h}px;animation-delay:${(bi * 0.07).toFixed(2)}s;"></div>`
    ).join('');

    return `
      <div class="vb-video-card" style="animation-delay:${0.05 + i * 0.08}s;" onclick="window.open('${v.url}','_blank')">
        <div class="vb-thumb" style="background:linear-gradient(135deg,${c.grad}22,${c.grad}55);">
          <div class="vb-play-btn">
            <div class="vb-play-arrow"></div>
          </div>
          <div class="vb-waveform">${barsHtml}</div>
        </div>
        <div class="vb-video-body">
          <span class="vb-video-tag" style="background:${c.tagBg};color:${c.tagColor};">${v.tag}</span>
          <div class="vb-video-title">${v.titre}</div>
          <div class="vb-video-meta">
            <span style="font-size:10px;">▶</span>
            <span>${v.duree}</span>
          </div>
          <a class="vb-video-link" href="${v.url}" target="_blank" onclick="event.stopPropagation()">
            <i class="fas fa-external-link-alt" style="font-size:.65rem;margin-right:4px;"></i>Voir sur YouTube
          </a>
        </div>
      </div>
    `;
  }).join('');

  document.getElementById('vbResultZone').innerHTML = `
    <div style="animation:vb-fadeIn .35s ease;">
      ${conseilHtml}
      <div class="vb-videos-grid">${videosHtml}</div>
    </div>
  `;
}


/* ══════════════════════════════════════════
   SIDE PANEL
══════════════════════════════════════════ */

const FALLBACK = (name, isCoach) => {
  const c = isCoach ? '6D8B74' : '5F7161';
  return `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=${c}&color=fff&size=120`;
};

function openPanel(proId) {
  const pro = PROS_DATA[proId];
  if (!pro) return;

  const av = document.getElementById('spAvatar');
  av.src = pro.avatar || FALLBACK(pro.name, pro.role.includes('Coach'));
  document.getElementById('spName').textContent = pro.name;
  document.getElementById('spRole').textContent = pro.role;

  const meta = document.getElementById('spMeta');
  meta.innerHTML = '';
  if (pro.location) meta.innerHTML += `<span class="sp-meta-chip"><i class="fas fa-location-dot"></i>${pro.location}</span>`;
  if (pro.phone)    meta.innerHTML += `<span class="sp-meta-chip"><i class="fas fa-phone"></i>${pro.phone}</span>`;
  if (pro.email)    meta.innerHTML += `<span class="sp-meta-chip"><i class="fas fa-envelope"></i>${pro.email}</span>`;

  document.getElementById('spProId').value = proId;
  document.getElementById('slotPreview').style.display = 'none';
  document.getElementById('bookPrompt').style.display  = 'none';
  document.getElementById('bookNoSlot').style.display  = 'block';

  const slots = SLOTS_DATA[proId] || [];
  const grid  = document.getElementById('slotsGrid');
  const none  = document.getElementById('noSlots');
  grid.innerHTML = '';

  if (slots.length === 0) {
    none.style.display = 'block';
  } else {
    none.style.display = 'none';
    buildCalendar(slots, grid, 0);
  }

  switchTab('slots');
  document.getElementById('panelBackdrop').classList.add('open');
  document.getElementById('sidePanel').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function buildCalendar(slots, container, weekOffset) {
  container.innerHTML = '';

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const dayNames = ['dim.','lun.','mar.','mer.','jeu.','ven.','sam.'];
  const months   = ['jan','fév','mars','avr','mai','juin','juil','août','sep','oct','nov','déc'];

  const slotsByNom = {};
  slots.forEach(slot => {
    if (!slotsByNom[slot.date]) slotsByNom[slot.date] = [];
    slotsByNom[slot.date].push(slot);
  });

  const jourToDow = {
    'Dimanche':0,'Lundi':1,'Mardi':2,'Mercredi':3,'Jeudi':4,'Vendredi':5,'Samedi':6
  };
  Object.keys(slotsByNom).forEach(jourNom => {
    const dow = jourToDow[jourNom] ?? -1;
    slotsByNom[jourNom] = slotsByNom[jourNom].filter(slot => {
      const [hh, mm] = slot.debut.split(':').map(Number);
      const minutes = hh * 60 + mm;
      if (dow === 0) return false;
      if (dow >= 1 && dow <= 5) return !(minutes >= 720 && minutes < 840);
      if (dow === 6) return minutes < 720;
      return true;
    });
  });

  const days = [];
  let d = new Date(today);
  d.setDate(today.getDate() + weekOffset * 5);
  while (days.length < 7) {
    days.push(new Date(d));
    d.setDate(d.getDate() + 1);
  }

  const dowToNom = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
  const slotsByDow = {};
  days.forEach(day => {
    const nom = dowToNom[day.getDay()];
    slotsByDow[day.getDay()] = slotsByNom[nom] || [];
  });

  const totalVisible = Object.values(slotsByDow).reduce((s, a) => s + a.length, 0);
  if (totalVisible === 0) {
    document.getElementById('noSlots').style.display = 'block';
    return;
  }
  document.getElementById('noSlots').style.display = 'none';

  const navRow = document.createElement('div');
  navRow.className = 'cal-nav-row';
  navRow.innerHTML = `
    <button class="cal-nav-btn" id="calPrev"><i class="fas fa-chevron-left"></i></button>
    <span class="cal-week-label">${days[0].getDate()} – ${days[4].getDate()} ${months[days[4].getMonth()]}</span>
    <button class="cal-nav-btn" id="calNext"><i class="fas fa-chevron-right"></i></button>
  `;
  container.appendChild(navRow);

  const table = document.createElement('table');
  table.className = 'cal-table';

  const thead = document.createElement('thead');
  const headRow = document.createElement('tr');
  days.forEach(day => {
    const th = document.createElement('th');
    const isSam = day.getDay() === 6;
    const isSun = day.getDay() === 0;
    th.innerHTML = `
      <span class="cal-day-name" style="${isSun?'color:#c0392b':isSam?'color:#c05a00':''}">
        ${dayNames[day.getDay()]}
      </span>
      <span class="cal-day-date">${day.getDate()} ${months[day.getMonth()]}</span>
      ${isSun ? '<span style="display:block;font-size:.58rem;color:#c0392b;margin-top:2px;">pas de travail</span>' : ''}
      ${isSam ? '<span style="display:block;font-size:.58rem;color:#c05a00;margin-top:2px;">jusqu\'à 12h</span>' : ''}
    `;
    headRow.appendChild(th);
  });
  thead.appendChild(headRow);
  table.appendChild(thead);

  const tbody = document.createElement('tbody');
  const maxRows = 3;
  const showMore = {};
  days.forEach(day => {
    showMore[day.getDay()] = (slotsByDow[day.getDay()] || []).length > maxRows;
  });
  const expandedCols = {};

  function makeSlotBtn(slot, day) {
    const reservedDatesForSlot = RESERVED_DATES[slot.id] || [];
    const isoDate =
      day.getFullYear() + '-' +
      String(day.getMonth() + 1).padStart(2, '0') + '-' +
      String(day.getDate()).padStart(2, '0');
    const reserved = reservedDatesForSlot.includes(isoDate);
    const btn = document.createElement('button');
    btn.className = 'slot-time-btn' + (reserved ? ' taken' : '');
    btn.textContent = slot.debut;
    btn.disabled = reserved;
    if (!reserved) {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.slot-time-btn.selected').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        document.getElementById('spRdvId').value = slot.id;
        const typeLabel = slot.type === 'en_ligne' ? 'En ligne' : 'Présentiel';
        const dateStr = `${day.getDate()} ${months[day.getMonth()]} ${day.getFullYear()}`;
        document.getElementById('slotPreviewText').textContent =
          `${dateStr}  •  ${slot.debut} – ${slot.fin}  •  ${typeLabel}`;
        document.getElementById('slotPreview').style.display = 'flex';
        document.getElementById('bookPrompt').style.display  = 'block';
        document.getElementById('bookNoSlot').style.display  = 'none';
        document.getElementById('spDateRdvHidden').value = isoDate;
        setTimeout(() => switchTab('book'), 260);
      });
    }
    return btn;
  }

  function renderRows(expanded) {
    tbody.innerHTML = '';

    for (let row = 0; row < maxRows; row++) {
      const tr = document.createElement('tr');
      days.forEach(day => {
        const dow = day.getDay();
        const daySlots = slotsByDow[dow] || [];
        const slot = daySlots[row];
        const td = document.createElement('td');
        if (slot) td.appendChild(makeSlotBtn(slot, day));
        else td.innerHTML = '<span class="cal-empty">–</span>';
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    }

    if (Object.keys(expanded).length > 0) {
      const maxExtra = Math.max(
        ...days.map(day => {
          const dow = day.getDay();
          return expanded[dow] ? (slotsByDow[dow] || []).length - maxRows : 0;
        })
      );
      for (let row = 0; row < maxExtra; row++) {
        const tr = document.createElement('tr');
        days.forEach(day => {
          const dow = day.getDay();
          const slot = expanded[dow] ? (slotsByDow[dow] || [])[maxRows + row] : null;
          const td = document.createElement('td');
          if (slot) td.appendChild(makeSlotBtn(slot, day));
          else td.innerHTML = '<span class="cal-empty"></span>';
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      }
    }

    const hasMore = days.some(day => showMore[day.getDay()] && !expanded[day.getDay()]);
    if (hasMore) {
      const moreRow = document.createElement('tr');
      moreRow.className = 'cal-more-row';
      const moreTd = document.createElement('td');
      moreTd.colSpan = 7; moreTd.style.textAlign = 'center';
      const moreBtn = document.createElement('button');
      moreBtn.className = 'cal-more-btn';
      moreBtn.innerHTML = 'Plus de disponibilités <i class="fas fa-chevron-down"></i>';
      moreBtn.addEventListener('click', () => {
        days.forEach(day => { if (showMore[day.getDay()]) expanded[day.getDay()] = true; });
        renderRows(expanded);
      });
      moreTd.appendChild(moreBtn);
      moreRow.appendChild(moreTd);
      tbody.appendChild(moreRow);
    }
  }

  renderRows(expandedCols);
  table.appendChild(tbody);
  container.appendChild(table);

  const legend = document.createElement('div');
  legend.style.cssText = 'margin-top:12px;padding:8px 12px;background:#f5f0e8;border-radius:8px;font-size:.7rem;color:#9a7a4a;font-family:Instrument Sans,sans-serif;display:flex;gap:12px;flex-wrap:wrap;';
  legend.innerHTML = `
    <span>☕ Lun–Ven : pause 12h–14h</span>
    <span>🕛 Samedi : fermeture à 12h</span>
    <span>🚫 Dimanche : pas de travail</span>
  `;
  container.appendChild(legend);

  container.querySelector('#calPrev').addEventListener('click', () => {
    if (weekOffset > 0) buildCalendar(slots, container, weekOffset - 1);
  });
  container.querySelector('#calNext').addEventListener('click', () => {
    buildCalendar(slots, container, weekOffset + 1);
  });
}

function closePanel() {
  document.getElementById('panelBackdrop').classList.remove('open');
  document.getElementById('sidePanel').classList.remove('open');
  document.body.style.overflow = '';
}

function submitBooking() {
  const dateVal = document.getElementById('spDateRdvHidden').value;
  if (!dateVal) return;
  document.getElementById('bookForm').submit();
}

function switchTab(name) {
  document.querySelectorAll('.sp-tab').forEach((t, i) => {
    t.classList.toggle('active', (i === 0 && name === 'slots') || (i === 1 && name === 'book'));
  });
  document.getElementById('pane-slots').classList.toggle('active', name === 'slots');
  document.getElementById('pane-book').classList.toggle('active',  name === 'book');
}


