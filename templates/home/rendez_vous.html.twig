async function openReservationsPopup() {
  document.getElementById('popupBackdrop').classList.add('open');
  document.getElementById('popupBody').innerHTML =
    '<div class="popup-loading"><i class="fas fa-circle-notch"></i> Chargement…</div>';
  document.getElementById('popupSubtitle').textContent = 'Chargement…';
  document.body.style.overflow = 'hidden';

  try {
    const res  = await fetch(RDV_RESERVATIONS_URL);
    const data = await res.json();

    document.getElementById('rdvBadgeCount').textContent = data.length;
    document.getElementById('popupSubtitle').textContent =
      data.length + ' rendez-vous réservé' + (data.length > 1 ? 's' : '');

    if (data.length === 0) {
      document.getElementById('popupBody').innerHTML = `
        <div class="popup-empty">
          <i class="fas fa-calendar-xmark"></i>
          <p>Aucun rendez-vous réservé pour le moment.</p>
        </div>`;
      return;
    }

    const html = data.map((r, i) => `
      <div class="res-card-popup" style="animation-delay:${i * 0.055}s">
        <div class="res-stripe-popup"></div>
        <div class="res-body-popup">
          <img class="res-avatar-popup" src="${r.doctorAvatar}" alt="${r.doctorName}">
          <div class="res-info-popup">
            <div class="res-doctor-popup">${r.doctorName}</div>
            <div class="res-role-popup">${r.doctorRole}</div>
          </div>
          <div style="font-size:.75rem;color:var(--slate);margin-bottom:6px;font-family:'Instrument Sans',sans-serif;">
            <i class="fas fa-user" style="color:var(--slate-lt);margin-right:4px;"></i>
            Réservé par <strong style="color:var(--navy);">${r.userName}</strong>
          </div>
          <div class="res-meta-popup">
            <div class="res-chip-popup"><i class="fas fa-calendar"></i>${r.date}</div>
            <div class="res-chip-popup"><i class="fas fa-tag"></i>${r.jourNom}</div>
            <div class="res-chip-popup"><i class="fas fa-clock"></i>${r.debut} – ${r.fin}</div>
            <div class="res-chip-popup">
              <i class="fas fa-${r.type === 'en_ligne' ? 'video' : 'building'}"></i>
              ${r.type === 'en_ligne' ? 'En ligne' : 'Présentiel'}
            </div>
            <div class="res-chip-popup"><i class="fas fa-calendar-plus"></i>Réservé le ${r.reservedAt}</div>
          </div>
          <span class="res-status-popup ${r.statut}">
            <i class="fas fa-${r.statut==='confirme'?'check-circle':r.statut==='annule'?'times-circle':'hourglass-half'}"></i>
            ${r.statut==='confirme'?'Confirmé':r.statut==='annule'?'Annulé':'En attente'}
          </span>
          <div class="res-lock-popup"><i class="fas fa-lock"></i> Non modifiable</div>
        </div>
      </div>`).join('');

    document.getElementById('popupBody').innerHTML =
      `<div class="res-list-popup">${html}</div>`;

  } catch (e) {
    document.getElementById('popupBody').innerHTML =
      '<div class="popup-empty"><i class="fas fa-triangle-exclamation"></i><p>Erreur de chargement.</p></div>';
  }
}

function closeReservationsPopup(e) {
  if (e && e.target !== document.getElementById('popupBackdrop')) return;
  document.getElementById('popupBackdrop').classList.remove('open');
  document.body.style.overflow = '';
}


