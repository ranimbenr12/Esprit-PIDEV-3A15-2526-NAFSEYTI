</div>{# /rdv-page #}

{# ════ DONNÉES JSON ════ #}
<script>
const SLOTS_DATA = {
  {% for pro in professionals %}
  "{{ pro.id }}": [
    {% for slot in slots[pro.id] ?? [] %}
    {
      id:    {{ slot.id }},
      date:  "{{ slot.dateRendezVous|date('d/m/Y') }}",
      debut: "{{ slot.heureDebut|date('H:i') }}",
      fin:   "{{ slot.heureFin|date('H:i') }}",
      type:  "{{ slot.typeSeance }}",
      statut:"{{ slot.statut }}"
    }{{ not loop.last ? ',' : '' }}
    {% endfor %}
  ]{{ not loop.last ? ',' : '' }}
  {% endfor %}
};

const PROS_DATA = {
  {% for pro in professionals %}
  "{{ pro.id }}": {
    name:     "{{ pro.firstname|e('html_attr') }} {{ pro.lastname|e('html_attr') }}",
    role:     "{{ (pro.role == 'coach_vie') ? 'Coach de vie' : 'Psychologue' }}",
    email:    "{{ pro.email|default('')|e('html_attr') }}",
    phone:    "{{ pro.phone_number|default('')|e('html_attr') }}",
    location: "{{ pro.location|default('')|e('html_attr') }}",
    avatar:   "{{ pro.profile_photo ? asset('uploads/photos/' ~ pro.profile_photo) : '' }}"
  }{{ not loop.last ? ',' : '' }}
  {% endfor %}
};
</script>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const FALLBACK = (name, isCoach) => {
  const c = isCoach ? '6D8B74' : '5F7161';
  return `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=${c}&color=fff&size=120`;
};

/* ══ Open panel ══ */
function openPanel(proId) {
  const pro = PROS_DATA[proId];
  if (!pro) return;

  const av = document.getElementById('spAvatar');
  av.src = pro.avatar || FALLBACK(pro.name, pro.role.includes('Coach'));
  document.getElementById('spName').textContent = pro.name;
  document.getElementById('spRole').textContent = pro.role;

  const meta = document.getElementById('spMeta');
  meta.innerHTML = '';
  if (pro.location) meta.innerHTML += `<span class="sp-meta-chip"><i class="fas fa-location-dot"></i>${pro.location}</span>`;
  if (pro.phone)    meta.innerHTML += `<span class="sp-meta-chip"><i class="fas fa-phone"></i>${pro.phone}</span>`;
  if (pro.email)    meta.innerHTML += `<span class="sp-meta-chip"><i class="fas fa-envelope"></i>${pro.email}</span>`;

  document.getElementById('spProId').value = proId;
  document.getElementById('slotPreview').style.display = 'none';
  document.getElementById('bookPrompt').style.display  = 'none';
  document.getElementById('bookNoSlot').style.display  = 'block';

  const slots = SLOTS_DATA[proId] || [];
  const grid  = document.getElementById('slotsGrid');
  const none  = document.getElementById('noSlots');
  grid.innerHTML = '';

  if (slots.length === 0) {
    none.style.display = 'block';
  } else {
    none.style.display = 'none';
    slots.forEach(slot => {
      const enLigne  = slot.type === 'en_ligne';
      const reserved = slot.statut === 'en attente';
      const card = document.createElement('div');
      card.className = 'slot-card' + (reserved ? ' slot-reserved' : '');
      card.dataset.id    = slot.id;
      card.dataset.date  = slot.date;
      card.dataset.debut = slot.debut;
      card.dataset.fin   = slot.fin;
      card.dataset.type  = slot.type;
      card.innerHTML = `
        <div class="slot-date">
          <i class="fas fa-calendar" style="margin-right:5px;font-size:.65rem;color:var(--blue-acc)"></i>${slot.date}
        </div>
        <div class="slot-time"><i class="fas fa-clock"></i>${slot.debut} – ${slot.fin}</div>
        <span class="slot-type-badge ${enLigne ? 'enligne' : 'presentiel'}">
          <i class="fas fa-${enLigne ? 'video' : 'building'}"></i>
          ${enLigne ? 'En ligne' : 'Présentiel'}
        </span>
        ${reserved ? '<span class="slot-taken"><i class="fas fa-lock"></i> En attente</span>' : ''}`;
      if (!reserved) {
        card.addEventListener('click', () => selectSlot(card));
      }
      grid.appendChild(card);
    });
  }

  switchTab('slots');
  document.getElementById('panelBackdrop').classList.add('open');
  document.getElementById('sidePanel').classList.add('open');
  document.body.style.overflow = 'hidden';
}

/* ══ Close panel ══ */
function closePanel() {
  document.getElementById('panelBackdrop').classList.remove('open');
  document.getElementById('sidePanel').classList.remove('open');
  document.body.style.overflow = '';
}

/* ══ Select slot ══ */
function selectSlot(card) {
  document.querySelectorAll('.slot-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
  document.getElementById('spRdvId').value = card.dataset.id;

  const typeLabel = card.dataset.type === 'en_ligne' ? 'En ligne' : 'Présentiel';
  document.getElementById('slotPreviewText').textContent =
    `${card.dataset.date}  •  ${card.dataset.debut} – ${card.dataset.fin}  •  ${typeLabel}`;
  document.getElementById('slotPreview').style.display = 'flex';
  document.getElementById('bookPrompt').style.display  = 'block';
  document.getElementById('bookNoSlot').style.display  = 'none';

  setTimeout(() => switchTab('book'), 260);
}

/* ══ Switch tabs ══ */
function switchTab(name) {
  document.querySelectorAll('.sp-tab').forEach((t, i) => {
    t.classList.toggle('active', (i === 0 && name === 'slots') || (i === 1 && name === 'book'));
  });
  document.getElementById('pane-slots').classList.toggle('active', name === 'slots');
  document.getElementById('pane-book').classList.toggle('active',  name === 'book');
}

/* ══ Popup Mes Réservations ══ */
async function openReservationsPopup() {
  document.getElementById('popupBackdrop').classList.add('open');
  document.getElementById('popupBody').innerHTML =
    '<div class="popup-loading"><i class="fas fa-circle-notch"></i> Chargement…</div>';
  document.getElementById('popupSubtitle').textContent = 'Chargement…';
  document.body.style.overflow = 'hidden';

  try {
    const res  = await fetch('{{ path("rdv_mes_reservations") }}');
    const data = await res.json();

    document.getElementById('rdvBadgeCount').textContent = data.length;
    document.getElementById('popupSubtitle').textContent =
      data.length + ' rendez-vous réservé' + (data.length > 1 ? 's' : '');

    if (data.length === 0) {
      document.getElementById('popupBody').innerHTML = `
        <div class="popup-empty">
          <i class="fas fa-calendar-xmark"></i>
          <p>Aucun rendez-vous réservé pour le moment.</p>
        </div>`;
      return;
    }

    const html = data.map((r, i) => `
      <div class="res-card-popup" style="animation-delay:${i * 0.055}s">
        <div class="res-stripe-popup"></div>
        <div class="res-body-popup">
          <img class="res-avatar-popup" src="${r.doctorAvatar}" alt="${r.doctorName}">
          <div class="res-info-popup">
            <div class="res-doctor-popup">${r.doctorName}</div>
            <div class="res-role-popup">${r.doctorRole}</div>
          </div>
          <div class="res-meta-popup">
            <div class="res-chip-popup"><i class="fas fa-calendar"></i>${r.date}</div>
            <div class="res-chip-popup"><i class="fas fa-clock"></i>${r.debut} – ${r.fin}</div>
            <div class="res-chip-popup">
              <i class="fas fa-${r.type === 'en_ligne' ? 'video' : 'building'}"></i>
              ${r.type === 'en_ligne' ? 'En ligne' : 'Présentiel'}
            </div>
            <div class="res-chip-popup"><i class="fas fa-calendar-plus"></i>Réservé le ${r.reservedAt}</div>
          </div>
          <span class="res-status-popup"><i class="fas fa-hourglass-half"></i> En attente</span>
          <div class="res-lock-popup"><i class="fas fa-lock"></i> Non modifiable</div>
        </div>
      </div>`).join('');

    document.getElementById('popupBody').innerHTML =
      `<div class="res-list-popup">${html}</div>`;

  } catch (e) {
    document.getElementById('popupBody').innerHTML =
      '<div class="popup-empty"><i class="fas fa-triangle-exclamation"></i><p>Erreur de chargement.</p></div>';
  }
}

function closeReservationsPopup(e) {
  if (e && e.target !== document.getElementById('popupBackdrop')) return;
  document.getElementById('popupBackdrop').classList.remove('open');
  document.body.style.overflow = '';
}

/* ══ Badge au chargement ══ */
fetch('{{ path("rdv_mes_reservations") }}')
  .then(r => r.json())
  .then(d => { document.getElementById('rdvBadgeCount').textContent = d.length; })
  .catch(() => { document.getElementById('rdvBadgeCount').textContent = '0'; });

/* ══ Filter & Search ══ */
document.querySelectorAll('.rdv-filter-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.rdv-filter-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    filterCards();
  });
});
document.getElementById('rdvSearch').addEventListener('input', filterCards);

function filterCards() {
  const filter = document.querySelector('.rdv-filter-btn.active').dataset.filter;
  const query  = document.getElementById('rdvSearch').value.toLowerCase().trim();
  let visible  = 0;
  document.querySelectorAll('.pro-card-h').forEach(card => {
    const show = ((filter === 'all') || (card.dataset.role === filter))
              && card.dataset.name.includes(query);
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('rdvCount').innerHTML =
    `<strong>${visible}</strong> professionnel${visible > 1 ? 's' : ''} disponible${visible > 1 ? 's' : ''}`;
}
</script>
{% endblock %}