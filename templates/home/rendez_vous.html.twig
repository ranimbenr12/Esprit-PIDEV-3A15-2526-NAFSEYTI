{# ════ POPUP MES RÉSERVATIONS ════ #}
<div class="popup-backdrop" id="popupBackdrop" onclick="closeReservationsPopup(event)">
  <div class="popup-box" id="popupBox">
    <div class="popup-header">
      <div class="popup-header-left">
        <div class="popup-header-icon"><i class="fas fa-calendar-check"></i></div>
