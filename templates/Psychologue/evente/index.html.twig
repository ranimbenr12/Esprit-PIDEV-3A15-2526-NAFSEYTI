    // Sort functionality — custom dropdown (no Bootstrap interference)
    const sortLabels = {
        title:      '📚 Par Titre (A → Z)',
        date:       '📅 Par Date (Récent)',
        activities: '🎯 Par Activités'
    };

    // Toggle menu open/close
    const sortBtn  = document.getElementById('sortBtn');
    const sortMenu = document.getElementById('sortMenu');

    sortBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = sortMenu.style.display === 'block';
        sortMenu.style.display = isOpen ? 'none' : 'block';
    });

    // Close when clicking outside
    document.addEventListener('click', () => { sortMenu.style.display = 'none'; });

    // Sort item click
    sortMenu.addEventListener('click', (e) => {
        const item = e.target.closest('.sort-item');
        if (!item) return;
        const sort = item.getAttribute('data-sort');

        // Reorder cards
        const container = document.getElementById('eventsContainer');
        const cards = [...container.querySelectorAll('.event-card')];
        cards.sort((a, b) => {
            if (sort === 'title')      return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'fr');
            if (sort === 'date')       return (b.dataset.date  || '').localeCompare(a.dataset.date  || '');
            if (sort === 'activities') return parseInt(b.dataset.activities || 0) - parseInt(a.dataset.activities || 0);
            return 0;
        });
        cards.forEach(card => container.appendChild(card));

        // Update button label
        sortBtn.textContent = sortLabels[sort] + ' ▾';

        // Highlight active item
        sortMenu.querySelectorAll('.sort-item').forEach(el => {
            el.classList.toggle('active-sort', el.getAttribute('data-sort') === sort);
        });

        sortMenu.style.display = 'none';
