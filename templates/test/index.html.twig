{% extends 'base.html.twig' %}

{% block title %}Gestion des Tests{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des tests psychologiques</h1>
        <a href="{{ path('app_test_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouveau test
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {% if tests is empty %}
                <div class="alert alert-info">
                    Aucun test n'a été créé pour le moment.
                    <a href="{{ path('app_test_new') }}">Créer le premier test</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Titre</th>
                                <th>Catégorie</th>
                                <th>Niveau</th>
                                <th>Durée</th>
                                <th>Questions</th>
                                <th>Statut</th>
                                <th>Créé le</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for test in tests %}
                                <tr>
                                    <td>{{ test.id }}</td>
                                    <td>{{ test.titre }}</td>
                                    <td>{{ test.categorie|capitalize }}</td>
                                    <td>{{ test.niveau|capitalize }}</td>
                                    <td>{{ test.duree ? test.duree ~ ' min' : '-' }}</td>
                                    <td>
                                        <span class="badge bg-info">
                                            {{ test.questions|length }} question(s)
                                        </span>
                                    </td>
                                    <td>
                                        {% if test.status == 'actif' %}
                                            <span class="badge bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-danger">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ test.createdAt|date('d/m/Y') }}</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_test_show', {'id': test.id}) }}" 
                                               class="btn btn-sm btn-info" title="Voir">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('app_test_edit', {'id': test.id}) }}" 
                                               class="btn btn-sm btn-warning" title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_test_delete', {'id': test.id}) }}" 
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce test ?');" 
                                                  style="display: inline-block;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ test.id) }}">
                                                <button class="btn btn-sm btn-danger" title="Supprimer">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}