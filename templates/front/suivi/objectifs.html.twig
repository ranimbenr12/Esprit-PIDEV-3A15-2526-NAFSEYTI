{% extends 'base.html.twig' %}

{% block title %}Objectifs — {{ suivi.titre }} — Nafseyti{% endblock %}

{% block body %}
<style>
    :root {
        --green-deep: #2D5016;
        --green-mid: #4A7C2F;
        --green-sage: #7BA05B;
        --green-light: #A8C68F;
        --green-pale: #D4E6C3;
        --beige-mid: #D9C4A0;
        --beige-light: #EDE3D0;
        --beige-cream: #F7F2E8;
        --beige-white: #FDFAF5;
        --text-dark: #1A2E0A;
        --text-mid: #3D5C28;
    }

    .obj-hero {
        background: linear-gradient(135deg, var(--green-deep) 0%, var(--green-mid) 100%);
        padding: 70px 60px 50px;
        position: relative;
        overflow: hidden;
    }
    .obj-hero::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 300px; height: 300px;
        border-radius: 50%;
        background: rgba(168,198,143,0.1);
    }
    .obj-hero-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--green-light);
        text-decoration: none;
        font-size: 0.78rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 20px;
        position: relative;
        transition: color 0.2s;
    }
    .obj-hero-back:hover { color: var(--beige-cream); }
    .obj-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        color: var(--beige-cream);
        font-weight: 400;
        position: relative;
    }
    .obj-hero h1 em { font-style: italic; color: var(--green-light); }
    .obj-hero-meta {
        display: flex;
        gap: 20px;
        margin-top: 14px;
        flex-wrap: wrap;
        position: relative;
    }
    .obj-hero-meta span {
        font-size: 0.78rem;
        color: rgba(237,227,208,0.7);
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .obj-hero-meta i { color: var(--green-light); }

    .obj-page { background: var(--beige-white); min-height: 60vh; padding: 60px; }

    .btn-add-obj {
        background: var(--green-mid);
        color: var(--beige-cream);
        border: none;
        padding: 13px 28px;
        font-size: 0.78rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-add-obj:hover { background: var(--green-deep); transform: translateY(-2px); }

    .obj-list { margin-top: 36px; display: flex; flex-direction: column; gap: 16px; }

    .obj-item {
        background: white;
        border: 1px solid var(--beige-light);
        border-radius: 8px;
        padding: 24px 28px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
        transition: all 0.3s;
        position: relative;
    }
    .obj-item:hover {
        border-color: var(--green-sage);
        box-shadow: 0 8px 30px rgba(45,80,22,0.1);
    }
    .obj-item.valide { border-left: 4px solid var(--green-sage); }
    .obj-item.en-cours { border-left: 4px solid var(--beige-dark, #C4A882); }

    .obj-check {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.9rem;
        margin-top: 2px;
    }
    .obj-check.done { background: var(--green-pale); color: var(--green-deep); }
    .obj-check.pending { background: #FFF3CD; color: #856404; }

    .obj-body { flex: 1; }
    .obj-body h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        color: var(--text-dark);
        margin-bottom: 6px;
        font-weight: 600;
    }
    .obj-body p { font-size: 0.87rem; color: #6B7D5A; line-height: 1.6; margin-bottom: 10px; }
    .obj-meta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
    .obj-meta span {
        font-size: 0.72rem;
        color: #8A9B7A;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .obj-meta i { color: var(--green-sage); }

    .obj-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
        align-items: flex-start;
    }
    .btn-obj {
        padding: 8px 14px;
        font-size: 0.72rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .btn-obj-edit { background: var(--beige-light); color: var(--text-mid); }
    .btn-obj-edit:hover { background: var(--beige-mid); }
    .btn-obj-delete { background: #FEE2E2; color: #991B1B; }
    .btn-obj-delete:hover { background: #FECACA; }

    .empty-state {
        text-align: center;
        padding: 60px 40px;
        color: #6B7D5A;
    }
    .empty-state i { font-size: 3.5rem; color: var(--green-pale); margin-bottom: 16px; display: block; }
    .empty-state h3 { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--text-mid); margin-bottom: 8px; }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(26,46,10,0.6);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }
    .modal-overlay.active { display: flex; }
    .modal-box {
        background: white;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 500px;
        position: relative;
        animation: slideUp 0.3s ease;
    }
    @keyframes slideUp {
        from { transform: translateY(30px); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
    }
    .modal-box h2 {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        color: var(--text-dark);
        margin-bottom: 24px;
    }
    .modal-close {
        position: absolute;
        top: 16px; right: 20px;
        background: none;
        border: none;
        font-size: 1.4rem;
        color: #999;
        cursor: pointer;
    }
    .form-field { margin-bottom: 16px; }
    .form-field label {
        display: block;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--green-mid);
        margin-bottom: 7px;
        font-weight: 600;
    }
    .form-field input,
    .form-field textarea {
        width: 100%;
        border: 1px solid var(--beige-mid);
        background: var(--beige-cream);
        padding: 11px 15px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        color: var(--text-dark);
        border-radius: 4px;
        outline: none;
        transition: border-color 0.3s;
    }
    .form-field input:focus,
    .form-field textarea:focus { border-color: var(--green-sage); background: white; }
    .modal-footer-btns {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 22px;
    }
    .btn-cancel {
        background: var(--beige-light);
        color: var(--text-mid);
        border: none;
        padding: 11px 22px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.82rem;
        font-weight: 600;
    }
    .btn-save {
        background: var(--green-mid);
        color: white;
        border: none;
        padding: 11px 26px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.82rem;
        font-weight: 600;
        transition: background 0.2s;
    }
    .btn-save:hover { background: var(--green-deep); }

    /* Confirm delete */
    .confirm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(26,46,10,0.6);
        z-index: 99999;
        align-items: center;
        justify-content: center;
    }
    .confirm-overlay.active { display: flex; }
    .confirm-box {
        background: white;
        border-radius: 12px;
        padding: 36px;
        max-width: 400px;
        width: 100%;
        text-align: center;
    }
    .confirm-box i { font-size: 2.5rem; color: #EF4444; margin-bottom: 16px; display: block; }
    .confirm-box h3 { font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--text-dark); margin-bottom: 10px; }
    .confirm-box p { font-size: 0.88rem; color: #6B7D5A; margin-bottom: 24px; }
    .confirm-btns { display: flex; gap: 12px; justify-content: center; }
    .btn-confirm-cancel { background: var(--beige-light); color: var(--text-mid); border: none; padding: 11px 22px; border-radius: 4px; cursor: pointer; font-weight: 600; }
    .btn-confirm-delete { background: #EF4444; color: white; border: none; padding: 11px 22px; border-radius: 4px; cursor: pointer; font-weight: 600; transition: background 0.2s; }
    .btn-confirm-delete:hover { background: #DC2626; }

    .toast-msg {
        position: fixed;
        bottom: 30px; right: 30px;
        background: var(--green-deep);
        color: var(--beige-cream);
        padding: 14px 24px;
        border-radius: 8px;
        font-size: 0.88rem;
        z-index: 99999;
        display: none;
    }
</style>

<!-- Hero -->
<section class="obj-hero">
    <a href="{{ path('front_suivi_index') }}" class="obj-hero-back">
        <i class="fas fa-arrow-left"></i> Retour aux suivis
    </a>
    <h1>Objectifs — <em>{{ suivi.titre }}</em></h1>
    <div class="obj-hero-meta">
        <span><i class="fas fa-tag"></i> {{ suivi.typeSuivi }}</span>
        <span><i class="fas fa-tasks"></i> {{ objectifs|length }} objectif(s)</span>
        {% set nb_valides = objectifs|filter(o => o.valide)|length %}
        <span><i class="fas fa-check-circle"></i> {{ nb_valides }} validé(s)</span>
    </div>
</section>

<!-- Page content -->
<section class="obj-page">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:3px;color:var(--green-sage);margin-bottom:6px;">
                <span style="display:inline-block;width:24px;height:1px;background:var(--green-sage);vertical-align:middle;margin-right:8px;"></span>
                Mes objectifs
            </div>
            <h2 style="font-family:'Playfair Display',serif;font-size:1.6rem;color:var(--text-dark);font-weight:400;">
                Gérez vos <em style="font-style:italic;color:var(--green-mid);">objectifs</em>
            </h2>
        </div>
        <button class="btn-add-obj" onclick="openModal()">
            <i class="fas fa-plus"></i> Nouvel objectif
        </button>
    </div>

    {% if objectifs|length == 0 %}
    <div class="empty-state">
        <i class="fas fa-bullseye"></i>
        <h3>Aucun objectif pour ce suivi</h3>
        <p>Ajoutez votre premier objectif pour commencer à progresser.</p>
    </div>
    {% else %}
    <div class="obj-list">
        {% for objectif in objectifs %}
        <div class="obj-item {{ objectif.valide ? 'valide' : 'en-cours' }}" id="obj-{{ objectif.idobjectif }}">
            <div class="obj-check {{ objectif.valide ? 'done' : 'pending' }}">
                <i class="fas {{ objectif.valide ? 'fa-check' : 'fa-clock' }}"></i>
            </div>
            <div class="obj-body">
                <h3>{{ objectif.titre }}</h3>
                {% if objectif.description %}
                <p>{{ objectif.description }}</p>
                {% endif %}
                <div class="obj-meta">
                    <span>
                        <i class="fas fa-calendar-alt"></i>
                        Créé le {{ objectif.dateCreation|date('d/m/Y') }}
                    </span>
                    {% if objectif.dateEcheance %}
                    <span>
                        <i class="fas fa-flag"></i>
                        Échéance : {{ objectif.dateEcheance|date('d/m/Y') }}
                    </span>
                    {% endif %}
                    <span>
                        <i class="fas fa-circle" style="color:{{ objectif.valide ? 'var(--green-sage)' : '#F59E0B' }};font-size:0.5rem;"></i>
                        {{ objectif.valide ? 'Validé' : 'En cours' }}
                    </span>
                </div>
            </div>
            <div class="obj-actions">
                <button class="btn-obj btn-obj-edit" onclick="editObjectif({{ objectif.idobjectif }})">
                    <i class="fas fa-pen"></i> Modifier
                </button>
                <button class="btn-obj btn-obj-delete" onclick="confirmDelete({{ objectif.idobjectif }})">
                    <i class="fas fa-trash"></i> Supprimer
                </button>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</section>

<!-- Modal Ajouter / Modifier objectif -->
<div class="modal-overlay" id="modalOverlay">
    <div class="modal-box">
        <button class="modal-close" onclick="closeModal()">&times;</button>
        <h2 id="modalTitle">Nouvel objectif</h2>
        <form id="objForm">
            <input type="hidden" id="objId" value="0">
            <div class="form-field">
                <label>Titre *</label>
                <input type="text" id="fTitre" placeholder="Ex : Méditer 10 min par jour" required>
            </div>
            <div class="form-field">
                <label>Description</label>
                <textarea id="fDescription" rows="3" placeholder="Décrivez cet objectif…"></textarea>
            </div>
            <div class="form-field">
                <label>Date d'échéance</label>
                <input type="date" id="fDate">
            </div>
            <div class="modal-footer-btns">
                <button type="button" class="btn-cancel" onclick="closeModal()">Annuler</button>
                <button type="submit" class="btn-save">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

<!-- Confirm delete -->
<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-box">
        <i class="fas fa-exclamation-triangle"></i>
        <h3>Supprimer cet objectif ?</h3>
        <p>Cette action est irréversible. L'objectif sera définitivement supprimé.</p>
        <div class="confirm-btns">
            <button class="btn-confirm-cancel" onclick="closeConfirm()">Annuler</button>
            <button class="btn-confirm-delete" id="btnConfirmDelete">Supprimer</button>
        </div>
    </div>
</div>

<div class="toast-msg" id="toast"></div>

<script>
const SUIVI_ID = {{ suivi.idsuivi }};
let deleteTargetId = null;

// ── Modal ──────────────────────────────────────────────────────────────────
function openModal() {
    document.getElementById('modalTitle').textContent = 'Nouvel objectif';
    document.getElementById('objId').value = '0';
    document.getElementById('fTitre').value = '';
    document.getElementById('fDescription').value = '';
    document.getElementById('fDate').value = '';
    document.getElementById('modalOverlay').classList.add('active');
}

function closeModal() {
    document.getElementById('modalOverlay').classList.remove('active');
}

function editObjectif(id) {
    fetch('/suivi/objectif/' + id + '/json')
        .then(r => r.json())
        .then(data => {
            document.getElementById('modalTitle').textContent = 'Modifier l\'objectif';
            document.getElementById('objId').value = data.id;
            document.getElementById('fTitre').value = data.titre;
            document.getElementById('fDescription').value = data.description || '';
            document.getElementById('fDate').value = data.date_echeance || '';
            document.getElementById('modalOverlay').classList.add('active');
        });
}

document.getElementById('objForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const id = document.getElementById('objId').value;
    const url = id > 0
        ? '/suivi/objectif/' + id + '/edit'
        : '/suivi/' + SUIVI_ID + '/objectifs/new';
    const body = new URLSearchParams({
        titre: document.getElementById('fTitre').value,
        description: document.getElementById('fDescription').value,
        date_echeance: document.getElementById('fDate').value,
    });
    fetch(url, { method: 'POST', body })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                closeModal();
                showToast(id > 0 ? 'Objectif modifié !' : 'Objectif ajouté !');
                setTimeout(() => location.reload(), 900);
            } else {
                alert('Erreur : ' + data.error);
            }
        });
});

document.getElementById('modalOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});

// ── Suppression ────────────────────────────────────────────────────────────
function confirmDelete(id) {
    deleteTargetId = id;
    document.getElementById('confirmOverlay').classList.add('active');
}

function closeConfirm() {
    document.getElementById('confirmOverlay').classList.remove('active');
    deleteTargetId = null;
}

document.getElementById('btnConfirmDelete').addEventListener('click', function() {
    if (!deleteTargetId) return;
    fetch('/suivi/objectif/' + deleteTargetId + '/delete', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const el = document.getElementById('obj-' + deleteTargetId);
                if (el) el.style.transition = 'opacity 0.3s';
                if (el) el.style.opacity = '0';
                setTimeout(() => {
                    if (el) el.remove();
                    closeConfirm();
                    showToast('Objectif supprimé.');
                }, 300);
            } else {
                alert('Erreur : ' + data.error);
            }
        });
});

document.getElementById('confirmOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeConfirm();
});

// ── Toast ──────────────────────────────────────────────────────────────────
function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 2500);
}
</script>
{% endblock %}
