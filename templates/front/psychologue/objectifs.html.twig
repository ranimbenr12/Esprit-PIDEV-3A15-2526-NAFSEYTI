{% extends 'base.html.twig' %}
{% block title %}Psychologue — Objectifs : {{ suivi.titre }}{% endblock %}

{% block body %}
<style>
/* Cacher la navbar sur les pages psychologue */
.navbar-wrap { display: none !important; }

:root{--green-deep:#2D5016;--green-mid:#4A7C2F;--green-sage:#7BA05B;--green-light:#A8C68F;--green-pale:#D4E6C3;--beige-light:#EDE3D0;--beige-cream:#F7F2E8;--beige-white:#FDFAF5;--text-dark:#1A2E0A;--text-mid:#3D5C28;}

.psy-hero{background:linear-gradient(135deg,var(--green-deep),var(--green-mid));padding:70px 60px 50px;position:relative;overflow:hidden;}
.psy-hero::before{content:'';position:absolute;top:-60px;right:-60px;width:300px;height:300px;border-radius:50%;background:rgba(168,198,143,.1);}
.hero-back{display:inline-flex;align-items:center;gap:8px;color:var(--green-light);text-decoration:none;font-size:.78rem;letter-spacing:2px;text-transform:uppercase;margin-bottom:20px;position:relative;transition:color .2s;}
.hero-back:hover{color:var(--beige-cream);}
.psy-hero h1{font-family:'Playfair Display',serif;font-size:2.2rem;color:var(--beige-cream);font-weight:400;position:relative;}
.psy-hero h1 em{font-style:italic;color:var(--green-light);}
.hero-meta{display:flex;gap:20px;margin-top:14px;flex-wrap:wrap;position:relative;}
.hero-meta span{font-size:.78rem;color:rgba(237,227,208,.7);display:flex;align-items:center;gap:6px;}
.hero-meta i{color:var(--green-light);}

.psy-page{background:var(--beige-white);min-height:60vh;padding:60px;}
.toolbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:32px;}
.btn-add{background:var(--green-mid);color:white;border:none;padding:12px 28px;font-size:.78rem;letter-spacing:2px;text-transform:uppercase;font-weight:600;border-radius:4px;cursor:pointer;transition:all .3s;display:inline-flex;align-items:center;gap:8px;}
.btn-add:hover{background:var(--green-deep);transform:translateY(-2px);}
.search-wrap{display:flex;align-items:center;gap:0;border:1px solid var(--beige-light);border-radius:4px;overflow:hidden;background:white;}
.search-wrap i{padding:0 14px;color:var(--green-sage);}
.search-wrap input{border:none;outline:none;padding:10px 0;font-size:.88rem;color:var(--text-dark);background:transparent;width:260px;}
.search-wrap button{background:none;border:none;padding:0 12px;color:#aaa;cursor:pointer;}

.table-wrap{background:white;border:1px solid var(--beige-light);border-radius:8px;overflow:hidden;}
.table-head{padding:20px 28px;border-bottom:1px solid var(--beige-light);display:flex;align-items:center;gap:10px;}
.table-head h3{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--text-dark);font-weight:600;margin:0;}
table{width:100%;border-collapse:collapse;}
thead th{background:var(--beige-cream);padding:12px 16px;font-size:.72rem;text-transform:uppercase;letter-spacing:2px;color:var(--text-mid);font-weight:600;text-align:left;border-bottom:1px solid var(--beige-light);}
tbody td{padding:14px 16px;font-size:.88rem;color:var(--text-dark);border-bottom:1px solid var(--beige-light);vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover{background:var(--beige-cream);}
.badge-valide{background:#d4edda;color:#155724;font-size:.65rem;padding:4px 12px;border-radius:100px;display:inline-block;}
.badge-encours{background:#fff3cd;color:#856404;font-size:.65rem;padding:4px 12px;border-radius:100px;display:inline-block;}

.btn-action{padding:7px 14px;font-size:.72rem;letter-spacing:1px;text-transform:uppercase;border-radius:4px;border:none;cursor:pointer;font-weight:600;display:inline-flex;align-items:center;gap:5px;transition:all .2s;margin:2px;}
.btn-edit{background:var(--beige-light);color:var(--text-mid);}
.btn-edit:hover{background:#D9C4A0;}
.btn-validate{background:var(--green-pale);color:var(--green-deep);}
.btn-validate:hover{background:var(--green-light);}
.btn-del{background:#FEE2E2;color:#991B1B;}
.btn-del:hover{background:#FECACA;}
.btn-media{background:#e8f4fd;color:#0c5460;}
.btn-media:hover{background:#bee5eb;}

/* Modal */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(26,46,10,.6);z-index:9999;align-items:center;justify-content:center;}
.modal-overlay.active{display:flex;}
.modal-box{background:white;border-radius:12px;padding:40px;width:100%;max-width:520px;position:relative;animation:slideUp .3s ease;}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-box h2{font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--text-dark);margin-bottom:24px;}
.modal-close{position:absolute;top:16px;right:20px;background:none;border:none;font-size:1.4rem;color:#999;cursor:pointer;}
.form-field{margin-bottom:16px;}
.form-field label{display:block;font-size:.68rem;text-transform:uppercase;letter-spacing:2px;color:var(--green-mid);margin-bottom:7px;font-weight:600;}
.form-field input,.form-field textarea{width:100%;border:1px solid var(--beige-light);background:var(--beige-cream);padding:11px 15px;font-family:'DM Sans',sans-serif;font-size:.9rem;color:var(--text-dark);border-radius:4px;outline:none;transition:border-color .3s;}
.form-field input:focus,.form-field textarea:focus{border-color:var(--green-sage);background:white;}
.form-field .err{color:#dc3545;font-size:.75rem;margin-top:4px;display:none;}
.modal-btns{display:flex;gap:12px;justify-content:flex-end;margin-top:22px;}
.btn-cancel{background:var(--beige-light);color:var(--text-mid);border:none;padding:11px 22px;border-radius:4px;cursor:pointer;font-size:.82rem;font-weight:600;}
.btn-save{background:var(--green-mid);color:white;border:none;padding:11px 26px;border-radius:4px;cursor:pointer;font-size:.82rem;font-weight:600;}
.btn-save:hover{background:var(--green-deep);}

/* Modal médias */
.modal-lg-box{max-width:700px;}
.media-card{border:1px solid var(--beige-light);border-radius:8px;padding:14px;margin-bottom:12px;display:flex;align-items:center;gap:14px;}
.media-card img{max-width:90px;max-height:65px;object-fit:cover;border-radius:4px;}
.media-card video{max-width:120px;max-height:80px;border-radius:4px;}
.media-doc-icon{font-size:2rem;color:#6c757d;width:60px;text-align:center;}
.media-info strong{display:block;font-size:.88rem;color:var(--text-dark);}
.media-info small{color:#6B7D5A;font-size:.75rem;}
.media-actions{margin-left:auto;display:flex;gap:8px;}

.confirm-overlay{display:none;position:fixed;inset:0;background:rgba(26,46,10,.6);z-index:99999;align-items:center;justify-content:center;}
.confirm-overlay.active{display:flex;}
.confirm-box{background:white;border-radius:12px;padding:36px;max-width:400px;width:100%;text-align:center;}
.confirm-box i{font-size:2.5rem;color:#EF4444;margin-bottom:16px;display:block;}
.confirm-box h3{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--text-dark);margin-bottom:8px;}
.confirm-box p{font-size:.87rem;color:#6B7D5A;margin-bottom:22px;}
.confirm-btns{display:flex;gap:12px;justify-content:center;}
.btn-confirm-cancel{background:var(--beige-light);color:var(--text-mid);border:none;padding:10px 20px;border-radius:4px;cursor:pointer;font-weight:600;}
.btn-confirm-del{background:#EF4444;color:white;border:none;padding:10px 20px;border-radius:4px;cursor:pointer;font-weight:600;}

.toast-msg{position:fixed;bottom:30px;right:30px;background:var(--green-deep);color:var(--beige-cream);padding:14px 24px;border-radius:8px;font-size:.88rem;z-index:99999;display:none;}
.empty{text-align:center;padding:60px;color:#6B7D5A;}
.empty i{font-size:3.5rem;color:var(--green-pale);margin-bottom:16px;display:block;}
</style>

<!-- Hero -->
<section class="psy-hero">
    <a href="{{ path('psy_suivi_index') }}" class="hero-back"><i class="fas fa-arrow-left"></i> Retour aux suivis</a>
    <h1>Objectifs — <em>{{ suivi.titre }}</em></h1>
    <div class="hero-meta">
        <span><i class="fas fa-tag"></i> {{ suivi.typeSuivi }}</span>
        <span><i class="fas fa-tasks"></i> {{ objectifs|length }} objectif(s)</span>
        {% set nb_valides = objectifs|filter(o => o.valide)|length %}
        <span><i class="fas fa-check-circle"></i> {{ nb_valides }} validé(s)</span>
    </div>
</section>

<!-- Page -->
<section class="psy-page">
    <div class="toolbar">
        <div>
            <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:3px;color:var(--green-sage);margin-bottom:6px;">Gestion des objectifs</div>
            <h2 style="font-family:'Playfair Display',serif;font-size:1.8rem;color:var(--text-dark);font-weight:400;">
                Objectifs du patient
            </h2>
        </div>
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
            <div class="search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Rechercher…" oninput="filterTable(this.value)">
                <button onclick="document.getElementById('searchInput').value='';filterTable('');" title="Effacer"><i class="fas fa-times"></i></button>
            </div>
            <button class="btn-add" onclick="openModal()">
                <i class="fas fa-plus"></i> Nouvel objectif
            </button>
        </div>
    </div>

    {% if objectifs|length == 0 %}
    <div class="empty">
        <i class="fas fa-bullseye"></i>
        <h3 style="font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--text-mid);">Aucun objectif</h3>
        <p>Ajoutez le premier objectif pour ce suivi.</p>
    </div>
    {% else %}
    <div class="table-wrap">
        <div class="table-head"><h3>Liste des objectifs</h3></div>
        <table>
            <thead>
                <tr><th>#</th><th>Titre</th><th>Description</th><th>Échéance</th><th>Statut</th><th>Fichiers client</th><th>Actions</th></tr>
            </thead>
            <tbody id="tableBody">
                {% for objectif in objectifs %}
                <tr id="row-{{ objectif.idobjectif }}">
                    <td>{{ objectif.idobjectif }}</td>
                    <td><strong>{{ objectif.titre }}</strong></td>
                    <td>{{ objectif.description|default('')|slice(0,50) }}{% if objectif.description|length > 50 %}…{% endif %}</td>
                    <td>{{ objectif.dateEcheance ? objectif.dateEcheance|date('d/m/Y') : '—' }}</td>
                    <td>
                        {% if objectif.valide %}
                            <span class="badge-valide">✅ Validé</span>
                        {% else %}
                            <span class="badge-encours">⏳ En cours</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if objectif.medias|length > 0 %}
                            <button class="btn-action btn-media" onclick="voirMedias({{ objectif.idobjectif }})">
                                <i class="fas fa-paperclip"></i> {{ objectif.medias|length }} fichier(s)
                            </button>
                        {% else %}
                            <span style="color:#aaa;font-size:.8rem;">Aucun</span>
                        {% endif %}
                    </td>
                    <td>
                        <button class="btn-action btn-edit" onclick="editObjectif({{ objectif.idobjectif }})"><i class="fas fa-pen"></i> Modifier</button>
                        {% if not objectif.valide %}
                        <button class="btn-action btn-validate" onclick="validerObjectif({{ objectif.idobjectif }})"><i class="fas fa-check"></i> Valider</button>
                        {% endif %}
                        <button class="btn-action btn-del" onclick="confirmDel({{ objectif.idobjectif }})"><i class="fas fa-trash"></i> Supprimer</button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</section>

<!-- Modal Objectif -->
<div class="modal-overlay" id="modalOverlay">
    <div class="modal-box">
        <button class="modal-close" onclick="closeModal()">&times;</button>
        <h2 id="modalTitle">Nouvel objectif</h2>
        <input type="hidden" id="objId" value="0">
        <div class="form-field">
            <label>Titre *</label>
            <input type="text" id="fTitre" placeholder="Ex : Méditer 10 min par jour">
            <div class="err" id="err_titre"></div>
        </div>
        <div class="form-field">
            <label>Description</label>
            <textarea id="fDesc" rows="3" placeholder="Décrivez cet objectif…"></textarea>
            <div class="err" id="err_description"></div>
        </div>
        <div class="form-field">
            <label>Date d'échéance</label>
            <input type="date" id="fDate">
            <div class="err" id="err_date_echeance"></div>
        </div>
        <div class="modal-btns">
            <button class="btn-cancel" onclick="closeModal()">Annuler</button>
            <button class="btn-save" onclick="saveObjectif()">Enregistrer</button>
        </div>
    </div>
</div>

<!-- Confirm suppression -->
<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-box">
        <i class="fas fa-exclamation-triangle"></i>
        <h3>Supprimer cet objectif ?</h3>
        <p>Cette action est irréversible.</p>
        <div class="confirm-btns">
            <button class="btn-confirm-cancel" onclick="closeConfirm()">Annuler</button>
            <button class="btn-confirm-del" id="btnConfirmDel">Supprimer</button>
        </div>
    </div>
</div>

<div class="toast-msg" id="toast"></div>

<!-- Modal Médias (lecture seule) -->
<div class="modal-overlay" id="modalMedias">
    <div class="modal-box" style="max-width:680px;">
        <button class="modal-close" onclick="document.getElementById('modalMedias').classList.remove('active')">&times;</button>
        <h2><i class="fas fa-paperclip" style="color:var(--green-sage);margin-right:10px;font-size:1.1rem;"></i>Fichiers du patient</h2>
        <div id="mediasContainer"><p style="color:#aaa;text-align:center;padding:20px;">Chargement…</p></div>
    </div>
</div>

<script>
var SUIVI_ID = {{ suivi.idsuivi }};
var deleteId = null;

// ── Modal objectif ─────────────────────────────────────────────────────────
function openModal() {
    document.getElementById('modalTitle').textContent = 'Nouvel objectif';
    document.getElementById('objId').value = '0';
    document.getElementById('fTitre').value = '';
    document.getElementById('fDesc').value = '';
    document.getElementById('fDate').value = '';
    clearErrors();
    document.getElementById('modalOverlay').classList.add('active');
}
function closeModal() { document.getElementById('modalOverlay').classList.remove('active'); }

function editObjectif(id) {
    fetch('/psychologue/objectifs/' + id + '/json')
        .then(r => r.json())
        .then(d => {
            document.getElementById('modalTitle').textContent = 'Modifier l\'objectif';
            document.getElementById('objId').value = d.id;
            document.getElementById('fTitre').value = d.titre;
            document.getElementById('fDesc').value = d.description || '';
            document.getElementById('fDate').value = d.date_echeance || '';
            clearErrors();
            document.getElementById('modalOverlay').classList.add('active');
        });
}

function saveObjectif() {
    clearErrors();
    var id = document.getElementById('objId').value;
    var url = parseInt(id) > 0
        ? '/psychologue/objectifs/' + id + '/edit'
        : '/psychologue/suivis/' + SUIVI_ID + '/objectifs/new';
    var body = new URLSearchParams({
        titre: document.getElementById('fTitre').value,
        description: document.getElementById('fDesc').value,
        date_echeance: document.getElementById('fDate').value,
    });
    fetch(url, { method: 'POST', body })
        .then(r => r.json())
        .then(data => {
            if (data.success) { closeModal(); showToast('Objectif enregistré !'); setTimeout(() => location.reload(), 800); }
            else if (data.errors) { showErrors(data.errors); }
            else { alert('Erreur : ' + (data.error || 'Inconnue')); }
        });
}

// ── Valider ────────────────────────────────────────────────────────────────
function validerObjectif(id) {
    confirmAction('Valider cet objectif pour le patient ?', { type: 'success', confirmText: 'Valider' }).then(function(ok) {
        if (!ok) return;
        fetch('/psychologue/objectifs/' + id + '/validate', { method: 'POST' })
            .then(r => r.json())
            .then(d => { if (d.success) { showToast('Objectif validé !'); setTimeout(() => location.reload(), 800); } else alert('Erreur : ' + d.error); });
    });
}

// ── Supprimer ──────────────────────────────────────────────────────────────
function confirmDel(id) { deleteId = id; document.getElementById('confirmOverlay').classList.add('active'); }
function closeConfirm() { document.getElementById('confirmOverlay').classList.remove('active'); deleteId = null; }

document.getElementById('btnConfirmDel').addEventListener('click', function() {
    if (!deleteId) return;
    fetch('/psychologue/objectifs/' + deleteId + '/delete', { method: 'POST' })
        .then(r => r.json())
        .then(d => {
            if (d.success) { var row = document.getElementById('row-' + deleteId); if (row) row.remove(); closeConfirm(); showToast('Objectif supprimé.'); }
            else alert('Erreur : ' + d.error);
        });
});

// ── Utilitaires ────────────────────────────────────────────────────────────
document.getElementById('modalOverlay').addEventListener('click', e => { if (e.target === document.getElementById('modalOverlay')) closeModal(); });
document.getElementById('modalMedias').addEventListener('click', e => { if (e.target === document.getElementById('modalMedias')) document.getElementById('modalMedias').classList.remove('active'); });
document.getElementById('confirmOverlay').addEventListener('click', e => { if (e.target === document.getElementById('confirmOverlay')) closeConfirm(); });

function clearErrors() {
    ['titre','description','date_echeance'].forEach(f => {
        var el = document.getElementById('err_' + f);
        if (el) { el.textContent = ''; el.style.display = 'none'; }
    });
}
function showErrors(errors) {
    Object.keys(errors).forEach(f => {
        var el = document.getElementById('err_' + f);
        if (el) { el.textContent = errors[f]; el.style.display = 'block'; }
        if (f === 'global') alert(errors[f]);
    });
}
function filterTable(val) {
    var q = val.toLowerCase().trim();
    document.querySelectorAll('#tableBody tr[id^="row-"]').forEach(row => {
        row.style.display = (!q || row.innerText.toLowerCase().includes(q)) ? '' : 'none';
    });
}

function voirMedias(id) {
    document.getElementById('mediasContainer').innerHTML = '<p style="color:#aaa;text-align:center;padding:20px;">Chargement…</p>';
    document.getElementById('modalMedias').classList.add('active');
    fetch('/psychologue/objectifs/' + id + '/medias')
        .then(r => r.json())
        .then(function(medias) {
            if (!medias.length) {
                document.getElementById('mediasContainer').innerHTML = '<p style="color:#aaa;text-align:center;padding:20px;">Aucun fichier uploadé par le patient.</p>';
                return;
            }
            var html = '';
            medias.forEach(function(m) {
                // Construire l'URL : si chemin absolu Windows → non accessible, sinon URL relative
                var url = null;
                if (m.chemin && !m.chemin.match(/^[A-Za-z]:\\/)) {
                    url = '/' + m.chemin.replace(/\\/g, '/');
                }

                html += '<div class="media-card">';
                if (!url) {
                    html += '<div class="media-doc-icon"><i class="fas fa-exclamation-triangle" style="color:#F59E0B;"></i></div>';
                } else if (m.type === 'image') {
                    html += '<img src="' + url + '" alt="' + m.nom + '">';
                } else if (m.type === 'video') {
                    html += '<video src="' + url + '" controls style="max-width:120px;max-height:80px;border-radius:4px;"></video>';
                } else {
                    html += '<div class="media-doc-icon"><i class="fas fa-file-alt"></i></div>';
                }

                html += '<div class="media-info"><strong>' + m.nom + '</strong><small>' + m.type + ' — ' + m.date + '</small></div>';
                html += '<div class="media-actions">';
                if (url) {
                    html += '<a href="' + url + '" target="_blank" style="background:var(--green-pale);color:var(--green-deep);padding:8px 16px;border-radius:4px;font-size:.72rem;text-decoration:none;font-weight:600;display:inline-flex;align-items:center;gap:6px;"><i class="fas fa-eye"></i> Voir</a>'
                          + '<a href="' + url + '" download="' + m.nom + '" style="background:var(--green-mid);color:white;padding:8px 16px;border-radius:4px;font-size:.72rem;text-decoration:none;font-weight:600;display:inline-flex;align-items:center;gap:6px;"><i class="fas fa-download"></i> Télécharger</a>';
                } else {
                    html += '<span style="font-size:.75rem;color:#aaa;">Fichier non accessible</span>';
                }
                html += '</div></div>';
            });
            document.getElementById('mediasContainer').innerHTML = html;
        });
}

function showToast(msg) {
    var t = document.getElementById('toast');
    t.textContent = msg; t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 2500);
}
</script>
{% endblock %}
