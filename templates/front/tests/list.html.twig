{% extends 'base.html.twig' %}

{% block title %}Tests psychologiques - NAFSEYTI{% endblock %}

{% block stylesheets %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,200;0,400;0,700;1,200;1,400&family=Cabinet+Grotesk:wght@300;400;500;700&display=swap');

    :root {
        --ink: #1A2E0A;
        --moss: #2D5016;
        --fern: #4A7C2F;
        --sage: #7BA05B;
        --mist: #A8C68F;
        --dew: #D4E6C3;
        --parchment: #F7F2E8;
        --cream: #FDFAF5;
        --sand: #C4A882;
        --linen: #EDE3D0;
    }

    /* ── HERO ── */
    .tests-hero {
        position: relative;
        min-height: 50vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--moss);
        padding: 100px 60px 80px;
        text-align: center;
    }

    .tests-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 80% 60% at 50% 120%, rgba(168,198,143,0.18) 0%, transparent 70%),
            radial-gradient(circle at 10% 20%, rgba(196,168,130,0.12) 0%, transparent 40%),
            radial-gradient(circle at 90% 80%, rgba(122,160,91,0.1) 0%, transparent 40%);
    }

    .tests-hero-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(168,198,143,0.06) 1px, transparent 1px),
            linear-gradient(90deg, rgba(168,198,143,0.06) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    .tests-hero-content {
        position: relative;
        z-index: 2;
        max-width: 800px;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(168,198,143,0.12);
        border: 1px solid rgba(168,198,143,0.3);
        border-radius: 100px;
        padding: 8px 22px;
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.7rem;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--mist);
        margin-bottom: 28px;
    }

    .hero-eyebrow::before {
        content: '';
        width: 5px; height: 5px;
        background: var(--sage);
        border-radius: 50%;
        animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.7); }
    }

    .tests-hero-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(2.8rem, 6vw, 5.2rem);
        color: var(--parchment);
        font-weight: 200;
        line-height: 1.1;
        margin-bottom: 22px;
        letter-spacing: -1px;
    }

    .tests-hero-title em {
        font-style: italic;
        color: var(--mist);
        font-weight: 200;
    }

    .tests-hero-sub {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 1.05rem;
        color: rgba(212,230,195,0.7);
        max-width: 560px;
        margin: 0 auto 48px;
        line-height: 1.8;
        font-weight: 300;
    }

    .hero-stats-row {
        display: flex;
        justify-content: center;
        gap: 0;
        margin-top: 48px;
        padding-top: 40px;
        border-top: 1px solid rgba(168,198,143,0.2);
    }

    .hero-stat {
        padding: 0 40px;
        border-right: 1px solid rgba(168,198,143,0.2);
    }
    .hero-stat:last-child { border-right: none; }

    .hero-stat-num {
        font-family: 'Fraunces', serif;
        font-size: 2.4rem;
        color: var(--parchment);
        font-weight: 400;
        line-height: 1;
        display: block;
    }

    .hero-stat-label {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.65rem;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--sage);
        display: block;
        margin-top: 6px;
    }

    /* ── FILTER BAR ── */
    .filter-bar {
        background: var(--cream);
        border-bottom: 1px solid var(--linen);
        padding: 0 60px;
        display: flex;
        align-items: center;
        gap: 8px;
        height: 60px;
        position: sticky;
        top: 64px;
        z-index: 99;
    }

    .filter-label {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--sand);
        margin-right: 8px;
        flex-shrink: 0;
    }

    .filter-pill {
        background: transparent;
        border: 1px solid var(--linen);
        color: var(--fern);
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 1px;
        padding: 6px 16px;
        border-radius: 100px;
        cursor: pointer;
        transition: all 0.25s;
    }

    .filter-pill:hover,
    .filter-pill.active {
        background: var(--moss);
        border-color: var(--moss);
        color: var(--parchment);
    }

    /* ── GRID ── */
    .tests-grid-section {
        background: var(--parchment);
        padding: 80px 60px 120px;
    }

    .tests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 28px;
        max-width: 1300px;
        margin: 0 auto;
    }

    /* ── CARD ── */
    .test-card {
        background: var(--cream);
        border: 1px solid var(--linen);
        border-radius: 4px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.35s cubic-bezier(0.22,1,0.36,1), box-shadow 0.35s ease, border-color 0.35s;
        position: relative;
    }

    .test-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 32px 80px rgba(45,80,22,0.14);
        border-color: var(--mist);
    }

    /* NUMBER BADGE */
    .test-card-num {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 10;
        font-family: 'Fraunces', serif;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.6);
        letter-spacing: 1px;
        background: rgba(0,0,0,0.25);
        backdrop-filter: blur(8px);
        padding: 4px 10px;
        border-radius: 100px;
    }

    /* IMAGE */
    .test-card-img-wrap {
        height: 230px;
        overflow: hidden;
        position: relative;
    }

    .test-card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.22,1,0.36,1);
        display: block;
    }

    .test-card:hover .test-card-img-wrap img {
        transform: scale(1.08);
    }

    .test-card-img-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 30%,
            rgba(26,46,10,0.75) 100%
        );
    }

    /* CATEGORY BADGE */
    .test-card-cat {
        position: absolute;
        bottom: 16px;
        left: 16px;
        background: var(--parchment);
        color: var(--moss);
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.6rem;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 100px;
        font-weight: 700;
    }

    /* CONTENT */
    .test-card-body {
        padding: 28px 28px 0;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .test-card-icon {
        width: 44px; height: 44px;
        background: var(--dew);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--moss);
        font-size: 1rem;
        margin-bottom: 18px;
        transition: all 0.3s;
    }

    .test-card:hover .test-card-icon {
        background: var(--moss);
        color: var(--parchment);
    }

    .test-card-title {
        font-family: 'Fraunces', serif;
        font-size: 1.4rem;
        color: var(--ink);
        font-weight: 400;
        margin-bottom: 10px;
        line-height: 1.3;
    }

    .test-card-desc {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.88rem;
        color: #6B7D5A;
        line-height: 1.75;
        margin-bottom: 24px;
    }

    /* META BAR */
    .test-card-meta {
        display: flex;
        gap: 20px;
        padding: 14px 0;
        border-top: 1px solid var(--linen);
        margin-top: auto;
    }

    .test-meta-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.75rem;
        color: var(--fern);
    }

    .test-meta-item i {
        font-size: 0.7rem;
        color: var(--sage);
    }

    /* DIFFICULTY DOT */
    .test-diff {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.72rem;
        color: var(--fern);
        margin-left: auto;
    }

    .diff-dots {
        display: flex;
        gap: 3px;
    }

    .diff-dot {
        width: 5px; height: 5px;
        border-radius: 50%;
        background: var(--dew);
    }

    .diff-dot.on { background: var(--sage); }

    /* CTA FOOTER */
    .test-card-footer {
        padding: 20px 28px 28px;
    }

    .test-start-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        background: var(--moss);
        color: var(--parchment);
        padding: 14px 22px;
        text-decoration: none;
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 700;
        border-radius: 3px;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
    }

    .test-start-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--fern);
        transform: translateX(-101%);
        transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);
    }

    .test-start-btn:hover::before { transform: translateX(0); }

    .test-start-btn span,
    .test-start-btn .btn-arrow { position: relative; z-index: 1; }

    .btn-arrow {
        width: 28px; height: 28px;
        background: rgba(255,255,255,0.12);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        transition: transform 0.3s;
    }

    .test-start-btn:hover .btn-arrow {
        transform: translateX(4px);
    }

    /* ── EMPTY STATE ── */
    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 80px 40px;
        background: var(--cream);
        border: 1px dashed var(--mist);
        border-radius: 4px;
    }

    .empty-state-icon {
        width: 64px; height: 64px;
        background: var(--dew);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        color: var(--moss);
        font-size: 1.4rem;
    }

    .empty-state p {
        font-family: 'Cabinet Grotesk', sans-serif;
        color: var(--fern);
        font-size: 1rem;
    }

    /* ── BOTTOM CTA ── */
    .tests-cta {
        background: var(--ink);
        padding: 100px 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .tests-cta::before {
        content: '';
        position: absolute;
        top: -200px; left: 50%;
        transform: translateX(-50%);
        width: 600px; height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(122,160,91,0.12) 0%, transparent 70%);
        pointer-events: none;
    }

    .tests-cta-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(2rem, 4vw, 3.2rem);
        color: var(--parchment);
        font-weight: 200;
        margin-bottom: 16px;
        line-height: 1.2;
    }

    .tests-cta-title em {
        font-style: italic;
        color: var(--mist);
    }

    .tests-cta-sub {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 1rem;
        color: rgba(212,230,195,0.6);
        max-width: 500px;
        margin: 0 auto 48px;
        line-height: 1.8;
    }

    .cta-btn-group {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .cta-btn-primary {
        background: var(--sand);
        color: var(--ink);
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 700;
        padding: 16px 36px;
        text-decoration: none;
        border-radius: 3px;
        transition: all 0.3s;
        display: inline-block;
    }

    .cta-btn-primary:hover {
        background: var(--parchment);
        color: var(--ink);
        transform: translateY(-2px);
    }

    .cta-btn-ghost {
        background: transparent;
        color: var(--parchment);
        border: 1px solid rgba(212,230,195,0.3);
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 16px 36px;
        text-decoration: none;
        border-radius: 3px;
        transition: all 0.3s;
        display: inline-block;
    }

    .cta-btn-ghost:hover {
        border-color: var(--mist);
        color: var(--mist);
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
        .tests-hero, .tests-grid-section, .filter-bar, .tests-cta {
            padding-left: 24px;
            padding-right: 24px;
        }
        .tests-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .hero-stats-row { flex-direction: column; gap: 20px; }
        .hero-stat { border-right: none; border-bottom: 1px solid rgba(168,198,143,0.2); padding: 0 0 20px; }
        .hero-stat:last-child { border-bottom: none; }
        .filter-bar { overflow-x: auto; height: auto; padding: 12px 24px; flex-wrap: nowrap; }
    }
</style>
{% endblock %}

{% block body %}

{# ── HERO ── #}
<section class="tests-hero">
    <div class="tests-hero-grid"></div>
    <div class="tests-hero-content">
        <div class="hero-eyebrow">Évaluez votre bien-être</div>
        <h1 class="tests-hero-title">
            Tests<br><em>psychologiques</em>
        </h1>
        <p class="tests-hero-sub">
            Découvrez nos évaluations conçues par des professionnels pour mieux comprendre
            votre état psychologique et obtenir des conseils personnalisés.
        </p>

        <div class="hero-stats-row">
            <div class="hero-stat">
                <span class="hero-stat-num">{{ tests|length }}</span>
                <span class="hero-stat-label">Tests disponibles</span>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-num">100%</span>
                <span class="hero-stat-label">Confidentiel</span>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-num">Gratuit</span>
                <span class="hero-stat-label">Accès libre</span>
            </div>
        </div>
    </div>
</section>

{# ── FILTER BAR ── #}
<div class="filter-bar">
    <span class="filter-label">Filtrer</span>
    <button class="filter-pill active">Tous</button>
    <button class="filter-pill">Anxiété</button>
    <button class="filter-pill">Stress</button>
    <button class="filter-pill">Dépression</button>
    <button class="filter-pill">Bien-être</button>
    <button class="filter-pill">Sommeil</button>
</div>

{# ── CARDS GRID ── #}
<section class="tests-grid-section">
    <div class="tests-grid">

        {% set imgs = ['img1.jpg', 'img2.jpg', 'img3.jpg'] %}
        {% set diff_levels = [2, 3, 1, 2, 3, 2] %}

        {% for test in tests %}

            {% set diff = diff_levels[loop.index0 % 6] %}

            <article class="test-card">
                <span class="test-card-num">0{{ loop.index }}</span>

                <div class="test-card-img-wrap">
                    <img src="{{ asset('img/' ~ imgs[loop.index0 % 3]) }}"
                         alt="{{ test.titre }}">
                    <div class="test-card-img-overlay"></div>
                    <span class="test-card-cat">Psychologie</span>
                </div>

                <div class="test-card-body">
                    <div class="test-card-icon">
                        <i class="fas fa-brain"></i>
                    </div>
                    <h2 class="test-card-title">{{ test.titre }}</h2>
                    <p class="test-card-desc">
                        {{ test.description|slice(0, 130) }}{{ test.description|length > 130 ? '…' : '' }}
                    </p>

                    <div class="test-card-meta">
                        <span class="test-meta-item">
                            <i class="fas fa-clock"></i>
                            {{ test.duree ? test.duree ~ ' min' : '10 min' }}
                        </span>
                        <span class="test-meta-item">
                            <i class="fas fa-list-ul"></i>
                            {{ test.questions|length }} questions
                        </span>
                        <div class="test-diff">
                            <div class="diff-dots">
                                <span class="diff-dot {{ diff >= 1 ? 'on' : '' }}"></span>
                                <span class="diff-dot {{ diff >= 2 ? 'on' : '' }}"></span>
                                <span class="diff-dot {{ diff >= 3 ? 'on' : '' }}"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="test-card-footer">
                    <a href="{{ path('front_test_show', {'id': test.id}) }}" class="test-start-btn">
                        <span>Commencer le test</span>
                        <div class="btn-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>
                </div>
            </article>

        {% else %}

            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-brain"></i>
                </div>
                <p>Aucun test disponible pour le moment.</p>
            </div>

        {% endfor %}

    </div>
</section>

{# ── BOTTOM CTA ── #}
<section class="tests-cta">
    <h2 class="tests-cta-title">
        Besoin d'un <em>accompagnement</em><br>personnalisé ?
    </h2>
    <p class="tests-cta-sub">
        Nos psychologues sont disponibles pour analyser vos résultats
        et vous proposer un suivi adapté à vos besoins.
    </p>
    <div class="cta-btn-group">
        <a href="#" class="cta-btn-primary">Prendre rendez-vous</a>
        <a href="#" class="cta-btn-ghost">En savoir plus</a>
    </div>
</section>

{% endblock %}
