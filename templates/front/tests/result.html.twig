{% extends 'base.html.twig' %}

{% block title %}Résultats — {{ test.titre }}{% endblock %}

{% block stylesheets %}
<style>
    .result-page { background: var(--beige-white); }

    /* ── HERO ── */
    .result-hero {
        background: linear-gradient(135deg, var(--green-deep) 0%, #1a3d10 60%, #2d5016 100%);
        padding: 60px 60px 0;
        position: relative;
        overflow: hidden;
    }
    .result-hero::before {
        content:'';position:absolute;top:-80px;right:-80px;
        width:400px;height:400px;
        border-radius:40% 60% 70% 30%/50% 30% 60% 40%;
        background:rgba(122,160,91,0.12);
        animation:morphing 12s ease-in-out infinite;
    }
    .result-hero-inner {
        position:relative;z-index:2;
        max-width:1100px;margin:0 auto;
        display:grid;grid-template-columns:1fr 400px;
        gap:48px;align-items:end;
    }
    .result-hero-left { padding-bottom:48px; }
    .result-breadcrumb {
        display:inline-flex;align-items:center;gap:8px;
        font-size:0.72rem;letter-spacing:2px;text-transform:uppercase;
        color:var(--green-light);margin-bottom:20px;opacity:0.85;
    }
    .result-breadcrumb span { color:rgba(212,230,195,0.4); }
    .result-hero-title {
        font-family:'Playfair Display',serif;
        font-size:clamp(1.8rem,3.5vw,2.8rem);
        color:var(--beige-cream);font-weight:400;line-height:1.2;margin-bottom:16px;
    }
    .result-hero-title em { font-style:italic;color:var(--green-light); }
    .result-hero-sub {
        font-family:'Cormorant Garamond',serif;
        font-size:1.1rem;color:rgba(212,230,195,0.65);
        font-weight:300;line-height:1.7;
    }

    /* ── SCORE CARD ── */
    .score-hero-card {
        background:rgba(255,255,255,0.06);
        border:1px solid rgba(168,198,143,0.2);
        border-radius:16px 16px 0 0;
        padding:36px 32px 44px;
        text-align:center;
    }
    .score-lbl-top { font-size:0.7rem;text-transform:uppercase;letter-spacing:2px;color:var(--green-light);margin-bottom:20px; }
    .score-circle {
        width:140px;height:140px;border-radius:50%;
        border:3px solid rgba(168,198,143,0.25);
        display:flex;flex-direction:column;align-items:center;justify-content:center;
        margin:0 auto 16px;position:relative;
    }
    .score-circle::before {
        content:'';position:absolute;inset:6px;border-radius:50%;
        border:2px solid rgba(168,198,143,0.12);
    }
    .score-num { font-family:'Playfair Display',serif;font-size:3rem;color:var(--beige-cream);line-height:1;font-weight:700; }
    .score-pct { font-size:1rem;color:var(--green-light); }
    .score-pts { font-size:0.78rem;color:rgba(212,230,195,0.55);margin-bottom:14px; }
    .score-bar-wrap { height:5px;background:rgba(255,255,255,0.1);border-radius:99px;overflow:hidden;margin-bottom:10px; }
    .score-bar-fill { height:100%;border-radius:99px;background:linear-gradient(90deg,var(--green-sage),var(--green-light));transition:width 1.5s cubic-bezier(.4,0,.2,1); }
    .score-status { font-size:0.72rem;text-transform:uppercase;letter-spacing:2px;color:var(--green-light); }

    /* ── LAYOUT ── */
    .result-body {
        max-width:1100px;margin:0 auto;
        padding:40px 60px 80px;
        display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:start;
    }
    .result-main { min-width:0; }
    .result-sidebar { position:sticky;top:88px; }

    /* ── BLOCK ── */
    .rb {
        background:var(--beige-white);
        border:1px solid var(--beige-mid);
        border-radius:12px;
        margin-bottom:20px;
        overflow:hidden;
    }
    .rb-head {
        padding:18px 24px;
        border-bottom:1px solid var(--beige-light);
        display:flex;align-items:center;gap:12px;
    }
    .rb-icon {
        width:34px;height:34px;border-radius:9px;
        display:flex;align-items:center;justify-content:center;
        font-size:0.9rem;flex-shrink:0;
    }
    .ic-green  { background:var(--green-pale);color:var(--green-deep); }
    .ic-blue   { background:#e8f0fe;color:#1a73e8; }
    .ic-spotify{ background:#d4f5de;color:#1DB954; }
    .ic-amber  { background:#fef9ee;color:#b7791f; }
    .rb-title  { font-family:'Playfair Display',serif;font-size:0.98rem;color:var(--text-dark);font-weight:600; }
    .rb-sub    { font-size:0.72rem;color:#999;margin-top:1px; }
    .rb-body   { padding:24px; }

    /* ── TWIN ── */
    .twin-wrap { width:100%;background:#07101a;border-radius:10px;overflow:hidden;position:relative; }
    #twin-canvas { width:100%;height:340px;display:block; }
    #twin-aura { position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:220px;height:220px;border-radius:50%;pointer-events:none;transition:all 1.5s; }
    .twin-ui { position:absolute;inset:0;pointer-events:none;padding:18px;display:flex;flex-direction:column;justify-content:space-between; }
    .twin-pill { background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.16);border-radius:99px;padding:4px 12px;color:white;font-size:10px;font-weight:700;letter-spacing:1px; }
    .twin-score-r { text-align:right;color:white; }
    .twin-score-r .n { font-size:26px;font-weight:700;line-height:1; }
    .twin-score-r .l { font-size:9px;opacity:0.5;letter-spacing:1px; }
    #twin-label { color:white;font-size:15px;font-weight:600;font-family:'Playfair Display',serif;text-shadow:0 0 20px rgba(100,200,255,0.5);text-align:center; }
    .twin-sub { color:rgba(255,255,255,0.4);font-size:10px;text-align:center;margin-top:3px; }

    /* ── INTERP ── */
    .interp-desc { font-size:0.9rem;line-height:1.8;color:#4a5a3a;margin-bottom:16px; }
    .interp-advice { background:var(--green-pale);border-radius:8px;padding:13px 16px;font-size:0.86rem;color:var(--green-deep);line-height:1.6; }
    .interp-advice i { color:var(--green-sage);margin-right:6px; }
    .visage-bar { background:var(--beige-cream);border-left:3px solid var(--green-sage);border-radius:0 7px 7px 0;padding:11px 14px;font-size:0.83rem;color:var(--green-deep);display:flex;align-items:center;gap:9px;margin-bottom:18px; }

    /* ── GEMINI ── */
    .gemini-analyse { font-size:0.9rem;line-height:1.85;color:#444;margin-bottom:20px; }
    .gemini-conseils { display:flex;flex-direction:column;gap:9px; }
    .gemini-conseil { display:flex;align-items:flex-start;gap:11px;background:var(--beige-cream);padding:11px 14px;border-radius:8px; }
    .g-num { width:20px;height:20px;background:var(--green-sage);color:white;border-radius:50%;font-size:0.68rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px; }
    .g-txt { font-size:0.86rem;color:#444;line-height:1.6; }
    .risque-badge { display:inline-flex;align-items:center;gap:5px;padding:3px 11px;border-radius:20px;font-size:0.7rem;font-weight:600;margin-left:auto; }

    /* ── SPOTIFY ── */
    .sp-grid { display:grid;grid-template-columns:1fr 1fr;gap:14px; }
    .sp-card { background:#141414;border-radius:9px;overflow:hidden; }
    .sp-img { width:100%;height:110px;object-fit:cover; }
    .sp-placeholder { width:100%;height:110px;background:#1DB954;display:flex;align-items:center;justify-content:center;font-size:2.2rem; }
    .sp-info { padding:11px; }
    .sp-name { font-weight:700;color:white;font-size:0.82rem;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .sp-meta { color:#666;font-size:0.7rem;margin-bottom:9px; }
    .sp-link { display:block;margin-top:7px;background:#1DB954;color:white;text-align:center;padding:6px;border-radius:5px;text-decoration:none;font-size:0.76rem;font-weight:600; }
    .sp-note { grid-column:1/-1;text-align:center;font-size:0.76rem;color:#666;padding-top:10px;border-top:1px solid #1e1e1e; }

    /* ── RÉPONSES ── */
    .rep-item { padding:16px 0;border-bottom:1px solid var(--beige-light); }
    .rep-item:last-child { border-bottom:none; }
    .rep-q { font-size:0.86rem;color:var(--text-mid);margin-bottom:7px;font-weight:500; }
    .rep-q-n { color:var(--green-sage);margin-right:5px; }
    .rep-answer { display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--beige-cream);padding:9px 13px;border-radius:7px; }
    .rep-text { font-size:0.83rem;color:#555; }
    .rep-chip { background:var(--green-deep);color:white;font-size:0.7rem;font-weight:700;padding:3px 9px;border-radius:99px;white-space:nowrap;flex-shrink:0; }

    /* ── SIDEBAR ── */
    .badge-card { background:var(--beige-white);border:1px solid var(--beige-mid);border-radius:12px;padding:24px 20px;text-align:center;margin-bottom:18px; }
    .badge-icon-wrap { width:72px;height:72px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 14px;animation:pulse-b 2.5s ease-in-out infinite; }
    @keyframes pulse-b { 0%,100%{transform:scale(1)} 50%{transform:scale(1.07)} }
    .badge-name { font-family:'Playfair Display',serif;font-size:1rem;color:var(--text-dark);margin-bottom:5px; }
    .badge-desc { font-size:0.8rem;color:#6B7D5A;line-height:1.6;margin-bottom:14px; }
    .badge-xp { display:inline-flex;align-items:center;gap:5px;padding:6px 16px;border-radius:99px;font-size:0.8rem;font-weight:600;color:white; }

    .side-card { background:var(--beige-white);border:1px solid var(--beige-mid);border-radius:12px;padding:18px;margin-bottom:18px; }
    .side-label { font-size:0.68rem;text-transform:uppercase;letter-spacing:2px;color:var(--green-mid);margin-bottom:13px; }
    .act-btn { display:flex;align-items:center;gap:9px;width:100%;padding:11px 14px;border-radius:7px;text-decoration:none;font-size:0.83rem;font-weight:500;margin-bottom:7px;border:1px solid var(--beige-mid);color:var(--text-dark);background:transparent;cursor:pointer;transition:all 0.2s;font-family:'DM Sans',sans-serif; }
    .act-btn:last-child { margin-bottom:0; }
    .act-btn:hover { border-color:var(--green-sage);background:var(--green-pale);color:var(--green-deep); }
    .act-btn.primary { background:var(--green-deep);color:var(--beige-cream);border-color:var(--green-deep); }
    .act-btn.primary:hover { background:var(--green-mid);color:white; }
    .act-btn i { width:14px;text-align:center; }
    .stat-row { display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--beige-light); }
    .stat-row:last-child { border-bottom:none; }
    .stat-k { font-size:0.8rem;color:#888; }
    .stat-v { font-size:0.84rem;font-weight:600;color:var(--text-dark); }

    /* ── RESPONSIVE ── */
    @media(max-width:900px){
        .result-hero-inner,.result-body { grid-template-columns:1fr; }
        .result-hero,.result-body { padding-left:24px;padding-right:24px; }
        .result-sidebar { position:static; }
        .sp-grid { grid-template-columns:1fr; }
    }
    @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
    .result-main    { animation:fadeUp 0.45s ease both; }
    .result-sidebar { animation:fadeUp 0.45s ease 0.12s both; }
</style>
{% endblock %}

{% block body %}
<div class="result-page">

{# ── POPUP SOS ── #}
{% if isCritique %}
<div id="sosOverlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div style="background:white;border-radius:20px;padding:36px;max-width:500px;width:100%;text-align:center;animation:popIn .4s ease;overflow-y:auto;max-height:90vh;">
        <div style="font-size:2.8rem;margin-bottom:14px;">🆘</div>
        <h2 style="color:#c0392b;font-family:'Playfair Display',serif;margin-bottom:10px;">Vous n'êtes pas seul(e)</h2>
        <p style="color:#555;line-height:1.7;margin-bottom:20px;font-size:0.88rem;">
            {% if gemini.message_sos %}{{ gemini.message_sos }}
            {% else %}Vos réponses indiquent que vous traversez une période difficile. Des professionnels sont disponibles maintenant.{% endif %}
        </p>
        <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:20px;text-align:left;">
            <div style="background:#fdf0ee;border-radius:9px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                <span style="font-size:1.5rem;">📞</span>
                <div style="flex:1"><div style="font-weight:700;color:#c0392b;font-size:0.85rem;">SAMU — Urgences médicales</div><div style="font-size:1rem;font-weight:bold;color:#c0392b;">190</div></div>
                <a href="tel:190" style="background:#c0392b;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:0.78rem;font-weight:600;">Appeler</a>
            </div>
            <div style="background:#fdf0ee;border-radius:9px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                <span style="font-size:1.5rem;">🚨</span>
                <div style="flex:1"><div style="font-weight:700;color:#c0392b;font-size:0.85rem;">Police secours</div><div style="font-size:1rem;font-weight:bold;color:#c0392b;">197</div></div>
                <a href="tel:197" style="background:#c0392b;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:0.78rem;font-weight:600;">Appeler</a>
            </div>
            <div style="background:#fef9ee;border-radius:9px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                <span style="font-size:1.5rem;">🧠</span>
                <div style="flex:1"><div style="font-weight:700;color:#b7791f;font-size:0.85rem;">Hôpital Razi — Psychiatrie</div><div style="font-size:0.9rem;font-weight:bold;color:#b7791f;">+216 71 560 600</div></div>
                <a href="tel:+21671560600" style="background:#b7791f;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:0.78rem;font-weight:600;">Appeler</a>
            </div>
            <div style="background:#d8f3dc;border-radius:9px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                <span style="font-size:1.5rem;">🏥</span>
                <div style="flex:1"><div style="font-weight:700;color:#1a3d2b;font-size:0.85rem;">Centre santé mentale MSP</div><div style="font-size:0.9rem;font-weight:bold;color:#1a3d2b;">+216 71 578 500</div></div>
                <a href="tel:+21671578500" style="background:#1a3d2b;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:0.78rem;font-weight:600;">Appeler</a>
            </div>
        </div>
        <button onclick="document.getElementById('sosOverlay').style.display='none'" style="background:transparent;border:1px solid #ddd;color:#999;padding:9px 24px;border-radius:7px;cursor:pointer;font-size:0.86rem;">Continuer vers mes résultats</button>
    </div>
</div>
{% endif %}

{# ── HERO ── #}
<div class="result-hero">
    <div class="result-hero-inner">
        <div class="result-hero-left">
           <div class="result-breadcrumb">
    <a href="{{ path('app_home') }}" style="color:var(--green-light);text-decoration:none;opacity:0.85;transition:opacity 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.85">
        <i class="fas fa-home"></i>
    </a>
    <span>›</span>
    <a href="{{ path('front_test_list') }}" style="color:var(--green-light);text-decoration:none;opacity:0.85;transition:opacity 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.85">
        Tests
    </a>
    <span>›</span>
    Résultats
</div>
            <h1 class="result-hero-title">
                Vos résultats<br><em>{{ test.titre }}</em>
            </h1>
            <p class="result-hero-sub">
                Analyse complète de votre profil psychologique, générée par Nafseyti AI avec des recommandations personnalisées.
            </p>
        </div>
        <div class="score-hero-card">
            <div class="score-lbl-top">Score global</div>
            <div class="score-circle">
                <div class="score-num">{{ percentage }}</div>
                <div class="score-pct">%</div>
            </div>
            <div class="score-pts">{{ totalScore }} / {{ maxScore }} points</div>
            <div class="score-bar-wrap">
                <div class="score-bar-fill" style="width:{{ percentage }}%;"></div>
            </div>
            <div class="score-status">
                {% if percentage >= 80 %}Excellent résultat
                {% elseif percentage >= 60 %}Bon résultat
                {% elseif percentage >= 40 %}Résultat moyen
                {% elseif percentage >= 20 %}En progression
                {% else %}Besoin d'accompagnement{% endif %}
            </div>
        </div>
    </div>
</div>

{# ── BODY ── #}
<div class="result-body">

    {# ── MAIN ── #}
    <div class="result-main">

        {# 1. DIGITAL TWIN 3D #}
        <div class="rb">
            <div class="rb-head">
                <div class="rb-icon ic-green"><i class="fas fa-user-circle"></i></div>
                <div>
                    <div class="rb-title">Digital Twin Mental</div>
                    <div class="rb-sub">Ton avatar 3D reflète ton état psychologique en temps réel</div>
                </div>
            </div>
            <div class="rb-body" style="padding:16px;">
                <div class="twin-wrap">
                    <canvas id="twin-canvas"></canvas>
                    <div id="twin-aura"></div>
                    <div class="twin-ui">
                        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                            <div class="twin-pill">NAFSEYTI AI</div>
                            <div class="twin-score-r">
                                <div class="n">{{ percentage }}</div>
                                <div class="l">SCORE %</div>
                            </div>
                        </div>
                        <div>
                            <div id="twin-label">
                                {% if percentage >= 60 %}État équilibré
                                {% elseif percentage >= 30 %}État à surveiller
                                {% else %}État critique{% endif %}
                            </div>
                            <div class="twin-sub">Ton avatar évolue avec tes résultats</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# 2. INTERPRÉTATION #}
        <div class="rb">
            <div class="rb-head">
                <div class="rb-icon ic-green"><i class="fas {{ interpretation.icon }}"></i></div>
                <div>
                    <div class="rb-title">{{ interpretation.title }}</div>
                    <div class="rb-sub">Interprétation de votre score</div>
                </div>
            </div>
            <div class="rb-body">
                {% if gemini.coherence_visage is defined and gemini.coherence_visage %}
                <div class="visage-bar">
                    <i class="fas fa-camera" style="color:var(--green-sage);"></i>
                    <span><strong>Analyse du visage :</strong> {{ gemini.coherence_visage }}</span>
                </div>
                {% endif %}
                <p class="interp-desc">{{ interpretation.description }}</p>
                <div class="interp-advice">
                    <i class="fas fa-lightbulb"></i>
                    <strong>Conseil :</strong> {{ interpretation.advice }}
                </div>
            </div>
        </div>

        {# 3. ANALYSE GEMINI #}
        {% if gemini is defined and gemini.analyse is defined %}
        <div class="rb">
            <div class="rb-head">
                <div class="rb-icon ic-blue"><i class="fas fa-brain"></i></div>
                <div style="flex:1;">
                    <div class="rb-title">Analyse personnalisée par IA</div>
                    <div class="rb-sub">Powered by Nafseyti AI</div>
                </div>
                {% if gemini.niveau_risque == 'critique' %}
                    <span class="risque-badge" style="background:#fdf0ee;color:#c0392b;border:1px solid #f5a99c;">⚠️ Attention requise</span>
                {% elseif gemini.niveau_risque == 'attention' %}
                    <span class="risque-badge" style="background:#fef9ee;color:#b7791f;border:1px solid #f6d860;">📊 À surveiller</span>
                {% else %}
                    <span class="risque-badge" style="background:#d8f3dc;color:#1a3d2b;border:1px solid #95d5b2;">✅ Normal</span>
                {% endif %}
            </div>
            <div class="rb-body">
                <p class="gemini-analyse">{{ gemini.analyse }}</p>
                {% if gemini.conseils is defined and gemini.conseils %}
                <div style="border-top:1px solid var(--beige-light);padding-top:18px;">
                    <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:2px;color:var(--green-mid);margin-bottom:12px;">💡 Conseils personnalisés</div>
                    <div class="gemini-conseils">
                        {% for conseil in gemini.conseils %}
                        <div class="gemini-conseil">
                            <div class="g-num">{{ loop.index }}</div>
                            <span class="g-txt">{{ conseil }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {# 4. SPOTIFY #}
        {% if spotify is defined and spotify.playlists is not empty %}
        <div class="rb">
            <div class="rb-head">
                <div class="rb-icon ic-spotify"><i class="fab fa-spotify"></i></div>
                <div>
                    <div class="rb-title">Musicothérapie personnalisée</div>
                    <div class="rb-sub">{{ spotify.message }}</div>
                </div>
            </div>
            <div class="rb-body" style="background:#0d0d0d;padding:16px;">
                <div class="sp-grid">
                    {% for playlist in spotify.playlists %}
                    <div class="sp-card">
                        {% if playlist.image %}
                            <img src="{{ playlist.image }}" alt="{{ playlist.name }}" class="sp-img">
                        {% else %}
                            <div class="sp-placeholder">🎵</div>
                        {% endif %}
                        <div class="sp-info">
                            <div class="sp-name">{{ playlist.name }}</div>
                            <div class="sp-meta">{{ playlist.owner }} · {{ playlist.tracks }} titres</div>
                            <iframe src="{{ playlist.embed_url }}?utm_source=generator&theme=0" width="100%" height="80" frameBorder="0" allow="autoplay;clipboard-write;encrypted-media;fullscreen;picture-in-picture" loading="lazy" style="border-radius:6px;"></iframe>
                            <a href="{{ playlist.url }}" target="_blank" class="sp-link">▶ Ouvrir sur Spotify</a>
                        </div>
                    </div>
                    {% endfor %}
                    <div class="sp-note">🎓 La musicothérapie agit directement sur le système limbique qui régule les émotions.</div>
                </div>
            </div>
        </div>
        {% endif %}

        {# 5. RÉPONSES #}
        <div class="rb">
            <div class="rb-head">
                <div class="rb-icon ic-amber"><i class="fas fa-list-ul"></i></div>
                <div>
                    <div class="rb-title">Détail de mes réponses</div>
                    <div class="rb-sub">{{ reponses|length }} questions répondues</div>
                </div>
            </div>
            <div class="rb-body">
                {% for reponse in reponses %}
                <div class="rep-item">
                    <div class="rep-q"><span class="rep-q-n">Q{{ loop.index }}.</span>{{ reponse.question.texte }}</div>
                    <div class="rep-answer">
                        <span class="rep-text">{{ reponse.reponse }}</span>
                        <span class="rep-chip">{{ reponse.score }} / {{ reponse.points_max }} pts</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>{# fin main #}

    {# ── SIDEBAR ── #}
    <div class="result-sidebar">

        {# BADGE #}
        {% if badge is defined and badge %}
        <div class="badge-card">
            <div class="badge-icon-wrap" style="background:{{ badge.color }}18;border:2px solid {{ badge.color }}35;">
                {{ badge.icon }}
            </div>
            <div class="badge-name">🎖️ {{ badge.label }}</div>
            <div class="badge-desc">{{ badge.description }}</div>
            <span class="badge-xp" style="background:{{ badge.color }};">⭐ +{{ badge.points_xp }} XP</span>
        </div>
        {% endif %}

        {# ACTIONS #}
        <div class="side-card">
            <div class="side-label">Actions</div>
            <a href="{{ path('front_test_pdf', {'id': test.id}) }}" class="act-btn primary">
                <i class="fas fa-file-pdf"></i> Télécharger le PDF
            </a>
            <a href="{{ path('front_test_show', {'id': test.id}) }}" class="act-btn">
                <i class="fas fa-redo"></i> Refaire le test
            </a>
            <a href="{{ path('front_test_list') }}" class="act-btn">
                <i class="fas fa-th-list"></i> Tous les tests
            </a>
            <button onclick="window.print();" class="act-btn">
                <i class="fas fa-print"></i> Imprimer
            </button>
        </div>

        {# RÉSUMÉ #}
        <div class="side-card">
            <div class="side-label">Résumé</div>
            <div class="stat-row"><span class="stat-k">Score</span><span class="stat-v">{{ percentage }}%</span></div>
            <div class="stat-row"><span class="stat-k">Points</span><span class="stat-v">{{ totalScore }} / {{ maxScore }}</span></div>
            <div class="stat-row"><span class="stat-k">Questions</span><span class="stat-v">{{ reponses|length }}</span></div>
            <div class="stat-row"><span class="stat-k">Niveau risque</span><span class="stat-v" style="text-transform:capitalize;">{{ gemini.niveau_risque ?? 'normal' }}</span></div>
        </div>

    </div>

</div>{# fin body #}
</div>{# fin page #}
{% endblock %}

{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
    const SCORE  = {{ percentage }};
    const RISQUE = "{{ gemini.niveau_risque ?? 'normal' }}";
    const canvas = document.getElementById('twin-canvas');
    if(!canvas || typeof THREE === 'undefined') return;

    const renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
    renderer.shadowMap.enabled = true;

    const scene  = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45,1,0.1,100);
    camera.position.set(0,1.2,5.5); camera.lookAt(0,0.8,0);

    function resize(){
        const w=canvas.offsetWidth,h=340;
        renderer.setSize(w,h,false);
        camera.aspect=w/h; camera.updateProjectionMatrix();
    }
    resize(); window.addEventListener('resize',resize);

    function getState(){ return (RISQUE==='critique'||SCORE<30)?'bad':(RISQUE==='attention'||SCORE<60)?'mid':'good'; }
    const S = getState();
    const C = {
        good:{body:0x4ade80,head:0x86efac,part:0x4ade80,aura:'rgba(74,222,128,0.25)',spd:0.8},
        mid: {body:0xfbbf24,head:0xfde68a,part:0xfbbf24,aura:'rgba(251,191,36,0.25)',  spd:1.4},
        bad: {body:0xf87171,head:0xfca5a5,part:0xef4444, aura:'rgba(248,113,113,0.25)',spd:2.0},
    }[S];

    const auraEl=document.getElementById('twin-aura');
    if(auraEl) auraEl.style.background=`radial-gradient(circle,${C.aura} 0%,transparent 70%)`;

    scene.add(new THREE.AmbientLight(0xffffff,0.4));
    const dl=new THREE.DirectionalLight(0xffffff,0.8); dl.position.set(3,5,3); dl.castShadow=true; scene.add(dl);
    const fl=new THREE.PointLight(C.body,0.9,20); fl.position.set(-3,2,2); scene.add(fl);

    const mB=new THREE.MeshPhongMaterial({color:C.body,shininess:60});
    const mH=new THREE.MeshPhongMaterial({color:C.head,shininess:80});
    const mE=new THREE.MeshPhongMaterial({color:0xffffff,emissive:C.body,emissiveIntensity:0.5});
    const mJ=new THREE.MeshPhongMaterial({color:0x1a3d2b,shininess:30});

    function mk(geo,mat,x=0,y=0,z=0){ const m=new THREE.Mesh(geo,mat); m.position.set(x,y,z); m.castShadow=true; return m; }

    const avatar=new THREE.Group();
    const torso=mk(new THREE.CylinderGeometry(0.28,0.32,0.7,16),mB,0,0.55,0);
    avatar.add(torso,mk(new THREE.SphereGeometry(0.28,24,24),mH,0,1.12,0));
    avatar.add(mk(new THREE.CylinderGeometry(0.1,0.12,0.18,12),mJ,0,0.93,0));
    avatar.add(mk(new THREE.SphereGeometry(0.22,16,16),mJ,0,0.2,0));
    const eg=new THREE.SphereGeometry(0.055,12,12);
    avatar.add(mk(eg,mE,-0.1,1.16,0.22),mk(eg,mE,0.1,1.16,0.22));

    function makeArm(s){ const g=new THREE.Group(); const u=mk(new THREE.CylinderGeometry(0.08,0.07,0.38,12),mB); u.position.y=-0.19; g.add(u,mk(new THREE.SphereGeometry(0.08,12,12),mJ,0,-0.38,0),mk(new THREE.CylinderGeometry(0.065,0.06,0.35,12),mB,0,-0.57,0),mk(new THREE.SphereGeometry(0.09,12,12),mH,0,-0.76,0)); g.position.set(s*0.42,0.75,0); g.rotation.z=s*0.18; return g; }
    const aL=makeArm(-1),aR=makeArm(1); avatar.add(aL,aR);

    function makeLeg(s){ const g=new THREE.Group(); g.add(mk(new THREE.CylinderGeometry(0.11,0.09,0.45,12),mB,0,-0.22,0),mk(new THREE.SphereGeometry(0.1,12,12),mJ,0,-0.45,0),mk(new THREE.CylinderGeometry(0.085,0.08,0.42,12),mB,0,-0.67,0),mk(new THREE.SphereGeometry(0.1,12,12),mH,0,-0.9,0.06)); g.position.set(s*0.14,0.18,0); return g; }
    avatar.add(makeLeg(-1),makeLeg(1));
    avatar.position.y=-0.3; scene.add(avatar);

    const floor=new THREE.Mesh(new THREE.CircleGeometry(1.4,64),new THREE.MeshPhongMaterial({color:0x0a1020,transparent:true,opacity:0.5}));
    floor.rotation.x=-Math.PI/2; floor.position.y=-1.05; floor.receiveShadow=true; scene.add(floor);

    const parts=[]; const pg=new THREE.SphereGeometry(0.03,8,8);
    for(let i=0;i<40;i++){ const pm=new THREE.MeshBasicMaterial({color:C.part,transparent:true,opacity:Math.random()*0.6+0.2}); const p=new THREE.Mesh(pg,pm); const a=Math.random()*Math.PI*2,r=0.7+Math.random()*0.9; p.position.set(Math.cos(a)*r,-0.5+Math.random()*2.5,Math.sin(a)*r); p.userData={a,r,spd:0.008+Math.random()*0.012,by:p.position.y,ph:Math.random()*Math.PI*2}; scene.add(p); parts.push(p); }

    let t=0,bt=0;
    function animate(){
        requestAnimationFrame(animate); t+=0.016; bt+=0.018*C.spd;
        const b=Math.sin(bt)*0.022; torso.scale.y=1+b; torso.scale.x=1-b*0.3;
        avatar.rotation.y=Math.sin(t*0.4)*0.2;
        const sw=Math.sin(t*C.spd*0.9)*0.22; aL.rotation.x=sw; aR.rotation.x=-sw;
        avatar.position.x=S==='bad'?Math.sin(t*8)*0.025:avatar.position.x*0.95;
        avatar.position.y=-0.3+(S==='good'?Math.sin(t*1.2)*0.03:0);
        parts.forEach((p,i)=>{ p.userData.a+=p.userData.spd*C.spd; p.position.x=Math.cos(p.userData.a)*p.userData.r; p.position.z=Math.sin(p.userData.a)*p.userData.r; p.position.y=p.userData.by+Math.sin(t+p.userData.ph)*0.15; p.material.opacity=0.1+Math.abs(Math.sin(t*0.5+i))*0.5; });
        renderer.render(scene,camera);
    }
    animate();
})();
</script>
<style>
@keyframes popIn{from{opacity:0;transform:scale(0.85)}to{opacity:1;transform:scale(1)}}
</style>
{% endblock %}
