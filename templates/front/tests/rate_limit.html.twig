{% extends 'base.html.twig' %}

{% block title %}Limite atteinte — Nafseyti{% endblock %}

{% block stylesheets %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,200;0,400;0,700;1,200;1,400&family=Cabinet+Grotesk:wght@300;400;500;700&display=swap');

    :root {
        --ink:       #1A2E0A;
        --moss:      #2D5016;
        --fern:      #4A7C2F;
        --sage:      #7BA05B;
        --mist:      #A8C68F;
        --dew:       #D4E6C3;
        --parchment: #F7F2E8;
        --cream:     #FDFAF5;
        --sand:      #C4A882;
        --linen:     #EDE3D0;
        --ember:     #C0392B;
        --ember-bg:  #FDF0EE;
        --ember-mid: #E8D5D3;
    }

    /* ── PAGE ── */
    .limit-page {
        min-height: calc(100vh - 136px);
        background: var(--moss);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
        position: relative;
        overflow: hidden;
    }

    .limit-bg-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(168,198,143,0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(168,198,143,0.05) 1px, transparent 1px);
        background-size: 56px 56px;
    }

    .limit-bg-glow {
        position: absolute;
        top: -200px; left: 50%;
        transform: translateX(-50%);
        width: 700px; height: 700px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(192,57,43,0.1) 0%, transparent 65%);
        pointer-events: none;
    }

    /* ── CARD ── */
    .limit-card {
        position: relative;
        z-index: 2;
        background: var(--cream);
        border: 1px solid var(--linen);
        border-radius: 4px;
        width: 100%;
        max-width: 520px;
        overflow: hidden;
        animation: fadeSlideUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }

    /* Top accent bar */
    .limit-card-accent {
        height: 4px;
        background: linear-gradient(90deg, var(--ember), #E8705A, var(--sand));
        width: 100%;
    }

    .limit-card-body {
        padding: 48px 48px 40px;
        text-align: center;
    }

    /* ── ICON ── */
    .limit-icon-wrap {
        width: 80px; height: 80px;
        margin: 0 auto 28px;
        position: relative;
    }

    .limit-icon-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1.5px solid rgba(192,57,43,0.2);
        animation: ringPulse 2.5s ease-in-out infinite;
    }

    .limit-icon-ring-2 {
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        border: 1px solid rgba(192,57,43,0.08);
        animation: ringPulse 2.5s ease-in-out 0.6s infinite;
    }

    .limit-icon-inner {
        width: 80px; height: 80px;
        background: var(--ember-bg);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .limit-icon-inner i {
        font-size: 1.8rem;
        color: var(--ember);
    }

    /* ── TEXT ── */
    .limit-eyebrow {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.62rem;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--ember);
        margin-bottom: 10px;
    }

    .limit-title {
        font-family: 'Fraunces', serif;
        font-size: 2.2rem;
        font-weight: 200;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 14px;
        letter-spacing: -0.5px;
    }

    .limit-title em {
        font-style: italic;
        color: var(--fern);
    }

    .limit-desc {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.9rem;
        color: #6B7D5A;
        line-height: 1.75;
        margin-bottom: 36px;
        font-weight: 400;
    }

    .limit-wait-highlight {
        font-weight: 700;
        color: var(--moss);
    }

    /* ── COUNTDOWN BLOCK ── */
    .countdown-block {
        background: var(--parchment);
        border: 1px solid var(--linen);
        border-radius: 4px;
        padding: 28px 32px;
        margin-bottom: 24px;
    }

    .countdown-label {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.6rem;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--sand);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .countdown-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--linen);
    }

    .countdown-digits {
        font-family: 'Fraunces', serif;
        font-size: 4rem;
        font-weight: 400;
        color: var(--ink);
        line-height: 1;
        letter-spacing: -2px;
        margin-bottom: 20px;
        transition: color 0.5s;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 0;
    }

    .countdown-digits.warning { color: var(--ember); }

    .countdown-colon {
        animation: blinkColon 1s step-end infinite;
        margin: 0 2px;
        opacity: 1;
    }

    /* ── PROGRESS TRACK ── */
    .countdown-track {
        height: 3px;
        background: var(--linen);
        border-radius: 100px;
        overflow: hidden;
    }

    .countdown-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--sage), var(--mist));
        border-radius: 100px;
        width: 100%;
        transition: width 1s linear, background 0.5s;
    }

    .countdown-fill.warning {
        background: linear-gradient(90deg, var(--ember), #E8705A);
    }

    /* ── INFO BOX ── */
    .info-box {
        background: var(--parchment);
        border: 1px solid var(--linen);
        border-left: 3px solid var(--sage);
        border-radius: 0 4px 4px 0;
        padding: 16px 20px;
        margin-bottom: 32px;
        text-align: left;
    }

    .info-box-header {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--fern);
        font-weight: 700;
        margin-bottom: 8px;
    }

    .info-box-text {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.82rem;
        color: #6B7D5A;
        line-height: 1.7;
        margin: 0;
    }

    .info-box-text strong { color: var(--moss); font-weight: 700; }

    /* ── ACTIONS ── */
    .limit-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .action-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--moss);
        color: var(--parchment);
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.7rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 700;
        padding: 13px 28px;
        border-radius: 3px;
        text-decoration: none;
        transition: background 0.25s;
        position: relative;
        overflow: hidden;
    }

    .action-btn-primary::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--fern);
        transform: translateX(-101%);
        transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
    }

    .action-btn-primary:hover::before { transform: translateX(0); }
    .action-btn-primary span { position: relative; z-index: 1; }

    .action-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        color: var(--sand);
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.7rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 13px 24px;
        border: 1px solid var(--linen);
        border-radius: 3px;
        text-decoration: none;
        transition: all 0.25s;
    }

    .action-btn-ghost:hover {
        border-color: var(--mist);
        color: var(--fern);
    }

    /* ── BOTTOM DIVIDER ── */
    .limit-card-footer {
        padding: 18px 48px;
        border-top: 1px solid var(--linen);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--parchment);
    }

    .limit-card-footer-text {
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.72rem;
        color: var(--sand);
    }

    .redirect-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--dew);
        color: var(--fern);
        font-family: 'Cabinet Grotesk', sans-serif;
        font-size: 0.65rem;
        letter-spacing: 1px;
        padding: 4px 10px;
        border-radius: 100px;
        font-weight: 700;
    }

    .redirect-dot {
        width: 5px; height: 5px;
        background: var(--sage);
        border-radius: 50%;
        animation: blinkColon 1s step-end infinite;
    }

    /* ── ANIMATIONS ── */
    @keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes ringPulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50%       { transform: scale(1.12); opacity: 0; }
    }

    @keyframes blinkColon {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.2; }
    }
</style>
{% endblock %}

{% block body %}

<div class="limit-page">
    <div class="limit-bg-grid"></div>
    <div class="limit-bg-glow"></div>

    <div class="limit-card">

        <div class="limit-card-accent"></div>

        <div class="limit-card-body">

            {# Icon #}
            <div class="limit-icon-wrap">
                <div class="limit-icon-ring-2"></div>
                <div class="limit-icon-ring"></div>
                <div class="limit-icon-inner">
                    <i class="fas fa-hourglass-half"></i>
                </div>
            </div>

            {# Text #}
            <p class="limit-eyebrow">Accès temporairement suspendu</p>
            <h1 class="limit-title">
                Trop de tests<br><em>soumis</em>
            </h1>
            <p class="limit-desc">
                Vous avez atteint la limite horaire. Patientez
                <span class="limit-wait-highlight">{{ minutes }} minute{{ minutes > 1 ? 's' : '' }}</span>
                avant de pouvoir soumettre un nouveau test.
            </p>

            {# Countdown #}
            <div class="countdown-block">
                <div class="countdown-label">Temps restant</div>
                <div class="countdown-digits" id="countdownDisplay">
                    <span id="cdMin">{{ '%02d'|format(minutes) }}</span>
                    <span class="countdown-colon">:</span>
                    <span id="cdSec">00</span>
                </div>
                <div class="countdown-track">
                    <div class="countdown-fill" id="countdownFill"></div>
                </div>
            </div>

            {# Info #}
            <div class="info-box">
                <div class="info-box-header">
                    <i class="fas fa-info-circle" style="color:var(--sage);font-size:0.75rem;"></i>
                    Pourquoi cette limite ?
                </div>
                <p class="info-box-text">
                    Pour garantir la qualité des analyses, nous limitons les soumissions à
                    <strong>3 tests par heure</strong>. Cela nous permet de vous fournir
                    des résultats précis et personnalisés.
                </p>
            </div>

            {# Actions #}
            <div class="limit-actions">
                <a href="{{ path('front_test_list') }}" class="action-btn-primary">
                    <span>Voir tous les tests</span>
                </a>
                <a href="{{ path('front_test_show', {'id': test.id}) }}" class="action-btn-ghost">
                    <i class="fas fa-redo" style="font-size:0.6rem;"></i>
                    Réessayer quand même
                </a>
            </div>

        </div>

        {# Footer #}
        <div class="limit-card-footer">
            <span class="limit-card-footer-text">Redirection automatique dans</span>
            <div class="redirect-badge">
                <div class="redirect-dot"></div>
                <span id="redirectCountdown">{{ minutes }}:00</span>
            </div>
        </div>

    </div>
</div>

<script>
const totalSeconds = {{ minutes }} * 60;
let secondsLeft    = totalSeconds;

const cdMin  = document.getElementById('cdMin');
const cdSec  = document.getElementById('cdSec');
const fill   = document.getElementById('countdownFill');
const digits = document.getElementById('countdownDisplay');
const rdBadge = document.getElementById('redirectCountdown');

const timer = setInterval(function() {
    secondsLeft--;

    if (secondsLeft <= 0) {
        clearInterval(timer);
        cdMin.textContent = '00';
        cdSec.textContent = '00';
        window.location.href = '{{ path('front_test_show', {'id': test.id}) }}';
        return;
    }

    const m = Math.floor(secondsLeft / 60);
    const s = secondsLeft % 60;
    cdMin.textContent = String(m).padStart(2, '0');
    cdSec.textContent = String(s).padStart(2, '0');
    rdBadge.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');

    const pct = (secondsLeft / totalSeconds) * 100;
    fill.style.width = pct + '%';

    if (secondsLeft <= 60) {
        digits.classList.add('warning');
        fill.classList.add('warning');
    }
}, 1000);
</script>

{% endblock %}
