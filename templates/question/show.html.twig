{% extends 'base.html.twig' %}

{% block title %}Question{% endblock %}

{% block body %}
    <h1>Question</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ question.id }}</td>
            </tr>
            <tr>
                <th>Texte</th>
                <td>{{ question.texte }}</td>
            </tr>
            <tr>
                <th>Type_question</th>
                <td>{{ question.typeQuestion }}</td>
            </tr>
            <tr>
                <th>Reponses_possibles</th>
                <td>{{ question.reponsesPossibles }}</td>
            </tr>
            <tr>
                <th>Points</th>
                <td>{{ question.points }}</td>
            </tr>
            <tr>
                <th>Ordre</th>
                <td>{{ question.ordre }}</td>
            </tr>
            <tr>
                <th>Obligatoire</th>
                <td>{{ question.obligatoire ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ question.status }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ question.createdAt ? question.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_question_index') }}">back to list</a>

    <a href="{{ path('app_question_edit', {'id': question.id}) }}">edit</a>

    {{ include('question/_delete_form.html.twig') }}
{% endblock %}
