<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="TestPsychologique.controllers.JournalController"
            style="-fx-background-color: linear-gradient(to bottom, #f0f4f8, #e8f0f7);">

    <!-- Header Compact -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 25;">
            <Button text="←" onAction="#handleBack"
                    style="-fx-background-color: #f5f5f5; -fx-text-fill: #333; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 35; -fx-pref-height: 35; -fx-background-radius: 18; -fx-cursor: hand;">
                <cursor><Cursor fx:constant="HAND"/></cursor>
            </Button>

            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label fx:id="dateLabel" text="Vendredi 24 février 2024"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                <Label text="Comment s'est passée votre journée ?"
                       style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
            </VBox>

            <Label fx:id="streakLabel" text="🔥 7 jours"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #ff6b35; -fx-background-color: #fff4f0; -fx-padding: 6 12; -fx-background-radius: 12;"/>

            <Button text="📊 Calendrier" onAction="#showCalendar"
                    style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 15; -fx-cursor: hand;">
                <cursor><Cursor fx:constant="HAND"/></cursor>
            </Button>
        </HBox>
    </top>

    <!-- Main Content avec padding réduit -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="15" style="-fx-padding: 20; -fx-max-width: 800; -fx-alignment: TOP_CENTER;">

                <!-- 1. HUMEUR -->
                <VBox spacing="10">
                    <Label text="😊 Comment vous sentez-vous ?"
                           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>

                    <HBox spacing="10" alignment="CENTER">
                        <VBox fx:id="btnExcellent" onMouseClicked="#selectHumeur" alignment="CENTER" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 10; -fx-pref-width: 85; -fx-pref-height: 95; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);"
                              userData="excellent">
                            <Label text="😊" style="-fx-font-size: 36px;"/>
                            <Label text="Excellent" style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-font-weight: 600;"/>
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </VBox>

                        <VBox fx:id="btnBien" onMouseClicked="#selectHumeur" alignment="CENTER" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 10; -fx-pref-width: 85; -fx-pref-height: 95; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);"
                              userData="bien">
                            <Label text="🙂" style="-fx-font-size: 36px;"/>
                            <Label text="Bien" style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-font-weight: 600;"/>
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </VBox>

                        <VBox fx:id="btnMoyen" onMouseClicked="#selectHumeur" alignment="CENTER" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 10; -fx-pref-width: 85; -fx-pref-height: 95; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);"
                              userData="moyen">
                            <Label text="😐" style="-fx-font-size: 36px;"/>
                            <Label text="Moyen" style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-font-weight: 600;"/>
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </VBox>

                        <VBox fx:id="btnDifficile" onMouseClicked="#selectHumeur" alignment="CENTER" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 10; -fx-pref-width: 85; -fx-pref-height: 95; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);"
                              userData="difficile">
                            <Label text="😔" style="-fx-font-size: 36px;"/>
                            <Label text="Difficile" style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-font-weight: 600;"/>
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </VBox>

                        <VBox fx:id="btnTresDifficile" onMouseClicked="#selectHumeur" alignment="CENTER" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 10; -fx-pref-width: 85; -fx-pref-height: 95; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);"
                              userData="très_difficile">
                            <Label text="😰" style="-fx-font-size: 36px;"/>
                            <Label text="Très difficile" style="-fx-font-size: 10px; -fx-text-fill: #666; -fx-font-weight: 600;"/>
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- 2. ÉMOTIONS -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
                    <Label text="💭 Quelles émotions ?"
                           style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                    <FlowPane fx:id="emotionsPane" hgap="8" vgap="8"/>
                </VBox>

                <!-- 3. ÉNERGIE & SOMMEIL -->
                <HBox spacing="12">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="⚡" style="-fx-font-size: 18px;"/>
                            <Label text="Énergie" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                        </HBox>
                        <Slider fx:id="energieSlider" min="1" max="10" value="5"
                                showTickMarks="false" showTickLabels="false"/>
                        <Label fx:id="energieLabel" text="5/10"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" alignment="CENTER"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="😴" style="-fx-font-size: 18px;"/>
                            <Label text="Sommeil" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                        </HBox>
                        <Slider fx:id="sommeilSlider" min="1" max="10" value="5"
                                showTickMarks="false" showTickLabels="false"/>
                        <Label fx:id="sommeilLabel" text="5/10"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" alignment="CENTER"/>
                    </VBox>
                </HBox>

                <!-- 4. NOTES -->
                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="✍️" style="-fx-font-size: 18px;"/>
                        <Label text="Racontez votre journée" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                    </HBox>
                    <TextArea fx:id="notesArea" promptText="Qu'est-ce qui a marqué votre journée ?"
                              wrapText="true" prefRowCount="4"
                              style="-fx-font-size: 13px; -fx-background-color: #f8f9fa; -fx-border-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;"/>
                    <Label fx:id="charCountLabel" text="0 caractères"
                           style="-fx-font-size: 10px; -fx-text-fill: #999;" alignment="CENTER_RIGHT"/>
                </VBox>

                <!-- 5. BOUTON SAVE -->
                <Button text="💾 Enregistrer" onAction="#saveEntry"
                        style="-fx-background-color: linear-gradient(to right, #2e7d32, #43a047); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 0; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(46,125,50,0.3), 8, 0, 0, 3); -fx-min-height: 50;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
