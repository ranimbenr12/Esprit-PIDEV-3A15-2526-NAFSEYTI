<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="TestPsychologique.controllers.UserInterfaceController"
            style="-fx-background-color: #f5f5f5;">

    <!-- Sidebar -->
    <left>
        <VBox spacing="0" style="-fx-background-color: #ece6df; -fx-pref-width: 250;">
            <padding>
                <Insets top="30" right="0" bottom="30" left="0"/>
            </padding>

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="10">
                <padding>
                    <Insets bottom="30"/>
                </padding>

                <StackPane>
                    <Circle radius="50" style="-fx-fill: linear-gradient(to bottom right, #285921, #2e7d32);"/>
                    <Label text="🧠" style="-fx-font-size: 48px;"/>
                </StackPane>

                <Label text="NAFSEYTI" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                <Label text="Espace Étudiant" style="-fx-font-size: 11px; -fx-text-fill: #69685c; -fx-font-style: italic;"/>
            </VBox>

            <!-- User Profile Card -->
            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 10; -fx-padding: 15;">
                <VBox.margin>
                    <Insets left="15" right="15" bottom="20"/>
                </VBox.margin>
                <Label text="👤" style="-fx-font-size: 36px;"/>
                <Label fx:id="welcomeLabel" text="Utilisateur Demo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                <Label text="Étudiant" style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-background-color: #e8f5e9; -fx-padding: 5 15; -fx-background-radius: 15;"/>
            </VBox>

            <Separator style="-fx-background-color: rgba(105, 104, 92, 0.2);">
                <VBox.margin>
                    <Insets top="0" right="20" bottom="20" left="20"/>
                </VBox.margin>
            </Separator>

            <!-- Navigation Buttons -->
            <VBox spacing="8">
                <padding>
                    <Insets left="15" right="15"/>
                </padding>

                <Button text="📊  Tableau de bord" maxWidth="Infinity"
                        style="-fx-background-color: #374535; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button text="🎯  Tests Disponibles" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button text="📈  Mes Résultats" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button text="🕐  Historique" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout Button -->
            <VBox>
                <padding>
                    <Insets top="20" right="15" bottom="0" left="15"/>
                </padding>
                <Separator style="-fx-background-color: rgba(105, 104, 92, 0.2);">
                    <VBox.margin>
                        <Insets bottom="15"/>
                    </VBox.margin>
                </Separator>
                <Button text="🔓  Se déconnecter" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #285921; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: #285921; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12 20; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #f8f5f2; -fx-background-color: #f8f5f2;">
            <VBox spacing="30" style="-fx-background-color: #f8f5f2;">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <!-- Welcome Section -->
                <VBox alignment="CENTER" spacing="15">
                    <Label text="Bienvenue sur NAFSEYTI 👋" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                    <Label text="Découvrez et passez vos tests psychologiques"
                           style="-fx-font-size: 16px; -fx-text-fill: #666666;" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <!-- Stats Cards -->
                <HBox spacing="30" alignment="CENTER">

                    <!-- Card 1 - Tests Disponibles -->
                    <VBox alignment="CENTER" spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-pref-width: 250; -fx-pref-height: 200;">
                        <Label text="🎯" style="-fx-font-size: 48px;"/>
                        <Label text="Tests Disponibles" style="-fx-font-size: 16px; -fx-text-fill: #666666;"/>
                        <Label fx:id="testsCountLabel" text="0" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                        <Button text="Voir les Tests" onAction="#showAllTests"
                                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>

                    <!-- Card 2 - Tests Complétés -->
                    <VBox alignment="CENTER" spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-pref-width: 250; -fx-pref-height: 200;">
                        <Label text="✅" style="-fx-font-size: 48px;"/>
                        <Label text="Tests Complétés" style="-fx-font-size: 16px; -fx-text-fill: #666666;"/>
                        <Label text="0" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                        <Button text="Voir Résultats"
                                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>

                    <!-- Card 3 - Tests En Cours -->
                    <VBox alignment="CENTER" spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-pref-width: 250; -fx-pref-height: 200;">
                        <Label text="⏳" style="-fx-font-size: 48px;"/>
                        <Label text="Tests En Cours" style="-fx-font-size: 16px; -fx-text-fill: #666666;"/>
                        <Label text="0" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                        <Button text="Continuer"
                                style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>

                </HBox>

                <!-- Tests Recommandés -->
                <VBox fx:id="testsContainer" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="⭐" style="-fx-font-size: 32px;"/>
                        <Label text="Tests Recommandés Pour Vous" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #e0e0e0;"/>

                    <!-- Les tests seront ajoutés dynamiquement ici -->
                    <VBox fx:id="testsListContainer" spacing="20">
                        <!-- Dynamic test cards will be added here -->
                    </VBox>

                    <!-- Empty state -->
                    <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="15" style="-fx-padding: 60 40;" visible="false" managed="false">
                        <Label text="📭" style="-fx-font-size: 64px;"/>
                        <Label text="Aucun test disponible" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                        <Label text="Les tests psychologiques apparaîtront ici une fois créés par l'administrateur"
                               style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-text-alignment: center;" wrapText="true"/>
                    </VBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
