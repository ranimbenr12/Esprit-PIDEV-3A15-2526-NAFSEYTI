<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="TestPsychologique.controllers.ResultatViewController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: #f8f5f2;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Container principal -->
    <VBox alignment="CENTER" spacing="30" maxWidth="800">

        <!-- Icône de succès -->
        <Label text="🎉" style="-fx-font-size: 80px;"/>

        <!-- Titre -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="Test Terminé!"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
            <Label fx:id="testNameLabel" text="Nom du test"
                   style="-fx-font-size: 18px; -fx-text-fill: #666;"/>
        </VBox>

        <!-- Card Score -->
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">

            <Label text="VOTRE SCORE"
                   style="-fx-font-size: 16px; -fx-text-fill: #666; -fx-font-weight: bold; letter-spacing: 2px;"/>

            <Label fx:id="scoreLabel" text="0 / 100"
                   style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>

            <HBox alignment="CENTER" spacing="15">
                <Label text="Questions répondues:" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                <Label fx:id="questionsLabel" text="10/10"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
            </HBox>
        </VBox>

        <!-- Card Interprétation -->
        <VBox fx:id="interpretationCard" spacing="20"
              style="-fx-background-color: #e8f5e9; -fx-background-radius: 15; -fx-padding: 30; -fx-border-color: #2e7d32; -fx-border-width: 2; -fx-border-radius: 15;">

            <!-- Titre de l'interprétation -->
            <HBox alignment="CENTER" spacing="10">
                <Label text="📊" style="-fx-font-size: 32px;"/>
                <Label fx:id="interpretationTitreLabel" text="Votre Profil"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
            </HBox>

            <Separator style="-fx-background-color: #2e7d32;"/>

            <!-- Description -->
            <VBox spacing="15">
                <Label text="📝 ANALYSE"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #285921; letter-spacing: 1px;"/>
                <Label fx:id="interpretationDescLabel" wrapText="true"
                       style="-fx-font-size: 15px; -fx-text-fill: #333; -fx-line-spacing: 5px;"/>
            </VBox>

            <!-- Conseils -->
            <VBox fx:id="conseilsBox" spacing="15">
                <Label text="💡 CONSEILS PERSONNALISÉS"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #285921; letter-spacing: 1px;"/>
                <Label fx:id="interpretationConseilsLabel" wrapText="true"
                       style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-line-spacing: 5px;"/>
            </VBox>

        </VBox>

        <!-- Boutons d'action -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="🏠 Retour à l'accueil" onAction="#returnToHome"
                    prefWidth="200" prefHeight="50"
                    style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;">
                <cursor><Cursor fx:constant="HAND"/></cursor>
            </Button>

            <Button text="🔁 Refaire le test" onAction="#refaireTest"
                    prefWidth="200" prefHeight="50"
                    style="-fx-background-color: transparent; -fx-text-fill: #2e7d32; -fx-font-size: 15px; -fx-font-weight: bold; -fx-border-color: #2e7d32; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;">
                <cursor><Cursor fx:constant="HAND"/></cursor>
            </Button>
        </HBox>

        <!-- Note -->
        <Label text="💾 Votre résultat a été enregistré"
               style="-fx-font-size: 12px; -fx-text-fill: #999; -fx-font-style: italic;"/>

    </VBox>

</VBox>
