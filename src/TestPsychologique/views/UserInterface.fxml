<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="TestPsychologique.controllers.UserInterfaceController"
            style="-fx-background-color: #f5f5f5;">

    <!-- Sidebar -->
    <left>
        <VBox spacing="0" style="-fx-background-color: #ece6df; -fx-pref-width: 250;">
            <padding>
                <Insets top="30" right="0" bottom="30" left="0"/>
            </padding>

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="10">
                <padding>
                    <Insets bottom="30"/>
                </padding>

                <StackPane>
                    <Circle radius="50" style="-fx-fill: linear-gradient(to bottom right, #285921, #2e7d32);"/>
                    <ImageView fx:id="logoImage" fitHeight="80" fitWidth="80" preserveRatio="true"/>
                </StackPane>

                <Label text="NAFSEYTI" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                <Label text="Espace Étudiant" style="-fx-font-size: 11px; -fx-text-fill: #69685c; -fx-font-style: italic;"/>
            </VBox>

            <!-- User Profile Card -->
            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 10; -fx-padding: 15;">
                <VBox.margin>
                    <Insets left="15" right="15" bottom="20"/>
                </VBox.margin>
                <Label text="👤" style="-fx-font-size: 36px;"/>
                <Label fx:id="welcomeLabel" text="Utilisateur Demo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                <Label text="Étudiant" style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-background-color: #e8f5e9; -fx-padding: 5 15; -fx-background-radius: 15;"/>
            </VBox>

            <Separator style="-fx-background-color: rgba(105, 104, 92, 0.2);">
                <VBox.margin>
                    <Insets top="0" right="20" bottom="20" left="20"/>
                </VBox.margin>
            </Separator>

            <!-- Navigation Buttons -->
            <VBox spacing="8">
                <padding>
                    <Insets left="15" right="15"/>
                </padding>

                <Button text="📊  Tableau de bord" maxWidth="Infinity"
                        style="-fx-background-color: #374535; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button text="🎯  Tests Disponibles" maxWidth="Infinity" onAction="#showAllTests"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button text="📈  Mes Résultats" maxWidth="Infinity" onAction="#showResultats"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button text="🕐  Historique" maxWidth="Infinity" onAction="#showResultats"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-padding: 15 20; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout Button -->
            <VBox>
                <padding>
                    <Insets top="20" right="15" bottom="0" left="15"/>
                </padding>
                <Separator style="-fx-background-color: rgba(105, 104, 92, 0.2);">
                    <VBox.margin>
                        <Insets bottom="15"/>
                    </VBox.margin>
                </Separator>
                <Button text="🔓  Se déconnecter" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #285921; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: #285921; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12 20; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #f8f5f2; -fx-background-color: #f8f5f2;">
            <VBox spacing="30" style="-fx-background-color: #f8f5f2;">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <!-- ✅ Welcome Section AVEC IMAGE DE FOND -->
                <!-- ✅ Welcome Section AVEC IMAGE DE FOND - VERSION CORRIGÉE -->
                <StackPane prefHeight="250" style="-fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 3);">

                    <!-- Image de fond - CORRIGÉ -->
                    <ImageView fx:id="backgroundImage" fitHeight="250" fitWidth="1200" preserveRatio="false" smooth="true">
                        <StackPane.margin>
                            <Insets/>
                        </StackPane.margin>
                        <!-- ✅ AJOUT : Clip pour respecter le border-radius -->
                        <clip>
                            <javafx.scene.shape.Rectangle width="1200" height="250" arcWidth="30" arcHeight="30"/>
                        </clip>
                    </ImageView>

                    <!-- Overlay sombre pour meilleure lisibilité -->
                    <VBox style="-fx-background-color: rgba(171,204,167,0.45); -fx-background-radius: 15;" prefHeight="250"/>

                    <!-- Contenu texte par-dessus -->
                    <VBox alignment="CENTER" spacing="15" prefHeight="250">
                        <padding>
                            <Insets top="20" right="40" bottom="20" left="40"/>
                        </padding>
                        <Label text="Bienvenue sur NAFSEYTI 👋"
                               style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 10, 0, 0, 2);"/>
                        <Label text="Découvrez et passez vos tests psychologiques"
                               style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 5, 0, 0, 2);"
                               wrapText="true" textAlignment="CENTER"/>
                    </VBox>

                </StackPane>

                <!-- Stats Cards -->
                <!-- Stats Cards AVEC IMAGES DE FOND -->
                <!-- Stats Cards AVEC IMAGES DE FOND - OVERLAY RÉDUIT -->
                <!-- Stats Cards AVEC IMAGES DE FOND EN PLEIN ÉCRAN -->
                <HBox spacing="30" alignment="CENTER">

                    <!-- Card 1 - Tests Disponibles -->
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 3); -fx-pref-width: 280; -fx-pref-height: 280;">

                        <!-- Zone Image (partie haute - 60%) -->
                        <StackPane prefHeight="168" prefWidth="280" style="-fx-background-radius: 15 15 0 0;">
                            <ImageView fx:id="testDisponibleImage" fitHeight="168" fitWidth="280" preserveRatio="true" smooth="true">
                                <clip>
                                    <javafx.scene.shape.Rectangle width="280" height="168" arcWidth="30" arcHeight="30"/>
                                </clip>
                            </ImageView>
                        </StackPane>

                        <!-- Zone Contenu (partie basse - 40%) -->
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 15 20; -fx-background-color: white; -fx-background-radius: 0 0 15 15;" VBox.vgrow="ALWAYS">
                            <Label text="Tests Disponibles"
                                   style="-fx-font-size: 16px; -fx-text-fill: #2d2d2d; -fx-font-weight: bold;"/>
                            <Label fx:id="testsCountLabel" text="0"
                                   style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                            <Button text="Voir les Tests" onAction="#showAllTests"
                                    style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; -fx-cursor: hand;">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </Button>
                        </VBox>
                    </VBox>

                    <!-- Card 2 - Tests Complétés -->
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 3); -fx-pref-width: 280; -fx-pref-height: 280;">

                        <!-- Zone Image (partie haute - 60%) -->
                        <StackPane prefHeight="168" prefWidth="280" style="-fx-background-radius: 15 15 0 0;">
                            <ImageView fx:id="testCompleteImage" fitHeight="168" fitWidth="280" preserveRatio="true" smooth="true">
                                <clip>
                                    <javafx.scene.shape.Rectangle width="280" height="168" arcWidth="30" arcHeight="30"/>
                                </clip>
                            </ImageView>
                        </StackPane>

                        <!-- Zone Contenu (partie basse - 40%) -->
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 15 20; -fx-background-color: white; -fx-background-radius: 0 0 15 15;" VBox.vgrow="ALWAYS">
                            <Label text="Tests Complétés"
                                   style="-fx-font-size: 16px; -fx-text-fill: #2d2d2d; -fx-font-weight: bold;"/>
                            <Label fx:id="testsCompletesLabel" text="0"
                                   style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                            <Button text="Voir Résultats" onAction="#showResultats"
                                    style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; -fx-cursor: hand;">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </Button>
                        </VBox>
                    </VBox>

                    <!-- Card 3 - Tests En Cours -->
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 3); -fx-pref-width: 280; -fx-pref-height: 280;">

                        <!-- Zone Image (partie haute - 60%) -->
                        <StackPane prefHeight="168" prefWidth="280" style="-fx-background-radius: 15 15 0 0;">
                            <ImageView fx:id="testEncoursImage" fitHeight="168" fitWidth="280" preserveRatio="true" smooth="true">
                                <clip>
                                    <javafx.scene.shape.Rectangle width="280" height="168" arcWidth="30" arcHeight="30"/>
                                </clip>
                            </ImageView>
                        </StackPane>

                        <!-- Zone Contenu (partie basse - 40%) -->
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 15 20; -fx-background-color: white; -fx-background-radius: 0 0 15 15;" VBox.vgrow="ALWAYS">
                            <Label text="Tests En Cours"
                                   style="-fx-font-size: 16px; -fx-text-fill: #2d2d2d; -fx-font-weight: bold;"/>
                            <Label text="0"
                                   style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                            <Button text="Continuer" onAction="#continueTest"
                                    style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; -fx-cursor: hand;">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </Button>
                        </VBox>
                    </VBox>

                </HBox>

                <!-- Tests Recommandés -->
                <VBox fx:id="testsContainer" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="⭐" style="-fx-font-size: 32px;"/>
                        <Label text="Tests Recommandés Pour Vous" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #e0e0e0;"/>

                    <!-- Les tests seront ajoutés dynamiquement ici -->
                    <VBox fx:id="testsListContainer" spacing="20">
                        <!-- Dynamic test cards will be added here -->
                    </VBox>

                    <!-- Empty state -->
                    <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="15" style="-fx-padding: 60 40;" visible="false" managed="false">
                        <Label text="📭" style="-fx-font-size: 64px;"/>
                        <Label text="Aucun test disponible" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                        <Label text="Les tests psychologiques apparaîtront ici une fois créés par l'administrateur"
                               style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-text-alignment: center;" wrapText="true"/>
                    </VBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
