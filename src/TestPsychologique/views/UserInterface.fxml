<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="TestPsychologique.controllers.UserInterfaceController"
            style="-fx-background-color: #f8f5f2;">

    <!-- ═══════════ SIDEBAR ═══════════ -->
    <left>
        <VBox spacing="0" style="-fx-background-color: #ece6df; -fx-pref-width: 255; -fx-min-width: 255;">
            <padding><Insets top="30" right="0" bottom="30" left="0"/></padding>

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="8">
                <padding><Insets bottom="20"/></padding>
                <StackPane alignment="CENTER">
                    <Circle radius="48" style="-fx-fill: linear-gradient(to bottom right, #285921, #43a047);
                                               -fx-effect: dropshadow(gaussian, rgba(40,89,33,0.3), 10, 0, 0, 3);"/>
                    <ImageView fx:id="logoImage" fitHeight="72" fitWidth="72" preserveRatio="true"/>
                </StackPane>
                <Label text="NAFSEYTI"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                <Label text="Espace Etudiant"
                       style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-style: italic;"/>
            </VBox>

            <!-- Profil -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.7); -fx-background-radius: 12; -fx-padding: 16;">
                <VBox.margin><Insets left="15" right="15" bottom="18"/></VBox.margin>
                <StackPane alignment="CENTER">
                    <Circle radius="26" style="-fx-fill: #e8f5e9;"/>
                    <Label text="&#128100;" style="-fx-font-size: 26px;"/>
                </StackPane>
                <Label fx:id="welcomeLabel" text="Utilisateur Demo"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                <Label text="Etudiant"
                       style="-fx-font-size: 11px; -fx-text-fill: #555;
                              -fx-background-color: #e8f5e9; -fx-padding: 4 14; -fx-background-radius: 12;"/>
            </VBox>

            <Separator style="-fx-background-color: rgba(105,104,92,0.2);">
                <VBox.margin><Insets top="0" right="20" bottom="15" left="20"/></VBox.margin>
            </Separator>

            <!-- Navigation -->
            <VBox spacing="5">
                <padding><Insets left="12" right="12"/></padding>

                <Button text="   Mon Journal" maxWidth="Infinity" onAction="#showJournal"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c;
                               -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                               -fx-padding: 13 18; -fx-background-radius: 8; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
                <Button text="   Tableau de bord" maxWidth="Infinity"
                        style="-fx-background-color: #374535; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;
                               -fx-padding: 13 18; -fx-background-radius: 8; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
                <Button text="   Tests Disponibles" maxWidth="Infinity" onAction="#showAllTests"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c;
                               -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                               -fx-padding: 13 18; -fx-background-radius: 8; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
                <Button text="   Mes Resultats" maxWidth="Infinity" onAction="#showResultats"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c;
                               -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                               -fx-padding: 13 18; -fx-background-radius: 8; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
                <Button text="   Historique" maxWidth="Infinity" onAction="#showResultats"
                        style="-fx-background-color: transparent; -fx-text-fill: #69685c;
                               -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                               -fx-padding: 13 18; -fx-background-radius: 8; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
                <Button text="   Blague du jour" onAction="#handleJoke" maxWidth="Infinity"
                        style="-fx-background-color: #ff9800; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;
                               -fx-padding: 13 18; -fx-background-radius: 8; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Deconnexion -->
            <VBox>
                <padding><Insets top="15" right="12" bottom="0" left="12"/></padding>
                <Separator style="-fx-background-color: rgba(105,104,92,0.2);">
                    <VBox.margin><Insets bottom="12"/></VBox.margin>
                </Separator>
                <Button text="   Se deconnecter" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #285921;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-border-color: #285921; -fx-border-width: 1.5;
                               -fx-border-radius: 8; -fx-background-radius: 8;
                               -fx-padding: 12 18; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════ CONTENU PRINCIPAL ═══════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #f8f5f2; -fx-background-color: #f8f5f2; -fx-border-color: transparent;">
            <VBox spacing="22" style="-fx-background-color: #f8f5f2;">
                <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>

                <!-- ══ BANNER HERO ══ -->
                <StackPane prefHeight="195"
                           style="-fx-background-color: linear-gradient(to right, #285921, #43a047, #66bb6a);
                                  -fx-background-radius: 16;
                                  -fx-effect: dropshadow(gaussian, rgba(40,89,33,0.35), 16, 0, 0, 5);">

                    <!-- Cercles décoratifs -->
                    <Circle radius="110" translateX="410" translateY="-25"
                            style="-fx-fill: rgba(255,255,255,0.07);"/>
                    <Circle radius="75" translateX="330" translateY="55"
                            style="-fx-fill: rgba(255,255,255,0.05);"/>
                    <Circle radius="55" translateX="-330" translateY="25"
                            style="-fx-fill: rgba(255,255,255,0.05);"/>

                    <VBox alignment="CENTER" spacing="10">
                        <padding><Insets left="40" right="40"/></padding>
                        <Label text="Bienvenue sur NAFSEYTI"
                               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 6, 0, 0, 2);"/>
                        <Label text="Decouvrez et passez vos tests psychologiques en toute serenite"
                               style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.88);"
                               wrapText="true" textAlignment="CENTER"/>
                        <HBox spacing="12" alignment="CENTER">
                            <VBox.margin><Insets top="6"/></VBox.margin>
                            <Button text="Commencer un test" onAction="#showAllTests"
                                    style="-fx-background-color: white; -fx-text-fill: #285921;
                                           -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-padding: 9 22; -fx-background-radius: 18; -fx-cursor: hand;">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </Button>
                            <Button text="Mon Journal" onAction="#showJournal"
                                    style="-fx-background-color: rgba(255,255,255,0.18);
                                           -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-padding: 9 22; -fx-background-radius: 18; -fx-cursor: hand;
                                           -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 1.5; -fx-border-radius: 18;">
                                <cursor><Cursor fx:constant="HAND"/></cursor>
                            </Button>
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- ══ STATS CARDS ══ -->
                <HBox spacing="18" alignment="CENTER">

                    <!-- Card Tests Disponibles -->
                    <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-padding: 24 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);
                                 -fx-pref-height: 190;">
                        <StackPane alignment="CENTER">
                            <Circle radius="28" style="-fx-fill: #e8f5e9;"/>
                            <Label text="&#127919;" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Tests Disponibles"
                               style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                        <Label fx:id="testsCountLabel" text="0"
                               style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                        <Button text="Voir les Tests" onAction="#showAllTests"
                                style="-fx-background-color: #285921; -fx-text-fill: white;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-padding: 8 20; -fx-background-radius: 16; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>

                    <!-- Card Tests Completes -->
                    <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-padding: 24 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);
                                 -fx-pref-height: 190;">
                        <StackPane alignment="CENTER">
                            <Circle radius="28" style="-fx-fill: #e3f2fd;"/>
                            <Label text="&#9989;" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Tests Completes"
                               style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                        <Label fx:id="testsCompletesLabel" text="0"
                               style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
                        <Button text="Voir Resultats" onAction="#showResultats"
                                style="-fx-background-color: #1565c0; -fx-text-fill: white;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-padding: 8 20; -fx-background-radius: 16; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>

                    <!-- Card Tests En Cours -->
                    <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-padding: 24 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);
                                 -fx-pref-height: 190;">
                        <StackPane alignment="CENTER">
                            <Circle radius="28" style="-fx-fill: #fff8e1;"/>
                            <Label text="&#9200;" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Tests En Cours"
                               style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                        <Label text="0"
                               style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #e65100;"/>
                        <Button text="Continuer" onAction="#continueTest"
                                style="-fx-background-color: #ff9800; -fx-text-fill: white;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-padding: 8 20; -fx-background-radius: 16; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>

                    <!-- Card Journal -->
                    <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-padding: 24 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);
                                 -fx-pref-height: 190;">
                        <StackPane alignment="CENTER">
                            <Circle radius="28" style="-fx-fill: #fce4ec;"/>
                            <Label text="&#128212;" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Mon Journal"
                               style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                        <Label text="Journal"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #c2185b;"/>
                        <Button text="Ecrire" onAction="#showJournal"
                                style="-fx-background-color: #c2185b; -fx-text-fill: white;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-padding: 8 20; -fx-background-radius: 16; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>
                </HBox>

                <!-- ══ TESTS RECOMMANDES ══ -->
                <VBox fx:id="testsContainer" spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-padding: 20 22 16 22;
                                 -fx-border-color: transparent transparent #f0ece8 transparent;
                                 -fx-border-width: 0 0 1 0;">
                        <StackPane>
                            <Circle radius="17" style="-fx-fill: #e8f5e9;"/>
                            <Label text="&#11088;" style="-fx-font-size: 15px;"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="Tests Recommandes Pour Vous"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                            <Label text="Selectionnes selon votre profil"
                                   style="-fx-font-size: 11px; -fx-text-fill: #aaa;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Voir tout" onAction="#showAllTests"
                                style="-fx-background-color: #e8f5e9; -fx-text-fill: #285921;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-padding: 6 16; -fx-background-radius: 13; -fx-cursor: hand;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </HBox>

                    <VBox fx:id="testsListContainer" spacing="0"
                          style="-fx-padding: 8 22 14 22;"/>

                    <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="10"
                          style="-fx-padding: 45 40;" visible="false" managed="false">
                        <Label text="&#128204;" style="-fx-font-size: 48px;"/>
                        <Label text="Aucun test disponible pour le moment"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #444;"/>
                        <Label text="Les tests apparaitront ici une fois crees par l'administrateur"
                               style="-fx-font-size: 12px; -fx-text-fill: #aaa;"
                               wrapText="true" textAlignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- ══ BAS DE PAGE - Conseil + Citation ══ -->
                <HBox spacing="18">
                    <!-- Conseil -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: linear-gradient(to right, #285921, #43a047);
                                 -fx-background-radius: 14; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(40,89,33,0.25), 10, 0, 0, 3);">
                        <Label text="Conseil du jour"
                               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.65);
                                      -fx-font-weight: bold;"/>
                        <Label text="Prenez soin de votre sante mentale"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"
                               wrapText="true"/>
                        <Label text="Quelques minutes d'ecriture chaque jour aident a mieux comprendre vos emotions et reduire le stress."
                               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.82);"
                               wrapText="true"/>
                        <Button text="Ouvrir le Journal" onAction="#showJournal"
                                style="-fx-background-color: rgba(255,255,255,0.18);
                                       -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-padding: 8 18; -fx-background-radius: 13; -fx-cursor: hand;
                                       -fx-border-color: rgba(255,255,255,0.35); -fx-border-width: 1; -fx-border-radius: 13;">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </VBox>

                    <!-- Citation -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);">
                        <Label text="Citation du jour"
                               style="-fx-font-size: 10px; -fx-text-fill: #aaa; -fx-font-weight: bold;"/>
                        <Label text="La sante mentale est une priorite"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
                               wrapText="true"/>
                        <Label text="Chaque pas vers la connaissance de soi est un pas vers une meilleure version de vous-meme."
                               style="-fx-font-size: 12px; -fx-text-fill: #666;"
                               wrapText="true"/>
                        <Label text="- NAFSEYTI"
                               style="-fx-font-size: 11px; -fx-text-fill: #285921;
                                      -fx-font-weight: bold; -fx-font-style: italic;"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
