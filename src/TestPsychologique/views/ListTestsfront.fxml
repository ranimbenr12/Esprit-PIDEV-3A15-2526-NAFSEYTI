<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="TestPsychologique.controllers.ListTestsfrontController"
      spacing="0"
      style="-fx-background-color: #f8f5f2;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox.margin>
            <Insets bottom="30"/>
        </VBox.margin>
        <Button text="😄 Blague du jour" onAction="#handleJoke"/>
        <Button text="← Retour" onAction="#returnToHome"
                style="-fx-background-color: transparent; -fx-text-fill: #285921; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: #285921; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;">
            <cursor><Cursor fx:constant="HAND"/></cursor>
        </Button>

        <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
            <Label text="📝" style="-fx-font-size: 36px;"/>
            <VBox>
                <Label fx:id="testNameLabel" text="Nom du Test"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
                <Label fx:id="testDescriptionLabel" text="Description du test"
                       style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- Progress Bar -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <VBox.margin>
            <Insets bottom="20"/>
        </VBox.margin>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="questionNumberLabel" text="Question 1 sur 10"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #285921;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressLabel" text="10%"
                   style="-fx-font-size: 14px; -fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
        </HBox>

        <ProgressBar fx:id="progressBar" progress="0.1" maxWidth="Infinity" prefHeight="10"
                     style="-fx-accent: #2e7d32;"/>
    </VBox>

    <!-- Question Card -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

            <!-- Question Content Container -->
            <VBox fx:id="questionContainer" spacing="20">
                <!-- Questions will be dynamically loaded here -->
            </VBox>

            <!-- Navigation Buttons -->
            <HBox spacing="15" alignment="CENTER">
                <padding>
                    <Insets top="20"/>
                </padding>

                <Button fx:id="previousButton" text="← Précédent" onAction="#previousQuestion"
                        prefWidth="150" prefHeight="45"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: #ddd; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="nextButton" text="Suivant →" onAction="#nextQuestion"
                        prefWidth="150" prefHeight="45"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>

                <Button fx:id="submitButton" text="✓ Terminer le test" onAction="#submitTest"
                        prefWidth="180" prefHeight="45" visible="false" managed="false"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </HBox>

            <!-- Help Text -->
            <Label text="💡 Conseil: Prenez votre temps pour lire chaque question attentivement"
                   style="-fx-font-size: 13px; -fx-text-fill: #666; -fx-padding: 10; -fx-background-color: #f5f5f5; -fx-background-radius: 5;"
                   wrapText="true"/>

        </VBox>
    </ScrollPane>

</VBox>
