<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      spacing="20" alignment="CENTER" style="-fx-background-color: #f8f5f2;"
      fx:controller="tn.esprit.gui.ModifierForumController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Modifier le Forum" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="tfTitre" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300" promptText="Entrez le titre"/>

        <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="taDescription" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300" prefHeight="150" promptText="Entrez la description"/>

        <Label text="Statut:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbStatut" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Modifier" fx:id="btnModifier" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Annuler" fx:id="btnAnnuler" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

</VBox>
