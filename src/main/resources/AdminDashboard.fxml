<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #f5f5f5;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.projet.gui.AdminDashboardController">

    <!-- SIDEBAR GAUCHE (identique à suivi.fxml) -->
    <left>
        <VBox prefWidth="220" spacing="5" style="-fx-background-color: #ece6df; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="179.0" spacing="10">
                <ImageView fitHeight="45.0" fitWidth="45.0">
                    <image><Image url="@../images/logo.png" /></image>
                </ImageView>
                <Label style="-fx-text-fill: #285921; -fx-font-size: 18px; -fx-font-weight: bold;" text="NAFSEYTI" />
            </HBox>

            <Separator style="-fx-background-color: #e0e0e0;">
                <VBox.margin><Insets bottom="10.0" top="10.0" /></VBox.margin>
            </Separator>

            <Label fx:id="lblAdmin" text="👑 Administrateur"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #c0392b; -fx-padding: 0 0 10 0;"/>

            <!-- MENU ADMIN - Même style que le menu psychologue -->
            <Button fx:id="btnDashboard"
                    onAction="#handleDashboard"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: #374535; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="📊 Tableau de bord">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button fx:id="btnUtilisateurs"
                    onAction="#handleUtilisateurs"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="👥 Gestion des utilisateurs">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button fx:id="btnPsychologues"
                    onAction="#handlePsychologues"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="🧠 Psychologues">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button fx:id="btnEtudiants"
                    onAction="#handleEtudiants"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="📚 Étudiants">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button fx:id="btnStatistiques"
                    onAction="#handleStatistiques"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="📊 Statistiques">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button fx:id="btnAlertes"
                    onAction="#handleAlertes"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="🚨 Alertes sécurité">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button fx:id="btnRecompenses"
                    onAction="#handleRecompenses"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="🎁 Récompenses">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button fx:id="btnRapports"
                    onAction="#handleRapports"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="📥 Rapports">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <ImageView fitHeight="150.0" fitWidth="200.0" opacity="0.69" pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../images/Therapy.jpg" /></image>
            </ImageView>

            <Button onAction="#handleDeconnexion"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #285921; -fx-border-color: #285921; -fx-border-radius: 8; -fx-background-radius: 8;"
                    text="🔓 Se déconnecter">
                <font><Font size="14.0" /></font>
            </Button>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL - Dashboard par défaut -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-background-color: #f8f5f2;">
                <padding>
                    <Insets bottom="20" left="25" right="25" top="20" />
                </padding>

                <!-- En-tête -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="📊 Tableau de bord administrateur" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #69685c;" text="Vue d'ensemble de la plateforme NAFSEYTI" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDate" text="31/03/2026"
                           style="-fx-background-color: #e0e0e0; -fx-padding: 8 15; -fx-background-radius: 20; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Cartes statistiques -->
                <HBox spacing="20">
                    <StackPane prefHeight="120" prefWidth="280" style="-fx-background-radius: 15; -fx-background-color: #3498db; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
                        <VBox alignment="CENTER" spacing="5">
                            <Label style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" fx:id="lblTotalUsers" text="245" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Utilisateurs totaux" />
                        </VBox>
                    </StackPane>

                    <StackPane prefHeight="120" prefWidth="280" style="-fx-background-radius: 15; -fx-background-color: #27ae60; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
                        <VBox alignment="CENTER" spacing="5">
                            <Label style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" fx:id="lblActifs" text="187" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Actifs ce mois" />
                        </VBox>
                    </StackPane>

                    <StackPane prefHeight="120" prefWidth="280" style="-fx-background-radius: 15; -fx-background-color: #e67e22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
                        <VBox alignment="CENTER" spacing="5">
                            <Label style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" fx:id="lblNouveaux" text="34" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Nouveaux ce mois" />
                        </VBox>
                    </StackPane>

                    <StackPane prefHeight="120" prefWidth="280" style="-fx-background-radius: 15; -fx-background-color: #e74c3c; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
                        <VBox alignment="CENTER" spacing="5">
                            <Label style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" fx:id="lblAlertes" text="2" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Alertes non traitées" />
                        </VBox>
                    </StackPane>
                </HBox>

                <!-- Deuxième ligne de cartes -->
                <HBox spacing="20">
                    <VBox prefWidth="580" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 20px;" text="👥" />
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Répartition des utilisateurs" />
                        </HBox>
                        <GridPane hgap="20" vgap="10" style="-fx-padding: 15 0 0 0;">
                            <Label text="👨‍⚕️ Psychologues :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblPsychologues" text="12" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>

                            <Label text="📚 Étudiants :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblEtudiants" text="187" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                            <Label text="👨‍🏫 Enseignants :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblEnseignants" text="42" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;"/>

                            <Label text="🧑‍🤝‍🧑 Coachs vie :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblCoachs" text="4" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-text-fill: #9b59b6; -fx-font-weight: bold;"/>
                        </GridPane>
                    </VBox>

                    <VBox prefWidth="580" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 20px;" text="🤖" />
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Activité chatbot" />
                        </HBox>
                        <GridPane hgap="20" vgap="10" style="-fx-padding: 15 0 0 0;">
                            <Label text="Conversations :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblConversations" text="3,876" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>

                            <Label text="Messages à risque :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblMessagesRisque" text="12" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>

                            <Label text="Tps réponse moyen :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTempsReponse" text="2.3s" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <!-- Objectifs et récompenses -->
                <HBox spacing="20">
                    <VBox prefWidth="580" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 20px;" text="🎯" />
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Objectifs" />
                        </HBox>
                        <GridPane hgap="20" vgap="10" style="-fx-padding: 15 0 0 0;">
                            <Label text="Objectifs créés :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblObjectifsCrees" text="345" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>

                            <Label text="Objectifs validés :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblObjectifsValides" text="234 (68%)" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                            <Label text="Points distribués :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblPoints" text="8,432" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;"/>
                        </GridPane>
                    </VBox>

                    <VBox prefWidth="580" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 20px;" text="🎁" />
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Récompenses" />
                        </HBox>
                        <GridPane hgap="20" vgap="10" style="-fx-padding: 15 0 0 0;">
                            <Label text="Récompenses échangées :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblRecompensesEchangees" text="89" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>

                            <Label text="Top récompense :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTopRecompense" text="McDonald's (45)" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>

                            <Label text="Points moyens :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblPointsMoyens" text="45 pts" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;"/>
                        </GridPane>
                    </VBox>
                </HBox>

                <!-- Derniers utilisateurs -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 20px;" text="📋" />
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Derniers utilisateurs inscrits" />
                    </HBox>

                    <TableView fx:id="tableUtilisateurs" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colNom" text="Nom" prefWidth="120"/>
                            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
                            <TableColumn fx:id="colRole" text="Rôle" prefWidth="120"/>
                            <TableColumn fx:id="colDate" text="Inscription" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>