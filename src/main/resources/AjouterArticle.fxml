<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" spacing="20" alignment="CENTER" style="-fx-background-color: #f8f5f2;" fx:controller="tn.esprit.gui.AjouterArticleController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Titre de la fenêtre -->
    <Label text="Ajouter un nouvel Article" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Formulaire -->
    <GridPane hgap="10" vgap="10">
        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitre" promptText="Entrez le titre" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

        <Label text="Contenu:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtContenu" promptText="Entrez le contenu" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300" prefHeight="150"/>
    </GridPane>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Ajouter" fx:id="btnAjouter" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Annuler" fx:id="btnAnnuler" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

</VBox>
