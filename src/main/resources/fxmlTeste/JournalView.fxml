<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="700" prefWidth="780" style="-fx-background-color: #0f1923;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.nafseyti.controllers.JournalController">

    <!-- ═══ HEADER FIXE ═══ -->
    <top>
        <VBox style="-fx-background-color: #0f1923;">
            <HBox prefHeight="3" style="-fx-background-color: linear-gradient(to right, #285921, #4caf50, #285921);" />
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: rgba(255,255,255,0.04);                          -fx-border-color: transparent transparent rgba(255,255,255,0.07) transparent;                          -fx-border-width: 0 0 1 0; -fx-padding: 12 24 12 24;">

                <Button onAction="#handleBack" style="-fx-background-color: rgba(255,255,255,0.06);                                -fx-text-fill: rgba(255,255,255,0.65);                                -fx-font-size: 12px; -fx-font-weight: bold;                                -fx-padding: 7 16; -fx-background-radius: 18;                                -fx-border-color: rgba(255,255,255,0.10);                                -fx-border-radius: 18; -fx-border-width: 1; -fx-cursor: hand;" text="← Retour">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Rectangle arcHeight="3" arcWidth="3" fill="#4caf50" height="22" width="3" />
                    <VBox spacing="1">
                        <Label style="-fx-font-size: 10px; -fx-font-weight: bold;                                       -fx-text-fill: #4caf50; -fx-letter-spacing: 2;" text="MON JOURNAL" />
                        <Label fx:id="dateLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;                                       -fx-text-fill: white;" text="Chargement..." />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="streakLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #ff6b35;                               -fx-background-color: rgba(255,107,53,0.12);                               -fx-padding: 6 12; -fx-background-radius: 18;                               -fx-border-color: rgba(255,107,53,0.22);                               -fx-border-radius: 18; -fx-border-width: 1;" text="🔥 7 jours" />

                <Button onAction="#showCalendar" style="-fx-background-color: linear-gradient(to right, #285921, #2e7d32);                                -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;                                -fx-padding: 8 16; -fx-background-radius: 18; -fx-cursor: hand;" text="📊 Calendrier">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- ═══ CONTENU SCROLLABLE ═══ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #0f1923; -fx-background-color: #0f1923;                            -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
            <VBox spacing="16" style="-fx-background-color: #0f1923; -fx-padding: 20 28 30 28;">

                <!-- Citation du jour -->
                <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-background-color: rgba(40,89,33,0.14);                              -fx-background-radius: 14;                              -fx-border-color: rgba(76,175,80,0.18);                              -fx-border-radius: 14; -fx-border-width: 1;                              -fx-padding: 14 18;">
                    <Label style="-fx-font-size: 28px;" text="🌿" />
                    <VBox spacing="2">
                        <Label style="-fx-font-size: 12px; -fx-font-style: italic;                                       -fx-text-fill: rgba(255,255,255,0.65);" text="« Prendre soin de son esprit, c'est aussi prendre soin de son avenir. »" wrapText="true" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #4caf50; -fx-font-weight: bold;" text="Citation du jour — NAFSEYTI" />
                    </VBox>
                </HBox>

                <!-- ── HUMEUR ── -->
                <VBox spacing="12" style="-fx-background-color: rgba(255,255,255,0.04);                              -fx-background-radius: 16;                              -fx-border-color: rgba(255,255,255,0.07);                              -fx-border-radius: 16; -fx-border-width: 1;                              -fx-padding: 18 20;">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Rectangle arcHeight="3" arcWidth="3" fill="#4caf50" height="18" width="3" />
                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold;                                       -fx-text-fill: white;" text="😊  Comment vous sentez-vous ?" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="10">
                        <VBox fx:id="btnExcellent" alignment="CENTER" onMouseClicked="#selectHumeur" spacing="6" style="-fx-background-color: rgba(255,255,255,0.05);                                      -fx-background-radius: 14;                                      -fx-border-color: rgba(255,255,255,0.07);                                      -fx-border-radius: 14; -fx-border-width: 1;                                      -fx-pref-width: 100; -fx-pref-height: 82; -fx-cursor: hand;" userData="excellent">
                            <Label style="-fx-font-size: 28px;" text="😊" textFill="#836ecc" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #836ecc; -fx-font-weight: bold;" text="Excellent" textFill="#836ecc" />
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </VBox>

                        <VBox fx:id="btnBien" alignment="CENTER" onMouseClicked="#selectHumeur" spacing="6" style="-fx-background-color: rgba(255,255,255,0.05);                                      -fx-background-radius: 14;                                      -fx-border-color: rgba(255,255,255,0.07);                                      -fx-border-radius: 14; -fx-border-width: 1;                                      -fx-pref-width: 100; -fx-pref-height: 82; -fx-cursor: hand;" userData="bien">
                            <Label style="-fx-font-size: 28px;" text="🙂" textFill="#469e72" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #469e72; -fx-font-weight: bold;" text="Bien" />
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </VBox>

                        <VBox fx:id="btnMoyen" alignment="CENTER" onMouseClicked="#selectHumeur" spacing="6" style="-fx-background-color: rgba(255,255,255,0.05);                                      -fx-background-radius: 14;                                      -fx-border-color: rgba(255,255,255,0.07);                                      -fx-border-radius: 14; -fx-border-width: 1;                                      -fx-pref-width: 100; -fx-pref-height: 82; -fx-cursor: hand;" userData="moyen">
                            <Label style="-fx-font-size: 28px;" text="😐" textFill="#965050" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #965050; -fx-font-weight: bold;" text="Moyen" />
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </VBox>

                        <VBox fx:id="btnDifficile" alignment="CENTER" onMouseClicked="#selectHumeur" spacing="6" style="-fx-background-color: rgba(255,255,255,0.05);                                      -fx-background-radius: 14;                                      -fx-border-color: rgba(255,255,255,0.07);                                      -fx-border-radius: 14; -fx-border-width: 1;                                      -fx-pref-width: 100; -fx-pref-height: 82; -fx-cursor: hand;" userData="difficile">
                            <Label style="-fx-font-size: 28px;" text="😔" textFill="#d42ea5" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #d42ea5; -fx-font-weight: bold;" text="Difficile" />
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </VBox>

                        <VBox fx:id="btnTresDifficile" alignment="CENTER" onMouseClicked="#selectHumeur" spacing="6" style="-fx-background-color: rgba(255,255,255,0.05);                                      -fx-background-radius: 14;                                      -fx-border-color: rgba(255,255,255,0.07);                                      -fx-border-radius: 14; -fx-border-width: 1;                                      -fx-pref-width: 100; -fx-pref-height: 82; -fx-cursor: hand;" userData="très_difficile">
                            <Label style="-fx-font-size: 28px;" text="😰" textFill="#c92b2b" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #c92b2b; -fx-font-weight: bold;" text="Épuisé" />
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ── ÉMOTIONS ── -->
                <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.04);                              -fx-background-radius: 16;                              -fx-border-color: rgba(156,39,176,0.20);                              -fx-border-radius: 16; -fx-border-width: 1;                              -fx-padding: 16 20;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Rectangle arcHeight="3" arcWidth="3" fill="#9c27b0" height="18" width="3" />
                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" text="💭  Quelles émotions ?" />
                    </HBox>
                    <FlowPane fx:id="emotionsPane" hgap="8" style="-fx-background-color: transparent;" vgap="8" />
                </VBox>

                <!-- ── ÉNERGIE + SOMMEIL ── -->
                <HBox spacing="14">
                    <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.04);                                  -fx-background-radius: 16;                                  -fx-border-color: rgba(255,193,7,0.18);                                  -fx-border-radius: 16; -fx-border-width: 1;                                  -fx-padding: 16 18;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-size: 18px;" text="⚡" />
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" text="Énergie" />
                        </HBox>
                        <Slider fx:id="energieSlider" max="10" min="1" showTickLabels="false" showTickMarks="false" style="-fx-accent: #ffc107;" value="5" />
                        <HBox alignment="CENTER">
                            <Label fx:id="energieLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #ffc107;" text="5/10" />
                        </HBox>
                    </VBox>

                    <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.04);                                  -fx-background-radius: 16;                                  -fx-border-color: rgba(100,181,246,0.18);                                  -fx-border-radius: 16; -fx-border-width: 1;                                  -fx-padding: 16 18;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-size: 18px;" text="😴" />
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" text="Sommeil" />
                        </HBox>
                        <Slider fx:id="sommeilSlider" max="10" min="1" showTickLabels="false" showTickMarks="false" style="-fx-accent: #64b5f6;" value="5" />
                        <HBox alignment="CENTER">
                            <Label fx:id="sommeilLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #64b5f6;" text="5/10" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ── NOTES ── -->
                <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.04);                              -fx-background-radius: 16;                              -fx-border-color: rgba(255,152,0,0.18);                              -fx-border-radius: 16; -fx-border-width: 1;                              -fx-padding: 16 20;">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Rectangle arcHeight="3" arcWidth="3" fill="#ff9800" height="18" width="3" />
                        <VBox spacing="1">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" text="✍️  Racontez votre journée" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.30);" text="Analysé par Gemini AI · Confidentiel" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="charCountLabel" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.28);                                       -fx-background-color: rgba(255,255,255,0.05);                                       -fx-background-radius: 8; -fx-padding: 3 8;" text="0 caractères" />
                    </HBox>

                    <TextArea fx:id="notesArea" prefRowCount="5" promptText="Qu'est-ce qui a marqué votre journée ? Vos pensées, émotions, réflexions..." style="-fx-control-inner-background: #162030;                                      -fx-text-fill: white;                                      -fx-prompt-text-fill: rgba(255,255,255,0.25);                                      -fx-font-size: 13px;                                      -fx-background-radius: 10;                                      -fx-border-color: rgba(255,152,0,0.12);                                      -fx-border-radius: 10; -fx-border-width: 1;                                      -fx-padding: 12;" wrapText="true" />
                </VBox>

                <!-- ── BOUTON SAVE ── -->
                <Button maxWidth="Infinity" onAction="#saveEntry" prefHeight="52" style="-fx-background-color: linear-gradient(to right, #285921, #2e7d32, #43a047);                                -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;                                -fx-background-radius: 14;                                -fx-effect: dropshadow(gaussian, rgba(40,89,33,0.55), 16, 0, 0, 4);                                -fx-cursor: hand;" text="💾  Enregistrer et Analyser avec Gemini AI">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>

                <!-- Espace bas -->
                <Region prefHeight="20" />

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
