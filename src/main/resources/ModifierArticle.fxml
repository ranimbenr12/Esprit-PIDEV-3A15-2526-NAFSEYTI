<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.gui.ModifierArticleController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Modifier l'article">
        <font>
            <Font name="System Bold" size="18" />
        </font>
    </Label>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="80" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
        </columnConstraints>

        <!-- Titre -->
        <Label text="Titre :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="titreField" promptText="Titre de l'article" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <!-- Contenu -->
        <Label text="Contenu :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextArea fx:id="contenuArea" prefRowCount="5" promptText="Contenu de l'article..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Statut -->
        <Label text="Statut :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="statutCombo" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#modifierArticle" text="Modifier" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
        <Button onAction="#annuler" text="Annuler" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
    </HBox>
</VBox>