<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.projet.gui.GestionSuiviController"
            fitToWidth="true"
            style="-fx-background-color: #f4f6f8;">

    <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f4f6f8;">

        <!-- ===== SECTION SÉLECTION PATIENT ===== -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #3498db; -fx-border-radius: 8; -fx-border-width: 2;">
            <Label text="👤 Sélectionner un patient" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbPatients" promptText="Choisir un patient..." prefWidth="350" onAction="#selectionnerPatient"/>
                <Label fx:id="lblPatientSelectionne" text="Aucun patient sélectionné" style="-fx-text-fill: #666; -fx-font-style: italic;"/>
            </HBox>
        </VBox>

        <!-- ===== SECTION SUIVI ===== -->
        <VBox spacing="10"
              style="-fx-background-color: white; -fx-padding: 15;
                     -fx-background-radius: 8; -fx-border-color: #27ae60; -fx-border-width: 2;">

            <Label text="📋 Gestion des Suivis"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>

            <!-- Formulaire d'ajout -->
            <GridPane hgap="10" vgap="10">
                <Label text="Titre :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtTitre" promptText="Titre du suivi" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextArea fx:id="txtDescription" promptText="Description du suivi" prefWidth="300" prefHeight="60" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Type :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cmbTypeSuivi" promptText="Type de suivi" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <!-- Boutons CRUD -->
            <HBox spacing="10">
                <Button text="➕ Ajouter" onAction="#ajouterSuivi" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
                <Button text="✏️ Modifier" onAction="#modifierSuivi" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
                <Button text="🗑️ Supprimer" onAction="#supprimerSuivi" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
                <Button text="🔄 Actualiser" onAction="#afficherSuivis" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
            </HBox>

            <!-- Tableau des suivis -->
            <Label text="Liste des suivis" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
            <TableView fx:id="tableSuivis" prefHeight="200" onMouseClicked="#chargerSuivi">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="150"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="300"/>
                    <TableColumn fx:id="colTypeSuivi" text="Type" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <!-- ===== SECTION OBJECTIFS ===== -->
        <VBox spacing="10"
              style="-fx-background-color: white; -fx-padding: 15;
                     -fx-background-radius: 8;
                     -fx-border-color: #e67e22; -fx-border-width: 2;">

            <Label fx:id="lblSuiviSelectionne" text="🎯 Objectifs du suivi sélectionné"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>

            <!-- Bouton pour afficher formulaire objectif -->
            <Button text="🎯 Gérer les objectifs" onAction="#afficherFormulaireObjectif"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-max-width: 200;"/>

            <!-- Tableau des objectifs -->
            <TableView fx:id="tableObjectifs" prefHeight="150" onMouseClicked="#voirFichiersClient">
                <columns>
                    <TableColumn fx:id="colIdObj" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTitreObj" text="Titre" prefWidth="150"/>
                    <TableColumn fx:id="colDateObj" text="Date échéance" prefWidth="120"/>
                    <TableColumn fx:id="colFichiersObj" text="Fichiers" prefWidth="100"/>
                    <TableColumn fx:id="colValideObj" text="Validé" prefWidth="80"/>
                </columns>
            </TableView>

            <!-- ✅ FORMULAIRE OBJECTIF AJOUTÉ ICI (manquait dans ton fichier) -->
            <VBox fx:id="vboxAjoutObjectif"
                  spacing="10"
                  visible="false"
                  managed="false"
                  style="-fx-background-color: #fff3e0; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e67e22; -fx-border-width: 2; -fx-margin: 10 0 0 0;">

                <Label fx:id="lblTitreAjoutObj" text="Ajouter un objectif" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="Titre :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtObjTitre" promptText="Titre de l'objectif" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextArea fx:id="txtObjDescription" promptText="Description" prefWidth="300" prefHeight="60" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Date échéance :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="dpObjDate" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <HBox spacing="10">
                    <Button text="➕ Ajouter" onAction="#ajouterObjectif" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
                    <Button text="✏️ Modifier" onAction="#modifierObjectif" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
                    <Button text="🗑️ Supprimer" onAction="#supprimerObjectif" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
                </HBox>
            </VBox>

            <!-- Label pour afficher le total des points -->
            <Label fx:id="lblTotalPoints" text="💰 Total points: 0"
                   style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 5 0;"/>

            <!-- Boutons d'action pour les objectifs -->
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
                <!-- Bouton Valider l'objectif (violet) -->
                <Button text="✅ Valider l'objectif"
                        onAction="#validerObjectif"
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>

                <!-- Bouton Voir les points (orange) -->
                <Button text="🎯 Voir les points"
                        onAction="#voirPointsPatient"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>

                <!-- Bouton Actualiser points (vert) -->
                <Button text="💰 Actualiser points"
                        onAction="#actualiserPoints"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>

        <!-- ===== SECTION FICHIERS ===== -->
        <VBox spacing="10"
              style="-fx-background-color: white; -fx-padding: 15;
                     -fx-background-radius: 8;
                     -fx-border-color: #3498db; -fx-border-width: 2;">

            <Label fx:id="lblObjectifSelectionne" text="📎 Fichiers de l'objectif"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>

            <TableView fx:id="tableMedias" prefHeight="120">
                <columns>
                    <TableColumn fx:id="colTypeMedia" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="colNomMedia" text="Nom du fichier" prefWidth="400"/>
                    <TableColumn fx:id="colDateMedia" text="Date d'ajout" prefWidth="150"/>
                </columns>
            </TableView>

            <Button text="👁️ Ouvrir le fichier" onAction="#ouvrirFichierClient"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-max-width: 150;"/>
        </VBox>

    </VBox>
</ScrollPane>