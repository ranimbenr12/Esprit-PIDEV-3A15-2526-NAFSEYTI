<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.gui.PosterArticleController" style="-fx-padding:20; -fx-background-color:#f5f5f5;">

    <Label text="Créer un nouvel article" style="-fx-font-size:18; -fx-font-weight:bold;"/>

    <TextField fx:id="txtTitre" promptText="Titre de l'article..." prefWidth="350"/>
    <TextArea fx:id="txtContenu" promptText="Contenu de l'article..." prefWidth="350" prefHeight="200"/>

    <Button text="Publier" fx:id="btnPoster"
            style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10;"/>
</VBox>