<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.nafseyti.view.GererRendezVousController">

    <!-- ══════════════  SIDEBAR GAUCHE  ══════════════ -->
    <left>
        <VBox prefWidth="220" spacing="5" style="-fx-background-color: #ece6df;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding><Insets bottom="20" left="15" right="15" top="20" /></padding>

            <VBox alignment="CENTER" spacing="10">
                <StackPane>
                    <Circle fill="#285921" radius="35.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0" />
                    <Label style="-fx-font-size: 30px; -fx-text-fill: white;" text="👤" />
                    <ImageView fitHeight="59.0" fitWidth="67.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/logo.png" /></image>
                    </ImageView>
                </StackPane>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #285921;" text="NAFSEYTI" />
                <Label fx:id="psychologueNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #69685c;" text="Dr. Psychologue" />
            </VBox>

            <Separator style="-fx-background-color: #e0e0e0;">
                <VBox.margin><Insets bottom="10.0" top="10.0" /></VBox.margin>
            </Separator>

            <Button onAction="#handleBtnAccueil" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c;                            -fx-alignment: CENTER_LEFT; -fx-padding: 10;                            -fx-font-size: 14px; -fx-background-radius: 8;" text="🏠 Accueil">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <!-- Bouton actif -->
            <Button prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #374535; -fx-text-fill: white;                            -fx-alignment: CENTER_LEFT; -fx-padding: 10;                            -fx-font-size: 14px; -fx-background-radius: 8;" text="⏰ Gérer les rendez-vous">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button onAction="#handleBtnMesRdv" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c;                            -fx-alignment: CENTER_LEFT; -fx-padding: 10;                            -fx-font-size: 14px; -fx-background-radius: 8;" text="📅 Mes rendez-vous">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Button onAction="#handleBtnFiches" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c;                            -fx-alignment: CENTER_LEFT; -fx-padding: 10;                            -fx-font-size: 14px; -fx-background-radius: 8;" text="📋 Mes fiches consultation">
                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Bouton Sync Google -->
            <Button fx:id="btnSyncGoogle" onAction="#handleSyncGoogle" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #4285F4; -fx-text-fill: white;                            -fx-border-radius: 8; -fx-background-radius: 8;                            -fx-font-size: 12px; -fx-font-weight: bold;" text="🔄 Sync Google Calendar">
                <VBox.margin><Insets bottom="8.0" /></VBox.margin>
                <font><Font size="12.0" /></font>
            </Button>

            <!-- Bouton ouvrir Google Calendar -->
            <Button onAction="#handleOuvrirCalendar"
                    prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: white;
               -fx-text-fill: #4285F4;
               -fx-border-color: #4285F4;
               -fx-border-radius: 8;
               -fx-background-radius: 8;
               -fx-font-size: 11px;
               -fx-font-weight: bold;
               -fx-cursor: hand;"
                    text="📅 Voir Google Calendar">
                <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Button>

            <Button prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #285921;                            -fx-border-color: #285921; -fx-border-radius: 8;                            -fx-background-radius: 8;" text="🔓 Se déconnecter">
                <font><Font size="14.0" /></font>
            </Button>
        </VBox>
    </left>

    <!-- ══════════════  CONTENU PRINCIPAL  ══════════════ -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F4F0EB;">

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: white;                          -fx-padding: 15 28 15 28;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 3);">
                <VBox spacing="3">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Region prefHeight="26" prefWidth="5" style="-fx-background-color: #285921; -fx-background-radius: 3;" />
                        <Label style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #1E3320;" text="⏰ Gérer les Rendez-vous" />
                    </HBox>
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #9B8E84;" text="   Calendrier mensuel · Ajout · Modification · Sync Google Calendar" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge statut sync -->
                <HBox fx:id="syncStatusBadge" alignment="CENTER" spacing="6" style="-fx-background-color: #EEF5EE; -fx-background-radius: 12; -fx-padding: 6 14;">
                    <Circle fx:id="syncDot" fill="#5DBB7A" radius="5" />
                    <Label fx:id="syncStatusLabel" style="-fx-font-size: 11px; -fx-text-fill: #285921; -fx-font-weight: bold;" text="Non synchronisé" />
                </HBox>

                <StackPane style="-fx-background-color: #EEF5EE; -fx-background-radius: 50; -fx-padding: 8;">
                    <ImageView fitHeight="46" fitWidth="46" preserveRatio="true">
                        <image><Image url="@../images/cerveau.png" /></image>
                    </ImageView>
                </StackPane>
            </HBox>

            <!-- CORPS : Calendrier GAUCHE + Panel DROITE -->
            <HBox spacing="16" style="-fx-padding: 20 26 20 26;" VBox.vgrow="ALWAYS">

                <!-- ───  CALENDRIER (colonne gauche)  ─── -->
                <VBox prefWidth="520" spacing="0" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">

                    <!-- Navigation mois -->
                    <HBox alignment="CENTER" spacing="16" style="-fx-background-color: #285921;                                  -fx-background-radius: 18 18 0 0;                                  -fx-padding: 14 20 14 20;">
                        <Button text="🧹 Nettoyer Google" onAction="#handleNettoyerGoogle"
                                style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 14px;
               -fx-background-color: #fde8e8; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        <Button fx:id="btnPrevMonth" onAction="#handlePrevMonth" style="-fx-background-color: rgba(255,255,255,0.2);                                        -fx-text-fill: white; -fx-font-weight: bold;                                        -fx-background-radius: 20; -fx-padding: 5 12;                                        -fx-cursor: hand;" text="◀" />
                        <Label fx:id="monthYearLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;                                       -fx-text-fill: white;" text="Janvier 2025" />
                        <Button fx:id="btnNextMonth" onAction="#handleNextMonth" style="-fx-background-color: rgba(255,255,255,0.2);                                        -fx-text-fill: white; -fx-font-weight: bold;                                        -fx-background-radius: 20; -fx-padding: 5 12;                                        -fx-cursor: hand;" text="▶" />
                    </HBox>

                    <!-- En-têtes jours -->
                    <GridPane fx:id="dayHeaderGrid" style="-fx-background-color: #f0f7ee; -fx-padding: 8 10 8 10;">
                        <!-- Rempli dynamiquement dans le contrôleur -->
                    </GridPane>

                    <!-- Grille calendrier (remplie par le contrôleur) -->
                    <GridPane fx:id="calendarGrid" hgap="2" style="-fx-padding: 10; -fx-background-color: white;" vgap="2" VBox.vgrow="ALWAYS" />

                    <!-- Légende -->
                    <HBox alignment="CENTER" spacing="16" style="-fx-padding: 10 16 14 16;                                  -fx-border-color: #f0ebe5;                                  -fx-border-width: 1 0 0 0;">
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Circle fill="#285921" radius="6" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #444;" text="Confirmé" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Circle fill="#FFC107" radius="6" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #444;" text="En attente" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Circle fill="#4285F4" radius="6" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #444;" text="Google Calendar" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Circle fill="#E53935" radius="6" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #444;" text="Annulé" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- ─── PANEL DROITE : RDV du jour sélectionné + Formulaire  ─── -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">

                    <!-- Carte : RDV du jour sélectionné -->
                    <VBox spacing="0" style="-fx-background-color: white;                                  -fx-background-radius: 18;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">

                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #285921;                                      -fx-background-radius: 18 18 0 0;                                      -fx-padding: 12 20 12 20;">
                            <Label style="-fx-font-size: 16px;" text="📅" />
                            <Label fx:id="selectedDayLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" text="Sélectionnez un jour" />
                        </HBox>

                        <ScrollPane fitToWidth="true" prefHeight="220" style="-fx-background: transparent;                                            -fx-background-color: transparent;                                            -fx-border-color: transparent;">
                            <VBox fx:id="rdvDuJourContainer" spacing="8" style="-fx-padding: 14 16 14 16;" />
                        </ScrollPane>
                    </VBox>

                    <!-- Carte : Ajouter un rendez-vous -->
                    <VBox spacing="0" style="-fx-background-color: white;                                  -fx-background-radius: 18;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #1a6b35;                                      -fx-background-radius: 18 18 0 0;                                      -fx-padding: 12 20 12 20;">
                            <Label style="-fx-font-size: 16px;" text="➕" />
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" text="Ajouter / Modifier un rendez-vous" />
                        </HBox>

                        <VBox spacing="12" style="-fx-padding: 18 20 18 20;">

                            <!-- Date sélectionnée (readonly) -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-min-width: 90;" text="📆 Date :" />
                                <Label fx:id="formDateLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;                                               -fx-text-fill: #285921; -fx-background-color: #eef5ee;                                               -fx-background-radius: 8; -fx-padding: 4 12;" text="—" />
                            </HBox>

                            <!-- Patient ID -->
                            <HBox alignment="CENTER_LEFT" spacing="10" />

                            <!-- Heure début -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-min-width: 90;" text="🕐 Début :" />
                                <TextField fx:id="fieldHeureDebut" promptText="Ex: 09:00" style="-fx-background-radius: 8; -fx-border-color: #ddd;                                                   -fx-border-radius: 8; -fx-padding: 6 10;                                                   -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                            </HBox>

                            <!-- Heure fin -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-min-width: 90;" text="🕐 Fin :" />
                                <TextField fx:id="fieldHeureFin" promptText="Ex: 10:00" style="-fx-background-radius: 8; -fx-border-color: #ddd;                                                   -fx-border-radius: 8; -fx-padding: 6 10;                                                   -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                            </HBox>

                            <!-- Type séance -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-min-width: 90;" text="📝 Type :" />
                                <ComboBox fx:id="comboTypeSeance" promptText="Choisir le type..." style="-fx-background-radius: 8; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                            </HBox>

                            <!-- Message erreur/succès -->
                            <Label fx:id="formMessage" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="" wrapText="true" />

                            <!-- Boutons -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Button fx:id="btnEnregistrer" onAction="#handleEnregistrerRdv" style="-fx-background-color: #285921;                                                -fx-text-fill: white; -fx-font-weight: bold;                                                -fx-background-radius: 20; -fx-padding: 9 24;                                                -fx-cursor: hand;                                                -fx-effect: dropshadow(gaussian, rgba(40,89,33,0.3), 6, 0, 0, 2);" text="💾 Enregistrer" />
                                <Button fx:id="btnAnnulerForm" onAction="#handleAnnulerForm" style="-fx-background-color: #f0e8e0;                                                -fx-text-fill: #856404; -fx-font-weight: bold;                                                -fx-background-radius: 20; -fx-padding: 9 24;                                                -fx-cursor: hand;" text="✖ Annuler" />
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>
