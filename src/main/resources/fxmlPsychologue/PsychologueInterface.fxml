<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.nafseyti.view.PsychologueInterfaceController">

    <!-- SIDEBAR GAUCHE -->
    <left>
        <VBox prefWidth="220" spacing="5" style="-fx-background-color: #ece6df; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>

            <!-- Profil utilisateur -->
            <VBox alignment="CENTER" spacing="10">
                <StackPane>
                    <Circle fill="#285921" radius="35.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0" />
                    <Label style="-fx-font-size: 30px; -fx-text-fill: white;" text="👤" />
                    <ImageView fitHeight="59.0" fitWidth="67.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo.png" />
                        </image>
                    </ImageView>
                </StackPane>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #285921;" text="NAFSEYTI" />
                <Label fx:id="psychologueNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #69685c;" text="Dr. Psychologue" />
            </VBox>

            <Separator style="-fx-background-color: #e0e0e0;">
                <VBox.margin>
                    <Insets bottom="10.0" top="10.0" />
                </VBox.margin>
            </Separator>

            <!-- Menu Items -->
            <Button fx:id="btnAccueil" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="🏠 Accueil">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnRendezVous" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #374535; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="📅 Mes rendez-vous" >
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnFichesConsultation" prefHeight="41.0" prefWidth="206.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="📋 Mes fiches consultation" onAction="#handleBtnFichesConsultation">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #285921; -fx-border-color: #285921; -fx-border-radius: 8; -fx-background-radius: 8;" text="🔓 Se déconnecter">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="20" style="-fx-background-color:#f8f5f2;">
            <padding>
                <Insets bottom="20" left="30" right="30" top="30" />
            </padding>

            <!-- ================= HEADER ================= -->
            <!-- ================= HEADER ================= -->
            <HBox alignment="CENTER_LEFT" spacing="15">

                <!-- Texte du header -->
                <VBox spacing="5">
                    <Label style="-fx-font-size:28; -fx-font-weight:bold; -fx-text-fill: #285921;" text="📅 Mes Rendez-vous" />
                    <Label style="-fx-text-fill:#69685c; -fx-font-size:14;" text="Gérez vos consultations et rendez-vous" />
                </VBox>
            <ImageView fitHeight="32.0" fitWidth="200.0" layoutX="292.0" layoutY="34.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fitHeight="32.0" fitWidth="200.0" layoutX="508.0" layoutY="34.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fitHeight="80.0" fitWidth="80.0" layoutX="723.0" layoutY="10.0" preserveRatio="true" />
            <ImageView fitHeight="82.0" fitWidth="99.0" layoutX="723.0" layoutY="10.0" preserveRatio="true">
               <image>
                  <Image url="@../images/cerveau.png" />
               </image>
            </ImageView>

            </HBox>


            <!-- ================= STATS RAPIDES ================= -->
            <HBox prefHeight="120.0" spacing="20">

                <!-- Carte 1 avec image de fond Psychology -->
                <StackPane prefHeight="120" prefWidth="200">
                    <!-- Image de fond -->
                    <ImageView fitHeight="120" fitWidth="200" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@../images/Therapy.jpg" />
                        </image>
                    </ImageView>

                    <!-- Rectangle overlay arrondi avec transparence -->
                    <Rectangle arcHeight="20" arcWidth="20" fill="#ffffffd9" height="120" width="200" />

                    <!-- Contenu par-dessus -->
                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 15;">
                        <Label style="-fx-font-size: 32px; -fx-effect: dropshadow(gaussian, rgba(255, 167, 38, 0.5), 8, 0, 0, 2);" text="📊" />
                        <Label fx:id="totalRdvLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #285921; -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.8), 3, 0, 0, 1);" text="0" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #2d5016; -fx-text-alignment: center; -fx-font-weight: bold;" text="Total rendez-vous" wrapText="true" />
                    </VBox>

                    <!-- Bordure décorative -->
                    <Rectangle arcHeight="20" arcWidth="20" fill="transparent" height="120.0" stroke="#e1bf8e" strokeWidth="3" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);" width="200.0" />
                </StackPane>

                <!-- Carte 2 - Confirmés -->
                <StackPane prefHeight="120" prefWidth="200">
                    <ImageView fitHeight="120" fitWidth="200" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@../images/logo1.jpg" />
                        </image>
                    </ImageView>
                    <Rectangle arcHeight="20" arcWidth="20" fill="#ffffffd9" height="120" width="200" />
                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 15;">
                        <Label style="-fx-font-size: 32px; -fx-effect: dropshadow(gaussian, rgba(102, 187, 106, 0.5), 8, 0, 0, 2);" text="✅" />
                        <Label fx:id="confirmedRdvLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="0" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #2d5016; -fx-text-alignment: center; -fx-font-weight: bold;" text="Confirmés" wrapText="true" />
                    </VBox>
                    <Rectangle arcHeight="20" arcWidth="20" fill="transparent" height="120.0" stroke="#a3c4a4" strokeWidth="3" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);" width="200.0" />
                </StackPane>

                <!-- Carte 3 - En attente -->
                <StackPane prefHeight="120" prefWidth="200">
                    <ImageView fitHeight="120" fitWidth="200" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@../images/pending.jpg" />
                        </image>
                    </ImageView>
                    <Rectangle arcHeight="20" arcWidth="20" fill="#ffffffd9" height="120" width="200" />
                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 15;">
                        <Label style="-fx-font-size: 32px; -fx-effect: dropshadow(gaussian, rgba(66, 165, 245, 0.5), 8, 0, 0, 2);" text="⏰" />
                        <Label fx:id="pendingRdvLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="0" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #0d47a1; -fx-text-alignment: center; -fx-font-weight: bold;" text="En attente" wrapText="true" />
                    </VBox>
                    <Rectangle arcHeight="20" arcWidth="20" fill="transparent" height="120" stroke="#708799b8" strokeWidth="3" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);" width="200" />
                </StackPane>

                <!-- Carte 4 - Fiches créées -->
                <StackPane prefHeight="120" prefWidth="200">
                    <ImageView fitHeight="120" fitWidth="200" pickOnBounds="true" preserveRatio="false">
                        <image>
                            <Image url="@../images/fiches.jpg" />
                        </image>
                    </ImageView>
                    <Rectangle arcHeight="20" arcWidth="20" fill="#ffffffd9" height="120" width="200" />
                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 15;">
                        <Label style="-fx-font-size: 32px; -fx-effect: dropshadow(gaussian, rgba(171, 71, 188, 0.5), 8, 0, 0, 2);" text="📋" />
                        <Label fx:id="totalFichesLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #9C27B0;" text="0" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6a1b9a; -fx-text-alignment: center; -fx-font-weight: bold;" text="Fiches créées" wrapText="true" />
                    </VBox>
                    <Rectangle arcHeight="20" arcWidth="20" fill="transparent" height="120" stroke="#23222489" strokeWidth="3" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);" width="200" />
                </StackPane>

            </HBox>

            <!-- ================= LISTE DES RENDEZ-VOUS ================= -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" VBox.vgrow="ALWAYS">

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #285921; -fx-padding: 0 0 15 0;" text="Rendez-vous du jour" />

                <!-- ScrollPane pour les rendez-vous -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="rendezVousContainer" spacing="15" style="-fx-background-color: transparent; -fx-padding: 10;">
                        <!-- Les cartes de rendez-vous seront ajoutées dynamiquement ici -->
                        <Label style="-fx-text-fill: #888; -fx-font-style: italic;" text="Chargement des rendez-vous..." />
                    </VBox>
                </ScrollPane>
            </VBox>

        </VBox>
    </center>
</BorderPane>
