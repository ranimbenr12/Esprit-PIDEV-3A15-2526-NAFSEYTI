<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15" style="-fx-background-color: #f8f5f2; -fx-background-radius: 25; -fx-padding: 25;"
      prefWidth="600" prefHeight="700"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.nafseyti.view.CreateFicheConsultationController">

    <!-- ================= HEADER ================= -->
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #285921;" text="📋 Fiche de Consultation" />

    <Separator prefWidth="550" style="-fx-background-color: #e0e0e0;" />

    <!-- ================= INFO PATIENT ================= -->
    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #285921;" text="Information Patient" />
        <Label fx:id="patientNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Patient: " />
        <Label fx:id="dateLabel" style="-fx-font-size: 12px; -fx-text-fill: #666;" text="Date: " />
    </VBox>

    <!-- ================= FORMULAIRE ================= -->
    <ScrollPane fitToWidth="true" prefHeight="420" style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox spacing="15" style="-fx-padding: 5;">

            <!-- Motif de consultation (notes) -->
            <VBox spacing="5">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;" text="📝 Motif de consultation *" />
                <TextArea fx:id="motifTextArea" promptText="Décrivez le motif de la consultation..."
                          prefHeight="70" wrapText="true"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-padding: 10;" />
            </VBox>

            <!-- Symptômes observés (probleme_principal) -->
            <VBox spacing="5">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;" text="⚠️ Symptômes / Problème principal *" />
                <TextArea fx:id="symptomesTextArea" promptText="Liste des symptômes identifiés..."
                          prefHeight="70" wrapText="true"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-padding: 10;" />
            </VBox>

            <!-- Diagnostic -->
            <VBox spacing="5">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;" text="🩺 Diagnostic / Observations *" />
                <TextArea fx:id="diagnosticTextArea" promptText="Votre diagnostic et observations..."
                          prefHeight="90" wrapText="true"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-padding: 10;" />
            </VBox>

            <!-- Recommandations -->
            <VBox spacing="5">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;" text="💡 Recommandations / Plan *" />
                <TextArea fx:id="recommandationsTextArea" promptText="Recommandations et plan de suivi..."
                          prefHeight="90" wrapText="true"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-padding: 10;" />
            </VBox>

            <!-- Traitement -->
            <VBox spacing="5">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333;" text="💊 Traitement / Prescription *" />
                <TextArea fx:id="traitementTextArea" promptText="Décrivez le traitement à suivre (médicaments, exercices, thérapies...)..."
                          prefHeight="90" wrapText="true"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-padding: 10;" />
            </VBox>



        </VBox>
    </ScrollPane>

    <!-- ================= MESSAGES ================= -->
    <Label fx:id="messageLabel" style="-fx-text-fill: green; -fx-font-weight: bold; -fx-font-size: 13px;" text="" />

    <!-- ================= BOUTONS ================= -->
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="btnSave" prefWidth="200" prefHeight="40"
                style="-fx-background-color: #285921; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;"
                text="💾 Enregistrer la fiche" />

        <Button fx:id="btnCancel" prefWidth="150" prefHeight="40"
                style="-fx-background-color: #DDD; -fx-text-fill: #333; -fx-font-size: 14px; -fx-background-radius: 20; -fx-cursor: hand;"
                text="❌ Annuler" />
    </HBox>

</VBox>
