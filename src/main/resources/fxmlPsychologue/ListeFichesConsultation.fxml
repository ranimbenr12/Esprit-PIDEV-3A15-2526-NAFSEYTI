<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #f5f5f5;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.nafseyti.view.ListeFichesConsultationController">

    <!-- SIDEBAR GAUCHE INCHANGEE -->
    <left>
        <VBox prefWidth="220" spacing="5"
              style="-fx-background-color: #ece6df; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20"/>
            </padding>
            <VBox alignment="CENTER" spacing="10">
                <StackPane>
                    <Circle fill="#285921" radius="35.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0"/>
                    <Label style="-fx-font-size: 30px; -fx-text-fill: white;" text="👤"/>
                    <ImageView fitHeight="59.0" fitWidth="67.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/logo.png"/></image>
                    </ImageView>
                </StackPane>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #285921;" text="NAFSEYTI"/>
                <Label fx:id="psychologueNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #69685c;" text="Dr. Psychologue"/>
            </VBox>
            <Separator style="-fx-background-color: #e0e0e0;">
                <VBox.margin><Insets bottom="10.0" top="10.0"/></VBox.margin>
            </Separator>
            <Button fx:id="btnAccueil" prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="🏠 Accueil">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Button>
            <Button fx:id="btnRendezVous" prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="📅 Mes rendez-vous" onAction="#handleBtnRendezVous">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Button>
            <Button fx:id="btnFichesConsultation" prefHeight="41.0" prefWidth="206.0"
                    style="-fx-background-color: #374535; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;"
                    text="📋 Mes fiches consultation">
                <VBox.margin><Insets bottom="5.0"/></VBox.margin>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <Button prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #285921; -fx-border-color: #285921; -fx-border-radius: 8; -fx-background-radius: 8;"
                    text="🔓 Se déconnecter" onAction="#handleDeconnexion">
                <font><Font size="14.0"/></font>
            </Button>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL AMELIORE -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F4F0EB;">

            <!-- TOP BAR BLANCHE AVEC TITRE ET ACCENT -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: white;
                         -fx-padding: 16 28 16 28;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 3);">
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Rectangle fill="#285921" width="5" height="26" arcWidth="4" arcHeight="4"/>
                        <Label text="Mes Fiches de Consultation"
                               style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #1E3320;"/>
                    </HBox>
                    <Label text="   Consultez, gérez et exportez en PDF les fiches de vos patients"
                           style="-fx-font-size: 12px; -fx-text-fill: #9B8E84;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Image cerveau dans cercle coloré -->
                <StackPane style="-fx-background-color: #EEF5EE; -fx-background-radius: 50; -fx-padding: 8;">
                    <ImageView fitHeight="46" fitWidth="46" preserveRatio="true">
                        <image><Image url="@../images/cerveau.png"/></image>
                    </ImageView>
                </StackPane>
            </HBox>

            <!-- 3 CARTES HERO AVEC OVERLAY GRADIENT -->
            <HBox spacing="14" style="-fx-padding: 20 26 8 26;">

                <StackPane HBox.hgrow="ALWAYS" prefHeight="115"
                           style="-fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">
                    <ImageView fitHeight="115" fitWidth="340" preserveRatio="false">
                        <image><Image url="@../images/1.jpg"/></image>
                    </ImageView>
                    <HBox style="-fx-background-color: linear-gradient(to right, rgba(22,40,26,0.82), transparent); -fx-background-radius: 16;">
                        <VBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 0 0 0 18; -fx-pref-width: 210;">
                            <Label text="📅 Planifier" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Vos rendez-vous patients" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                        </VBox>
                    </HBox>
                    <StackPane alignment="TOP_RIGHT" style="-fx-padding: 10 12 0 0;">
                        <Label text="RDV" style="-fx-background-color: rgba(255,255,255,0.22); -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 8px; -fx-font-weight: bold; -fx-padding: 3 8;"/>
                    </StackPane>
                </StackPane>

                <StackPane HBox.hgrow="ALWAYS" prefHeight="115"
                           style="-fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">
                    <ImageView fitHeight="115" fitWidth="340" preserveRatio="false">
                        <image><Image url="@../images/banner2.jpg"/></image>
                    </ImageView>
                    <HBox style="-fx-background-color: linear-gradient(to right, rgba(40,89,33,0.82), transparent); -fx-background-radius: 16;">
                        <VBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 0 0 0 18; -fx-pref-width: 210;">
                            <Label text="📝 Consultations" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Suivi médical complet" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                        </VBox>
                    </HBox>
                    <StackPane alignment="TOP_RIGHT" style="-fx-padding: 10 12 0 0;">
                        <Label text="FICHES" style="-fx-background-color: rgba(255,255,255,0.22); -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 8px; -fx-font-weight: bold; -fx-padding: 3 8;"/>
                    </StackPane>
                </StackPane>

                <StackPane HBox.hgrow="ALWAYS" prefHeight="115"
                           style="-fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">
                    <ImageView fitHeight="115" fitWidth="340" preserveRatio="false">
                        <image><Image url="@../images/banner3.jpg"/></image>
                    </ImageView>
                    <HBox style="-fx-background-color: linear-gradient(to right, rgba(30,51,32,0.82), transparent); -fx-background-radius: 16;">
                        <VBox alignment="CENTER_LEFT" spacing="5" style="-fx-padding: 0 0 0 18; -fx-pref-width: 210;">
                            <Label text="💙 Bien-être" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Thérapie et soin mental" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                        </VBox>
                    </HBox>
                    <StackPane alignment="TOP_RIGHT" style="-fx-padding: 10 12 0 0;">
                        <Label text="SOIN" style="-fx-background-color: rgba(255,255,255,0.22); -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 8px; -fx-font-weight: bold; -fx-padding: 3 8;"/>
                    </StackPane>
                </StackPane>

            </HBox>

            <!-- BARRE RECHERCHE + BADGE EXPORT -->
            <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 14 26 8 26;">

                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 30;
                             -fx-border-color: #DDD5CC;
                             -fx-border-radius: 30;
                             -fx-border-width: 1.5;
                             -fx-padding: 10 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 5, 0, 0, 2);">
                    <Label text="🔍" style="-fx-font-size: 15px; -fx-text-fill: #285921;"/>
                    <TextField fx:id="searchField"
                               promptText="Rechercher un patient par nom..."
                               style="-fx-background-color: transparent; -fx-border-color: transparent;
                                      -fx-font-size: 13px; -fx-text-fill: #3D3530;
                                      -fx-prompt-text-fill: #B5A99E;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Badge PDF -->
                <Button onAction="#handleBtnExportSheets"
                        prefHeight="40.0" prefWidth="190.0"
                        style="-fx-background-color: #0F9D58; -fx-text-fill: white;
               -fx-alignment: CENTER_LEFT; -fx-padding: 10;
               -fx-font-size: 13px; -fx-background-radius: 8;"
                        text="📊 Export Google Sheets">
                    <VBox.margin><Insets bottom="5.0" /></VBox.margin>
                </Button>

            </HBox>

            <!-- LABEL SECTION -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 2 26 10 26;">
                <Rectangle fill="#285921" width="4" height="16" arcWidth="4" arcHeight="4"/>
                <Label text="Toutes les fiches"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2D4A30;"/>
            </HBox>

            <!-- LISTE DES FICHES -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-border-color: transparent;
                               -fx-background: #F4F0EB;">
                <VBox fx:id="fichesContainer" spacing="14"
                      style="-fx-background-color: transparent; -fx-padding: 0 26 24 26;"/>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
