<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<ScrollPane fitToWidth="true" prefHeight="600.0" prefWidth="800.0"
            style="-fx-background: #f8f5f2; -fx-background-color: #f8f5f2;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.nafseyti.fxmlUser.controllers.ProfileViewController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="25.0"
              style="-fx-background-color: #f8f5f2;">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <!-- ══════════ HEADER CARD ══════════ -->
            <VBox alignment="CENTER" spacing="15.0"
                  style="-fx-background-color: linear-gradient(to bottom right, #374535, #296f1f);
                      -fx-background-radius: 20;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0, 0, 5);
                      -fx-padding: 35;">

                <!-- Avatar -->
                <StackPane>
                    <!-- Cercle décoratif externe -->
                    <Circle radius="80.0"
                            style="-fx-fill: rgba(255,255,255,0.15); -fx-stroke: rgba(255,255,255,0.4); -fx-stroke-width: 3;" />
                    <!-- Photo de profil -->
                    <ImageView fx:id="profilePictureView"
                               fitHeight="140.0" fitWidth="140.0"
                               preserveRatio="false">
                        <clip>
                            <Circle centerX="70.0" centerY="70.0" radius="70.0" />
                        </clip>
                    </ImageView>
                    <!-- Placeholder si pas de photo -->
                    <Label fx:id="profilePlaceholder" text="👤" visible="true"
                           style="-fx-font-size: 58px;" />
                </StackPane>

                <!-- Nom -->
                <Label fx:id="nameLabel" text="Chargement..."
                       style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;" />

                <!-- Badge rôle -->
                <HBox alignment="CENTER">
                    <Label fx:id="roleLabel" text="Utilisateur"
                           style="-fx-background-color: rgba(255,255,255,0.2);
                             -fx-text-fill: white;
                             -fx-padding: 5 18;
                             -fx-background-radius: 20;
                             -fx-font-size: 12px;
                             -fx-font-weight: bold;
                             -fx-border-color: rgba(255,255,255,0.5);
                             -fx-border-radius: 20;
                             -fx-border-width: 1;" />
                </HBox>

                <!-- Citation inspirante -->
                <Label text="✨ Prendre soin de soi, c'est prendre soin des autres"
                       wrapText="true"
                       style="-fx-font-size: 12px;
                          -fx-text-fill: rgba(255,255,255,0.75);
                          -fx-font-style: italic;" />
            </VBox>


            <!-- ══════════ CARTE INFOS ══════════ -->
            <VBox spacing="0"
                  style="-fx-background-color: white;
                      -fx-background-radius: 18;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                <padding>
                    <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
                </padding>

                <!-- Titre section -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 15 0 10 0;">
                    <Label text="📋"
                           style="-fx-font-size: 16px;" />
                    <Label text="Informations personnelles"
                           style="-fx-font-size: 15px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                </HBox>

                <Separator style="-fx-background-color: #ece6df;" />

                <!-- Email -->
                <HBox spacing="15.0" alignment="CENTER_LEFT"
                      style="-fx-padding: 18 5;">
                    <StackPane minWidth="42" minHeight="42"
                               style="-fx-background-color: #eaf3e8;
                                 -fx-background-radius: 12;">
                        <Label text="📧" style="-fx-font-size: 18px;" />
                    </StackPane>
                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <Label text="EMAIL"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                        <Label fx:id="emailLabel" text="email@exemple.com"
                               style="-fx-font-size: 14px;
                                -fx-text-fill: #333;" />
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Téléphone -->
                <HBox spacing="15.0" alignment="CENTER_LEFT"
                      style="-fx-padding: 18 5;">
                    <StackPane minWidth="42" minHeight="42"
                               style="-fx-background-color: #eaf3e8;
                                 -fx-background-radius: 12;">
                        <Label text="📱" style="-fx-font-size: 18px;" />
                    </StackPane>
                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <Label text="TÉLÉPHONE"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                        <Label fx:id="phoneLabel" text="Non renseigné"
                               style="-fx-font-size: 14px;
                                -fx-text-fill: #333;" />
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Adresse -->
                <HBox spacing="15.0" alignment="CENTER_LEFT"
                      style="-fx-padding: 18 5;">
                    <StackPane minWidth="42" minHeight="42"
                               style="-fx-background-color: #eaf3e8;
                                 -fx-background-radius: 12;">
                        <Label text="🏠" style="-fx-font-size: 18px;" />
                    </StackPane>
                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <Label text="ADRESSE"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                        <Label fx:id="addressLabel" text="Non renseignée"
                               style="-fx-font-size: 14px;
                                -fx-text-fill: #333;" />
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Localisation -->
                <HBox spacing="15.0" alignment="CENTER_LEFT"
                      style="-fx-padding: 18 5;">
                    <StackPane minWidth="42" minHeight="42"
                               style="-fx-background-color: #eaf3e8;
                                 -fx-background-radius: 12;">
                        <Label text="📍" style="-fx-font-size: 18px;" />
                    </StackPane>
                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <Label text="LOCALISATION"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                        <Label fx:id="locationLabel" text="Non renseignée"
                               style="-fx-font-size: 14px;
                                -fx-text-fill: #333;" />
                    </VBox>
                </HBox>
            </VBox>


            <!-- ══════════ CARTE BIEN-ÊTRE ══════════ -->
            <VBox spacing="12"
                  style="-fx-background-color: linear-gradient(to bottom right, #fdf5e6, #e0cda9);
                      -fx-background-radius: 18;
                      -fx-padding: 22;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🌿" style="-fx-font-size: 20px;" />
                    <Label text="Votre bien-être mental"
                           style="-fx-font-size: 15px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                </HBox>
                <Label text="Chaque pas vers la compréhension de soi est une victoire. Continuez votre parcours avec NAFSEYTI."
                       wrapText="true"
                       style="-fx-font-size: 13px;
                          -fx-text-fill: #5a4f3c;
                          -fx-font-style: italic;" />
            </VBox>

        </VBox>
    </content>
</ScrollPane>