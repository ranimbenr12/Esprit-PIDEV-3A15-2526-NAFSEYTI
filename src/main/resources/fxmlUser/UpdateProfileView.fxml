<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<ScrollPane fitToWidth="true" prefHeight="600.0" prefWidth="700.0"
            style="-fx-background: #f8f5f2; -fx-background-color: #f8f5f2;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.nafseyti.fxmlUser.controllers.UpdateProfileViewController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="25.0"
              style="-fx-background-color: #f8f5f2;">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <!-- ══════════ TITRE ══════════ -->
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="✏️"  style="-fx-font-size: 24px;" />
                    <Label text="Modifier le profil"
                           style="-fx-font-size: 24px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                </HBox>
                <Label text="Mettez à jour vos informations personnelles et votre photo de profil"
                       style="-fx-font-size: 13px;
                          -fx-text-fill: #888;
                          -fx-font-style: italic;" />
            </VBox>

            <!-- ══════════ CARTE PHOTO ══════════ -->
            <VBox alignment="CENTER" spacing="15.0"
                  style="-fx-background-color: linear-gradient(to bottom right, #374535, #296f1f);
                      -fx-background-radius: 18;
                      -fx-padding: 30;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 12, 0, 0, 4);">

                <Label text="Photo de profil"
                       style="-fx-font-size: 15px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;" />

                <!-- Avatar -->
                <StackPane>
                    <Circle radius="65.0"
                            style="-fx-fill: rgba(255,255,255,0.15);
                              -fx-stroke: rgba(255,255,255,0.45);
                              -fx-stroke-width: 3;" />
                    <ImageView fx:id="profilePicturePreview"
                               fitHeight="130.0" fitWidth="130.0"
                               preserveRatio="false">
                        <clip>
                            <Circle centerX="65.0" centerY="65.0" radius="65.0" />
                        </clip>
                    </ImageView>
                    <Label fx:id="profilePlaceholder" text="👤" visible="true"
                           style="-fx-font-size: 52px;" />
                </StackPane>

                <!-- Boutons upload -->
                <HBox alignment="CENTER" spacing="12.0">
                    <Button fx:id="uploadButton" onAction="#handleUploadPhoto"
                            text="📷  Choisir une photo"
                            style="-fx-background-color: white;
                              -fx-text-fill: #374535;
                              -fx-font-weight: bold;
                              -fx-padding: 9 20;
                              -fx-background-radius: 10;
                              -fx-font-size: 12px;" />
                    <Button fx:id="removePhotoButton" onAction="#handleRemovePhoto"
                            text="🗑️  Supprimer"
                            visible="false"
                            style="-fx-background-color: rgba(255,255,255,0.15);
                              -fx-text-fill: white;
                              -fx-padding: 9 20;
                              -fx-background-radius: 10;
                              -fx-border-color: rgba(255,255,255,0.5);
                              -fx-border-radius: 10;
                              -fx-font-size: 12px;" />
                </HBox>

                <Label text="Formats acceptés : JPG, PNG  •  Max 5 Mo"
                       style="-fx-font-size: 11px;
                          -fx-text-fill: rgba(255,255,255,0.65);
                          -fx-font-style: italic;" />
            </VBox>


            <!-- ══════════ FORMULAIRE ══════════ -->
            <VBox spacing="0"
                  style="-fx-background-color: white;
                      -fx-background-radius: 18;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);">
                <padding>
                    <Insets bottom="20.0" left="25.0" right="25.0" top="15.0" />
                </padding>

                <!-- Titre section -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 10 0 15 0;">
                    <Label text="📋" style="-fx-font-size: 16px;" />
                    <Label text="Informations personnelles"
                           style="-fx-font-size: 15px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                </HBox>

                <Separator style="-fx-background-color: #ece6df;" />

                <!-- Prénom -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="👤" style="-fx-font-size: 13px;" />
                        <Label text="PRÉNOM"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <TextField fx:id="firstnameField" promptText="Entrez votre prénom"
                               style="-fx-background-color: #f8f5f2;
                                 -fx-background-radius: 10;
                                 -fx-border-color: #e0dbd4;
                                 -fx-border-radius: 10;
                                 -fx-padding: 10 14;
                                 -fx-font-size: 13px;" />
                </VBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Nom -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="👤" style="-fx-font-size: 13px;" />
                        <Label text="NOM"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <TextField fx:id="lastnameField" promptText="Entrez votre nom"
                               style="-fx-background-color: #f8f5f2;
                                 -fx-background-radius: 10;
                                 -fx-border-color: #e0dbd4;
                                 -fx-border-radius: 10;
                                 -fx-padding: 10 14;
                                 -fx-font-size: 13px;" />
                </VBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Adresse -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🏠" style="-fx-font-size: 13px;" />
                        <Label text="ADRESSE"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <TextField fx:id="addressField" promptText="Entrez votre adresse (optionnel)"
                               style="-fx-background-color: #f8f5f2;
                                 -fx-background-radius: 10;
                                 -fx-border-color: #e0dbd4;
                                 -fx-border-radius: 10;
                                 -fx-padding: 10 14;
                                 -fx-font-size: 13px;" />
                </VBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Localisation -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="📍" style="-fx-font-size: 13px;" />
                        <Label text="LOCALISATION"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <TextField fx:id="locationField" promptText="Entrez votre localisation (optionnel)"
                               style="-fx-background-color: #f8f5f2;
                                 -fx-background-radius: 10;
                                 -fx-border-color: #e0dbd4;
                                 -fx-border-radius: 10;
                                 -fx-padding: 10 14;
                                 -fx-font-size: 13px;" />
                </VBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Téléphone -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="📱" style="-fx-font-size: 13px;" />
                        <Label text="TÉLÉPHONE"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <TextField fx:id="phoneField" promptText="Entrez votre numéro (optionnel)"
                               style="-fx-background-color: #f8f5f2;
                                 -fx-background-radius: 10;
                                 -fx-border-color: #e0dbd4;
                                 -fx-border-radius: 10;
                                 -fx-padding: 10 14;
                                 -fx-font-size: 13px;" />
                </VBox>
            </VBox>


            <!-- ══════════ MESSAGE + BOUTON SAVE ══════════ -->
            <Label fx:id="messageLabel" visible="false" wrapText="true"
                   style="-fx-font-size: 13px;
                       -fx-text-fill: #296f1f;
                       -fx-background-color: #eaf3e8;
                       -fx-background-radius: 10;
                       -fx-padding: 10 15;
                       -fx-font-weight: bold;" />

            <Button fx:id="saveButton" maxWidth="Infinity"
                    onAction="#handleSave"
                    text="💾  Enregistrer les modifications"
                    style="-fx-background-color: linear-gradient(to right, #374535, #296f1f);
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-padding: 13 0;
                        -fx-background-radius: 12;
                        -fx-effect: dropshadow(gaussian, rgba(55,69,53,0.4), 10, 0, 0, 3);
                        -fx-cursor: hand;" />

        </VBox>
    </content>
</ScrollPane>