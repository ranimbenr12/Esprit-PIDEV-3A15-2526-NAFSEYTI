<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true"
            style="-fx-background: #f8f5f2; -fx-background-color: #f8f5f2;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.nafseyti.fxmlUser.controllers.DashboardController">
    <content>
        <VBox spacing="25" style="-fx-background-color: #f8f5f2;">
            <padding>
                <Insets bottom="30" left="30" right="30" top="25" />
            </padding>

            <!-- ══ HEADER ══ -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox spacing="4">
                    <Label fx:id="welcomeLabel"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #285921;"
                           text="👤 Mon espace personnel" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-font-style: italic;"
                           text="Gérez votre profil et votre sécurité" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- ══ MENU ONGLETS ══ -->
            <HBox spacing="10">

                <Button fx:id="btnMonProfil"
                        text="👤 Mon profil"
                        onAction="#showProfile"
                        style="-fx-background-color: #374535;
                           -fx-text-fill: white;
                           -fx-background-radius: 20;
                           -fx-padding: 9 18;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;" />

                <Button fx:id="btnModifier"
                        text="✏️ Modifier profil"
                        onAction="#showUpdateProfile"
                        style="-fx-background-color: white;
                           -fx-text-fill: #374535;
                           -fx-background-radius: 20;
                           -fx-border-color: #d0cbc4;
                           -fx-border-radius: 20;
                           -fx-padding: 9 18;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;" />

                <Button fx:id="btnMotDePasse"
                        text="🔒 Mot de passe"
                        onAction="#showChangePassword"
                        style="-fx-background-color: white;
                           -fx-text-fill: #374535;
                           -fx-background-radius: 20;
                           -fx-border-color: #d0cbc4;
                           -fx-border-radius: 20;
                           -fx-padding: 9 18;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;" />

                <Button fx:id="btnSupprimer"
                        text="🗑️ Supprimer compte"
                        onAction="#showDeleteAccount"
                        style="-fx-background-color: #fff0f0;
                           -fx-text-fill: #c0392b;
                           -fx-background-radius: 20;
                           -fx-border-color: #e8b4b4;
                           -fx-border-radius: 20;
                           -fx-padding: 9 18;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;" />

                <Button fx:id="btnTousUsers"
                        text="👥 Tous les utilisateurs"
                        onAction="#showAllUsers"
                        visible="false"
                        style="-fx-background-color: white;
                           -fx-text-fill: #374535;
                           -fx-background-radius: 20;
                           -fx-border-color: #d0cbc4;
                           -fx-border-radius: 20;
                           -fx-padding: 9 18;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;" />
            </HBox>

            <!-- ══ ZONE DE CONTENU ══ -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                           -fx-background-radius: 18;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);"
                       minHeight="400">
                <VBox alignment="CENTER" spacing="15">
                    <Label text="🌿"
                           style="-fx-font-size: 48px;" />
                    <Label text="Sélectionnez une option ci-dessus"
                           style="-fx-text-fill: #bbb;
                             -fx-font-size: 15px;
                             -fx-font-style: italic;" />
                    <Label text="Gérez votre profil, sécurité et préférences"
                           style="-fx-text-fill: #ccc;
                             -fx-font-size: 12px;" />
                </VBox>
            </StackPane>

            <!-- ══ CARTE BIEN-ÊTRE ══ -->
            <VBox spacing="8"
                  style="-fx-background-color: linear-gradient(to bottom right, #fdf5e6, #e0cda9);
                      -fx-background-radius: 15;
                      -fx-padding: 18;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="🌿" style="-fx-font-size: 16px;" />
                    <Label text="Votre espace de confiance"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374535;" />
                </HBox>
                <Label text="NAFSEYTI protège vos données personnelles. Votre parcours de bien-être vous appartient."
                       wrapText="true"
                       style="-fx-font-size: 12px; -fx-text-fill: #5a4f3c; -fx-font-style: italic;" />
            </VBox>

        </VBox>
    </content>
</ScrollPane>