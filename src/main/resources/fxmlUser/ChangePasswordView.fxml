<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            style="-fx-background: #f8f5f2; -fx-background-color: #f8f5f2;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.nafseyti.fxmlUser.controllers.ChangePasswordViewController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="25.0"
              style="-fx-background-color: #f8f5f2;">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <!-- ══════════ TITRE ══════════ -->
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔒" style="-fx-font-size: 24px;" />
                    <Label text="Changer le mot de passe"
                           style="-fx-font-size: 24px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                </HBox>
                <Label text="Mettez à jour le mot de passe de votre compte"
                       style="-fx-font-size: 13px;
                          -fx-text-fill: #888;
                          -fx-font-style: italic;" />
            </VBox>

            <!-- ══════════ CARTE CONSEILS SÉCURITÉ ══════════ -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: linear-gradient(to right, #eaf3e8, #f8f5f2);
                      -fx-background-radius: 12;
                      -fx-border-color: #c8dfc5;
                      -fx-border-radius: 12;
                      -fx-border-width: 1;
                      -fx-padding: 14 18;">
                <Label text="🛡️" style="-fx-font-size: 22px;" />
                <VBox spacing="3">
                    <Label text="Conseils pour un mot de passe sécurisé"
                           style="-fx-font-size: 12px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                    <Label text="Au moins 8 caractères  •  Majuscules &amp; chiffres  •  Caractères spéciaux recommandés"
                           style="-fx-font-size: 11px;
                             -fx-text-fill: #6a8c68;" />
                </VBox>
            </HBox>

            <!-- ══════════ FORMULAIRE ══════════ -->
            <VBox spacing="0"
                  style="-fx-background-color: white;
                      -fx-background-radius: 18;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);">
                <padding>
                    <Insets bottom="20.0" left="25.0" right="25.0" top="15.0" />
                </padding>

                <!-- Titre section -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 10 0 15 0;">
                    <Label text="🔑" style="-fx-font-size: 16px;" />
                    <Label text="Informations de sécurité"
                           style="-fx-font-size: 15px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                </HBox>

                <Separator style="-fx-background-color: #ece6df;" />

                <!-- Mot de passe actuel -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🔓" style="-fx-font-size: 13px;" />
                        <Label text="MOT DE PASSE ACTUEL"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <PasswordField fx:id="currentPasswordField"
                                   promptText="Entrez votre mot de passe actuel"
                                   style="-fx-background-color: #f8f5f2;
                                     -fx-background-radius: 10;
                                     -fx-border-color: #e0dbd4;
                                     -fx-border-radius: 10;
                                     -fx-padding: 10 14;
                                     -fx-font-size: 13px;" />
                </VBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Nouveau mot de passe -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🔒" style="-fx-font-size: 13px;" />
                        <Label text="NOUVEAU MOT DE PASSE"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <PasswordField fx:id="newPasswordField"
                                   promptText="Minimum 8 caractères"
                                   style="-fx-background-color: #f8f5f2;
                                     -fx-background-radius: 10;
                                     -fx-border-color: #e0dbd4;
                                     -fx-border-radius: 10;
                                     -fx-padding: 10 14;
                                     -fx-font-size: 13px;" />
                </VBox>

                <Separator style="-fx-background-color: #f0ede8;" />

                <!-- Confirmer mot de passe -->
                <VBox spacing="6" style="-fx-padding: 18 0 14 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="✅" style="-fx-font-size: 13px;" />
                        <Label text="CONFIRMER LE MOT DE PASSE"
                               style="-fx-font-size: 10px;
                                -fx-text-fill: #a0a0a0;
                                -fx-font-weight: bold;" />
                    </HBox>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Répétez le nouveau mot de passe"
                                   style="-fx-background-color: #f8f5f2;
                                     -fx-background-radius: 10;
                                     -fx-border-color: #e0dbd4;
                                     -fx-border-radius: 10;
                                     -fx-padding: 10 14;
                                     -fx-font-size: 13px;" />
                </VBox>
            </VBox>

            <!-- ══════════ MESSAGE ══════════ -->
            <Label fx:id="messageLabel" visible="false" wrapText="true"
                   style="-fx-font-size: 13px;
                       -fx-text-fill: #296f1f;
                       -fx-background-color: #eaf3e8;
                       -fx-background-radius: 10;
                       -fx-padding: 10 15;
                       -fx-font-weight: bold;" />

            <!-- ══════════ BOUTON ══════════ -->
            <Button fx:id="changeButton" maxWidth="Infinity"
                    onAction="#handleChangePassword"
                    text="🔐  Mettre à jour le mot de passe"
                    style="-fx-background-color: linear-gradient(to right, #374535, #296f1f);
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-padding: 13 0;
                        -fx-background-radius: 12;
                        -fx-effect: dropshadow(gaussian, rgba(55,69,53,0.4), 10, 0, 0, 3);
                        -fx-cursor: hand;" />

            <!-- ══════════ CARTE BIEN-ÊTRE ══════════ -->
            <VBox spacing="8"
                  style="-fx-background-color: linear-gradient(to bottom right, #fdf5e6, #e0cda9);
                      -fx-background-radius: 15;
                      -fx-padding: 18;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="🌿" style="-fx-font-size: 16px;" />
                    <Label text="Votre sécurité, notre priorité"
                           style="-fx-font-size: 13px;
                             -fx-font-weight: bold;
                             -fx-text-fill: #374535;" />
                </HBox>
                <Label text="Un mot de passe fort protège votre espace de bien-être et vos données personnelles."
                       wrapText="true"
                       style="-fx-font-size: 12px;
                          -fx-text-fill: #5a4f3c;
                          -fx-font-style: italic;" />
            </VBox>

        </VBox>
    </content>
</ScrollPane>