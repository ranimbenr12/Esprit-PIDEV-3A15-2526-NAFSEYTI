<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.projet.gui.ChatBotController"
      spacing="10"
      style="-fx-background-color: linear-gradient(to bottom, #f8f5f2, #ffffff); -fx-padding: 20;"
      prefWidth="800"
      prefHeight="700">

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: white; -fx-padding: 15;
                 -fx-background-radius: 15; -fx-border-color: #6c5ce7;
                 -fx-border-radius: 15; -fx-border-width: 2;
                 -fx-effect: dropshadow(gaussian, rgba(108,92,231,0.2), 10, 0, 0, 5);">

        <Label text="🤖" style="-fx-font-size: 32px;"/>

        <VBox spacing="3">
            <Label text="NafseytiBot - Assistant Psychologique"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;"/>
            <Label fx:id="lblConfigInfo"
                   text="Posez vos questions sur le bien-être mental"
                   style="-fx-font-size: 12px; -fx-text-fill: #636e72;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="🔄 Nouvelle conversation"
                onAction="#reinitialiserChat"
                style="-fx-background-color: #6c5ce7; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 8;
                       -fx-cursor: hand; -fx-padding: 10 20 10 20;
                       -fx-font-size: 13px;
                       -fx-effect: dropshadow(gaussian, rgba(108,92,231,0.3), 5, 0, 0, 2);"/>
    </HBox>

    <!-- Zone de conversation -->
    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS"
                prefHeight="450"
                style="-fx-background-color: transparent; -fx-border-color: #e0e0e0;
                       -fx-border-radius: 15; -fx-background-radius: 15;
                       -fx-background: white; -fx-background-color: white;">

        <VBox fx:id="vboxMessages"
              spacing="15"
              style="-fx-padding: 20; -fx-background-color: white;">
        </VBox>
    </ScrollPane>

    <!-- Indicateur de frappe -->
    <Label fx:id="lblTyping"
           visible="false"
           managed="false"
           text="🤖 est en train d'écrire..."
           style="-fx-text-fill: #6c5ce7; -fx-font-style: italic; -fx-font-size: 12px; -fx-padding: 5 0 0 10;"/>

    <!-- Suggestions rapides -->
    <ScrollPane fitToHeight="true"
                hbarPolicy="ALWAYS"
                vbarPolicy="NEVER"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <HBox fx:id="hboxSuggestions"
              spacing="10"
              alignment="CENTER_LEFT"
              style="-fx-padding: 10 0 10 0;">
            <Label text="💡 Suggestions :"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6c5ce7;"/>
        </HBox>
    </ScrollPane>

    <!-- Zone de saisie -->
    <HBox spacing="15" alignment="CENTER" VBox.vgrow="NEVER">

        <TextArea fx:id="txtMessage"
                  promptText="Tapez votre message ici... (Entrée pour envoyer, Maj+Entrée pour nouvelle ligne)"
                  prefRowCount="3"
                  wrapText="true"
                  style="-fx-background-color: white; -fx-border-color: #6c5ce7;
                         -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 15;
                         -fx-padding: 12; -fx-font-size: 14px;
                         -fx-focus-color: #6c5ce7;"
                  HBox.hgrow="ALWAYS">
            <font>
                <Font size="14"/>
            </font>
        </TextArea>

        <VBox spacing="8" alignment="CENTER">
            <Button fx:id="btnEnvoyer"
                    text="📤 Envoyer"
                    onAction="#envoyerMessage"
                    prefWidth="110" prefHeight="70"
                    style="-fx-background-color: #6c5ce7; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 15px;
                           -fx-background-radius: 15; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(108,92,231,0.4), 8, 0, 0, 3);"/>

            <Label text="Entrée ↵"
                   style="-fx-text-fill: #b2bec3; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Indicateur de chargement -->
    <HBox fx:id="hboxLoading"
          visible="false"
          managed="false"
          alignment="CENTER"
          spacing="15"
          style="-fx-padding: 15; -fx-background-color: rgba(255,255,255,0.9);
                 -fx-background-radius: 50; -fx-border-radius: 50;">

        <ProgressIndicator prefWidth="25" prefHeight="25"
                           style="-fx-progress-color: #6c5ce7;"/>

        <Label text="NafseytiBot réfléchit à votre message..."
               style="-fx-text-fill: #6c5ce7; -fx-font-weight: bold; -fx-font-size: 14px;">
            <font>
                <Font size="14"/>
            </font>
        </Label>
    </HBox>

    <!-- Info sur les suggestions personnalisées -->
    <HBox fx:id="hboxInfoConfig"
          visible="false"
          managed="false"
          spacing="12"
          alignment="CENTER_LEFT"
          style="-fx-background-color: linear-gradient(to right, #e8f5e9, #c8e6c9);
                 -fx-padding: 12; -fx-background-radius: 10;
                 -fx-border-color: #27ae60; -fx-border-radius: 10;
                 -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(39,174,96,0.2), 5, 0, 0, 2);">

        <Label text="✨"
               style="-fx-font-size: 20px;"/>

        <VBox spacing="3">
            <Label text="Configuration personnalisée active"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Label fx:id="lblConfigInfo"
                   text="✨ Chatbot personnalisé par votre psychologue"
                   style="-fx-font-size: 12px; -fx-text-fill: #2e7d32;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Pied de page -->
    <HBox alignment="CENTER" spacing="5"
          style="-fx-padding: 10 0 0 0;">
        <Label text="NafseytiBot v1.0 • "
               style="-fx-text-fill: #b2bec3; -fx-font-size: 11px;"/>
        <Label text="Mode gratuit"
               style="-fx-text-fill: #6c5ce7; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        <Label text=" • "
               style="-fx-text-fill: #b2bec3; -fx-font-size: 11px;"/>
        <Label text="Réponses instantanées"
               style="-fx-text-fill: #00b894; -fx-font-size: 11px;"/>
    </HBox>

</VBox>