<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="tn.esprit.nafseyti.view.TestIAController">

    <!-- ═══════════════  HEADER  ═══════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #285921;                      -fx-padding: 14 30 14 20;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.28), 8, 0, 0, 3);">

            <!-- ← Bouton Back -->
            <Button fx:id="btnBack" onAction="#handleBack" style="-fx-background-color: rgba(255,255,255,0.15);                            -fx-text-fill: white;                            -fx-font-size: 13px;                            -fx-font-weight: bold;                            -fx-background-radius: 20;                            -fx-padding: 7 18;                            -fx-cursor: hand;                            -fx-border-color: rgba(255,255,255,0.45);                            -fx-border-radius: 20;                            -fx-border-width: 1.5;" text="← Retour" />

            <Separator orientation="VERTICAL" prefHeight="40" style="-fx-background-color: rgba(255,255,255,0.3);" />

            <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS">

                <ImageView fx:id="headerImage" fitHeight="56" fitWidth="56" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 6, 0, 0, 2);">
                    <image>
                        <Image url="@../images/cerveau.png" />
                    </image>
                </ImageView>

                <VBox alignment="CENTER_LEFT" spacing="3">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Questionnaire d'évaluation psychologique" />
                    <Label style="-fx-font-size: 11.5px; -fx-text-fill: rgba(255,255,255,0.82);" text="Répondez honnêtement à chaque question pour obtenir votre analyse personnalisée." />
                </VBox>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════  MAIN CONTENT  ═══════════════ -->
    <center>
        <!-- StackPane : fond image + overlay + cartes -->
        <StackPane fx:id="centerPane">

            <!-- Image de fond — taille liée au StackPane via le contrôleur -->
            <ImageView fx:id="bgImageView" preserveRatio="false" smooth="true">
                <image>
                    <Image url="@../images/Therapy.jpg" />
                </image>
            </ImageView>

            <!-- Overlay blanc semi-transparent pour lisibilité -->
            <Rectangle fx:id="overlay" fill="rgba(255,255,255,0.72)" />

            <!-- Cartes questionnaire + résultat -->
            <HBox alignment="TOP_LEFT" fillHeight="true" spacing="20">
                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <!-- ─────  LEFT : Questionnaire card  ───── -->
                <VBox spacing="0" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 16, 0, 0, 4);                              -fx-border-color: #d4edda;                              -fx-border-radius: 18;                              -fx-border-width: 1;" HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #c8ad7f; -fx-background-radius: 18 18 0 0; -fx-padding: 14 22 14 22;">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="📋  Questions" />
                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background: transparent;                                        -fx-background-color: transparent;                                        -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="questionsContainer" spacing="14">
                                <padding>
                                    <Insets bottom="10" left="22" right="22" top="20" />
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <HBox alignment="CENTER" style="-fx-padding: 16 22 20 22;                                  -fx-border-color: #e8f5e3;                                  -fx-border-width: 1 0 0 0;">
                        <Button fx:id="btnSubmit" onAction="#handleSubmit" style="-fx-background-color: #c8ad7f; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 11 38; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(40,89,33,0.35), 8, 0, 0, 3);" text="✅  Terminer le test" />
                    </HBox>
                </VBox>

                <!-- ─────  RIGHT : Result card  ───── -->
                <VBox fx:id="resultBox" managed="false" minWidth="320" prefWidth="400" spacing="0" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 16, 0, 0, 4);                              -fx-border-color: #d4edda;                              -fx-border-radius: 18;                              -fx-border-width: 1;" visible="false" HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a6b35;                                  -fx-background-radius: 18 18 0 0;                                  -fx-padding: 14 22 14 22;">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="📊  Résultat de l'analyse" />
                    </HBox>

                    <VBox alignment="CENTER" style="-fx-padding: 22 22 10 22;">
                        <Label style="-fx-font-size: 40px;" text="🔍" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #666; -fx-padding: 6 0 0 0;" text="Votre analyse personnalisée" />
                    </VBox>

                    <TextArea fx:id="resultArea" editable="false" style="-fx-background-color: #f9fdf8;                                      -fx-border-color: #d4edda;                                      -fx-border-width: 1 0 0 0;                                      -fx-font-size: 13px;                                      -fx-padding: 16;                                      -fx-text-fill: #2c3e2c;" wrapText="true" VBox.vgrow="ALWAYS" />
                </VBox>
            </HBox>
        </StackPane>
    </center>

</BorderPane>
