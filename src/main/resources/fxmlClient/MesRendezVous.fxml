<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.nafseyti.view.mesRendezVousClientController">

    <!-- SIDEBAR GAUCHE -->
    <left>
        <VBox prefWidth="220" spacing="5" style="-fx-background-color: #ece6df; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>

            <!-- Profil utilisateur -->
            <VBox alignment="CENTER" spacing="10">
                <StackPane>
                    <Circle fill="#285921" radius="35.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0" />
                    <Label style="-fx-font-size: 30px; -fx-text-fill: white;" text="👤" />
                    <ImageView fitHeight="59.0" fitWidth="67.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo.png" />
                        </image>
                    </ImageView>
                </StackPane>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #285921;" text="NAFSEYTI" />
            </VBox>

            <Separator style="-fx-background-color: #e0e0e0;">
                <VBox.margin>
                    <Insets bottom="10.0" top="10.0" />
                </VBox.margin>
            </Separator>

            <!-- Menu Items -->
            <Button fx:id="btnAccueil" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="🏠 Accueil" onAction="#handleBtnAccueil">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnRendezVous" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: #374535; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="📅 Mes rendez-vous">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnContenu" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="📚 Mon contenu">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnTests" onAction="#handleBtnTests" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="📊 Tests et Évaluations">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnEvenements" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="🎉 Événements et Ateliers">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnSuivi" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="📈 Mon progression">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnFeedback" prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #69685c; -fx-alignment: CENTER_LEFT; -fx-padding: 10; -fx-font-size: 14px; -fx-background-radius: 8;" text="💬 Donner mon avis">
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button prefHeight="40.0" prefWidth="190.0" style="-fx-background-color: transparent; -fx-text-fill: #285921; -fx-border-color: #285921; -fx-border-radius: 8; -fx-background-radius: 8;" text="🔓 Se déconnecter" onAction="#handleDeconnexion">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="20" style="-fx-background-color:#f8f5f2;">
            <padding>
                <Insets bottom="20" left="30" right="30" top="30" />
            </padding>

            <!-- ================= HEADER ================= -->
            <VBox spacing="5">

                <!-- HBox pour le titre + bouton -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:28; -fx-font-weight:bold; -fx-text-fill: #285921;" text="📅 Liste des Spécialistes" />
                    <Region HBox.hgrow="ALWAYS"/> <!-- pousse le bouton à droite -->
                    <Button fx:id="btnMesRendezVous" text="📅 Mes rendez-vous"
                            style="-fx-background-color: #285921; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 5 15;"
                            onAction="#handleBtnMesRendezVous"/>
                </HBox>

                <Label style="-fx-text-fill:#69685c; -fx-font-size:14;" text="Choisissez le professionnel qui vous convient" />
                <!-- Dans la VBox du HEADER, après le Label sous-titre -->
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="btnTestIA"
                            text="📋 Faire un test avant de réserver"
                            style="-fx-background-color: #752503; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-font-size: 14px;"
                            onAction="#handleBtnTestIA"/>
                </HBox>
            </VBox>


            <!-- ================= STATS RAPIDES ================= -->
            <HBox prefHeight="150.0" prefWidth="894.0" spacing="20">
                <VBox alignment="CENTER" prefWidth="200" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-color: #752503; -fx-border-radius: 20;">
                    <Label style="-fx-font-size: 28px;" text="👨‍⚕️" textFill="#752503" />
                    <Label fx:id="totalDoctorsLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #285921;" text="0" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #69685c; -fx-text-alignment: center;" text="Spécialistes disponibles" wrapText="true" />
                </VBox>
                <HBox alignment="CENTER" prefHeight="180" spacing="20">
                    <!-- Carte Image 1 -->
                    <StackPane prefHeight="150" prefWidth="180" style="-fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                        <ImageView fitHeight="150" fitWidth="180" preserveRatio="true">
                            <image>
                                <Image url="@../images/télécharger (12).jpg" />
                            </image>
                        </ImageView>
                        <!-- Overlay semi-transparent -->
                        <Rectangle arcHeight="15" arcWidth="15" fill="#e7dbcd4f" height="150" width="180" />
                        <!-- Texte flottant -->
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="🌟 Nouveau" textFill="white" StackPane.alignment="BOTTOM_CENTER" />
                    </StackPane>

                    <!-- Carte Image 2 -->
                    <StackPane prefHeight="150" prefWidth="180" style="-fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                        <ImageView fitHeight="150" fitWidth="180" preserveRatio="true">
                            <image>
                                <Image url="@../images/télécharger (13).jpg" />
                            </image>
                        </ImageView>
                        <Rectangle arcHeight="15" arcWidth="15" fill="#75250350" height="150" width="180" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="🔥 Populaire" textFill="white" StackPane.alignment="BOTTOM_CENTER" />
                    </StackPane>

                    <!-- Carte Image 3 -->
                    <StackPane prefHeight="150" prefWidth="180" style="-fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                        <ImageView fitHeight="150" fitWidth="180" preserveRatio="true">
                            <image>
                                <Image url="@../images/New Home Awaits at Our Loving Abode.jpg" />
                            </image>
                        </ImageView>
                        <Rectangle arcHeight="15" arcWidth="15" fill="#28592150" height="150" width="180" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="✨ Découverte" textFill="white" StackPane.alignment="BOTTOM_CENTER" />
                    </StackPane>
                </HBox>

            </HBox>

            <!-- ================= SEARCH + FILTER ================= -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <HBox style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 8 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 18px;" text="🔍" />
                    <TextField fx:id="searchField" promptText="Rechercher un spécialiste..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                </HBox>

                <ComboBox fx:id="specialtyFilter" prefWidth="220" promptText="Spécialité" style="-fx-background-radius:20; -fx-background-color: white; -fx-padding: 8;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Tous les spécialistes" />
                            <String fx:value="Psychologue" />
                            <String fx:value="Coach de vie" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <!-- ================= CONTENEUR SCROLLABLE - 3 CARTES PAR LIGNE ================= -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" VBox.vgrow="ALWAYS">

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #285921; -fx-padding: 0 0 15 0;" text="Nos Spécialistes" />

                <!-- ScrollPane avec VBox contenant les lignes de 3 cartes -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="doctorContainer" spacing="25" style="-fx-background-color: transparent; -fx-padding: 10;">
                        <!-- Les HBox (lignes de 3 cartes) seront ajoutées dynamiquement ici -->
                    </VBox>
                </ScrollPane>
            </VBox>

        </VBox>
    </center>
</BorderPane>
