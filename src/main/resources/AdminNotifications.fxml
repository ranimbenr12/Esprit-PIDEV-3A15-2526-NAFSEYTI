<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.projet.gui.AdminNotificationsController"
      style="-fx-background-color: linear-gradient(to bottom right, #f8f5f2, #f0ede5); -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>

    <!-- Decorative Top Border -->
    <Region style="-fx-background-color: linear-gradient(to right, #285921, #4CAF50, #8BC34A); -fx-height: 5px; -fx-background-radius: 5;">
        <VBox.margin>
            <Insets bottom="5" />
        </VBox.margin>
    </Region>

    <!-- Header with Icon and Badge -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <!-- Notification Icon with Circle Background -->
        <StackPane>
            <Circle radius="25" fill="linear-gradient(to bottom, #285921, #1e4a18)" stroke="white" strokeWidth="2">
                <effect>
                    <DropShadow color="#285921" radius="10" spread="0.1" />
                </effect>
            </Circle>
            <Label text="🔔" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, white, 5, 0.5, 0, 0);" />
        </StackPane>

        <VBox spacing="5">
            <Label text="Notifications de participations"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #285921; -fx-font-family: 'Segoe UI';">
                <effect>
                    <DropShadow color="#a5d6a5" radius="2" spread="0.1" offsetX="1" offsetY="1" />
                </effect>
            </Label>
            <Label text="Restez informé des nouvelles inscriptions"
                   style="-fx-font-size: 14px; -fx-text-fill: #8b9a8b; -fx-font-style: italic;" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Unread Count Badge with Animation -->
        <StackPane>
            <Circle radius="22" fill="linear-gradient(to bottom, #4CAF50, #2E7D32)" stroke="white" strokeWidth="2">
                <effect>
                    <DropShadow color="#4CAF50" radius="8" spread="0.2" />
                </effect>
            </Circle>
            <Label fx:id="unreadCountLabel" text="0"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI';" />
        </StackPane>
    </HBox>

    <!-- Toolbar with Gradient Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="markAllReadBtn" text="✅ Marquer tout comme lu">
            <graphic>
                <Label text="✓" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-padding: 0 5 0 0;" />
            </graphic>
            <style>
                -fx-background-color: linear-gradient(to bottom, #374535, #2a3328);
                -fx-text-fill: white;
                -fx-font-size: 14px;
                -fx-font-weight: bold;
                -fx-padding: 10 20;
                -fx-background-radius: 25;
                -fx-cursor: hand;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 2);
            </style>
        </Button>

        <Button fx:id="refreshBtn" text="🔄 Actualiser">
            <graphic>
                <Label text="↻" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-padding: 0 5 0 0;" />
            </graphic>
            <style>
                -fx-background-color: linear-gradient(to bottom, #4CAF50, #45a049);
                -fx-text-fill: white;
                -fx-font-size: 14px;
                -fx-font-weight: bold;
                -fx-padding: 10 20;
                -fx-background-radius: 25;
                -fx-cursor: hand;
                -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.3), 8, 0, 0, 2);
            </style>
        </Button>
    </HBox>

    <!-- Search Bar (Optional - can be added) -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 5 15;">
        <Label text="🔍" style="-fx-font-size: 18px; -fx-text-fill: #8b9a8b;" />
        <TextField promptText="Rechercher une notification..."
                   style="-fx-background-color: transparent; -fx-border: none; -fx-font-size: 14px; -fx-padding: 10 0;"
                   HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Notifications Table with Custom Styling -->
    <TableView fx:id="notificationsTable" VBox.vgrow="ALWAYS">
        <style>
            -fx-background-color: transparent;
            -fx-border-color: rgba(40, 89, 33, 0.2);
            -fx-border-width: 1;
            -fx-border-radius: 15;
            -fx-background-radius: 15;
            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);
        </style>
        <columns>
            <TableColumn fx:id="colMessage" text="Message" prefWidth="320">
                <style>
                    -fx-background-color: #f0ede5;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                </style>
            </TableColumn>
            <TableColumn fx:id="colDate" text="Date" prefWidth="160">
                <style>
                    -fx-background-color: #f0ede5;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                </style>
            </TableColumn>
            <TableColumn fx:id="colStatus" text="Statut" prefWidth="120">
                <style>
                    -fx-background-color: #f0ede5;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                </style>
            </TableColumn>
            <TableColumn fx:id="colAction" text="Action" prefWidth="170">
                <style>
                    -fx-background-color: #f0ede5;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                </style>
            </TableColumn>
        </columns>
    </TableView>

    <!-- Decorative Bottom Border -->
    <Region style="-fx-background-color: linear-gradient(to right, #8BC34A, #4CAF50, #285921); -fx-height: 3px; -fx-background-radius: 5;">
        <VBox.margin>
            <Insets top="10" />
        </VBox.margin>
    </Region>

    <!-- Status Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Circle radius="5" fill="#4CAF50" />
        <Label text="Notifications en temps réel" style="-fx-font-size: 12px; -fx-text-fill: #8b9a8b;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Dernière mise à jour: à l'instant" style="-fx-font-size: 11px; -fx-text-fill: #b0b0b0; -fx-font-style: italic;" />
    </HBox>

</VBox>