<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<ScrollPane fitToWidth="true" prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.fxml.controllers.UpdateProfileViewController">
   <content>
      <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="content-area">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         
         <children>
            <Label text="Update Profile">
               <style>
                  -fx-font-size: 24px;
                  -fx-font-weight: bold;
               </style>
            </Label>
            
            <Label text="Update your personal information and profile picture" textFill="#666">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            
            <!-- Profile Picture Section -->
            <VBox alignment="CENTER" spacing="15.0" styleClass="profile-card">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               
               <Label text="Profile Picture">
                  <style>
                     -fx-font-size: 14px;
                     -fx-font-weight: bold;
                  </style>
               </Label>
               
               <!-- Profile Picture Preview -->
               <StackPane>
                  <Circle radius="60.0" strokeWidth="3.0">
                     <style>
                        -fx-fill: #f0f0f0;
                        -fx-stroke: #667eea;
                     </style>
                  </Circle>
                  <ImageView fx:id="profilePicturePreview" fitHeight="120.0" fitWidth="120.0" preserveRatio="false">
                     <clip>
                        <Circle centerX="60.0" centerY="60.0" radius="60.0" />
                     </clip>
                  </ImageView>
                  <Label fx:id="profilePlaceholder" text="👤" visible="true">
                     <style>
                        -fx-font-size: 50px;
                     </style>
                  </Label>
               </StackPane>
               
               <!-- Upload Buttons -->
               <HBox alignment="CENTER" spacing="10.0">
                  <Button fx:id="uploadButton" onAction="#handleUploadPhoto" text="Upload Photo">
                     <style>
                        -fx-background-color: #667eea;
                        -fx-text-fill: white;
                        -fx-padding: 8 20;
                        -fx-font-size: 12px;
                     </style>
                  </Button>
                  <Button fx:id="removePhotoButton" onAction="#handleRemovePhoto" text="Remove Photo" visible="false">
                     <style>
                        -fx-background-color: #e74c3c;
                        -fx-text-fill: white;
                        -fx-padding: 8 20;
                        -fx-font-size: 12px;
                     </style>
                  </Button>
               </HBox>
               
               <Label text="Accepted formats: JPG, PNG (Max 5MB)" textFill="#999">
                  <style>
                     -fx-font-size: 11px;
                  </style>
               </Label>
            </VBox>
            
            <!-- Form Fields -->
            <VBox spacing="15.0" maxWidth="500.0">
               
               <VBox spacing="8.0">
                  <Label text="First Name" />
                  <TextField fx:id="firstnameField" promptText="Enter first name" styleClass="custom-field" />
               </VBox>
               
               <VBox spacing="8.0">
                  <Label text="Last Name" />
                  <TextField fx:id="lastnameField" promptText="Enter last name" styleClass="custom-field" />
               </VBox>
               
               <VBox spacing="8.0">
                  <Label text="Address" />
                  <TextField fx:id="addressField" promptText="Enter address (optional)" styleClass="custom-field" />
               </VBox>
               
               <VBox spacing="8.0">
                  <Label text="Location" />
                  <TextField fx:id="locationField" promptText="Enter location (optional)" styleClass="custom-field" />
               </VBox>
               
               <VBox spacing="8.0">
                  <Label text="Phone Number" />
                  <TextField fx:id="phoneField" promptText="Enter phone number (optional)" styleClass="custom-field" />
               </VBox>
               
               <Label fx:id="messageLabel" textFill="GREEN" visible="false" wrapText="true">
                  <VBox.margin>
                     <Insets top="10.0" />
                  </VBox.margin>
               </Label>
               
               <Button fx:id="saveButton" maxWidth="Infinity" onAction="#handleSave" styleClass="primary-button" text="Save Changes">
                  <VBox.margin>
                     <Insets top="10.0" />
                  </VBox.margin>
               </Button>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
