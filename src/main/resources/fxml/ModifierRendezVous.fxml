<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20"
      style="-fx-background-color: #ece6df; -fx-padding: 20;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.nafseyti.view.ModifierRendezVousController">

    <!-- 🔹 Titre avec icône -->
    <HBox alignment="CENTER" spacing="10">
        <ImageView fitHeight="30" fitWidth="30">
            <image>
                <Image url="@../images/appointment_icon.png" />
            </image>
        </ImageView>
        <Label text="Modifier Rendez-vous"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" />
    </HBox>

    <!-- 🔹 Formulaire -->
    <GridPane hgap="15" vgap="15">



        <Label text="Médecin:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbMedecin"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #2E7D32;"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <DatePicker fx:id="datePicker"
                    style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #2E7D32;"
                    GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Heure Début:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtHeureDebut"
                   promptText="HH:mm"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #2E7D32;"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Heure Fin:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtHeureFin"
                   promptText="HH:mm"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #2E7D32;"
                   GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- 🔹 Type séance -->
        <Label text="Type de séance:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <ComboBox fx:id="cmbTypeSeance"
                  style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #2E7D32;"
                  GridPane.columnIndex="1" GridPane.rowIndex="5">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="En ligne" />
                    <String fx:value="Présentiel" />
                </FXCollections>
            </items>
        </ComboBox>

        <!-- 🔹 Statut -->
        <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <ComboBox fx:id="cmbStatut"
                  style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #2E7D32;"
                  GridPane.columnIndex="1" GridPane.rowIndex="6">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="En attente" />
                    <String fx:value="Confirmé" />
                    <String fx:value="Annulé" />
                    <String fx:value="Pas encore pris" />
                </FXCollections>
            </items>
        </ComboBox>

        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
        </columnConstraints>

        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <!-- 🔹 Boutons -->
    <HBox alignment="CENTER" spacing="20">
        <Button text="Annuler"
                onAction="#handleAnnuler"
                style="-fx-background-color: #D7CCC8; -fx-text-fill: #2E7D32; -fx-background-radius: 12;" />

        <Button text="Modifier"
                onAction="#handleModifier"
                style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-background-radius: 12;" />
    </HBox>

</VBox>
