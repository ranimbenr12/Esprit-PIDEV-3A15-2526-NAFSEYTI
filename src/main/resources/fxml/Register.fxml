<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.fxml.controllers.RegisterController">
   <children>
      <!-- Left Side - Branding -->
      <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="700.0" prefWidth="350.0" styleClass="left-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label styleClass="app-title" text="Join Us" />
            <Label styleClass="tagline" text="Start your wellness journey" />
         </children>
      </VBox>

      <!-- Right Side - Registration Form -->
      <ScrollPane fitToWidth="true" layoutX="350.0" layoutY="0.0" prefHeight="700.0" prefWidth="550.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="right-panel">
               <padding>
                  <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
               </padding>
               <children>
                  <Label styleClass="form-title" text="Create Account" />
                  <Label styleClass="form-subtitle" text="Fill in your details to register">
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </Label>

                  <!-- First Name -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="First Name *" />
                        <TextField fx:id="firstnameField" promptText="Enter your first name" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Last Name -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Last Name *" />
                        <TextField fx:id="lastnameField" promptText="Enter your last name" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Email -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Email *" />
                        <TextField fx:id="emailField" promptText="Enter your email" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Password -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Password *" />
                        <PasswordField fx:id="passwordField" promptText="Minimum 8 characters" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Confirm Password -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Confirm Password *" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Phone Number -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Phone Number" />
                        <TextField fx:id="phoneField" promptText="Optional" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Address -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Address" />
                        <TextField fx:id="addressField" promptText="Optional" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Location -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Location" />
                        <TextField fx:id="locationField" promptText="Optional" styleClass="custom-field" />
                     </children>
                  </VBox>

                  <!-- Error Label -->
                  <Label fx:id="errorLabel" styleClass="error-label" textFill="RED" visible="false" wrapText="true" />

                  <!-- Success Label -->
                  <Label fx:id="successLabel" styleClass="success-label" textFill="GREEN" visible="false" wrapText="true" />

                  <!-- Register Button -->
                  <Button fx:id="registerButton" maxWidth="Infinity" onAction="#handleRegister" styleClass="primary-button" text="Register">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Button>

                  <!-- Login Link -->
                  <HBox alignment="CENTER" spacing="5.0">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <children>
                        <Label text="Already have an account?" />
                        <Hyperlink fx:id="loginLink" onAction="#handleBackToLogin" styleClass="link" text="Login here" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
