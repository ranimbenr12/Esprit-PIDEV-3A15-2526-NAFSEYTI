<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_LEFT" maxWidth="700.0" prefHeight="600.0" prefWidth="700.0" spacing="20.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.projet.fxml.controllers.ManageRolesViewController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   
   <children>
      <Label text="Manage User Roles">
         <style>
            -fx-font-size: 24px;
            -fx-font-weight: bold;
         </style>
      </Label>
      
      <Label text="Search for a user and update their role" textFill="#666" />
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
         <Label text="User ID:" />
         <TextField fx:id="userIdField" prefWidth="150.0" promptText="Enter user ID" styleClass="custom-field" />
         <Button fx:id="searchButton" onAction="#handleSearch" text="Search User">
            <style>
               -fx-background-color: #2196F3;
               -fx-text-fill: white;
               -fx-padding: 8 15;
            </style>
         </Button>
      </HBox>
      
      <Label fx:id="userInfoLabel" textFill="#666" visible="false" wrapText="true" />
      
      <VBox spacing="10.0" fx:id="roleSelectionBox" visible="false">
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="New Role:" />
            <ComboBox fx:id="roleComboBox" prefWidth="200.0" promptText="Select role">
               <style>
                  -fx-pref-height: 35px;
               </style>
            </ComboBox>
         </HBox>
         
         <Button fx:id="updateButton" maxWidth="200.0" onAction="#handleUpdateRole" text="Update Role">
            <style>
               -fx-background-color: #4CAF50;
               -fx-text-fill: white;
               -fx-padding: 10 20;
            </style>
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin>
         </Button>
      </VBox>
      
      <Label fx:id="messageLabel" textFill="GREEN" visible="false" wrapText="true">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
   </children>
</VBox>
